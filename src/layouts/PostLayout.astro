---
import Layout from './Layout.astro';
import CitationBlock from '../components/CitationBlock.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const {
  title,
  subtitle,
  description,
  excerpt,
  pubDate,
  updatedDate,
  author,
  category,
  tags,
  keywords,
  cover,
  coverAlt,
  faq,
  readingTime,
  citationAuthors,
  citationVolume,
  citationLanguage,
  authorsMeta,
  mentions,
} = post.data;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug)
  .map((p) => {
    const sameCat = p.data.category === category ? 2 : 0;
    const tagOverlap = p.data.tags.filter((t) => tags.includes(t)).length;
    return { post: p, score: sameCat + tagOverlap };
  })
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
  .slice(0, 2)
  .map((x) => x.post);

if (relatedPosts.length === 0) {
  const fallback = allPosts
    .filter((p) => p.slug !== post.slug)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 2);
  relatedPosts.push(...fallback);
}

const formatRelDate = (d: Date) =>
  d.toLocaleDateString('pt-BR', { year: 'numeric', month: 'long' });

const isoPub = pubDate.toISOString();
const isoMod = (updatedDate ?? pubDate).toISOString();
const canonicalURL = new URL(`/posts/${post.slug}/`, Astro.site).toString();
const imageURL = cover ? new URL(cover, Astro.site).toString() : new URL('/d.lab.png', Astro.site).toString();

const allKeywords = Array.from(new Set([...(keywords ?? []), ...(tags ?? [])]));

const articleInLang = 'pt-BR';

// Google Scholar citation metadata — passed to Layout/BaseHead which
// renders <meta name="citation_*"> tags in <head>. Also powers the
// "Como citar" block at the bottom of the article.
//
// Padrão: apenas pesquisa original recebe tags acadêmicas + bloco de
// citação, para evitar falso sinal de autoria primária em compilações
// interpretativas. Estudos de dados secundários com co-autoria formal
// (ex.: parcerias institucionais com método publicado) opt-in via
// `citationAuthors` no frontmatter, que sinaliza intenção explícita
// do autor de tornar o trabalho citável.
const isOriginalResearch = post.data.researchType === 'original';
const isCitable = isOriginalResearch || (citationAuthors !== undefined && citationAuthors.length > 0);
const yyyy = pubDate.getUTCFullYear();
const mm = String(pubDate.getUTCMonth() + 1).padStart(2, '0');
const dd = String(pubDate.getUTCDate()).padStart(2, '0');
const citationDate = `${yyyy}/${mm}/${dd}`;
// Fall back to splitting the free-form `author` string when
// citationAuthors isn't declared (e.g. solo-author posts).
const citationAuthorList =
  citationAuthors && citationAuthors.length > 0
    ? citationAuthors
    : author.split(/\s*&\s*/).filter(Boolean);
const citationMeta = isCitable
  ? {
      title,
      authors: citationAuthorList,
      date: citationDate,
      volume: citationVolume,
      language: citationLanguage,
      keywords: allKeywords.join(', '),
    }
  : undefined;

// Word count — derived from the raw MDX body, stripped of code fences,
// HTML tags and markdown syntax. Rough but defensible; strengthens
// the "depth" signal for both Scholar and mainstream SEO.
const bodyText = (post.body ?? '')
  .replace(/```[\s\S]*?```/g, ' ')
  .replace(/<[^>]+>/g, ' ')
  .replace(/[#*_`~\[\]()!]/g, ' ');
const wordCount = bodyText.split(/\s+/).filter((w) => w.length > 0).length;

// Author schema: prefer Person[] when the post declares authorsMeta
// (LinkedIn/ORCID/jobTitle for E-E-A-T). Fall back to a per-author
// Person[] built from citationAuthors. If neither is available
// (e.g. non-original posts without citation), keep the legacy
// Organization-as-author shape for backward compatibility.
const siteOrigin = new URL('/', Astro.site).toString();
type AuthorSchema =
  | { '@type': 'Person'; name: string; jobTitle?: string; sameAs?: string[]; url?: string }
  | { '@type': 'Organization'; '@id': string; name: string; url: string };
const authorSchema: AuthorSchema | AuthorSchema[] = (() => {
  if (authorsMeta && authorsMeta.length > 0) {
    return authorsMeta.map((a): AuthorSchema => {
      const sameAs: string[] = [];
      if (a.linkedin) sameAs.push(a.linkedin);
      if (a.orcid) sameAs.push(a.orcid.startsWith('http') ? a.orcid : `https://orcid.org/${a.orcid}`);
      return {
        '@type': 'Person',
        name: a.name,
        ...(a.jobTitle ? { jobTitle: a.jobTitle } : {}),
        ...(sameAs.length ? { sameAs } : {}),
      };
    });
  }
  if (citationAuthorList.length > 0 && isCitable) {
    return citationAuthorList.map((name): AuthorSchema => ({ '@type': 'Person', name }));
  }
  return {
    '@type': 'Organization',
    '@id': siteOrigin + '#org',
    name: author,
    url: siteOrigin,
  };
})();

// Periodical wrapper for the research series. Scholar uses isPartOf
// to group articles under the same publication banner.
const periodicalLd = {
  '@type': 'Periodical',
  '@id': new URL('/blog', Astro.site).toString() + '#series',
  name: 'D.Lab Research Series',
  publisher: { '@id': siteOrigin + '#org' },
  inLanguage: articleInLang,
};

// Citations mapped to CreativeWork. Free-form text in `name`
// (reference string); URL/author optional per entry.
const mentionsLd = mentions && mentions.length > 0
  ? mentions.map((m) => ({
      '@type': 'CreativeWork',
      name: m.name,
      ...(m.url ? { url: m.url } : {}),
      ...(m.author ? { author: { '@type': 'Person', name: m.author } } : {}),
    }))
  : undefined;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': canonicalURL + '#article',
  headline: title,
  alternativeHeadline: subtitle ?? undefined,
  description,
  abstract: excerpt ?? description,
  datePublished: isoPub,
  dateModified: isoMod,
  inLanguage: articleInLang,
  isAccessibleForFree: true,
  url: canonicalURL,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL,
  },
  image: {
    '@type': 'ImageObject',
    url: imageURL,
    width: 1200,
    height: 675,
    ...(coverAlt ? { caption: coverAlt } : {}),
  },
  author: authorSchema,
  publisher: {
    '@type': 'Organization',
    '@id': siteOrigin + '#org',
    name: 'D.Lab',
    url: siteOrigin,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/d.lab.png', Astro.site).toString(),
      width: 512,
      height: 512,
    },
  },
  isPartOf: periodicalLd,
  keywords: allKeywords.join(', '),
  articleSection: category,
  about: tags.map((t) => ({ '@type': 'Thing', name: t })),
  wordCount,
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.article-title', '.post-title', '.tldr-card', '.article-subtitle', '.post-subtitle'],
  },
  ...(mentionsLd ? { mentions: mentionsLd } : {}),
  ...(readingTime
    ? {
        timeRequired: 'PT' + (parseInt(readingTime, 10) || 10) + 'M',
      }
    : {}),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'D.Lab', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Análises Públicas', item: new URL('/blog', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: title, item: canonicalURL },
  ],
};

const faqLd =
  faq && faq.length
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      }
    : null;

const keepReadingLabel = 'Continue lendo';
const moreResearchLabel = 'Outras pesquisas do D.Lab';
const readLabel = 'Ler';
const originalResearchLabel = 'Pesquisa Original';

// DRAFT: confirmar copy — ponte de conversão ao fim de cada estudo.
// Sem venda agressiva: convida a enquadrar a mesma pergunta no contexto
// do leitor. Link para o contato já existente.
const bridgeLabel = 'Do público ao seu contexto';
const bridgeTitle = 'Esse estudo respondeu uma pergunta pública.';
const bridgeBody = 'Existe uma versão dessa pergunta no seu mercado? A mesma metodologia vira projeto fechado, sob NDA. A primeira conversa serve para enquadrar a pergunta.';
const bridgeCta = 'Conversa de enquadramento →';
---

<Layout
  title={`${title} | D.Lab Experts`}
  description={description}
  image={cover}
  imageAlt={coverAlt}
  active="blog"
  type="article"
  publishedTime={isoPub}
  modifiedTime={isoMod}
  author={author}
  tags={allKeywords}
  citationMeta={citationMeta}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}

  <article itemscope itemtype="https://schema.org/Article">
    <meta itemprop="datePublished" content={isoPub} />
    <meta itemprop="dateModified" content={isoMod} />
    <meta itemprop="inLanguage" content={articleInLang} />
    <slot />
  </article>

  {isCitable && (
    <CitationBlock
      title={title}
      authors={citationAuthorList}
      date={citationDate}
      volume={citationVolume}
      language={citationLanguage}
      url={canonicalURL}
    />
  )}

  <!-- DRAFT: confirmar copy — ponte de conversão reutilizável (todo estudo). -->
  <section class="study-bridge">
    <div class="post-container">
      <div class="study-bridge-card">
        <div class="study-bridge-label">
          <span style="width:22px;height:1px;background:var(--grad);display:block"></span>
          {bridgeLabel}
        </div>
        <h2 class="study-bridge-title">{bridgeTitle}</h2>
        <p class="study-bridge-body">{bridgeBody}</p>
        <a href="/contato" class="btn btn-primary study-bridge-cta">{bridgeCta}</a>
      </div>
    </div>
  </section>

  {relatedPosts.length > 0 && (
    <section class="related-posts">
      <div class="post-container">
        <div class="related-header">
          <div class="label" style="display:flex;align-items:center;gap:10px;margin-bottom:14px">
            <span style="width:22px;height:1px;background:var(--grad);display:block"></span>
            {keepReadingLabel}
          </div>
          <h2>{moreResearchLabel}</h2>
        </div>
        <div class="related-grid">
          {relatedPosts.map((rp) => {
            return (
              <a href={`/posts/${rp.slug}`} class="related-card">
                {rp.data.cover && (
                  <div class="related-card-img">
                    <img src={rp.data.cover} alt={rp.data.coverAlt ?? ''} loading="lazy" />
                  </div>
                )}
                <div class="related-card-body">
                  <div class="related-card-tags">
                    {rp.data.researchType === 'original' && (
                      <span class="related-card-tag original">{originalResearchLabel}</span>
                    )}
                    <span class="related-card-tag">{rp.data.category}</span>
                  </div>
                  <h3 class="related-card-title">{rp.data.title}</h3>
                  <p class="related-card-excerpt">{rp.data.description}</p>
                  <div class="related-card-footer">
                    <span class="related-card-date">{formatRelDate(rp.data.pubDate)}{rp.data.readingTime ? ` · ${rp.data.readingTime}` : ''}</span>
                    <span class="related-card-read">
                      {readLabel}
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  /* Ponte de conversão — discreta, ao fim do estudo, antes dos relacionados. */
  .study-bridge {
    padding: 56px 0 8px;
    position: relative;
    z-index: 1;
  }
  .study-bridge-card {
    background: linear-gradient(160deg, rgba(234,234,240,0.08), rgba(234,234,240,0.03) 70%, transparent);
    border: 1px solid rgba(234,234,240,0.20);
    border-radius: 20px;
    padding: 40px 40px 36px;
    text-align: left;
  }
  .study-bridge-label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lilac);
    margin-bottom: 16px;
  }
  .study-bridge-title {
    font-size: clamp(20px, 2.4vw, 26px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--white);
    margin: 0 0 12px;
    text-wrap: balance;
  }
  .study-bridge-body {
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted);
    margin: 0 0 24px;
    max-width: 640px;
  }
  .study-bridge-cta { display: inline-flex; }
  @media (max-width: 767px) {
    .study-bridge-card { padding: 30px 24px 26px; }
  }

  .related-posts {
    padding: 72px 0 40px;
    border-top: 1px solid var(--border);
    position: relative;
    z-index: 1;
  }
  .related-header {
    margin-bottom: 36px;
  }
  .related-header h2 {
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .related-card {
    background: linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.015));
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 16px;
    overflow: hidden;
    backdrop-filter: blur(14px) saturate(120%);
    -webkit-backdrop-filter: blur(14px) saturate(120%);
    transition: transform 0.3s cubic-bezier(.16, 1, .3, 1), border-color 0.3s, box-shadow 0.3s;
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }
  .related-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-h);
    box-shadow: 0 24px 64px rgba(0, 0, 0, .35);
  }
  .related-card-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--surface);
    overflow: hidden;
    position: relative;
  }
  .related-card-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 50%, var(--card) 100%);
  }
  .related-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    position: relative;
    z-index: 1;
  }
  .related-card-body {
    padding: 22px 24px 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .related-card-tags {
    display: flex;
    gap: 6px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }
  .related-card-tag {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: 6px;
    background: rgba(255, 255, 255, .08);
    color: var(--lilac);
    border: 1px solid rgba(255, 255, 255, .12);
  }
  :global(.related-card-tag.original) {
    background: linear-gradient(135deg, rgba(255,255,255,0.16) 0%, rgba(255,255,255,0.07) 100%);
    color: #fff;
    border-color: rgba(255, 255, 255,.5);
  }
  .related-card-title {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin-bottom: 10px;
    color: var(--white);
  }
  .related-card-excerpt {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 18px;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .related-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .related-card-date {
    font-size: 11px;
    color: var(--dimmed);
  }
  .related-card-read {
    font-size: 12px;
    font-weight: 500;
    color: var(--lilac);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: gap 0.2s;
  }
  .related-card:hover .related-card-read {
    gap: 8px;
  }
  @media (max-width: 767px) {
    .related-grid { grid-template-columns: 1fr; }
  }
</style>
