---
import Layout from './Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const {
  title,
  subtitle,
  description,
  excerpt,
  pubDate,
  updatedDate,
  author,
  category,
  tags,
  keywords,
  cover,
  faq,
  readingTime,
} = post.data;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug)
  .map((p) => {
    const sameCat = p.data.category === category ? 2 : 0;
    const tagOverlap = p.data.tags.filter((t) => tags.includes(t)).length;
    return { post: p, score: sameCat + tagOverlap };
  })
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
  .slice(0, 2)
  .map((x) => x.post);

if (relatedPosts.length === 0) {
  const fallback = allPosts
    .filter((p) => p.slug !== post.slug)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 2);
  relatedPosts.push(...fallback);
}

const formatRelDate = (d: Date) =>
  d.toLocaleDateString('pt-BR', { year: 'numeric', month: 'long' });

const isoPub = pubDate.toISOString();
const isoMod = (updatedDate ?? pubDate).toISOString();
const canonicalURL = new URL(`/posts/${post.slug}/`, Astro.site).toString();
const imageURL = cover ? new URL(cover, Astro.site).toString() : new URL('/d.lab.png', Astro.site).toString();

const allKeywords = Array.from(new Set([...(keywords ?? []), ...(tags ?? [])]));

const articleInLang = 'pt-BR';

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': canonicalURL + '#article',
  headline: title,
  alternativeHeadline: subtitle ?? undefined,
  description,
  abstract: excerpt ?? description,
  datePublished: isoPub,
  dateModified: isoMod,
  inLanguage: articleInLang,
  isAccessibleForFree: true,
  url: canonicalURL,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL,
  },
  image: {
    '@type': 'ImageObject',
    url: imageURL,
    width: 1200,
    height: 675,
  },
  author: {
    '@type': 'Organization',
    '@id': new URL('/', Astro.site).toString() + '#org',
    name: author,
    url: new URL('/', Astro.site).toString(),
  },
  publisher: {
    '@type': 'Organization',
    '@id': new URL('/', Astro.site).toString() + '#org',
    name: 'D.Lab',
    url: new URL('/', Astro.site).toString(),
    logo: {
      '@type': 'ImageObject',
      url: new URL('/d.lab.png', Astro.site).toString(),
    },
  },
  keywords: allKeywords.join(', '),
  articleSection: category,
  about: tags.map((t) => ({ '@type': 'Thing', name: t })),
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.article-title', '.post-title', '.tldr-card', '.article-subtitle', '.post-subtitle'],
  },
  ...(readingTime
    ? {
        timeRequired: 'PT' + (parseInt(readingTime, 10) || 10) + 'M',
      }
    : {}),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'D.Lab', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Análises Públicas', item: new URL('/blog', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: title, item: canonicalURL },
  ],
};

const faqLd =
  faq && faq.length
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      }
    : null;

const keepReadingLabel = 'Continue lendo';
const moreResearchLabel = 'Outras pesquisas do D.Lab';
const readLabel = 'Ler';
const originalResearchLabel = 'Pesquisa Original';
---

<Layout
  title={`${title} | D.Lab Experts`}
  description={description}
  image={cover}
  active="blog"
  type="article"
  publishedTime={isoPub}
  modifiedTime={isoMod}
  author={author}
  tags={allKeywords}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}

  <article itemscope itemtype="https://schema.org/Article">
    <meta itemprop="datePublished" content={isoPub} />
    <meta itemprop="dateModified" content={isoMod} />
    <meta itemprop="inLanguage" content={articleInLang} />
    <slot />
  </article>

  {relatedPosts.length > 0 && (
    <section class="related-posts">
      <div class="post-container">
        <div class="related-header">
          <div class="label" style="display:flex;align-items:center;gap:10px;margin-bottom:14px">
            <span style="width:22px;height:1px;background:var(--grad);display:block"></span>
            {keepReadingLabel}
          </div>
          <h2>{moreResearchLabel}</h2>
        </div>
        <div class="related-grid">
          {relatedPosts.map((rp) => {
            return (
              <a href={`/posts/${rp.slug}`} class="related-card">
                {rp.data.cover && (
                  <div class="related-card-img">
                    <img src={rp.data.cover} alt={rp.data.coverAlt ?? ''} loading="lazy" />
                  </div>
                )}
                <div class="related-card-body">
                  <div class="related-card-tags">
                    {rp.data.researchType === 'original' && (
                      <span class="related-card-tag original">{originalResearchLabel}</span>
                    )}
                    <span class="related-card-tag">{rp.data.category}</span>
                  </div>
                  <h3 class="related-card-title">{rp.data.title}</h3>
                  <p class="related-card-excerpt">{rp.data.description}</p>
                  <div class="related-card-footer">
                    <span class="related-card-date">{formatRelDate(rp.data.pubDate)}{rp.data.readingTime ? ` · ${rp.data.readingTime}` : ''}</span>
                    <span class="related-card-read">
                      {readLabel}
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  .related-posts {
    padding: 72px 0 40px;
    border-top: 1px solid var(--border);
    position: relative;
    z-index: 1;
  }
  .related-header {
    margin-bottom: 36px;
  }
  .related-header h2 {
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .related-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 18px;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(.16, 1, .3, 1);
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }
  .related-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-h);
    box-shadow: 0 24px 64px rgba(0, 0, 0, .35);
  }
  .related-card-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--surface);
    overflow: hidden;
    position: relative;
  }
  .related-card-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 50%, var(--card) 100%);
  }
  .related-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    position: relative;
    z-index: 1;
  }
  .related-card-body {
    padding: 22px 24px 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .related-card-tags {
    display: flex;
    gap: 6px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }
  .related-card-tag {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: 6px;
    background: rgba(177, 140, 255, .08);
    color: var(--lilac);
    border: 1px solid rgba(177, 140, 255, .12);
  }
  :global(.related-card-tag.original) {
    background: linear-gradient(135deg, rgba(124,58,237,.22) 0%, rgba(6,182,212,.18) 100%);
    color: #fff;
    border-color: rgba(177,140,255,.5);
  }
  .related-card-title {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin-bottom: 10px;
    color: var(--white);
  }
  .related-card-excerpt {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 18px;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .related-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .related-card-date {
    font-size: 11px;
    color: var(--dimmed);
  }
  .related-card-read {
    font-size: 12px;
    font-weight: 500;
    color: var(--lilac);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: gap 0.2s;
  }
  .related-card:hover .related-card-read {
    gap: 8px;
  }
  @media (max-width: 767px) {
    .related-grid { grid-template-columns: 1fr; }
  }
</style>
