---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SvgDefs from '../components/SvgDefs.astro';
import CustomCursor from '../components/CustomCursor.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '../styles/global.css';
import { htmlLang } from '../i18n/ui';
import type { CitationMeta } from '../components/BaseHead.astro';

export interface Props {
  title: string;
  description: string;
  active?: 'home' | 'about' | 'segments' | 'products' | 'blog' | 'contato' | 'colaborar' | 'solucoes';
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  citationMeta?: CitationMeta;
}

const {
  title,
  description,
  active,
  image,
  imageAlt,
  type,
  publishedTime,
  modifiedTime,
  author,
  tags,
  citationMeta,
} = Astro.props;
---

<!DOCTYPE html>
<html lang={htmlLang}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      tags={tags}
      citationMeta={citationMeta}
    />
  </head>
  <body>
    <SvgDefs />
    {/* PixelBird removido: o pássaro pixel-art destoa do registro
        minimalista Apple/Resend do redesign. Reintroduzir aqui se
        a marca quiser o mascote ambiente de volta. */}
    <CustomCursor enabled={false} />
    <Header active={active} />
    <slot />
    <Footer />

    <script>
      // ══ NAV SCROLL + PROGRESS BAR ═════════════════════════════════════
      // Single scroll listener drives both the nav shrink state and the
      // progress bar underneath it. rAF-throttled so it never does more
      // than one style update per frame, even on trackpad/fling scrolls.
      const nav = document.getElementById('nav');
      const progress = document.getElementById('scroll-progress');
      if (nav || progress) {
        let ticking = false;
        const update = () => {
          const scrollY = window.scrollY;
          if (nav) {
            nav.classList.toggle('scrolled', scrollY > 40);
          }
          if (progress) {
            const max = document.documentElement.scrollHeight - window.innerHeight;
            const ratio = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
            progress.style.setProperty('--progress', String(ratio));
          }
          ticking = false;
        };
        const onScroll = () => {
          if (!ticking) {
            requestAnimationFrame(update);
            ticking = true;
          }
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        update(); // initial paint in case page loads mid-scroll
      }

      // ══ HAMBURGER ═════════════════════════════════════════════════════
      const hb = document.getElementById('hamburger');
      const mm = document.getElementById('mobile-menu');
      if (hb && mm) {
        const closeMM = () => { hb.classList.remove('open'); mm.classList.remove('open'); };
        hb.addEventListener('click', () => { hb.classList.toggle('open'); mm.classList.toggle('open'); });
        document.querySelectorAll('[data-mm-link]').forEach((link) => {
          link.addEventListener('click', closeMM);
        });
      }

      // ══ INTERSECTION OBSERVER ═════════════════════════════════════════
      const animClasses = ['.fi', '.fi-l', '.fi-r', '.fi-s'];
      const allAnim = document.querySelectorAll(animClasses.join(','));
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            observer.unobserve(e.target);
          }
        });
      }, { threshold: 0.1 });
      allAnim.forEach((el) => {
        if (el.closest('#hero') || el.closest('.post-hero') || el.closest('.about-hero') || el.closest('.blog-hero') || el.closest('.article-hero')) {
          setTimeout(() => el.classList.add('visible'), 80);
        } else {
          observer.observe(el);
        }
      });

      // ══ BARS ══════════════════════════════════════════════════════════
      function animBars(sel: string) {
        document.querySelectorAll<HTMLElement>(sel).forEach((b) => {
          b.style.width = (b.dataset.v ?? '0') + '%';
        });
      }
      setTimeout(() => animBars('.hero-bar'), 700);

      const demoSec = document.getElementById('demo');
      if (demoSec) {
        let demoDone = false;
        const demoObs = new IntersectionObserver((e) => {
          if (e[0].isIntersecting && !demoDone) {
            demoDone = true;
            animBars('.demo-bar');
            document.querySelectorAll('.line-draw').forEach((line) => line.classList.add('drawn'));
            demoObs.unobserve(demoSec);
          }
        }, { threshold: 0.2 });
        demoObs.observe(demoSec);
      }

      // ══ REPORT TABS ═══════════════════════════════════════════════════
      document.querySelectorAll<HTMLButtonElement>('.rc-tab').forEach((tab) => {
        tab.addEventListener('click', () => {
          const target = tab.dataset.tab;
          document.querySelectorAll('.rc-tab').forEach((t) => t.classList.remove('active'));
          document.querySelectorAll('.rc-tab-panel').forEach((p) => p.classList.remove('active'));
          tab.classList.add('active');
          const panel = document.querySelector(`.rc-tab-panel[data-panel="${target}"]`);
          if (panel) {
            panel.classList.add('active');
            if (target === 'score') setTimeout(() => animBars('.score-bar'), 100);
          }
        });
      });

      // ══ SMOOTH SCROLL ═════════════════════════════════════════════════
      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
        a.addEventListener('click', (e) => {
          const href = a.getAttribute('href');
          if (!href || href === '#') return;
          const t = document.querySelector(href);
          if (t) {
            e.preventDefault();
            window.scrollTo({ top: t.getBoundingClientRect().top + window.scrollY - 80, behavior: 'smooth' });
          }
        });
      });

      // ══ NAV SCROLL SPY ═════════════════════════════════════════════════
      // On the home page, the nav has in-page anchors (/#hero, /#segments,
      // /#products). The server can only mark one of them active, so the
      // others never light up. This observer tracks which section is in
      // view and toggles the `active` class on the matching anchor link so
      // Segmentos/Produtos get the same lilac treatment as Home.
      (function () {
        const nav = document.getElementById('nav');
        if (!nav) return;
        const anchorLinks = new Map<string, HTMLAnchorElement>();
        nav.querySelectorAll<HTMLAnchorElement>('.nav-links a').forEach((a) => {
          const href = a.getAttribute('href') || '';
          const m = href.match(/^\/?#(.+)$/);
          if (m) anchorLinks.set(m[1], a);
        });
        if (!anchorLinks.size) return;

        const sections: HTMLElement[] = [];
        anchorLinks.forEach((_, id) => {
          const el = document.getElementById(id);
          if (el) sections.push(el);
        });
        if (!sections.length) return;

        const activate = (id: string) => {
          anchorLinks.forEach((a, key) => {
            a.classList.toggle('active', key === id);
          });
        };

        const observer = new IntersectionObserver((entries) => {
          // Pick the entry that's most prominently in view.
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (visible) activate((visible.target as HTMLElement).id);
        }, {
          // Activate when a section crosses the middle of the viewport.
          rootMargin: '-40% 0px -50% 0px',
          threshold: [0, 0.25, 0.5, 0.75, 1],
        });
        sections.forEach((s) => observer.observe(s));
      })();

      // ══ 3D TILT + PARALLAX ════════════════════════════════════════════
      // Profundidade elegante estilo Apple/Resend: cards .tilt inclinam
      // levemente seguindo o ponteiro; elementos [data-parallax] deslizam
      // no scroll. rAF-throttled, listeners passivos, e tudo desligado
      // sob prefers-reduced-motion.
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion) {
        // — tilt reativo ao ponteiro —
        const MAX_TILT = 6; // graus
        document.querySelectorAll<HTMLElement>('.tilt').forEach((card) => {
          const inner = card.querySelector<HTMLElement>('.tilt-inner');
          if (!inner) return;
          let raf = 0;
          card.addEventListener('pointermove', (e) => {
            const r = card.getBoundingClientRect();
            const px = (e.clientX - r.left) / r.width - 0.5;
            const py = (e.clientY - r.top) / r.height - 0.5;
            if (raf) return;
            raf = requestAnimationFrame(() => {
              inner.style.setProperty('--rx', (px * MAX_TILT).toFixed(2) + 'deg');
              inner.style.setProperty('--ry', (-py * MAX_TILT).toFixed(2) + 'deg');
              raf = 0;
            });
          }, { passive: true });
          card.addEventListener('pointerleave', () => {
            inner.style.setProperty('--rx', '0deg');
            inner.style.setProperty('--ry', '0deg');
          });
        });

        // — parallax no scroll —
        const plx = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
        if (plx.length) {
          let pTicking = false;
          const updPlx = () => {
            const vh = window.innerHeight;
            for (const el of plx) {
              const speed = parseFloat(el.getAttribute('data-parallax') || '0.15');
              const r = el.getBoundingClientRect();
              const center = r.top + r.height / 2 - vh / 2;
              el.style.transform = `translate3d(0, ${(-center * speed).toFixed(1)}px, 0)`;
            }
            pTicking = false;
          };
          const onPlx = () => { if (!pTicking) { requestAnimationFrame(updPlx); pTicking = true; } };
          window.addEventListener('scroll', onPlx, { passive: true });
          window.addEventListener('resize', onPlx, { passive: true });
          updPlx();
        }
      }
    </script>

    <!-- Vercel Analytics + Speed Insights (idiomatic Astro integration,
         only collects data when deployed on Vercel) -->
    <Analytics />
    <SpeedInsights />
  </body>
</html>
