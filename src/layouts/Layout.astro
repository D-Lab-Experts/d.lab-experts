---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SvgDefs from '../components/SvgDefs.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '../styles/global.css';
import { htmlLang, type Locale } from '../i18n/ui';
import { getLocaleFromUrl } from '../i18n/utils';

export interface Props {
  title: string;
  description: string;
  active?: 'home' | 'about' | 'segments' | 'products' | 'blog' | 'contato' | 'colaborar';
  locale?: Locale;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
}

const {
  title,
  description,
  active,
  locale: explicitLocale,
  image,
  type,
  publishedTime,
  modifiedTime,
  author,
  tags,
} = Astro.props;

// Pages can pass `locale` explicitly (cleanest), otherwise we derive
// it from the URL prefix (/pt/..., /es/..., or root = en).
const locale: Locale = explicitLocale ?? getLocaleFromUrl(Astro.url);
---

<!DOCTYPE html>
<html lang={htmlLang[locale]}>
  <head>
    <BaseHead
      title={title}
      description={description}
      locale={locale}
      image={image}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      tags={tags}
    />
  </head>
  <body>
    <canvas id="geo-canvas"></canvas>
    <SvgDefs />
    <Header active={active} locale={locale} />
    <slot />
    <Footer locale={locale} />

    <script>
      // ══ REDUCED MOTION: skip all decorative animations ══════════════════
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ══ GEOMETRIC INTELLIGENCE CANVAS ══════════════════════════════════
      (function () {
        if (reducedMotion) return;
        const canvas = document.getElementById('geo-canvas') as HTMLCanvasElement | null;
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        let W = 0, H = 0;
        let nodes: any[] = [];
        let hexes: any[] = [];
        let time = 0;

        const COLORS: number[][] = [
          [177, 140, 255], // lilac
          [77, 163, 255],  // blue
          [0, 212, 255],   // cyan
          [0, 229, 160],   // green
        ];

        function initNodes() {
          nodes = [];
          hexes = [];
          const spacing = 130;
          const cols = Math.ceil(W / spacing) + 1;
          const rows = Math.ceil(H / spacing) + 1;
          for (let i = 0; i < cols; i++) {
            for (let j = 0; j < rows; j++) {
              if (Math.random() > 0.3) {
                const baseX = i * spacing + (j % 2 ? spacing * 0.5 : 0);
                const baseY = j * spacing;
                const rnd = Math.random();
                const colorType = rnd > 0.65 ? 0 : rnd > 0.35 ? 1 : rnd > 0.15 ? 2 : 3;
                nodes.push({
                  x: baseX, y: baseY,
                  baseX, baseY,
                  r: Math.random() * 1.4 + 0.4,
                  phase: Math.random() * Math.PI * 2,
                  amplitude: 10 + Math.random() * 14,
                  colorType,
                  label: Math.random() > 0.85 ? ['0x', 'AI', '∑', 'ML', 'λ', '∂', '97%', '∇', '→', '⬡', 'Δ', '§', '//', '::'][Math.floor(Math.random() * 14)] : null,
                  isHex: Math.random() > 0.92,
                });
              }
            }
          }
          for (let k = 0; k < 8; k++) {
            hexes.push({
              x: Math.random() * W, y: Math.random() * H,
              size: 12 + Math.random() * 20,
              phase: Math.random() * Math.PI * 2,
              rotation: Math.random() * Math.PI,
              rotSpeed: 0.001 + Math.random() * 0.002,
              colorType: Math.floor(Math.random() * 4),
            });
          }
        }

        function resize() {
          W = canvas!.width = window.innerWidth;
          H = canvas!.height = window.innerHeight;
          initNodes();
        }

        function drawHex(cx: number, cy: number, size: number, rotation: number) {
          ctx!.beginPath();
          for (let i = 0; i < 6; i++) {
            const angle = rotation + (Math.PI / 3) * i;
            const px = cx + size * Math.cos(angle);
            const py = cy + size * Math.sin(angle);
            i === 0 ? ctx!.moveTo(px, py) : ctx!.lineTo(px, py);
          }
          ctx!.closePath();
        }

        function draw() {
          ctx!.clearRect(0, 0, W, H);
          time += 0.007;
          nodes.forEach((n: any) => {
            n.x = n.baseX + Math.sin(time + n.phase) * n.amplitude * 0.5;
            n.y = n.baseY + Math.cos(time * 0.7 + n.phase) * n.amplitude * 0.3;
          });
          const maxDist = 160;
          for (let i = 0; i < nodes.length; i++) {
            for (let j = i + 1; j < nodes.length; j++) {
              const dx = nodes[i].x - nodes[j].x;
              const dy = nodes[i].y - nodes[j].y;
              const d = Math.sqrt(dx * dx + dy * dy);
              if (d < maxDist) {
                const a = 0.07 * (1 - d / maxDist);
                const c1 = COLORS[nodes[i].colorType];
                const c2 = COLORS[nodes[j].colorType];
                ctx!.beginPath();
                ctx!.moveTo(nodes[i].x, nodes[i].y);
                ctx!.lineTo(nodes[j].x, nodes[j].y);
                const grad = ctx!.createLinearGradient(nodes[i].x, nodes[i].y, nodes[j].x, nodes[j].y);
                grad.addColorStop(0, `rgba(${c1[0]},${c1[1]},${c1[2]},${a})`);
                grad.addColorStop(1, `rgba(${c2[0]},${c2[1]},${c2[2]},${a})`);
                ctx!.strokeStyle = grad;
                ctx!.lineWidth = 0.5;
                ctx!.stroke();
              }
            }
          }
          hexes.forEach((h: any) => {
            h.rotation += h.rotSpeed;
            const drift = Math.sin(time + h.phase) * 8;
            const c = COLORS[h.colorType];
            const a = 0.04 + 0.03 * Math.sin(time * 1.5 + h.phase);
            drawHex(h.x + drift, h.y + Math.cos(time * 0.5 + h.phase) * 5, h.size, h.rotation);
            ctx!.strokeStyle = `rgba(${c[0]},${c[1]},${c[2]},${a})`;
            ctx!.lineWidth = 0.6;
            ctx!.stroke();
          });
          nodes.forEach((n: any) => {
            const c = COLORS[n.colorType];
            const pulse = 0.14 + 0.1 * Math.sin(time * 2 + n.phase);
            if (n.isHex) {
              drawHex(n.x, n.y, n.r * 3, time * 0.5 + n.phase);
              ctx!.strokeStyle = `rgba(${c[0]},${c[1]},${c[2]},${pulse * 0.6})`;
              ctx!.lineWidth = 0.5;
              ctx!.stroke();
            } else {
              ctx!.beginPath();
              ctx!.arc(n.x, n.y, n.r, 0, Math.PI * 2);
              ctx!.fillStyle = `rgba(${c[0]},${c[1]},${c[2]},${pulse})`;
              ctx!.fill();
            }
            if (n.label) {
              ctx!.fillStyle = `rgba(${c[0]},${c[1]},${c[2]},${pulse * 0.6})`;
              ctx!.font = '9px Satoshi, sans-serif';
              ctx!.fillText(n.label, n.x + n.r + 3, n.y + 3);
            }
          });
          requestAnimationFrame(draw);
        }

        resize();
        window.addEventListener('resize', resize);
        draw();
      })();

      // ══ NAV SCROLL + PROGRESS BAR ═════════════════════════════════════
      // Single scroll listener drives both the nav shrink state and the
      // progress bar underneath it. rAF-throttled so it never does more
      // than one style update per frame, even on trackpad/fling scrolls.
      const nav = document.getElementById('nav');
      const progress = document.getElementById('scroll-progress');
      if (nav || progress) {
        let ticking = false;
        const update = () => {
          const scrollY = window.scrollY;
          if (nav) {
            nav.classList.toggle('scrolled', scrollY > 40);
          }
          if (progress) {
            const max = document.documentElement.scrollHeight - window.innerHeight;
            const ratio = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
            progress.style.setProperty('--progress', String(ratio));
          }
          ticking = false;
        };
        const onScroll = () => {
          if (!ticking) {
            requestAnimationFrame(update);
            ticking = true;
          }
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        update(); // initial paint in case page loads mid-scroll
      }

      // ══ HAMBURGER ═════════════════════════════════════════════════════
      const hb = document.getElementById('hamburger');
      const mm = document.getElementById('mobile-menu');
      if (hb && mm) {
        const closeMM = () => { hb.classList.remove('open'); mm.classList.remove('open'); };
        hb.addEventListener('click', () => { hb.classList.toggle('open'); mm.classList.toggle('open'); });
        document.querySelectorAll('[data-mm-link]').forEach((link) => {
          link.addEventListener('click', closeMM);
        });
      }

      // ══ INTERSECTION OBSERVER ═════════════════════════════════════════
      const animClasses = ['.fi', '.fi-l', '.fi-r', '.fi-s'];
      const allAnim = document.querySelectorAll(animClasses.join(','));
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            observer.unobserve(e.target);
          }
        });
      }, { threshold: 0.1 });
      allAnim.forEach((el) => {
        if (el.closest('#hero') || el.closest('.post-hero') || el.closest('.about-hero') || el.closest('.blog-hero') || el.closest('.article-hero')) {
          setTimeout(() => el.classList.add('visible'), 80);
        } else {
          observer.observe(el);
        }
      });

      // ══ BARS ══════════════════════════════════════════════════════════
      function animBars(sel: string) {
        document.querySelectorAll<HTMLElement>(sel).forEach((b) => {
          b.style.width = (b.dataset.v ?? '0') + '%';
        });
      }
      setTimeout(() => animBars('.hero-bar'), 700);

      const demoSec = document.getElementById('demo');
      if (demoSec) {
        let demoDone = false;
        const demoObs = new IntersectionObserver((e) => {
          if (e[0].isIntersecting && !demoDone) {
            demoDone = true;
            animBars('.demo-bar');
            document.querySelectorAll('.line-draw').forEach((line) => line.classList.add('drawn'));
            demoObs.unobserve(demoSec);
          }
        }, { threshold: 0.2 });
        demoObs.observe(demoSec);
      }

      // ══ REPORT TABS ═══════════════════════════════════════════════════
      document.querySelectorAll<HTMLButtonElement>('.rc-tab').forEach((tab) => {
        tab.addEventListener('click', () => {
          const target = tab.dataset.tab;
          document.querySelectorAll('.rc-tab').forEach((t) => t.classList.remove('active'));
          document.querySelectorAll('.rc-tab-panel').forEach((p) => p.classList.remove('active'));
          tab.classList.add('active');
          const panel = document.querySelector(`.rc-tab-panel[data-panel="${target}"]`);
          if (panel) {
            panel.classList.add('active');
            if (target === 'score') setTimeout(() => animBars('.score-bar'), 100);
          }
        });
      });

      // ══ SMOOTH SCROLL ═════════════════════════════════════════════════
      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
        a.addEventListener('click', (e) => {
          const href = a.getAttribute('href');
          if (!href || href === '#') return;
          const t = document.querySelector(href);
          if (t) {
            e.preventDefault();
            window.scrollTo({ top: t.getBoundingClientRect().top + window.scrollY - 80, behavior: 'smooth' });
          }
        });
      });

      // ══ SECTION FLOATING PARTICLES ════════════════════════════════════
      (function () {
        if (reducedMotion) return;
        const colors: Record<string, { r: number; g: number; b: number }> = {
          lilac: { r: 177, g: 140, b: 255 },
          blue:  { r: 77,  g: 163, b: 255 },
          green: { r: 0,   g: 229, b: 160 },
          cyan:  { r: 0,   g: 212, b: 255 },
        };
        document.querySelectorAll<HTMLCanvasElement>('.section-particles').forEach((canvas) => {
          const ctx = canvas.getContext('2d');
          if (!ctx) return;
          const colorKey = canvas.dataset.color || 'lilac';
          const c = colors[colorKey];
          let W = 0, H = 0, particles: any[] = [];
          const COUNT = 25;
          function resize() {
            const parent = canvas.parentElement;
            if (!parent) return;
            const rect = parent.getBoundingClientRect();
            W = canvas.width = rect.width;
            H = canvas.height = rect.height;
          }
          function init() {
            particles = [];
            for (let i = 0; i < COUNT; i++) {
              particles.push({
                x: Math.random() * W,
                y: Math.random() * H,
                vx: (Math.random() - 0.5) * 0.3,
                vy: (Math.random() - 0.5) * 0.3,
                r: Math.random() * 1.5 + 0.4,
                phase: Math.random() * Math.PI * 2,
                speed: 0.01 + Math.random() * 0.015,
              });
            }
          }
          let running = false;
          function draw() {
            if (!running) return;
            ctx!.clearRect(0, 0, W, H);
            particles.forEach((p) => {
              p.x += p.vx;
              p.y += p.vy;
              p.phase += p.speed;
              if (p.x < -10) p.x = W + 10;
              if (p.x > W + 10) p.x = -10;
              if (p.y < -10) p.y = H + 10;
              if (p.y > H + 10) p.y = -10;
              const a = 0.12 + 0.1 * Math.sin(p.phase);
              ctx!.beginPath();
              ctx!.arc(p.x, p.y, p.r, 0, Math.PI * 2);
              ctx!.fillStyle = `rgba(${c.r},${c.g},${c.b},${a})`;
              ctx!.fill();
            });
            for (let i = 0; i < particles.length; i++) {
              for (let j = i + 1; j < particles.length; j++) {
                const dx = particles[i].x - particles[j].x;
                const dy = particles[i].y - particles[j].y;
                const d = Math.sqrt(dx * dx + dy * dy);
                if (d < 140) {
                  const a = 0.04 * (1 - d / 140);
                  ctx!.beginPath();
                  ctx!.moveTo(particles[i].x, particles[i].y);
                  ctx!.lineTo(particles[j].x, particles[j].y);
                  ctx!.strokeStyle = `rgba(${c.r},${c.g},${c.b},${a})`;
                  ctx!.lineWidth = 0.4;
                  ctx!.stroke();
                }
              }
            }
            requestAnimationFrame(draw);
          }
          const sectionObs = new IntersectionObserver((entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting && !running) {
                running = true;
                resize();
                init();
                draw();
              } else if (!e.isIntersecting) {
                running = false;
              }
            });
          }, { threshold: 0.05 });
          resize();
          if (canvas.parentElement) sectionObs.observe(canvas.parentElement);
          window.addEventListener('resize', () => { resize(); if (running) init(); });
        });
      })();

      // ══ NAV SCROLL SPY ═════════════════════════════════════════════════
      // On the home page, the nav has in-page anchors (/#hero, /#segments,
      // /#products). The server can only mark one of them active, so the
      // others never light up. This observer tracks which section is in
      // view and toggles the `active` class on the matching anchor link so
      // Segmentos/Produtos get the same lilac treatment as Home.
      (function () {
        const nav = document.getElementById('nav');
        if (!nav) return;
        const anchorLinks = new Map<string, HTMLAnchorElement>();
        nav.querySelectorAll<HTMLAnchorElement>('.nav-links a').forEach((a) => {
          const href = a.getAttribute('href') || '';
          const m = href.match(/^\/?#(.+)$/);
          if (m) anchorLinks.set(m[1], a);
        });
        if (!anchorLinks.size) return;

        const sections: HTMLElement[] = [];
        anchorLinks.forEach((_, id) => {
          const el = document.getElementById(id);
          if (el) sections.push(el);
        });
        if (!sections.length) return;

        const activate = (id: string) => {
          anchorLinks.forEach((a, key) => {
            a.classList.toggle('active', key === id);
          });
        };

        const observer = new IntersectionObserver((entries) => {
          // Pick the entry that's most prominently in view.
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (visible) activate((visible.target as HTMLElement).id);
        }, {
          // Activate when a section crosses the middle of the viewport.
          rootMargin: '-40% 0px -50% 0px',
          threshold: [0, 0.25, 0.5, 0.75, 1],
        });
        sections.forEach((s) => observer.observe(s));
      })();
    </script>

    <!-- Vercel Analytics + Speed Insights (idiomatic Astro integration,
         only collects data when deployed on Vercel) -->
    <Analytics />
    <SpeedInsights />
  </body>
</html>
