---
import { useTranslations, localize } from '../i18n/utils';
import { defaultLocale, type Locale } from '../i18n/ui';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;
const t = useTranslations(locale);
const href = (path: string) => localize(path, locale);
const year = new Date().getFullYear();
---

<footer id="footer">
  <div class="container">
    <!-- Mini manifesto -->
    <div class="foot-manifesto fi">
      <p class="foot-manifesto-text">{t('footer.manifesto')}</p>
    </div>

    <div class="foot-grid">
      <div class="foot-brand">
        <img src="/d.lab-logo.png" class="foot-logo-img" alt={t('footer.logoAlt')} width="1082" height="240" />
        <p>{t('footer.brandTagline')}</p>
      </div>
      <div class="foot-col">
        <h4>{t('footer.colHub')}</h4>
        <ul>
          <li><a href={href('/blog')}>{t('footer.linkPublications')}</a></li>
          <li><a href={href('/#casos')}>{t('footer.linkAgenda')}</a></li>
          <li><a href="https://chat.whatsapp.com/C85TJhrlPHPE7UAJkXTAgk" target="_blank" rel="noopener noreferrer">{t('footer.linkCollaborate')}</a></li>
          <li><a href={href('/solucoes')}>{t('footer.linkSolucoes')}</a></li>
          <li><a href="/rss.xml">{t('footer.linkRss')}</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h4>{t('footer.colConsulting')}</h4>
        <ul>
          <li><a href={href('/#como-funciona')}>{t('footer.linkPractices')}</a></li>
          <li><a href={href('/solucoes')}>{t('footer.linkMethod')}</a></li>
          <li><a href={href('/contato')}>{t('footer.linkTalk')}</a></li>
          <li><a href={href('/about')}>{t('footer.linkAbout')}</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h4>{t('footer.colContact')}</h4>
        <ul>
          <li><a href={href('/contato')}>{t('footer.linkForm')}</a></li>
          <li><a href="mailto:gabriel@dlabexperts.com">{t('footer.linkEmail')}</a></li>
          <li><a href="https://wa.me/5511933279420" target="_blank" rel="noopener noreferrer">{t('footer.linkWhatsapp')}</a></li>
          <li><a href="https://chat.whatsapp.com/C85TJhrlPHPE7UAJkXTAgk" target="_blank" rel="noopener noreferrer">{t('footer.linkCommunity')}</a></li>
          <li><a href={href('/imprensa')}>{t('footer.linkImprensa')}</a></li>
          <li><a href="https://www.linkedin.com/company/d-lab-intelligence" target="_blank" rel="noopener noreferrer">{t('footer.linkLinkedin')}</a></li>
        </ul>
      </div>
    </div>

    <div class="foot-seal">
      <div class="foot-seal-badge">
        <img src="/d.lab-icon.webp" alt="" class="foot-seal-icon" width="16" height="16" loading="lazy" />
        {t('footer.sealText')}
      </div>
    </div>

    <div class="foot-bottom">
      <p>&copy; {year} {t('footer.copyright')}</p>
      <p>{t('footer.city')}</p>
    </div>
  </div>
</footer>
