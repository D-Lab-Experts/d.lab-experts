---
const year = new Date().getFullYear();
// Buttondown embed endpoint. Replace {USERNAME} once Buttondown account is live.
// Fallback: form posts nowhere and analytics event fires — no crash.
const BUTTONDOWN_USER = import.meta.env.PUBLIC_BUTTONDOWN_USER ?? 'REPLACE_ME';
const newsletterAction = `https://buttondown.com/api/emails/embed-subscribe/${BUTTONDOWN_USER}`;
---

<footer id="footer">
  <div class="container">
    <!-- Mini manifesto -->
    <div class="foot-manifesto fi">
      <p class="foot-manifesto-text">"Não vendemos certeza. Entregamos leitura de contexto boa o suficiente para a decisão se sustentar de pé."</p>
    </div>

    <div class="foot-grid">
      <div class="foot-brand">
        <img src="/d.lab-mark.webp" alt="D.Lab" class="foot-logo-img" width="98" height="22" loading="lazy" />
        <p>Laboratório brasileiro de pesquisa aplicada em inteligência de dados e cybersegurança. Trabalho sob NDA, com escopo negociado por projeto.</p>
        <form
          class="foot-newsletter"
          action={newsletterAction}
          method="POST"
          target="popupwindow"
          data-track="newsletter_subscribe"
        >
          <label class="foot-newsletter-label" for="nl-email">Nota semanal da mesa de pesquisa. O que os dados estão dizendo, direto.</label>
          <div class="foot-newsletter-row">
            <input id="nl-email" type="email" name="email" required class="foot-newsletter-input" placeholder="voce@empresa.com.br" autocomplete="email" />
            <button type="submit" class="foot-newsletter-btn">Inscrever</button>
          </div>
        </form>
      </div>
      <div class="foot-col">
        <h4>Serviços</h4>
        <ul>
          <li><a href="/#segments">Análise Estratégica de Mercado</a></li>
          <li><a href="/#segments">Inteligência Competitiva</a></li>
          <li><a href="/#segments">Cybersegurança & Pentest</a></li>
          <li><a href="/#segments">Transformação Digital & IA</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h4>Empresa</h4>
        <ul>
          <li><a href="/about">Sobre</a></li>
          <li><a href="/#how">Metodologia</a></li>
          <li><a href="/#products">Produtos</a></li>
          <li><a href="/blog">Pesquisas Públicas</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h4>Contato</h4>
        <ul>
          <li><a href="/contato">Propor um problema</a></li>
          <li><a href="/contato">Apresentar o contexto</a></li>
          <li><a href="mailto:contato@dlabexperts.com">E-mail direto</a></li>
          <li><a href="https://www.linkedin.com/company/d-lab-intelligence" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
          <li><a href="/rss.xml">RSS das pesquisas</a></li>
        </ul>
      </div>
    </div>

    <div class="foot-seal">
      <div class="foot-seal-badge">
        <img src="/d.lab-icon.webp" alt="" class="foot-seal-icon" width="16" height="16" loading="lazy" />
        Data Intelligence & Cybersecurity
      </div>
    </div>

    <div class="foot-bottom">
      <p>&copy; {year} D.Lab | Data Intelligence & Cybersecurity. Todos os direitos reservados.</p>
      <p>São Paulo, BR</p>
    </div>
  </div>
</footer>
