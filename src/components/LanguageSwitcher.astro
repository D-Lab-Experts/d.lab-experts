---
import { locales, localeShort, localeNames, type Locale } from '../i18n/ui';
import { getLocalizedPath, useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
  /**
   * Optional explicit cross-locale URL map. Pages where the target URL
   * cannot be derived by simple prefix swap (e.g., posts whose slug
   * differs per language) can pass this from PostLayout so the switch
   * lands on the real sibling instead of a 404.
   */
  alternateUrls?: Partial<Record<Locale, string>>;
}
const { locale, alternateUrls } = Astro.props;
const t = useTranslations(locale);
const currentPath = Astro.url.pathname;
---

<div class="lang-switcher" role="group" aria-label={t('langSwitcher.label')}>
  {locales.map((loc) => {
    const href = alternateUrls?.[loc] ?? getLocalizedPath(currentPath, loc);
    return (
      <a
        href={href}
        class:list={['lang-switcher-item', { active: loc === locale }]}
        aria-current={loc === locale ? 'true' : undefined}
        title={localeNames[loc]}
        hreflang={loc}
      >
        {localeShort[loc]}
      </a>
    );
  })}
</div>

<style>
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(22, 22, 32, 0.4);
  }
  .lang-switcher-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 24px;
    padding: 0 8px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--muted);
    border-radius: 7px;
    transition: color 0.2s, background 0.2s;
  }
  .lang-switcher-item:hover {
    color: var(--white);
    background: rgba(177, 140, 255, 0.08);
  }
  .lang-switcher-item.active {
    color: var(--lilac);
    background: rgba(177, 140, 255, 0.12);
  }
</style>
