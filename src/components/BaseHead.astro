---
import { useTranslations, getLocalizedPath } from '../i18n/utils';
import { locales, defaultLocale, ogLocale, type Locale } from '../i18n/ui';

export interface CitationMeta {
  title: string;
  authors: string[];
  // YYYY/MM/DD — Scholar's expected format
  date: string;
  volume?: string;
  language?: string;
  keywords?: string;
}

export interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  locale?: Locale;
  // Explicit per-locale URLs (e.g. posts whose slug differs per
  // language). When absent, alternates are derived by prefix swap.
  alternateUrls?: Partial<Record<Locale, string>>;
  // When passed (by PostLayout), renders Google Scholar citation_* meta
  // tags in <head> so the post is indexable in academic search.
  citationMeta?: CitationMeta;
}

const {
  title,
  description,
  image = '/d.lab.png',
  imageAlt,
  canonical,
  type = 'website',
  publishedTime,
  modifiedTime,
  author = 'D.Lab Experts',
  tags = [],
  locale = defaultLocale,
  alternateUrls,
  citationMeta,
} = Astro.props;

const t = useTranslations(locale);

const canonicalURL = canonical
  ? new URL(canonical, Astro.site)
  : new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

// hreflang alternates: same page in each locale. Prefer an explicit
// URL map (posts with per-locale slugs); else swap the path prefix.
const altLinks = locales.map((loc) => ({
  loc,
  href: new URL(
    alternateUrls?.[loc] ?? getLocalizedPath(Astro.url.pathname, loc),
    Astro.site,
  ).toString(),
}));
const defaultHref = altLinks.find((a) => a.loc === defaultLocale)?.href;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#0E0E12" />
<meta name="color-scheme" content="dark" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={author} />
<link rel="canonical" href={canonicalURL} />

<!-- hreflang alternates (both locales + x-default → PT) -->
{altLinks.map((a) => (
  <link rel="alternate" hreflang={a.loc === 'pt' ? 'pt-BR' : a.loc} href={a.href} />
))}
{defaultHref && <link rel="alternate" hreflang="x-default" href={defaultHref} />}

<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

<link rel="alternate" type="application/rss+xml" title="D.Lab Experts · Research Hub" href="/rss.xml" />

<!-- Redesign monocromático Apple/Resend: Inter como fonte única
     (display + corpo + dados), pesos finos para registro elegante e
     alto contraste. Optical sizing on. Código/tabular usa o mono do
     sistema. font-display: swap, só os pesos usados. -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<!-- Space Grotesk como display (futurista) + Inter no corpo.
     font-display: swap, só os pesos usados. Alternativas futuristas
     pra testar: trocar a família em --font-display (global.css). -->
<link
  href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600&display=swap"
  rel="stylesheet"
/>

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="675" />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
<meta property="og:locale" content={ogLocale[locale]} />
{locales.filter((l) => l !== locale).map((l) => (
  <meta property="og:locale:alternate" content={ogLocale[l]} />
))}
<meta property="og:site_name" content={t('meta.ogSiteName')} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{type === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime} />
)}
{type === 'article' && author && (
  <meta property="article:author" content={author} />
)}
{type === 'article' && tags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

{citationMeta && (
  <>
    <!-- Google Scholar citation metadata -->
    <meta name="citation_title" content={citationMeta.title} />
    {citationMeta.authors.map((a) => (
      <meta name="citation_author" content={a} />
    ))}
    <meta name="citation_publication_date" content={citationMeta.date} />
    <meta name="citation_journal_title" content="D.Lab Research Series" />
    {citationMeta.volume && <meta name="citation_volume" content={citationMeta.volume} />}
    <meta name="citation_abstract_html_url" content={canonicalURL.toString()} />
    <meta name="citation_fulltext_html_url" content={canonicalURL.toString()} />
    <meta name="citation_language" content={citationMeta.language ?? 'pt-BR'} />
    {citationMeta.keywords && <meta name="citation_keywords" content={citationMeta.keywords} />}
    <meta name="citation_publisher" content="D.Lab Experts" />
  </>
)}

<!-- Structured data: Organization -->
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/', Astro.site).toString() + '#org',
  name: t('meta.siteName'),
  url: Astro.site?.toString(),
  logo: new URL('/d.lab.png', Astro.site).toString(),
  description: t('meta.orgDescription'),
  sameAs: ['https://www.linkedin.com/company/d-lab-intelligence'],
})} />

<!-- Structured data: WebPage. Emitted for every content page except
     articles (PostLayout already ships a richer Article schema, so we
     skip WebPage there to avoid a competing mainEntity signal). Ties
     the page to the Organization + a site-wide WebSite node so AI/search
     crawlers can resolve author, publisher and language in one graph. -->
{type !== 'article' && (
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': canonicalURL.toString() + '#webpage',
    url: canonicalURL.toString(),
    name: title,
    description,
    inLanguage: locale === 'pt' ? 'pt-BR' : 'en',
    isPartOf: {
      '@type': 'WebSite',
      '@id': new URL('/', Astro.site).toString() + '#website',
      url: new URL('/', Astro.site).toString(),
      name: t('meta.ogSiteName'),
      publisher: { '@id': new URL('/', Astro.site).toString() + '#org' },
    },
    about: { '@id': new URL('/', Astro.site).toString() + '#org' },
    primaryImageOfPage: imageURL.toString(),
    ...(modifiedTime ? { dateModified: modifiedTime } : {}),
    ...(publishedTime ? { datePublished: publishedTime } : {}),
  })} />
)}
