---
/**
 * "Como citar" block — formats ABNT + APA citation from the post's
 * structured frontmatter. Lives at the end of each publication, above
 * the related posts. Both citation strings are composed server-side so
 * they're indexable / selectable without JS; the copy buttons are the
 * only client-side bit.
 */
export interface Props {
  title: string;
  authors: string[];
  // YYYY/MM/DD
  date: string;
  volume?: string;
  url: string;
  language?: string;
}

const { title, authors, date, volume, url } = Astro.props;

// ABNT: SOBRENOME, Nome; SOBRENOME2, Nome2
const authorsABNT = authors
  .map((a) => {
    const parts = a.trim().split(/\s+/);
    const last = parts.pop() ?? '';
    return `${last.toUpperCase()}, ${parts.join(' ')}`;
  })
  .join('; ');

// APA: Last, F. I., & Last, F. I. — initials-only version.
// Tokens that already include dots (e.g. "H.C.C.") are treated as
// pre-formatted initials and kept as-is, so names like "Lucas H.C.C.
// Santos" surface correctly as "Santos, L. H.C.C.".
const authorsAPA = authors
  .map((a) => {
    const parts = a.trim().split(/\s+/);
    const last = parts.pop() ?? '';
    const initials = parts
      .map((p) => (p.includes('.') ? p : p.charAt(0).toUpperCase() + '.'))
      .join(' ');
    return `${last}, ${initials}`;
  })
  .reduce((acc, curr, idx, arr) => {
    if (idx === 0) return curr;
    if (idx === arr.length - 1) return `${acc}, & ${curr}`;
    return `${acc}, ${curr}`;
  }, '');

const [year, month, day] = date.split('/');
const monthNames: Record<string, string> = {
  '01': 'jan.', '02': 'fev.', '03': 'mar.', '04': 'abr.',
  '05': 'maio', '06': 'jun.', '07': 'jul.', '08': 'ago.',
  '09': 'set.', '10': 'out.', '11': 'nov.', '12': 'dez.',
};
const monthABNT = monthNames[month ?? ''] ?? '';
const dayStr = day ? `${day} ` : '';

const volumeFragment = volume ? ` (D.Lab Research Series, n. ${volume})` : '';
const volumeAPAFragment = volume ? ` (D.Lab Research Series No. ${volume})` : '';

const abnt = `${authorsABNT}. ${title}. São Paulo: D.Lab Experts, ${dayStr}${monthABNT} ${year}.${volumeFragment} Disponível em: ${url}.`;
const apa = `${authorsAPA} (${year}). ${title}${volumeAPAFragment}. D.Lab Experts. ${url}`;
---

<section class="citation-block" aria-labelledby="citation-label">
  <div class="post-container">
    <div class="citation-inner">
      <div class="citation-head">
        <span class="citation-label" id="citation-label">Como citar</span>
        <span class="citation-sub">Referências geradas a partir dos metadados da publicação</span>
      </div>

      <div class="citation-format">
        <div class="citation-row">
          <span class="citation-style">ABNT</span>
          <button type="button" class="citation-copy" data-copy-target="abnt" aria-label="Copiar citação ABNT">
            <span class="citation-copy-label">Copiar</span>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <rect x="3" y="3" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
              <path d="M5.5 3V2a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-1" stroke="currentColor" stroke-width="1.3"/>
            </svg>
          </button>
        </div>
        <p class="citation-text" data-copy-source="abnt">{abnt}</p>
      </div>

      <div class="citation-format">
        <div class="citation-row">
          <span class="citation-style">APA</span>
          <button type="button" class="citation-copy" data-copy-target="apa" aria-label="Copiar citação APA">
            <span class="citation-copy-label">Copiar</span>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <rect x="3" y="3" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
              <path d="M5.5 3V2a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-1" stroke="currentColor" stroke-width="1.3"/>
            </svg>
          </button>
        </div>
        <p class="citation-text" data-copy-source="apa">{apa}</p>
      </div>
    </div>
  </div>
</section>

<script>
  // Copy the sibling <p data-copy-source="key"> when the button is clicked,
  // then swap label to "Copiado" for ~1.6s. Guarded against missing
  // clipboard API (very old browsers / insecure contexts).
  document.querySelectorAll<HTMLButtonElement>('.citation-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const key = btn.dataset.copyTarget;
      if (!key) return;
      const source = document.querySelector<HTMLElement>(`[data-copy-source="${key}"]`);
      if (!source) return;
      const text = source.textContent?.trim() ?? '';
      const label = btn.querySelector<HTMLElement>('.citation-copy-label');
      const originalLabel = label?.textContent ?? 'Copiar';
      try {
        if (navigator.clipboard) {
          await navigator.clipboard.writeText(text);
        } else {
          // Fallback: select + execCommand
          const range = document.createRange();
          range.selectNodeContents(source);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
          document.execCommand('copy');
          sel?.removeAllRanges();
        }
        if (label) label.textContent = 'Copiado';
        btn.classList.add('is-copied');
        setTimeout(() => {
          if (label) label.textContent = originalLabel;
          btn.classList.remove('is-copied');
        }, 1600);
      } catch (err) {
        console.error('[citation] copy failed', err);
      }
    });
  });
</script>

<style>
  .citation-block {
    padding: 56px 0 16px;
    position: relative;
    z-index: 1;
  }
  .citation-inner {
    background: var(--graphite);
    border: 1px solid var(--border);
    border-left: 3px solid var(--lilac);
    border-radius: 16px;
    padding: 28px 32px;
    max-width: 820px;
    margin: 0 auto;
  }
  .citation-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 22px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border);
  }
  .citation-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--lilac);
  }
  .citation-sub {
    font-size: 11px;
    color: var(--dimmed);
    letter-spacing: 0.03em;
  }
  .citation-format {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px 0;
  }
  .citation-format + .citation-format {
    border-top: 1px solid var(--border);
  }
  .citation-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .citation-style {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 3px 10px;
    border-radius: 6px;
    background: rgba(177, 140, 255, 0.08);
    border: 1px solid rgba(177, 140, 255, 0.18);
  }
  .citation-copy {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dimmed);
    background: transparent;
    border: 1px solid var(--border);
    padding: 5px 10px;
    border-radius: 100px;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .citation-copy:hover {
    color: var(--lilac);
    border-color: rgba(177, 140, 255, 0.4);
    background: rgba(177, 140, 255, 0.06);
  }
  .citation-copy.is-copied {
    color: var(--green);
    border-color: rgba(0, 229, 160, 0.45);
    background: rgba(0, 229, 160, 0.08);
  }
  .citation-text {
    font-family: 'SF Mono', 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 12.5px;
    line-height: 1.65;
    color: var(--muted);
    user-select: text;
    word-break: break-word;
  }
  @media (max-width: 640px) {
    .citation-inner { padding: 22px 20px; }
    .citation-head { margin-bottom: 16px; padding-bottom: 14px; }
  }
</style>
