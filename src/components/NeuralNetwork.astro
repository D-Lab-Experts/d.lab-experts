---
// NeuralNetwork.astro
// Subtle high-tech background: monochrome animated mesh of nodes with a few
// slow data pulses traveling along the edges. Designed to *suggest* tech
// without competing with the foreground content.
//
// Usage:
//   <NeuralNetwork color="lilac" density="medium" opacity={0.35} />
//
// Props:
//   color    : 'lilac' | 'blue' | 'green' | 'cyan' | 'white' (default 'lilac')
//   density  : 'low' | 'medium' | 'high'                     (default 'low')
//   opacity  : number 0..1                                   (default 0.32)
//
// Renders an absolutely positioned canvas that fills its parent.
// The parent must be `position: relative` (or absolute/fixed).
// Fade-in/out is handled by CSS opacity transition driven by an
// IntersectionObserver class toggle, so the network never "pops" in or out.
export interface Props {
  color?: 'lilac' | 'blue' | 'green' | 'cyan' | 'white';
  density?: 'low' | 'medium' | 'high';
  opacity?: number;
}
const {
  color = 'white',
  density = 'low',
  opacity = 0.14,
} = Astro.props;
---

<canvas
  class="neural-net"
  data-color={color}
  data-density={density}
  style={`--nn-target-opacity:${opacity}`}
  aria-hidden="true"
></canvas>

<style>
  .neural-net {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    transition: opacity 1.6s cubic-bezier(.16, 1, .3, 1);
  }
  .neural-net.nn-visible {
    opacity: var(--nn-target-opacity, 0.32);
  }
</style>

<script>
  // Subtle, monochrome animated mesh. One animation loop per canvas instance,
  // started lazily on first intersection. The loop never stops once started —
  // we control on-screen visibility via a CSS opacity transition (.nn-visible)
  // so there is no abrupt pop in or out. The CPU cost is tiny because the
  // node count is small and we draw a single channel of color.
  type Node = {
    baseX: number; baseY: number;
    x: number; y: number;
    r: number;
    phase: number;
    amp: number;
  };

  type Pulse = {
    a: number; b: number; // node indices
    t: number;            // 0..1
    speed: number;
  };

  const COLORS: Record<string, [number, number, number]> = {
    lilac: [177, 140, 255],
    blue:  [120, 165, 240],
    green: [120, 200, 170],
    cyan:  [110, 190, 220],
    white: [220, 222, 230],
  };

  const DENSITY: Record<string, { spacing: number; pulseRate: number; maxPulses: number }> = {
    low:    { spacing: 200, pulseRate: 0.005, maxPulses: 4 },
    medium: { spacing: 160, pulseRate: 0.008, maxPulses: 6 },
    high:   { spacing: 130, pulseRate: 0.012, maxPulses: 9 },
  };

  function init(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const colorKey = canvas.dataset.color || 'lilac';
    const densityKey = canvas.dataset.density || 'low';
    const c = COLORS[colorKey] || COLORS.lilac;
    const cfg = DENSITY[densityKey] || DENSITY.low;

    const dpr = Math.max(1, Math.min(2, window.devicePixelRatio || 1));
    const MAX_DIST = 200;

    let W = 0, H = 0;
    let nodes: Node[] = [];
    let edges: Array<[number, number, number]> = [];
    let pulses: Pulse[] = [];
    let time = 0;
    let started = false;

    function resize() {
      const parent = canvas.parentElement;
      if (!parent) return;
      const rect = parent.getBoundingClientRect();
      W = rect.width;
      H = rect.height;
      canvas.width = Math.max(1, Math.floor(W * dpr));
      canvas.height = Math.max(1, Math.floor(H * dpr));
      canvas.style.width = `${W}px`;
      canvas.style.height = `${H}px`;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      buildNodes();
      buildEdges();
    }

    function buildNodes() {
      nodes = [];
      const spacing = cfg.spacing;
      const cols = Math.ceil(W / spacing) + 1;
      const rows = Math.ceil(H / spacing) + 1;
      for (let i = 0; i < cols; i++) {
        for (let j = 0; j < rows; j++) {
          if (Math.random() < 0.7) {
            const baseX = i * spacing + (j % 2 ? spacing * 0.5 : 0) + (Math.random() - 0.5) * 24;
            const baseY = j * spacing + (Math.random() - 0.5) * 24;
            nodes.push({
              baseX, baseY,
              x: baseX, y: baseY,
              r: 0.9 + Math.random() * 0.9,
              phase: Math.random() * Math.PI * 2,
              amp: 4 + Math.random() * 8,
            });
          }
        }
      }
    }

    function buildEdges() {
      edges = [];
      pulses = []; // discard pulses tied to old node indices
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[i].baseX - nodes[j].baseX;
          const dy = nodes[i].baseY - nodes[j].baseY;
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d < MAX_DIST) edges.push([i, j, d]);
        }
      }
    }

    function spawnPulse() {
      if (pulses.length >= cfg.maxPulses || edges.length === 0) return;
      const e = edges[(Math.random() * edges.length) | 0];
      const dir = Math.random() < 0.5;
      pulses.push({
        a: dir ? e[0] : e[1],
        b: dir ? e[1] : e[0],
        t: 0,
        speed: 0.0025 + Math.random() * 0.0035,
      });
    }

    function frame() {
      if (W === 0 || H === 0) {
        requestAnimationFrame(frame);
        return;
      }
      ctx!.clearRect(0, 0, W, H);
      time += 0.0055;

      // node drift
      for (const n of nodes) {
        n.x = n.baseX + Math.sin(time + n.phase) * n.amp * 0.35;
        n.y = n.baseY + Math.cos(time * 0.65 + n.phase) * n.amp * 0.22;
      }

      // edges (very faint)
      ctx!.lineWidth = 0.4;
      for (const [i, j, d] of edges) {
        const a = nodes[i];
        const b = nodes[j];
        const alpha = 0.045 * (1 - d / MAX_DIST);
        ctx!.strokeStyle = `rgba(${c[0]},${c[1]},${c[2]},${alpha})`;
        ctx!.beginPath();
        ctx!.moveTo(a.x, a.y);
        ctx!.lineTo(b.x, b.y);
        ctx!.stroke();
      }

      // occasional slow pulses
      if (Math.random() < cfg.pulseRate) spawnPulse();
      for (let i = pulses.length - 1; i >= 0; i--) {
        const p = pulses[i];
        p.t += p.speed;
        if (p.t >= 1) { pulses.splice(i, 1); continue; }
        const a = nodes[p.a];
        const b = nodes[p.b];
        if (!a || !b) { pulses.splice(i, 1); continue; }
        const x = a.x + (b.x - a.x) * p.t;
        const y = a.y + (b.y - a.y) * p.t;
        // soft halo (small)
        const halo = ctx!.createRadialGradient(x, y, 0, x, y, 7);
        halo.addColorStop(0, `rgba(${c[0]},${c[1]},${c[2]},0.30)`);
        halo.addColorStop(1, `rgba(${c[0]},${c[1]},${c[2]},0)`);
        ctx!.fillStyle = halo;
        ctx!.beginPath();
        ctx!.arc(x, y, 7, 0, Math.PI * 2);
        ctx!.fill();
        // crisp head
        ctx!.fillStyle = `rgba(${c[0]},${c[1]},${c[2]},0.55)`;
        ctx!.beginPath();
        ctx!.arc(x, y, 1.1, 0, Math.PI * 2);
        ctx!.fill();
      }

      // nodes (faint, gently breathing)
      for (const n of nodes) {
        const a = 0.18 + 0.06 * Math.sin(time * 1.6 + n.phase);
        ctx!.fillStyle = `rgba(${c[0]},${c[1]},${c[2]},${a})`;
        ctx!.beginPath();
        ctx!.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        ctx!.fill();
      }

      requestAnimationFrame(frame);
    }

    function start() {
      if (started) return;
      started = true;
      resize();
      requestAnimationFrame(frame);
    }

    // Lazy start on first intersection. Once started, animation runs forever
    // but visibility is controlled by the CSS class toggle (smooth fade).
    const obs = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            start();
            canvas.classList.add('nn-visible');
          } else {
            canvas.classList.remove('nn-visible');
          }
        }
      },
      { threshold: 0.05, rootMargin: '120px 0px' },
    );
    if (canvas.parentElement) obs.observe(canvas.parentElement);

    // Resize handling: debounced to avoid thrashing.
    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        if (started) resize();
      }, 150);
    });
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas.neural-net').forEach(init);
</script>
