---
import Layout from '../../layouts/Layout.astro';
import NeuralNetwork from '../NeuralNetwork.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations();

// Aggregate every keyFindings entry across all publications into a
// single flat list — journalists land here and see everything ready
// to cite, not per-post.
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

type AggregatedFinding = {
  stat: string;
  label: string;
  id: string;
  color: 'lilac' | 'blue' | 'cyan' | 'green' | 'yellow';
  postTitle: string;
  postSlug: string;
  pubDate: Date;
};

const aggregatedFindings: AggregatedFinding[] = posts.flatMap((p) =>
  (p.data.keyFindings ?? []).map((f) => ({
    ...f,
    postTitle: p.data.title,
    postSlug: p.slug,
    pubDate: p.data.pubDate,
  })),
);

const dateStr = (d: Date) =>
  d.toLocaleDateString('pt-BR', { year: 'numeric', month: 'long' });

const assets = [
  { key: 'assetLogoFull', file: '/d.lab.png', format: 'PNG · 1024×1024' },
  { key: 'assetLogoMark', file: '/d.lab-mark.png', format: 'PNG · 560×128' },
  { key: 'assetLogoIcon', file: '/d.lab-icon.png', format: 'PNG · 512×512' },
] as const;
---

<Layout
  title={t('pageTitles.imprensa')}
  description={t('pageTitles.imprensaDescription')}
>
  <!-- ═══════════════ HERO ═════════════════════════════════════════ -->
  <section class="imp-hero">
    <div class="section-glow lilac" style="top:-40px;left:50%;transform:translateX(-50%)"></div>
    <div class="section-glow blue" style="bottom:0;right:-80px"></div>
    <NeuralNetwork color="lilac" density="low" opacity={0.24} />
    <div class="container">
      <div class="imp-hero-inner fi">
        <div class="imp-eyebrow">
          <span style="width:22px;height:1px;background:var(--grad);display:block"></span>
          {t('imprensaPage.heroEyebrow')}
        </div>
        <h1 class="imp-title">
          {t('imprensaPage.heroTitleLead')} <span class="gradient-text">{t('imprensaPage.heroTitleAccent')}</span>
        </h1>
        <p class="imp-sub">{t('imprensaPage.heroSub')}</p>
      </div>
    </div>
  </section>

  <!-- ═══════════════ CONTACT ═════════════════════════════════════ -->
  <section class="imp-section">
    <div class="container">
      <div class="imp-contact-card fi">
        <div class="imp-contact-head">
          <span class="imp-contact-label">{t('imprensaPage.contactLabel')}</span>
          <span class="imp-contact-pulse"></span>
        </div>
        <p class="imp-contact-note">{t('imprensaPage.contactNote')}</p>
        <div class="imp-contact-grid">
          <a class="imp-contact-item" href={`mailto:${t('imprensaPage.contactEmail')}`}>
            <span class="imp-contact-item-label">{t('imprensaPage.contactEmailLabel')}</span>
            <span class="imp-contact-item-value">{t('imprensaPage.contactEmail')}</span>
            <span class="imp-contact-item-meta">{t('imprensaPage.contactResponse')}</span>
          </a>
          <a
            class="imp-contact-item"
            href="https://www.linkedin.com/company/d-lab-intelligence"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="imp-contact-item-label">{t('imprensaPage.contactLinkedinLabel')}</span>
            <span class="imp-contact-item-value">{t('imprensaPage.contactLinkedinHandle')}</span>
            <span class="imp-contact-item-meta">linkedin.com/company/d-lab-intelligence</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ AUTHORS ═════════════════════════════════════ -->
  <section class="imp-section">
    <div class="container">
      <div class="imp-section-head fi">
        <span class="imp-section-label">{t('imprensaPage.authorsLabel')}</span>
      </div>
      <div class="imp-authors-grid">
        <article class="imp-author-card fi">
          <header>
            <h3 class="imp-author-name">{t('imprensaPage.author1Name')}</h3>
            <span class="imp-author-role">{t('imprensaPage.author1Role')}</span>
          </header>
          <p class="imp-author-bio">{t('imprensaPage.author1Bio')}</p>
          <div class="imp-author-expertise">
            <span class="imp-author-expertise-label">Expertise</span>
            <span class="imp-author-expertise-list">{t('imprensaPage.author1Expertise')}</span>
          </div>
        </article>
        <article class="imp-author-card fi d1">
          <header>
            <h3 class="imp-author-name">{t('imprensaPage.author2Name')}</h3>
            <span class="imp-author-role">{t('imprensaPage.author2Role')}</span>
          </header>
          <p class="imp-author-bio">{t('imprensaPage.author2Bio')}</p>
          <div class="imp-author-expertise">
            <span class="imp-author-expertise-label">Expertise</span>
            <span class="imp-author-expertise-list">{t('imprensaPage.author2Expertise')}</span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ═══════════════ KEY FINDINGS ════════════════════════════════ -->
  <section class="imp-section">
    <div class="container">
      <div class="imp-section-head fi">
        <span class="imp-section-label">{t('imprensaPage.findingsLabel')}</span>
        <p class="imp-section-sub">{t('imprensaPage.findingsSub')}</p>
      </div>
      {aggregatedFindings.length > 0 ? (
        <dl class="imp-findings-list fi">
          {aggregatedFindings.map((f) => (
            <div class={`imp-finding-row imp-finding-${f.color}`}>
              <dt class="imp-finding-stat">{f.stat}</dt>
              <dd class="imp-finding-body">
                <p class="imp-finding-label">{f.label}</p>
                <p class="imp-finding-source">
                  <a href={`/posts/${f.postSlug}`}>{f.postTitle}</a>
                  <span class="imp-finding-dot">·</span>
                  <span>{dateStr(f.pubDate)}</span>
                </p>
              </dd>
            </div>
          ))}
        </dl>
      ) : (
        <p class="imp-findings-empty">Novos estudos originais serão publicados em breve.</p>
      )}
    </div>
  </section>

  <!-- ═══════════════ ASSETS ══════════════════════════════════════ -->
  <section class="imp-section">
    <div class="container">
      <div class="imp-section-head fi">
        <span class="imp-section-label">{t('imprensaPage.assetsLabel')}</span>
        <p class="imp-section-sub">{t('imprensaPage.assetsSub')}</p>
      </div>
      <div class="imp-assets-grid fi">
        {assets.map((a) => (
          <a href={a.file} download class="imp-asset-card">
            <div class="imp-asset-preview">
              <img src={a.file} alt="" loading="lazy" />
            </div>
            <div class="imp-asset-body">
              <span class="imp-asset-name">{t(`imprensaPage.${a.key}` as any)}</span>
              <span class="imp-asset-format">{a.format}</span>
              <span class="imp-asset-cta">{t('imprensaPage.assetDownload')} ↓</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════ USAGE GUIDELINES ════════════════════════════ -->
  <section class="imp-section">
    <div class="container">
      <div class="imp-section-head fi">
        <span class="imp-section-label">{t('imprensaPage.usageLabel')}</span>
      </div>
      <ul class="imp-usage-list fi">
        <li>{t('imprensaPage.usageItem1')}</li>
        <li>{t('imprensaPage.usageItem2')}</li>
        <li>{t('imprensaPage.usageItem3')}</li>
        <li>{t('imprensaPage.usageItem4')}</li>
      </ul>
    </div>
  </section>

  <!-- ═══════════════ CTA ═════════════════════════════════════════ -->
  <section class="imp-cta">
    <div class="section-glow lilac" style="top:50%;left:50%;transform:translate(-50%,-50%)"></div>
    <div class="container fi">
      <h2>{t('imprensaPage.ctaLabel')}</h2>
      <p>{t('imprensaPage.ctaSub')}</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a href={`mailto:${t('imprensaPage.contactEmail')}`} class="btn btn-primary">{t('imprensaPage.ctaPrimary')}</a>
        <a href="/blog" class="btn btn-ghost">{t('imprensaPage.ctaSecondary')}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ═══════════ HERO ═══════════════════════════════════════════ */
  .imp-hero {
    padding: 150px 0 60px;
    position: relative;
    overflow: hidden;
    z-index: 1;
  }
  .imp-hero-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 2;
  }
  .imp-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lilac);
    margin-bottom: 22px;
  }
  .imp-title {
    font-size: clamp(36px, 5vw, 60px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: 22px;
    text-wrap: balance;
  }
  .imp-sub {
    font-size: 16px;
    color: var(--muted);
    line-height: 1.7;
    max-width: 620px;
    margin: 0 auto;
    text-wrap: pretty;
  }

  /* ═══════════ SECTIONS ═════════════════════════════════════════ */
  .imp-section {
    padding: 48px 0;
    position: relative;
    z-index: 1;
  }
  .imp-section-head {
    max-width: 820px;
    margin: 0 auto 28px;
  }
  .imp-section-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lilac);
    margin-bottom: 10px;
  }
  .imp-section-label::before {
    content: '';
    display: block;
    width: 22px;
    height: 1px;
    background: var(--grad);
  }
  .imp-section-sub {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.65;
    max-width: 640px;
  }

  /* ═══════════ CONTACT CARD ════════════════════════════════════ */
  .imp-contact-card {
    max-width: 820px;
    margin: 0 auto;
    background: linear-gradient(145deg, rgba(177, 140, 255, 0.08), rgba(22, 22, 32, 0.6));
    border: 1px solid rgba(177, 140, 255, 0.26);
    border-radius: 18px;
    padding: 30px 32px;
  }
  .imp-contact-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }
  .imp-contact-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--lilac);
  }
  .imp-contact-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 12px rgba(0, 229, 160, 0.6);
    animation: impPulse 2.4s ease-in-out infinite;
  }
  @keyframes impPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.5; transform: scale(1.3); }
  }
  .imp-contact-note {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 22px;
  }
  .imp-contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .imp-contact-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: rgba(22, 22, 32, 0.55);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
  }
  .imp-contact-item:hover {
    border-color: rgba(177, 140, 255, 0.45);
    background: rgba(177, 140, 255, 0.06);
    transform: translateY(-2px);
  }
  .imp-contact-item-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dimmed);
  }
  .imp-contact-item-value {
    font-size: 17px;
    font-weight: 600;
    color: var(--white);
    letter-spacing: -0.01em;
    margin-top: 4px;
  }
  .imp-contact-item-meta {
    font-size: 12px;
    color: var(--muted);
    margin-top: 4px;
  }

  /* ═══════════ AUTHORS ═════════════════════════════════════════ */
  .imp-authors-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    max-width: 920px;
    margin: 0 auto;
  }
  .imp-author-card {
    background: rgba(22, 22, 32, 0.55);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 26px 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .imp-author-name {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--white);
    margin-bottom: 4px;
  }
  .imp-author-role {
    font-size: 12px;
    color: var(--lilac);
    letter-spacing: 0.04em;
  }
  .imp-author-bio {
    font-size: 14px;
    line-height: 1.65;
    color: var(--muted);
  }
  .imp-author-expertise {
    padding-top: 14px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .imp-author-expertise-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dimmed);
  }
  .imp-author-expertise-list {
    font-size: 12.5px;
    color: var(--muted);
    line-height: 1.55;
  }

  /* ═══════════ FINDINGS LIST ═══════════════════════════════════ */
  .imp-findings-list {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0;
  }
  .imp-finding-row {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 20px;
    align-items: start;
    padding: 18px 22px;
    background: rgba(22, 22, 32, 0.55);
    border: 1px solid var(--border);
    border-left: 3px solid var(--lilac);
    border-radius: 12px;
  }
  .imp-finding-blue   { border-left-color: var(--blue); }
  .imp-finding-cyan   { border-left-color: var(--cyan); }
  .imp-finding-green  { border-left-color: var(--green); }
  .imp-finding-yellow { border-left-color: var(--yellow); }
  .imp-finding-stat {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .imp-finding-blue   .imp-finding-stat { color: var(--blue); }
  .imp-finding-cyan   .imp-finding-stat { color: var(--cyan); }
  .imp-finding-green  .imp-finding-stat { color: var(--green); }
  .imp-finding-yellow .imp-finding-stat { color: var(--yellow); }
  .imp-finding-lilac  .imp-finding-stat,
  .imp-finding-row    .imp-finding-stat { color: var(--lilac); }
  .imp-finding-blue   .imp-finding-stat { color: var(--blue); }
  .imp-finding-body { margin: 0; }
  .imp-finding-label {
    font-size: 14px;
    line-height: 1.55;
    color: var(--white);
    margin: 0 0 6px 0;
  }
  .imp-finding-source {
    font-size: 12px;
    color: var(--dimmed);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .imp-finding-source a {
    color: var(--lilac);
    text-decoration: none;
    border-bottom: 1px dashed rgba(177, 140, 255, 0.3);
  }
  .imp-finding-source a:hover { color: var(--white); border-bottom-color: var(--white); }
  .imp-finding-dot { opacity: 0.5; }
  .imp-findings-empty {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
    padding: 40px 20px;
    color: var(--muted);
    font-size: 14px;
    border: 1px dashed var(--border);
    border-radius: 12px;
  }

  /* ═══════════ ASSETS ══════════════════════════════════════════ */
  .imp-assets-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    max-width: 820px;
    margin: 0 auto;
  }
  .imp-asset-card {
    display: flex;
    flex-direction: column;
    background: rgba(22, 22, 32, 0.55);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
  }
  .imp-asset-card:hover {
    border-color: rgba(177, 140, 255, 0.4);
    background: rgba(177, 140, 255, 0.04);
    transform: translateY(-2px);
  }
  .imp-asset-preview {
    background: radial-gradient(circle at 50% 50%, rgba(177, 140, 255, 0.1), transparent 70%),
                rgba(14, 14, 22, 0.8);
    padding: 32px 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 120px;
  }
  .imp-asset-preview img {
    max-width: 100%;
    max-height: 80px;
    object-fit: contain;
  }
  .imp-asset-body {
    padding: 14px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    border-top: 1px solid var(--border);
  }
  .imp-asset-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--white);
    letter-spacing: -0.005em;
  }
  .imp-asset-format {
    font-size: 11px;
    color: var(--dimmed);
    letter-spacing: 0.03em;
  }
  .imp-asset-cta {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lilac);
    margin-top: 6px;
  }

  /* ═══════════ USAGE ═══════════════════════════════════════════ */
  .imp-usage-list {
    max-width: 820px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    counter-reset: imp-usage;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .imp-usage-list li {
    counter-increment: imp-usage;
    position: relative;
    padding: 14px 18px 14px 52px;
    background: rgba(22, 22, 32, 0.55);
    border: 1px solid var(--border);
    border-radius: 12px;
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--muted);
  }
  .imp-usage-list li::before {
    content: counter(imp-usage, decimal-leading-zero);
    position: absolute;
    left: 18px;
    top: 14px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--lilac);
  }

  /* ═══════════ CTA ═════════════════════════════════════════════ */
  .imp-cta {
    padding: 60px 0 120px;
    text-align: center;
    position: relative;
    z-index: 1;
    overflow: hidden;
  }
  .imp-cta h2 {
    font-size: clamp(26px, 3.2vw, 36px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 14px;
    text-wrap: balance;
  }
  .imp-cta p {
    font-size: 15px;
    color: var(--muted);
    max-width: 540px;
    margin: 0 auto 26px;
    line-height: 1.65;
  }

  @media (max-width: 768px) {
    .imp-contact-grid { grid-template-columns: 1fr; }
    .imp-authors-grid { grid-template-columns: 1fr; }
    .imp-assets-grid { grid-template-columns: 1fr 1fr; }
    .imp-finding-row { grid-template-columns: 1fr; gap: 8px; }
    .imp-finding-stat { font-size: 26px; }
  }
  @media (max-width: 480px) {
    .imp-assets-grid { grid-template-columns: 1fr; }
  }
</style>
