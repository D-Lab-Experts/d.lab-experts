          <div class="icon-wrap"><svg viewBox="0 0 22 22" fill="none"><path d="M11 3L13.5 8.5H19L14.5 12L16.5 18L11 14.5L5.5 18L7.5 12L3 8.5H8.5L11 3Z" stroke="url(#g1)" stroke-width="1.5" stroke-linejoin="round"/></svg></div>
