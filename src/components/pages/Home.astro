          <span class="source-pill"><span class="source-pill-dot cyan"></span>{t('how.sourceWeb')}</span>
          <span class="source-pill"><span class="source-pill-dot violet"></span>{t('how.sourcePrimary')}</span>
        </div>
      </div>
    </div>
  </section>

