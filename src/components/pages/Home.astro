<script>
  // ══ GIMMICK · DECODE DO TÍTULO ════════════════════════════════════
  // A frase-afirmação do hero "decodifica": cada caractere passa por
  // glifos aleatórios antes de assentar, da esquerda p/ direita. Vibe
  // de IA/terminal resolvendo. Roda uma vez no load; desligado sob
  // prefers-reduced-motion (texto aparece direto).
  (function () {
    const el = document.querySelector<HTMLElement>('.hero-b-headline .ink');
    if (!el) return;
    const finalText = (el.textContent || '').trim();
    if (!finalText) return;

    // O texto correto já está no HTML (fallback estático sem JS).
    // Sob reduced-motion, não anima: garante o texto nítido na hora.
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) { el.textContent = finalText; return; }

    const CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/<>#*+=-·';
    const DURATION = 520;       // ms — resolve em < 600ms, sempre
    const SETTLE = 0.16;        // janela final em que cada char fixa
    const n = finalText.length;
    let done = false;
    let startTs = 0;

    const finish = () => { if (!done) { done = true; el.textContent = finalText; } };

    const step = (ts: number) => {
      if (done) return;
      if (!startTs) startTs = ts;
      const t = (ts - startTs) / DURATION;       // 0 → 1
      if (t >= 1) { finish(); return; }
      let out = '';
      for (let i = 0; i < n; i++) {
        const ch = finalText[i];
        if (ch === ' ') { out += ' '; continue; }
        const settleAt = (i / n) * (1 - SETTLE);  // revela da esquerda p/ direita
        if (t >= settleAt + SETTLE) {
          out += ch;                               // já assentado, nítido
        } else if (t >= settleAt) {
          out += '<span class="scramble-glyph">' + CHARS[(Math.random() * CHARS.length) | 0] + '</span>';
        } else {
          out += '<span class="scramble-glyph" style="opacity:.4">' + CHARS[(Math.random() * CHARS.length) | 0] + '</span>';
        }
      }
      el.innerHTML = out;
      requestAnimationFrame(step);
    };

    // Trava de segurança: aconteça o que acontecer, o texto fica nítido.
    window.setTimeout(finish, DURATION + 180);
    // Começa só depois do texto já estar pintado (dois rAF).
    requestAnimationFrame(() => requestAnimationFrame(step));
  })();

  // ══ PARTÍCULAS DO HERÓI ═══════════════════════════════════════════
  // Malha de pontos roxos leve em canvas (zero dependência). Pausa fora
  // da viewport e desliga sob prefers-reduced-motion. transform/opacity
  // apenas; densidade baixa pra não pesar.
  (function () {
    const canvas = document.querySelector<HTMLCanvasElement>('.hero-b-particles');
    if (!canvas) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const hero = canvas.closest('section');
    let w = 0, h = 0, dpr = Math.min(window.devicePixelRatio || 1, 2);
    let pts: { x: number; y: number; vx: number; vy: number }[] = [];
    let raf = 0, running = false;

    const resize = () => {
      const r = (hero || canvas).getBoundingClientRect();
      w = r.width; h = r.height;
      canvas.width = w * dpr; canvas.height = h * dpr;
      canvas.style.width = w + 'px'; canvas.style.height = h + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.min(140, Math.round((w * h) / 13000));
      pts = Array.from({ length: count }, (_, i) => ({
        x: ((i * 97) % 100) / 100 * w,
        y: ((i * 53) % 100) / 100 * h,
        vx: (((i % 7) - 3) / 3) * 0.20,
        vy: (((i % 5) - 2) / 2) * 0.18,
      }));
    };

    const tick = () => {
      if (!running) return;
      ctx.clearRect(0, 0, w, h);
      for (const p of pts) {
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0 || p.x > w) p.vx *= -1;
        if (p.y < 0 || p.y > h) p.vy *= -1;
      }
      for (let i = 0; i < pts.length; i++) {
        for (let j = i + 1; j < pts.length; j++) {
          const a = pts[i], b = pts[j];
          const dx = a.x - b.x, dy = a.y - b.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < 20000) {
            ctx.globalAlpha = (1 - d2 / 20000) * 0.32;
            ctx.strokeStyle = '#A78BFA';
            ctx.lineWidth = 1;
            ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
          }
        }
      }
      ctx.globalAlpha = 0.9;
      ctx.fillStyle = '#A78BFA';
      for (const p of pts) { ctx.beginPath(); ctx.arc(p.x, p.y, 2, 0, Math.PI * 2); ctx.fill(); }
      ctx.globalAlpha = 1;
      raf = requestAnimationFrame(tick);
    };

    const start = () => { if (!running) { running = true; raf = requestAnimationFrame(tick); } };
    const stop = () => { running = false; cancelAnimationFrame(raf); };

    resize();
    window.addEventListener('resize', resize, { passive: true });
    if ('IntersectionObserver' in window && hero) {
      new IntersectionObserver((e) => { e[0].isIntersecting ? start() : stop(); }, { threshold: 0.02 }).observe(hero);
    } else { start(); }
  })();

  // ══ CONSTELAÇÃO DE SERVIÇOS ════════════════════════════════════════
  // Núcleo + 5 nós orbitando, linhas com fluxo de luz, profundidade 3D
  // (nós "atrás" menores/desfocados), partículas ao fundo e parallax no
  // cursor. Um único loop rAF cuida de órbita + fluxo + parallax +
  // partículas. Pausa fora da viewport (IntersectionObserver) e, sob
  // prefers-reduced-motion, desenha um único quadro estático.
  (function () {
    const root = document.querySelector<HTMLElement>('.constel');
    if (!root) return;
    const stage = root.querySelector<HTMLElement>('[data-stage]');
    const svg = root.querySelector<SVGSVGElement>('[data-links]');
    const canvas = root.querySelector<HTMLCanvasElement>('.constel-particles');
    const nodes = Array.from(root.querySelectorAll<HTMLElement>('[data-node]'));
    if (!stage || !svg || !canvas || !nodes.length) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const N = nodes.length;
    const TAU = Math.PI * 2;
    const SVGNS = 'http://www.w3.org/2000/svg';

    // Duas linhas por nó: base fina (sempre) + fluxo de luz (tracejado).
    const bases: SVGLineElement[] = [];
    const flows: SVGLineElement[] = [];
    for (let i = 0; i < N; i++) {
      const b = document.createElementNS(SVGNS, 'line'); b.setAttribute('class', 'clink-base'); svg.appendChild(b); bases.push(b);
      const f = document.createElementNS(SVGNS, 'line'); f.setAttribute('class', 'clink-flow'); svg.appendChild(f); flows.push(f);
    }

    let W = 0, H = 0, cx = 0, cy = 0, R = 0, Rv = 0;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let parts: { x: number; y: number; r: number; vx: number; vy: number; a: number }[] = [];

    const resize = () => {
      const r = root.getBoundingClientRect();
      W = r.width; H = r.height; cx = W / 2; cy = H / 2;
      R = Math.min(W, H) * 0.40; Rv = R * 0.42;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      canvas.width = W * dpr; canvas.height = H * dpr;
      canvas.style.width = W + 'px'; canvas.style.height = H + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = W < 340 ? 7 : 14;   // mobile: menos partículas
      parts = Array.from({ length: count }, (_, i) => ({
        x: ((i * 89) % 100) / 100 * W,
        y: ((i * 61) % 100) / 100 * H,
        r: (i % 3) + 1,
        vx: (((i % 5) - 2) / 2) * 0.10,
        vy: (((i % 4) - 1.5)) * 0.06,
        a: 0.16 + (i % 4) * 0.05,
      }));
    };

    // Hover estável: em vez de :hover por nó (que tremia, porque o nó
    // sai de baixo do cursor enquanto orbita), rastreamos o ponteiro e
    // fazemos hit-test por distância contra a posição ATUAL de cada nó a
    // cada frame — sem corrida de enter/leave. Ao focar um nó, a órbita
    // desacelera até parar (ele "estaciona" sob o cursor) e volta ao
    // soltar. O parallax usa o mesmo ponteiro.
    let active = -1, pointerX = -999, pointerY = -999, inside = false;
    let mx = 0, my = 0, rx = 0, ry = 0;
    if (fine) {
      root.addEventListener('pointerenter', () => { inside = true; });
      root.addEventListener('pointerleave', () => { inside = false; pointerX = pointerY = -999; mx = 0; my = 0; });
      root.addEventListener('pointermove', (e) => {
        const r = root.getBoundingClientRect();
        pointerX = e.clientX - r.left; pointerY = e.clientY - r.top;
        mx = (pointerX / r.width - 0.5) * 2;
        my = (pointerY / r.height - 0.5) * 2;
      }, { passive: true });
    }
    const setActive = (idx: number) => {
      if (idx === active) return;
      if (active >= 0) { nodes[active].classList.remove('is-active'); flows[active].classList.remove('is-active'); bases[active].classList.remove('is-active'); }
      active = idx;
      if (active >= 0) { nodes[active].classList.add('is-active'); flows[active].classList.add('is-active'); bases[active].classList.add('is-active'); }
    };

    let t = 0, flowOff = 0, speed = 1;
    const frame = (dt: number) => {
      // Com um nó sob o cursor, desacelera suavemente até parar de vez
      // (clamp no fim do easing pra não ficar um creep sub-pixel).
      const target = active >= 0 ? 0 : 1;
      speed += (target - speed) * 0.08;
      if (target === 0 && speed < 0.015) speed = 0;
      t += dt * 0.00016 * speed;  // órbita lenta e contínua
      flowOff -= dt * 0.05;       // luz segue correndo mesmo parado (vida)
      rx += ((-my * 5) - rx) * 0.06;
      ry += ((mx * 7) - ry) * 0.06;
      stage.style.transform = `rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg)`;

      let best = -1, bestD = Infinity;
      for (let i = 0; i < N; i++) {
        const th = t + i * (TAU / N);
        const x = cx + R * Math.cos(th);
        const y = cy + Rv * Math.sin(th);
        const dn = (Math.sin(th) + 1) / 2;          // 0 (atrás) .. 1 (frente)
        let s = 0.66 + dn * 0.52;
        if (i === active) s *= 1.16;
        const blur = dn < 0.5 ? ((0.5 - dn) * 5.2).toFixed(2) : '0';
        const node = nodes[i];
        node.style.transform = `translate(-50%,-50%) translate(${(x - cx).toFixed(1)}px, ${(y - cy).toFixed(1)}px) scale(${s.toFixed(3)})`;
        node.style.opacity = (0.42 + dn * 0.58).toFixed(3);
        node.style.filter = blur === '0' ? 'none' : `blur(${blur}px)`;
        node.style.zIndex = String(20 + Math.round(dn * 60));

        for (const ln of [bases[i], flows[i]]) {
          ln.setAttribute('x1', String(cx)); ln.setAttribute('y1', String(cy));
          ln.setAttribute('x2', x.toFixed(1)); ln.setAttribute('y2', y.toFixed(1));
        }
        const len = Math.hypot(x - cx, y - cy);
        flows[i].setAttribute('stroke-dasharray', `6 ${Math.max(12, len - 6).toFixed(1)}`);
        flows[i].setAttribute('stroke-dashoffset', (flowOff - i * 8).toFixed(1));
        flows[i].style.opacity = (0.22 + dn * 0.5).toFixed(2);

        // hit-test contra a posição atual (raio generoso, escala c/ o nó)
        if (inside) {
          const d = Math.hypot(pointerX - x, pointerY - y);
          if (d < 20 + 20 * s && d < bestD) { bestD = d; best = i; }
        }
      }
      setActive(inside ? best : -1);

      ctx.clearRect(0, 0, W, H);
      ctx.fillStyle = '#A78BFA';
      for (const p of parts) {
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0) p.x += W; if (p.x > W) p.x -= W;
        if (p.y < 0) p.y += H; if (p.y > H) p.y -= H;
        ctx.globalAlpha = p.a;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, TAU); ctx.fill();
      }
      ctx.globalAlpha = 1;
    };

    let raf = 0, running = false, prev = 0;
    const tick = (ts: number) => {
      if (!running) return;
      const dt = prev ? Math.min(ts - prev, 50) : 16;
      prev = ts; frame(dt);
      raf = requestAnimationFrame(tick);
    };
    const start = () => { if (running) return; running = true; prev = 0; root.classList.remove('is-paused'); raf = requestAnimationFrame(tick); };
    const stop = () => { running = false; cancelAnimationFrame(raf); root.classList.add('is-paused'); };

    resize();
    window.addEventListener('resize', resize, { passive: true });

    if (reduce) {
      // Estático e elegante: um quadro só, sem movimento.
      root.classList.add('is-paused');
      t = -0.6;
      frame(0);
      return;
    }
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((e) => { e[0].isIntersecting ? start() : stop(); }, { threshold: 0.04 }).observe(root);
    } else { start(); }
  })();
</script>

<style>
  /* ═══════════ CASOS DE USO (cards modernos, escaneáveis) ══════════ */
  .casos-section { padding: clamp(64px, 8vw, 110px) 0; position: relative; z-index: 1; }
  .casos-head { text-align: center; max-width: 760px; margin: 0 auto 48px; }
  .casos-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px;
    max-width: 1120px; margin: 0 auto;
  }
  .caso-card {
    display: flex; flex-direction: column;
    padding: 26px 26px 24px;
    /* liquid glass: tint lilás sutil + sheen interno no topo */
    background: linear-gradient(165deg, rgba(167,139,250,0.08), rgba(255,255,255,0.02));
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 18px;
    text-decoration: none; color: inherit;
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.12);
    transition: transform .3s cubic-bezier(.16,1,.3,1), border-color .3s, box-shadow .3s;
  }
  .caso-card:hover {
    transform: translateY(-4px);
    border-color: rgba(167,139,250,0.42);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.14), 0 24px 60px rgba(0,0,0,.45), 0 0 0 1px rgba(167,139,250,0.10);
  }
  /* Fallback sem backdrop-filter: fundo um pouco mais opaco p/ legibilidade. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .caso-card { background: linear-gradient(165deg, rgba(167,139,250,0.12), var(--bg-elev)); }
  }
  .caso-ic {
    width: 46px; height: 46px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    background: var(--accent-tint);
    border: 1px solid rgba(167,139,250,0.22);
    color: var(--accent); margin-bottom: 18px;
  }
  .caso-ic svg { width: 22px; height: 22px; }
  .caso-tag {
    font-size: 10px; font-weight: 700; letter-spacing: .14em;
    text-transform: uppercase; color: var(--accent-strong); margin-bottom: 8px;
  }
  .caso-title {
    font-family: var(--font-display); font-weight: 600;
    font-size: 20px; letter-spacing: -.02em; color: var(--ink); margin: 0 0 12px;
  }
  .caso-prob { font-size: 13.5px; line-height: 1.55; color: var(--text-muted); margin: 0 0 10px; }
  .caso-prob-lbl {
    display: inline-block; font-size: 9.5px; font-weight: 700; letter-spacing: .1em;
    text-transform: uppercase; color: var(--text-dim);
    border: 1px solid var(--line); border-radius: 5px; padding: 1px 6px; margin-right: 6px;
  }
  .caso-does { font-size: 14px; line-height: 1.6; color: var(--ink); margin: 0 0 18px; flex: 1; }
  .caso-metric {
    display: flex; flex-direction: column; gap: 2px;
    padding-top: 14px; border-top: 1px solid var(--line);
  }
  .caso-metric-val { font-family: var(--font-display); font-weight: 700; font-size: 17px; letter-spacing: -.02em; color: var(--accent); }
  .caso-metric-note { font-size: 10.5px; letter-spacing: .04em; text-transform: uppercase; color: var(--text-dim); }
  /* Card-CTA que fecha o grid */
  .caso-card-cta {
    align-items: flex-start; justify-content: center;
    background: linear-gradient(165deg, rgba(167,139,250,0.12), rgba(139,92,246,0.04));
    border-color: rgba(167,139,250,0.30);
  }
  .caso-cta-text {
    font-family: var(--font-display); font-weight: 600; font-size: 19px;
    letter-spacing: -.02em; color: var(--accent-strong);
  }
  .casos-disclaimer {
    max-width: 1120px; margin: 22px auto 0; text-align: center;
    font-size: 12px; color: var(--text-dim);
  }
  @media (max-width: 900px) { .casos-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .casos-grid { grid-template-columns: 1fr; } }

  /* ═══════════ SOLUÇÕES (teaser) ══════════════════════════════════ */
  .solt-section { padding: clamp(56px, 7vw, 96px) 0; position: relative; z-index: 1; background: var(--bg-elev); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .solt-inner { display: grid; grid-template-columns: 1.1fr 0.9fr; align-items: center; gap: 48px; max-width: 1080px; margin: 0 auto; }
  .solt-copy .section-title { margin-bottom: 14px; }
  .solt-cta-row { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 24px; }
  .solt-note { font-size: 12.5px; color: var(--text-dim); }
  .solt-art { position: relative; min-height: 420px; display: flex; align-items: center; justify-content: center; }

  /* ── Constelação de Serviços ─────────────────────────────────────
     Núcleo + 5 nós orbitando. As posições dos nós e das linhas são
     calculadas em JS (um rAF só); o CSS cuida do brilho do núcleo, do
     vidro dos rótulos e do fallback estático (placement em pentágono
     via --i caso o JS não rode). */
  .constel { position: relative; width: 100%; max-width: 480px; aspect-ratio: 1; margin-inline: auto; perspective: 1000px; }
  .constel-glow { position: absolute; inset: 10%; border-radius: 50%; background: radial-gradient(closest-side, rgba(167,139,250,0.20), transparent 70%); filter: blur(40px); z-index: 0; pointer-events: none; }
  .constel-particles { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; }
  .constel-stage { position: absolute; inset: 0; z-index: 2; transform-style: preserve-3d; will-change: transform; }

  /* Linhas núcleo ↔ nós (base fina + fluxo de luz tracejado animado) */
  .constel-links { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; z-index: 2; }
  .clink-base { stroke: rgba(167,139,250,0.20); stroke-width: 1; fill: none; transition: stroke .2s; }
  .clink-base.is-active { stroke: rgba(167,139,250,0.45); }
  .clink-flow { stroke: rgba(206,189,255,0.85); stroke-width: 1.6; fill: none; stroke-linecap: round; filter: drop-shadow(0 0 3px rgba(167,139,250,0.65)); transition: stroke-width .2s; }
  .clink-flow.is-active { stroke: #EDE6FF; stroke-width: 2.4; filter: drop-shadow(0 0 6px rgba(167,139,250,0.95)); }

  /* Núcleo de IA — orbe lilás "respirando" + dois anéis de pulso */
  .constel-core { position: absolute; top: 50%; left: 50%; width: 18%; height: 18%; transform: translate(-50%,-50%); z-index: 40; }
  .constel-core-orb {
    position: absolute; inset: 0; border-radius: 50%;
    background: radial-gradient(circle at 38% 32%, #F1ECFF, var(--accent) 46%, var(--accent-deep) 100%);
    box-shadow: 0 0 34px 8px rgba(167,139,250,0.55), inset 0 1px 2px rgba(255,255,255,0.5);
    animation: constelCore 3.6s ease-in-out infinite;
  }
  .constel-core-ping { position: absolute; inset: 0; border-radius: 50%; border: 1px solid rgba(167,139,250,0.55); animation: constelPing 3.6s ease-out infinite; }
  .constel-core-ping.d { animation-delay: 1.8s; }

  /* Nós (serviços). JS sobrescreve transform/opacity/filter/z-index;
     o transform abaixo é só o fallback estático sem JS. */
  .constel-node {
    position: absolute; top: 50%; left: 50%; z-index: 20;
    display: flex; flex-direction: column; align-items: center; gap: 7px;
    pointer-events: auto; cursor: pointer; text-decoration: none; color: inherit;
    will-change: transform, opacity, filter;
    transform: translate(-50%,-50%) rotate(calc(var(--i) * 72deg - 90deg)) translateY(-156px) rotate(calc(var(--i) * -72deg + 90deg));
  }
  .constel-node:focus-visible { outline: none; }
  .constel-node:focus-visible .constel-label {
    color: #F3EEFF; background: rgba(167,139,250,0.16);
    border-color: var(--accent); box-shadow: 0 0 0 2px rgba(167,139,250,0.45);
  }
  .constel-node:focus-visible .constel-dot {
    box-shadow: 0 0 0 3px rgba(167,139,250,0.5),
      0 0 16px 2px var(--pg, rgba(167,139,250,0.55)),
      inset -3px -4px 8px rgba(0,0,0,0.5), inset 2px 2px 6px rgba(255,255,255,0.30);
  }
  /* Cada nó é um pequeno planeta: corpo esférico com luz vinda do alto-
     esquerda, sombra do terminador (inset escuro embaixo-direita) e halo
     na cor do planeta. As cores vêm das vars --pb/--pd/--pa/--pg no
     markup, então cada serviço tem um planeta diferente. */
  .constel-dot {
    position: relative;
    width: 22px; height: 22px; border-radius: 50%;
    background:
      radial-gradient(circle at 30% 26%, rgba(255,255,255,0.95), rgba(255,255,255,0) 42%),
      radial-gradient(circle at 68% 74%, var(--pd, #4C1D95), var(--pb, #8B5CF6) 66%);
    box-shadow:
      0 0 16px 2px var(--pg, rgba(167,139,250,0.55)),
      inset -3px -4px 8px rgba(0,0,0,0.5),
      inset 2px 2px 6px rgba(255,255,255,0.30);
    border: 1px solid rgba(255,255,255,0.14);
    transition: box-shadow .25s, transform .2s;
  }
  /* Textura de superfície (manchas tipo continentes/crateras), estática e
     em soft-light pra reagir à cor de cada planeta sem ficar berrante. */
  .constel-dot::before {
    content: ''; position: absolute; inset: 0; border-radius: 50%;
    background:
      radial-gradient(circle at 58% 30%, var(--pa, rgba(255,255,255,0.2)), transparent 24%),
      radial-gradient(circle at 32% 60%, rgba(0,0,0,0.32), transparent 30%),
      radial-gradient(circle at 80% 66%, rgba(0,0,0,0.24), transparent 26%),
      radial-gradient(circle at 46% 84%, var(--pa, rgba(255,255,255,0.16)), transparent 20%);
    mix-blend-mode: soft-light;
    opacity: 0.9;
  }
  .constel-label {
    font-size: 12px; font-weight: 600; letter-spacing: .01em; color: var(--text-muted);
    padding: 3px 9px; border-radius: 999px; white-space: nowrap;
    background: rgba(167,139,250,0.06); border: 1px solid rgba(255,255,255,0.08);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    transition: color .2s, background .2s, border-color .2s;
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .constel-label { background: rgba(124,58,237,0.16); }
  }
  .constel-node.is-active { z-index: 90 !important; }
  .constel-node.is-active .constel-dot {
    box-shadow:
      0 0 24px 7px var(--pg, rgba(167,139,250,0.9)),
      inset -3px -4px 8px rgba(0,0,0,0.5),
      inset 2px 2px 6px rgba(255,255,255,0.4);
    transform: scale(1.12);
  }
  .constel-node.is-active .constel-label { color: #F3EEFF; background: rgba(167,139,250,0.16); border-color: rgba(167,139,250,0.45); }

  @keyframes constelCore {
    0%,100% { transform: scale(1); box-shadow: 0 0 30px 6px rgba(167,139,250,0.45), inset 0 1px 2px rgba(255,255,255,0.5); }
    50%     { transform: scale(1.07); box-shadow: 0 0 46px 12px rgba(167,139,250,0.7), inset 0 1px 2px rgba(255,255,255,0.6); }
  }
  @keyframes constelPing { 0% { transform: scale(1); opacity: .55; } 100% { transform: scale(2.4); opacity: 0; } }

  /* Pausa o pulso do núcleo quando o loop está parado (fora da viewport) */
  .constel.is-paused .constel-core-orb,
  .constel.is-paused .constel-core-ping { animation-play-state: paused; }

  /* Reduced motion: tudo estático, ainda elegante (sem pulso, sem fluxo) */
  @media (prefers-reduced-motion: reduce) {
    .constel-core-orb, .constel-core-ping { animation: none !important; }
  }

  @media (max-width: 820px) {
    .solt-inner { grid-template-columns: 1fr; gap: 28px; }
    .solt-art { min-height: 320px; }
    .constel { max-width: 320px; }
    .constel-label { font-size: 11px; padding: 2px 7px; }
  }

  /* ═══════════ PROVA / MERCADO (referências rotuladas) ════════════ */
  .prova-section { padding: clamp(56px, 7vw, 100px) 0; position: relative; z-index: 1; }
  .prova-head { text-align: center; max-width: 720px; margin: 0 auto 44px; }
  .prova-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; max-width: 1080px; margin: 0 auto; }
  .prova-stat { padding: 26px 22px; border: 1px solid var(--line); border-radius: 16px; background: var(--bg-elev); }
  .prova-val { font-family: var(--font-display); font-weight: 700; font-size: clamp(28px, 3.4vw, 40px); letter-spacing: -.03em; color: var(--accent); line-height: 1; margin-bottom: 12px; }
  .prova-lbl { font-size: 13.5px; line-height: 1.55; color: var(--text); margin-bottom: 14px; }
  .prova-src { font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--text-dim); padding-top: 12px; border-top: 1px solid var(--line); }
  .prova-disclaimer { max-width: 1080px; margin: 22px auto 0; text-align: center; font-size: 12px; color: var(--text-dim); }
  @media (max-width: 880px) { .prova-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .prova-grid { grid-template-columns: 1fr; } }

  /* ═══════════ VÍDEO DO D.LAB ═════════════════════════════════════ */
  .video-section { padding: clamp(56px, 7vw, 100px) 0; position: relative; z-index: 1; }
