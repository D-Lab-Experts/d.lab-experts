---
import Layout from '../../layouts/Layout.astro';
import NeuralNetwork from '../NeuralNetwork.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations();

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const formatLabelMap: Record<'briefing' | 'report' | 'foresight' | 'sector', string> = {
  briefing: t('formats.briefing'),
  report: t('formats.report'),
  foresight: t('formats.foresight'),
  sector: t('formats.sector'),
};
---

<Layout
  title={t('pageTitles.home')}
  description={t('pageTitles.homeDescription')}
  active="home"
>
  <!-- ═══════════════ HERO ══════════════════════════════════════════ -->
  <section id="hero">
    <div class="hero-grid"></div>
    <div class="hero-light-a"></div>
    <div class="hero-light-b"></div>

    <svg class="hero-orbital" viewBox="0 0 800 800" fill="none">
      <circle cx="400" cy="400" r="300" stroke="rgba(177,140,255,0.15)" stroke-width="0.5" fill="none" stroke-dasharray="6 8"/>
      <circle cx="400" cy="400" r="200" stroke="rgba(77,163,255,0.12)" stroke-width="0.5" fill="none" stroke-dasharray="4 10"/>
      <circle cx="400" cy="400" r="100" stroke="rgba(177,140,255,0.1)" stroke-width="0.5" fill="none"/>
      <circle r="3" fill="#B18CFF" opacity=".6">
        <animateMotion dur="20s" repeatCount="indefinite" path="M400,100 A300,300 0 1,1 399.99,100"/>
      </circle>
      <circle r="2.5" fill="#4DA3FF" opacity=".5">
        <animateMotion dur="15s" repeatCount="indefinite" path="M400,200 A200,200 0 1,1 399.99,200"/>
      </circle>
      <circle r="2" fill="#00E5A0" opacity=".4">
        <animateMotion dur="10s" repeatCount="indefinite" path="M400,300 A100,100 0 1,1 399.99,300"/>
      </circle>
      <circle cx="400" cy="400" r="2" fill="rgba(177,140,255,0.3)"/>
      <circle cx="250" cy="350" r="1.5" fill="rgba(77,163,255,0.25)"/>
      <circle cx="550" cy="350" r="1.5" fill="rgba(77,163,255,0.25)"/>
      <circle cx="400" cy="250" r="1.5" fill="rgba(177,140,255,0.2)"/>
      <circle cx="400" cy="550" r="1.5" fill="rgba(177,140,255,0.2)"/>
      <line x1="400" y1="400" x2="250" y2="350" stroke="rgba(177,140,255,0.08)" stroke-width="0.5"/>
      <line x1="400" y1="400" x2="550" y2="350" stroke="rgba(77,163,255,0.08)" stroke-width="0.5"/>
      <line x1="400" y1="400" x2="400" y2="250" stroke="rgba(177,140,255,0.06)" stroke-width="0.5"/>
      <line x1="400" y1="400" x2="400" y2="550" stroke="rgba(177,140,255,0.06)" stroke-width="0.5"/>
    </svg>

    <div class="hero-inner">
      <div class="hero-text fi">
        <div class="hero-tag"><span class="tag-dot"></span>{t('hero.tag')}</div>
        <h1 class="hero-h1">
          {t('hero.h1Line1')}<br><span class="hero-accent">{t('hero.h1Accent')}</span>
        </h1>
        <p class="hero-sub">{t('hero.sub')}</p>
        <div class="hero-ctas">
          <a href="/blog" class="btn btn-primary">{t('hero.ctaPrimary')}</a>
          <a href="/#products" class="btn btn-ghost">{t('hero.ctaSecondary')}</a>
        </div>
        <div class="hero-stats">
          <div>
            <div class="hero-stat-val">{t('hero.statNdaVal')}</div>
            <div class="hero-stat-lbl">{t('hero.statNdaLbl')}</div>
            <div class="hero-stat-src">{t('hero.statNdaSrc')}</div>
          </div>
          <div>
            <div class="hero-stat-val">{t('hero.statSeniorVal')}</div>
            <div class="hero-stat-lbl">{t('hero.statSeniorLbl')}</div>
            <div class="hero-stat-src">{t('hero.statSeniorSrc')}</div>
          </div>
          <div>
            <div class="hero-stat-val">{t('hero.statProtocolVal')}</div>
            <div class="hero-stat-lbl">{t('hero.statProtocolLbl')}</div>
            <div class="hero-stat-src">{t('hero.statProtocolSrc')}</div>
          </div>
        </div>
      </div>

      <!-- ── 3D Research Cube ─────────────────────────────────────────
           Six-face data cube with grid overlays, corner brackets and
           one headline metric per face. The outer cube spins on Y;
           inside, a smaller wireframe cube counter-rotates on X+Y for
           parallax depth. Pure CSS 3D, no JS. -->
      <div class="hero-cube-stage fi d2" aria-hidden="true">
        <div class="hero-cube-glow"></div>
        <div class="hero-cube-shadow"></div>
        <div class="hero-cube">
          <!-- Inner counter-rotating wireframe -->
          <div class="hero-cube-inner">
            <div class="cube-inner-face inner-front"></div>
            <div class="cube-inner-face inner-back"></div>
            <div class="cube-inner-face inner-right"></div>
            <div class="cube-inner-face inner-left"></div>
            <div class="cube-inner-face inner-top"></div>
            <div class="cube-inner-face inner-bottom"></div>
          </div>

          <!-- Outer faces with research data -->
          <div class="cube-face cube-front">
            <div class="cube-grid"></div>
            <div class="cube-corner tl"></div><div class="cube-corner tr"></div>
            <div class="cube-corner bl"></div><div class="cube-corner br"></div>
            <div class="cube-content">
              <div class="cube-eyebrow">{t('cube.frontEyebrow')}</div>
              <div class="cube-num">N=98</div>
              <div class="cube-lbl">{t('cube.frontLbl')}</div>
            </div>
          </div>

          <div class="cube-face cube-back">
            <div class="cube-grid"></div>
            <div class="cube-corner tl"></div><div class="cube-corner tr"></div>
            <div class="cube-corner bl"></div><div class="cube-corner br"></div>
            <div class="cube-content">
              <div class="cube-eyebrow">{t('cube.backEyebrow')}</div>
              <div class="cube-num" style="background:linear-gradient(135deg,#00E5A0 0%,#00D4FF 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">$4.88M</div>
              <div class="cube-lbl">{t('cube.backLbl')}</div>
            </div>
          </div>

          <div class="cube-face cube-right">
            <div class="cube-grid"></div>
            <div class="cube-corner tl"></div><div class="cube-corner tr"></div>
            <div class="cube-corner bl"></div><div class="cube-corner br"></div>
            <div class="cube-content">
              <div class="cube-eyebrow">{t('cube.rightEyebrow')}</div>
              <div class="cube-num">73%</div>
              <div class="cube-lbl">{t('cube.rightLbl')}</div>
            </div>
          </div>

          <div class="cube-face cube-left">
            <div class="cube-grid"></div>
            <div class="cube-corner tl"></div><div class="cube-corner tr"></div>
            <div class="cube-corner bl"></div><div class="cube-corner br"></div>
            <div class="cube-content">
              <div class="cube-eyebrow">{t('cube.leftEyebrow')}</div>
              <div class="cube-num" style="background:linear-gradient(135deg,#B18CFF 0%,#4DA3FF 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">3.48×</div>
              <div class="cube-lbl">{t('cube.leftLbl')}</div>
            </div>
          </div>

          <div class="cube-face cube-top">
            <div class="cube-grid"></div>
            <div class="cube-corner tl"></div><div class="cube-corner tr"></div>
            <div class="cube-corner bl"></div><div class="cube-corner br"></div>
            <div class="cube-content">
              <div class="cube-mark">D.LAB</div>
              <div class="cube-mark-sub">{t('cube.topMarkSub')}</div>
            </div>
          </div>

          <div class="cube-face cube-bottom">
            <div class="cube-grid"></div>
            <div class="cube-corner tl"></div><div class="cube-corner tr"></div>
            <div class="cube-corner bl"></div><div class="cube-corner br"></div>
            <div class="cube-content">
              <div class="cube-eyebrow">{t('cube.bottomEyebrow')}</div>
              <div class="cube-num" style="background:linear-gradient(135deg,#FFD166 0%,#F5A623 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">12:1</div>
              <div class="cube-lbl">{t('cube.bottomLbl')}</div>
            </div>
          </div>
        </div>

        <!-- Floating particles around the cube (decorative) -->
        <span class="cube-particle p1"></span>
        <span class="cube-particle p2"></span>
        <span class="cube-particle p3"></span>
        <span class="cube-particle p4"></span>
      </div>
    </div>

    <div class="scroll-ind">
      <span class="label" style="font-size:9px">Scroll</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- ═══════════════ FEATURED STUDY ════════════════════════════════ -->
  <!-- Pulled out of the hero so the headline owns the viewport.
       This card is the most recent original study — readers land, see
       the claim, then immediately encounter the proof. -->
  <section id="featured-study">
    <div class="section-glow lilac" style="top:-40px;left:20%;width:480px;height:360px"></div>
    <div class="section-glow blue" style="bottom:-60px;right:-40px;width:520px;height:380px"></div>
    <div class="container">
      <div class="featured-study-header fi">
        <span class="label" style="display:inline-flex;align-items:center;gap:10px">
          <span style="width:22px;height:1px;background:var(--grad);display:block"></span>
          {t('featured.eyebrow')}
        </span>
        <h2 class="featured-study-title">{t('featured.titleLead')} <span class="gradient-text">{t('featured.titleAccent')}</span></h2>
      </div>

      <div class="hero-card-wrap fi d1">
        <div class="hero-card">
          <div class="hc-header">
            <div style="display:flex;align-items:center">
              <img src="/d.lab-icon.webp" alt="" class="hc-icon" width="28" height="28" />
              <div>
                <div class="hc-title">{t('featured.cardTitle')}</div>
                <div class="hc-sub">{t('featured.cardSub')}</div>
              </div>
            </div>
            <span class="badge badge-green badge-dot">{t('featured.badgePublished')}</span>
          </div>

          <div class="hc-body">
            <div class="hc-body-left">
              <div class="hc-metrics">
                <div class="hc-m"><div class="hc-m-val" style="color:var(--green)">87.8%</div><div class="hc-m-lbl">{t('featured.metricPerceived')}</div></div>
                <div class="hc-m"><div class="hc-m-val" style="color:var(--yellow)">16.3%</div><div class="hc-m-lbl">{t('featured.metricTrust')}</div></div>
                <div class="hc-m"><div class="hc-m-val" style="color:var(--lilac)">3.48×</div><div class="hc-m-lbl">{t('featured.metricSwitch')}</div></div>
              </div>

              <div class="hc-verdict">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" style="flex-shrink:0;margin-top:1px"><path d="M8 1L10 6H15L11 9.5L12.5 15L8 11.5L3.5 15L5 9.5L1 6H6L8 1Z" fill="url(#g1)" opacity=".9"/></svg>
                <div class="hc-verdict-text"><strong>{t('featured.verdictLead')}</strong> {t('featured.verdictText')}</div>
              </div>
            </div>

            <div class="hc-body-right">
              <div class="hc-chart">
                <div class="hc-chart-label">{t('featured.chartLabel')}</div>
                <svg class="sparkline-svg" viewBox="0 0 320 56" preserveAspectRatio="none">
                  <defs>
                    <linearGradient id="spark-area" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="#B18CFF" stop-opacity="0.2"/>
                      <stop offset="100%" stop-color="#B18CFF" stop-opacity="0"/>
                    </linearGradient>
                  </defs>
                  <path d="M0,42 C20,40 40,36 60,32 C80,28 100,30 120,24 C140,18 160,20 180,16 C200,12 220,14 240,10 C260,6 280,8 320,4 L320,56 L0,56 Z" fill="url(#spark-area)"/>
                  <path d="M0,42 C20,40 40,36 60,32 C80,28 100,30 120,24 C140,18 160,20 180,16 C200,12 220,14 240,10 C260,6 280,8 320,4" fill="none" stroke="url(#g2)" stroke-width="1.8" stroke-linecap="round" filter="url(#glow-f)"/>
                  <circle cx="320" cy="4" r="3" fill="#B18CFF" filter="url(#glow-f)">
                    <animate attributeName="opacity" values="1;0.4;1" dur="1.4s" repeatCount="indefinite"/>
                  </circle>
                  <circle cx="320" cy="4" r="3" fill="none" stroke="#B18CFF" stroke-opacity=".6">
                    <animate attributeName="r" values="3;8;3" dur="1.4s" repeatCount="indefinite"/>
                    <animate attributeName="stroke-opacity" values=".6;0;.6" dur="1.4s" repeatCount="indefinite"/>
                  </circle>
                  <text x="0" y="56" font-size="8" fill="rgba(234,234,240,0.22)" font-family="Satoshi">Jan</text>
                  <text x="145" y="56" font-size="8" fill="rgba(234,234,240,0.22)" font-family="Satoshi">Jun</text>
                  <text x="300" y="56" font-size="8" fill="rgba(234,234,240,0.22)" font-family="Satoshi">Dec</text>
                </svg>
              </div>

              <div class="hc-bars">
                <div class="hc-bar-row">
                  <div class="hc-bar-meta"><span class="hc-bar-name">{t('featured.barMinority')}</span><span class="hc-bar-pct" style="color:var(--lilac)">73%</span></div>
                  <div class="hc-bar-track"><div class="hc-bar-fill hero-bar" data-v="73"></div></div>
                </div>
                <div class="hc-bar-row">
                  <div class="hc-bar-meta"><span class="hc-bar-name">{t('featured.barNonMinority')}</span><span class="hc-bar-pct" style="color:var(--blue)">44%</span></div>
                  <div class="hc-bar-track"><div class="hc-bar-fill hero-bar" data-v="44"></div></div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <a href="/posts/campanhas-afirmativas-gaming" class="featured-study-link">
          {t('featured.readFull')}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════ DIAGNOSTIC PROMO ══════════════════════════════ -->
  <!-- Prominent promo for the /diagnostic interactive tool. Sits
       between the featured study and the brand statement so readers
       land on the tool right after seeing what we publish. -->
  <section id="diagnostic-promo" class="diag-promo-section">
    <div class="section-glow lilac" style="top:20%;left:-100px;width:460px;height:340px"></div>
    <div class="section-glow blue" style="bottom:-40px;right:-60px;width:520px;height:360px"></div>
    <div class="container">
      <a class="diag-promo-card fi" href="/diagnostico" aria-label={t('diagnostic.homePromoCta')}>
        <div class="diag-promo-copy">
          <div class="diag-promo-eyebrow">
            <span class="diag-promo-pulse"></span>
            {t('diagnostic.homeEyebrow')}
          </div>
          <h2 class="diag-promo-title">
            {t('diagnostic.homePromoTitle')}<br /><span class="gradient-text">{t('diagnostic.homePromoAccent')}</span>
          </h2>
          <p class="diag-promo-sub">{t('diagnostic.homePromoSub')}</p>
          <div class="diag-promo-stats">
            <div class="diag-promo-stat">
              <div class="diag-promo-stat-val">{t('diagnostic.homePromoStat1Val')}</div>
              <div class="diag-promo-stat-lbl">{t('diagnostic.homePromoStat1Label')}</div>
            </div>
            <div class="diag-promo-stat">
              <div class="diag-promo-stat-val">{t('diagnostic.homePromoStat2Val')}</div>
              <div class="diag-promo-stat-lbl">{t('diagnostic.homePromoStat2Label')}</div>
            </div>
            <div class="diag-promo-stat">
              <div class="diag-promo-stat-val">{t('diagnostic.homePromoStat3Val')}</div>
              <div class="diag-promo-stat-lbl">{t('diagnostic.homePromoStat3Label')}</div>
            </div>
          </div>
          <span class="diag-promo-cta">
            {t('diagnostic.homePromoCta')}
          </span>
        </div>

        <!-- Tiny decorative cube preview on the right — echoes the
             hero cube so visitors recognize the tool as D.Lab-built. -->
        <div class="diag-promo-visual" aria-hidden="true">
          <div class="diag-promo-cube">
            <div class="diag-promo-cube-face diag-promo-cube-front">
              <div class="diag-promo-cube-eyebrow">Quality</div>
              <div class="diag-promo-cube-num">47%</div>
              <div class="diag-promo-cube-bar">
                <div class="diag-promo-cube-bar-baseline"></div>
                <div class="diag-promo-cube-bar-fill"></div>
              </div>
              <div class="diag-promo-cube-lbl">vs. 37% baseline</div>
            </div>
          </div>
          <div class="diag-promo-sparkles">
            <span class="diag-promo-sparkle s1"></span>
            <span class="diag-promo-sparkle s2"></span>
            <span class="diag-promo-sparkle s3"></span>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- ═══════════════ BRAND STATEMENT ═══════════════════════════════ -->
  <section id="brand-statement">
    <div class="brand-wave-bg">
      <svg viewBox="0 0 1200 400" preserveAspectRatio="none">
        <path class="brand-wave-line" d="M0,200 Q150,140 300,200 T600,200 T900,200 T1200,200" stroke="rgba(177,140,255,0.25)" stroke-width="1">
          <animate attributeName="d" dur="8s" repeatCount="indefinite" values="M0,200 Q150,140 300,200 T600,200 T900,200 T1200,200;M0,200 Q150,260 300,200 T600,200 T900,200 T1200,200;M0,200 Q150,140 300,200 T600,200 T900,200 T1200,200"/>
        </path>
        <path class="brand-wave-line" d="M0,200 Q200,160 400,200 T800,200 T1200,200" stroke="rgba(77,163,255,0.18)" stroke-width="0.8">
          <animate attributeName="d" dur="10s" repeatCount="indefinite" values="M0,200 Q200,160 400,200 T800,200 T1200,200;M0,200 Q200,240 400,200 T800,200 T1200,200;M0,200 Q200,160 400,200 T800,200 T1200,200"/>
        </path>
        <path class="brand-wave-line" d="M0,200 Q300,180 600,200 T1200,200" stroke="rgba(0,229,160,0.1)" stroke-width="0.6">
          <animate attributeName="d" dur="12s" repeatCount="indefinite" values="M0,200 Q300,180 600,200 T1200,200;M0,200 Q300,220 600,200 T1200,200;M0,200 Q300,180 600,200 T1200,200"/>
        </path>
      </svg>
    </div>
    <NeuralNetwork color="lilac" density="low" opacity={0.22} />
    <div class="container">
      <div class="brand-grid">
        <div class="brand-text fi">
          <h2 class="brand-title">
            {t('brand.title')} <span class="gradient-text">{t('brand.titleAccent')}</span>
          </h2>
          <p class="brand-desc">{t('brand.desc')}</p>
        </div>

        <!-- Globe visualization: 6 labeled satellites orbiting a
             wireframe Earth, signaling where our research lands in
             the world. Outer rotation walks the points around the
             globe; inner counter-rotation keeps each label upright. -->
        <div class="brand-globe fi d1" aria-hidden="true">
          <svg class="brand-globe-core" viewBox="0 0 280 280">
            <defs>
              <linearGradient id="globe-grad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#B18CFF" stop-opacity="0.7"/>
                <stop offset="100%" stop-color="#4DA3FF" stop-opacity="0.5"/>
              </linearGradient>
            </defs>
            <!-- Outer wireframe sphere -->
            <circle cx="140" cy="140" r="90" fill="none" stroke="url(#globe-grad)" stroke-width="1" stroke-opacity="0.55"/>
            <!-- Latitude ellipses (horizontal slices) -->
            <ellipse cx="140" cy="140" rx="90" ry="30" fill="none" stroke="rgba(177,140,255,0.22)" stroke-width="0.7"/>
            <ellipse cx="140" cy="140" rx="90" ry="60" fill="none" stroke="rgba(177,140,255,0.18)" stroke-width="0.7"/>
            <!-- Longitude ellipses (vertical slices) -->
            <ellipse cx="140" cy="140" rx="30" ry="90" fill="none" stroke="rgba(77,163,255,0.22)" stroke-width="0.7"/>
            <ellipse cx="140" cy="140" rx="60" ry="90" fill="none" stroke="rgba(77,163,255,0.18)" stroke-width="0.7"/>
            <!-- Equator + prime meridian -->
            <line x1="50" y1="140" x2="230" y2="140" stroke="rgba(177,140,255,0.35)" stroke-width="1"/>
            <line x1="140" y1="50" x2="140" y2="230" stroke="rgba(177,140,255,0.35)" stroke-width="1"/>
            <!-- Pulsing core dot (the Hub at the center) -->
            <circle cx="140" cy="140" r="4" fill="url(#globe-grad)">
              <animate attributeName="r" values="3;6;3" dur="3s" repeatCount="indefinite"/>
              <animate attributeName="opacity" values="1;.5;1" dur="3s" repeatCount="indefinite"/>
            </circle>
            <!-- Ring pulse outward from core -->
            <circle cx="140" cy="140" r="4" fill="none" stroke="url(#globe-grad)" stroke-width="1">
              <animate attributeName="r" values="4;90;4" dur="5s" repeatCount="indefinite"/>
              <animate attributeName="opacity" values=".8;0;.8" dur="5s" repeatCount="indefinite"/>
            </circle>

          </svg>

          <!-- 6 orbiting labels. Each uses `transform: rotate(a)
               translateX(r) rotate(-a)` keyframes: outer rotate
               walks around the globe, inner counter-rotate keeps the
               label upright. Delays distribute them at 60° intervals. -->
          <div class="brand-point" style="--delay: 0s">
            <span class="brand-point-dot"></span>
            <span class="brand-point-label">Communication studies</span>
          </div>
          <div class="brand-point" style="--delay: -10s">
            <span class="brand-point-dot"></span>
            <span class="brand-point-label">ESG strategy</span>
          </div>
          <div class="brand-point" style="--delay: -20s">
            <span class="brand-point-dot"></span>
            <span class="brand-point-label">Venture capital</span>
          </div>
          <div class="brand-point" style="--delay: -30s">
            <span class="brand-point-dot"></span>
            <span class="brand-point-label">Policy analysis</span>
          </div>
          <div class="brand-point" style="--delay: -40s">
            <span class="brand-point-dot"></span>
            <span class="brand-point-label">Market foresight</span>
          </div>
