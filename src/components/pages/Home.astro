---
import Layout from '../../layouts/Layout.astro';
import Visual from '../Visual.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations();

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const formatLabelMap: Record<'briefing' | 'report' | 'foresight' | 'sector', string> = {
  briefing: t('formats.briefing'),
  report: t('formats.report'),
  foresight: t('formats.foresight'),
  sector: t('formats.sector'),
};
---

<Layout
  title={t('pageTitles.home')}
  description={t('pageTitles.homeDescription')}
  active="home"
>
  <!-- ═══════════════ HERO ══════════════════════════════════════════
       Redesign monocromático Apple/Resend: composição editorial à
       esquerda, headline em Inter peso leve, grid fino + glow branco no
       topo, faixa de dados full-bleed com hairlines. Estilo escopado
       abaixo (.hero-b-*). Alto contraste por preto×branco, sem cor. -->
  <section id="hero" class="hero-b">
    <div class="hero-b-grid" aria-hidden="true"></div>
    <div class="hero-b-glow" data-parallax="0.18" aria-hidden="true"></div>

    <div class="hero-b-wrap">
      <div class="hero-b-brandrow fi">
        <span class="hero-b-brand">D<span class="hero-b-dot" aria-hidden="true"></span>Lab</span>
        <span class="hero-b-sep" aria-hidden="true"></span>
        <span class="hero-b-eyebrow">{t('hero.eyebrow')}</span>
      </div>

      <h1 class="hero-b-headline fi d1">
        <span class="dim">{t('hero.taglineLine1')} {t('hero.taglineLine2')}</span><br />
        <span class="ink">{t('hero.taglineLine3')}</span>
      </h1>

      <p class="hero-b-sub fi d2">{t('hero.sub')}</p>

      <div class="hero-b-ctas fi d3">
        <a href="/contato" class="hero-b-btn hero-b-btn-solid">{t('hero.ctaPrimary')}</a>
        <a href="/blog" class="hero-b-btn hero-b-btn-ghost">{t('hero.ctaSecondary')}</a>
      </div>
    </div>

    <div class="hero-b-proof fi d4">
      <div class="hero-b-proof-inner">
        <a href="/posts/campanhas-afirmativas-gaming" class="hero-b-proof-item">
          <span class="hero-b-proof-val">{t('hero.proof1Val')}</span>
          <span class="hero-b-proof-lbl">{t('hero.proof1Lbl')}</span>
        </a>
        <a href="/posts/campanhas-afirmativas-gaming" class="hero-b-proof-item">
          <span class="hero-b-proof-val">{t('hero.proof2Val')}</span>
          <span class="hero-b-proof-lbl">{t('hero.proof2Lbl')}</span>
        </a>
        <a href="/posts/campanhas-afirmativas-gaming" class="hero-b-proof-item">
          <span class="hero-b-proof-val">{t('hero.proof3Val')}</span>
          <span class="hero-b-proof-lbl">{t('hero.proof3Lbl')}</span>
        </a>
        <a href="/posts/campanhas-afirmativas-gaming" class="hero-b-proof-item">
          <span class="hero-b-proof-val">{t('hero.proof4Val')}</span>
          <span class="hero-b-proof-lbl">{t('hero.proof4Lbl')}</span>
        </a>
        <a href="/posts/campanhas-afirmativas-gaming" class="hero-b-proof-item">
          <span class="hero-b-proof-val">{t('hero.proof5Val')}</span>
          <span class="hero-b-proof-lbl">{t('hero.proof5Lbl')}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════ FEATURED STUDY ════════════════════════════════ -->
  <!-- Pulled out of the hero so the headline owns the viewport.
       This card is the most recent original study — readers land, see
       the claim, then immediately encounter the proof. -->
  <section id="featured-study">
    <div class="section-glow lilac" data-parallax="0.12" style="top:-40px;left:20%;width:480px;height:360px"></div>
    <div class="section-glow blue" data-parallax="-0.1" style="bottom:-60px;right:-40px;width:520px;height:380px"></div>
    <div class="container">
      <div class="featured-study-header fi">
        <span class="label" style="display:inline-flex;align-items:center;gap:10px">
          <span style="width:22px;height:1px;background:var(--grad);display:block"></span>
          {t('featured.eyebrow')}
        </span>
        <h2 class="featured-study-title">{t('featured.titleLead')} <span class="gradient-text">{t('featured.titleAccent')}</span></h2>
      </div>

      <div class="hero-card-wrap fi d1 tilt">
        <div class="hero-card glass-panel tilt-inner">
          <div class="hc-header">
            <div style="display:flex;align-items:center;gap:14px">
              <img src="/d.lab-icon.webp" alt="" class="hc-icon" width="28" height="28" />
              <div>
                <div class="hc-title">{t('featured.cardTitle')}</div>
                <div class="hc-sub">{t('featured.cardSub')}</div>
              </div>
            </div>
            <span class="hc-catalogid">D.LAB #001</span>
          </div>

          <div class="hc-body">
            <div class="hc-body-left">
              <div class="hc-metrics">
                <div class="hc-m"><div class="hc-m-val">87.8%</div><div class="hc-m-lbl">{t('featured.metricPerceived')}</div></div>
                <div class="hc-m"><div class="hc-m-val">16.3%</div><div class="hc-m-lbl">{t('featured.metricTrust')}</div></div>
                <div class="hc-m"><div class="hc-m-val">3.48×</div><div class="hc-m-lbl">{t('featured.metricSwitch')}</div></div>
              </div>

              <div class="hc-verdict">
                <div class="hc-verdict-text"><strong>{t('featured.verdictLead')}</strong> {t('featured.verdictText')}</div>
              </div>
            </div>

            <div class="hc-body-right">
              <div class="hc-bars">
                <div class="hc-bars-label">{t('featured.chartLabel')}</div>
                <div class="hc-bar-row">
                  <div class="hc-bar-meta"><span class="hc-bar-name">{t('featured.barMinority')}</span><span class="hc-bar-pct">73%</span></div>
                  <div class="hc-bar-track"><div class="hc-bar-fill hero-bar" data-v="73"></div></div>
                </div>
                <div class="hc-bar-row">
                  <div class="hc-bar-meta"><span class="hc-bar-name">{t('featured.barNonMinority')}</span><span class="hc-bar-pct">44%</span></div>
                  <div class="hc-bar-track"><div class="hc-bar-fill hero-bar" data-v="44"></div></div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <a href="/posts/campanhas-afirmativas-gaming" class="featured-study-link">
          {t('featured.readFull')}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════ DIAGNOSTIC PROMO ══════════════════════════════ -->
  <!-- Prominent promo for the /diagnostic interactive tool. Sits
       between the featured study and the brand statement so readers
       land on the tool right after seeing what we publish. -->
  <section id="diagnostic-promo" class="diag-promo-section">
    <div class="section-glow lilac" data-parallax="0.1" style="top:20%;left:-100px;width:460px;height:340px"></div>
    <div class="section-glow blue" data-parallax="-0.08" style="bottom:-40px;right:-60px;width:520px;height:360px"></div>
    <div class="container">
      <a class="diag-promo-card fi" href="/diagnostico" aria-label={t('diagnostic.homePromoCta')}>
        <div class="diag-promo-copy">
          <div class="diag-promo-eyebrow">
            <span class="diag-promo-pulse"></span>
            {t('diagnostic.homeEyebrow')}
          </div>
          <h2 class="diag-promo-title">
            {t('diagnostic.homePromoTitle')}<br /><span class="gradient-text">{t('diagnostic.homePromoAccent')}</span>
          </h2>
          <p class="diag-promo-sub">{t('diagnostic.homePromoSub')}</p>
          <div class="diag-promo-stats">
            <div class="diag-promo-stat">
              <div class="diag-promo-stat-val">{t('diagnostic.homePromoStat1Val')}</div>
              <div class="diag-promo-stat-lbl">{t('diagnostic.homePromoStat1Label')}</div>
            </div>
            <div class="diag-promo-stat">
              <div class="diag-promo-stat-val">{t('diagnostic.homePromoStat2Val')}</div>
              <div class="diag-promo-stat-lbl">{t('diagnostic.homePromoStat2Label')}</div>
            </div>
            <div class="diag-promo-stat">
              <div class="diag-promo-stat-val">{t('diagnostic.homePromoStat3Val')}</div>
              <div class="diag-promo-stat-lbl">{t('diagnostic.homePromoStat3Label')}</div>
            </div>
          </div>
          <span class="diag-promo-cta">
            {t('diagnostic.homePromoCta')}
          </span>
        </div>

        <!-- Tiny decorative cube preview on the right — echoes the
             hero cube so visitors recognize the tool as D.Lab-built. -->
        <div class="diag-promo-visual" aria-hidden="true">
          <div class="diag-promo-cube">
            <div class="diag-promo-cube-face diag-promo-cube-front">
              <div class="diag-promo-cube-eyebrow">Quality</div>
              <div class="diag-promo-cube-num">47%</div>
              <div class="diag-promo-cube-bar">
                <div class="diag-promo-cube-bar-baseline"></div>
                <div class="diag-promo-cube-bar-fill"></div>
              </div>
              <div class="diag-promo-cube-lbl">vs. 37% baseline</div>
            </div>
          </div>
          <div class="diag-promo-sparkles">
            <span class="diag-promo-sparkle s1"></span>
            <span class="diag-promo-sparkle s2"></span>
            <span class="diag-promo-sparkle s3"></span>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- ═══════════════ BRAND STATEMENT ═══════════════════════════════ -->
  <section id="brand-statement">
    <div class="brand-wave-bg">
      <svg viewBox="0 0 1200 400" preserveAspectRatio="none">
        <path class="brand-wave-line" d="M0,200 Q150,140 300,200 T600,200 T900,200 T1200,200" stroke="rgba(255,255,255,0.25)" stroke-width="1">
          <animate attributeName="d" dur="8s" repeatCount="indefinite" values="M0,200 Q150,140 300,200 T600,200 T900,200 T1200,200;M0,200 Q150,260 300,200 T600,200 T900,200 T1200,200;M0,200 Q150,140 300,200 T600,200 T900,200 T1200,200"/>
        </path>
        <path class="brand-wave-line" d="M0,200 Q200,160 400,200 T800,200 T1200,200" stroke="rgba(255,255,255,0.18)" stroke-width="0.8">
          <animate attributeName="d" dur="10s" repeatCount="indefinite" values="M0,200 Q200,160 400,200 T800,200 T1200,200;M0,200 Q200,240 400,200 T800,200 T1200,200;M0,200 Q200,160 400,200 T800,200 T1200,200"/>
        </path>
        <path class="brand-wave-line" d="M0,200 Q300,180 600,200 T1200,200" stroke="rgba(255,255,255,0.1)" stroke-width="0.6">
          <animate attributeName="d" dur="12s" repeatCount="indefinite" values="M0,200 Q300,180 600,200 T1200,200;M0,200 Q300,220 600,200 T1200,200;M0,200 Q300,180 600,200 T1200,200"/>
        </path>
      </svg>
    </div>
    <div class="container">
      <div class="brand-grid">
        <div class="brand-text fi">
          <h2 class="brand-title">
            {t('brand.title')} <span class="gradient-text">{t('brand.titleAccent')}</span>
          </h2>
          <p class="brand-desc">{t('brand.desc')}</p>
        </div>

        <!-- Globe visualization: 6 labeled satellites orbiting a
             wireframe Earth, signaling where our research lands in
             the world. Outer rotation walks the points around the
             globe; inner counter-rotation keeps each label upright. -->
        <div class="brand-visual fi d1 tilt">
          <div class="tilt-inner">
            <Visual variant="attack" alt="Radar monocromático varrendo uma superfície de ataque" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ TRUST BAR ═════════════════════════════════════ -->
  <div id="logos">
    <div class="container">
      <p class="logos-lbl label">{t('trust.title')}</p>
      <div class="trust-row">
        <div class="trust-item">
          <div class="trust-val">{t('trust.ndaVal')}</div>
          <div class="trust-lbl">{t('trust.ndaLbl')}</div>
        </div>
        <div class="trust-item">
          <div class="trust-val">{t('trust.seniorVal')}</div>
          <div class="trust-lbl">{t('trust.seniorLbl')}</div>
        </div>
        <div class="trust-item">
          <div class="trust-val">{t('trust.dualVal')}</div>
          <div class="trust-lbl">{t('trust.dualLbl')}</div>
        </div>
        <div class="trust-item">
          <div class="trust-val">{t('trust.methodVal')}</div>
          <div class="trust-lbl">{t('trust.methodLbl')}</div>
        </div>
        <div class="trust-item">
          <div class="trust-val">{t('trust.openVal')}</div>
          <div class="trust-lbl">{t('trust.openLbl')}</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══════════════ LATEST PUBLICATIONS (Research Hub flagship) ═══════ -->
  <div class="section-sep"></div>
  <section id="research" class="section">
    <div class="section-glow violet" data-parallax="0.08" style="top:-60px;right:-100px;width:400px;height:400px;background:radial-gradient(ellipse,rgba(255,255,255,.05) 0%,transparent 70%);filter:blur(60px);position:absolute;pointer-events:none;border-radius:50%"></div>
    <div class="section-glow blue" data-parallax="0.08" style="bottom:0;left:-80px"></div>
    <div class="container">
      <div class="research-head fi">
        <div class="section-label" style="justify-content:center"><span class="label">{t('research.eyebrow')}</span></div>
        <h2 class="section-title">{t('research.title')}<br><span class="gradient-text">{t('research.titleAccent')}</span></h2>
        <p class="section-sub" style="margin:0 auto">{t('research.sub')}</p>
      </div>

      <div class="research-grid fi">
        {posts.map((post, i) => {
          const isOriginal = post.data.researchType === 'original';
          const cat = post.data.category.toLowerCase();
          const extraTag = post.data.tags.find((tag: string) => tag.toLowerCase() !== cat);
          return (
          <a href={`/posts/${post.slug}`} class={`research-card fi d${i + 1}`} style="position:relative">
            <div class="research-card-img" style="padding:0;background:#000000">
              {post.data.cover && (
                <img src={post.data.cover} alt={post.data.coverAlt ?? ''} loading="lazy" width="800" height="450" style="width:100%;height:100%;object-fit:cover;position:relative;z-index:1" />
              )}
            </div>
            <div class="research-card-body">
              <div class="research-card-tags">
                {isOriginal && <span class="research-card-tag original">{t('blog.originalMarker')}</span>}
                <span class="research-card-tag">{post.data.category}</span>
                {!isOriginal && extraTag && (
                  <span class="research-card-tag blue">{extraTag}</span>
                )}
              </div>
              <h3 class="research-card-title">{post.data.title}</h3>
              <p class="research-card-excerpt">{post.data.description}</p>
              <div class="research-card-format-row">
                <span class={`research-card-format format-${post.data.format}`}>
                  <span class="format-dot"></span>{formatLabelMap[post.data.format]}
                </span>
                {post.data.readingTime && (
                  <>
                    <span class="blog-card-dot"></span>
                    <span class="research-card-time">{post.data.readingTime}</span>
                  </>
                )}
              </div>
              <div class="research-card-footer">
                <span class="research-card-date">{post.data.pubDate.toLocaleDateString('pt-BR', { year: 'numeric', month: 'long' })}</span>
                <span class="research-card-read">{t('research.readCta')} <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              </div>
            </div>
          </a>
          );
        })}
      </div>

      <div class="research-cta fi">
        <a href="/blog" class="btn btn-ghost">{t('research.cta')}</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════ FRENTES EM IMAGEM (3 tiles) ═══════════════════ -->
  <div class="section-sep"></div>
  <section id="themes" class="section">
    <div class="container">
      <div class="themes-head fi">
        <div class="section-label" style="justify-content:center"><span class="label">Frentes de pesquisa</span></div>
        <h2 class="section-title">Onde a inteligência<br><span class="gradient-text">encontra a decisão.</span></h2>
      </div>
      <div class="themes-grid fi d1">
        <figure class="theme-tile">
          <Visual variant="market" alt="Barras ascendentes com linha de tendência, inteligência competitiva" />
          <figcaption class="theme-tile-cap">Inteligência competitiva</figcaption>
        </figure>
        <figure class="theme-tile">
          <Visual variant="audience" alt="Ondas concêntricas e nuvem de pontos, comportamento de audiência" />
          <figcaption class="theme-tile-cap">Comportamento &amp; audiência</figcaption>
        </figure>
        <figure class="theme-tile">
          <Visual variant="lab" alt="Órbitas de pesquisa em torno de um núcleo" />
          <figcaption class="theme-tile-cap">Data &amp; engenharia de dados</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ═══════════════ RESEARCH AGENDA ════════════════════════════════ -->
  <div class="section-sep"></div>
  <section id="segments" class="section">
    <div class="section-glow lilac" data-parallax="0.09" style="top:-100px;right:-150px"></div>
    <div class="section-glow blue" data-parallax="-0.07" style="bottom:-80px;left:-100px"></div>
    <div class="container">
      <div class="seg-head fi">
        <div class="section-label" style="justify-content:center"><span class="label">{t('segments.eyebrow')}</span></div>
        <h2 class="section-title">{t('segments.title')}<br><span class="gradient-text">{t('segments.titleAccent')}</span></h2>
        <p class="section-sub" style="margin:0 auto">{t('segments.sub')}</p>
      </div>
      <div class="seg-grid">
        <div class="seg-card fi d1">
          <div class="icon-wrap" style="margin-bottom:20px">
            <svg viewBox="0 0 22 22" fill="none"><circle cx="11" cy="11" r="8" stroke="url(#g1)" stroke-width="1.5"/><circle cx="11" cy="11" r="3" stroke="url(#g1)" stroke-width="1.5"/><path d="M11 3v3M11 16v3M3 11h3M16 11h3" stroke="url(#g1)" stroke-width="1.3" stroke-linecap="round"/></svg>
          </div>
          <div class="seg-tag">{t('segments.marketTag')}</div>
          <div class="seg-name">{t('segments.marketName')}</div>
          <p class="seg-desc">{t('segments.marketDesc')}</p>
          <div class="seg-samples">
            <span class="seg-sample">{t('segments.marketSample1')}</span>
            <span class="seg-sample">{t('segments.marketSample2')}</span>
            <span class="seg-sample">{t('segments.marketSample3')}</span>
          </div>
        </div>

        <div class="seg-card blue fi d2">
          <div class="icon-wrap blue" style="margin-bottom:20px">
            <svg viewBox="0 0 22 22" fill="none"><rect x="3" y="3" width="7" height="7" rx="2" stroke="url(#g2)" stroke-width="1.5"/><rect x="12" y="3" width="7" height="7" rx="2" stroke="url(#g2)" stroke-width="1.5"/><rect x="3" y="12" width="7" height="7" rx="2" stroke="url(#g2)" stroke-width="1.5"/><path d="M15.5 12v7M12 15.5h7" stroke="url(#g2)" stroke-width="1.5" stroke-linecap="round"/></svg>
          </div>
          <div class="seg-tag">{t('segments.stratTag')}</div>
          <div class="seg-name">{t('segments.stratName')}</div>
          <p class="seg-desc">{t('segments.stratDesc')}</p>
          <div class="seg-samples">
            <span class="seg-sample">{t('segments.stratSample1')}</span>
            <span class="seg-sample">{t('segments.stratSample2')}</span>
            <span class="seg-sample">{t('segments.stratSample3')}</span>
          </div>
        </div>

        <div class="seg-card yellow fi d3">
          <div class="icon-wrap yellow" style="margin-bottom:20px">
            <svg viewBox="0 0 22 22" fill="none"><path d="M11 3l8 8-8 8-8-8 8-8z" stroke="url(#g-yellow)" stroke-width="1.5" stroke-linejoin="round"/><circle cx="11" cy="11" r="3.8" stroke="url(#g-yellow)" stroke-width="1.5"/></svg>
          </div>
          <div class="seg-tag">{t('segments.politicsTag')}</div>
          <div class="seg-name">{t('segments.politicsName')}</div>
          <p class="seg-desc">{t('segments.politicsDesc')}</p>
          <div class="seg-samples">
            <span class="seg-sample">{t('segments.politicsSample1')}</span>
            <span class="seg-sample">{t('segments.politicsSample2')}</span>
            <span class="seg-sample">{t('segments.politicsSample3')}</span>
          </div>
        </div>

        <div class="seg-card violet fi d2">
          <div class="icon-wrap violet" style="margin-bottom:20px">
            <svg viewBox="0 0 22 22" fill="none"><polyline points="3,15 7,9 11,12 15,6 19,8" stroke="url(#g-violet)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/><circle cx="19" cy="8" r="2" fill="url(#g-violet)" opacity=".7"/></svg>
          </div>
          <div class="seg-tag">{t('segments.foresightTag')}</div>
          <div class="seg-name">{t('segments.foresightName')}</div>
          <p class="seg-desc">{t('segments.foresightDesc')}</p>
          <div class="seg-samples">
            <span class="seg-sample">{t('segments.foresightSample1')}</span>
            <span class="seg-sample">{t('segments.foresightSample2')}</span>
            <span class="seg-sample">{t('segments.foresightSample3')}</span>
          </div>
        </div>

        <div class="seg-card green fi d3">
          <div class="icon-wrap green" style="margin-bottom:20px">
            <svg viewBox="0 0 22 22" fill="none"><path d="M3 18l4-4 4 3 4-6 4-4" stroke="url(#g-green)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="3" cy="18" r="1.5" fill="url(#g-green)"/><circle cx="19" cy="7" r="1.5" fill="url(#g-green)"/></svg>
          </div>
