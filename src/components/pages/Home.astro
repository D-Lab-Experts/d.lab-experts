          <div class="icon-wrap green"><svg viewBox="0 0 22 22" fill="none"><path d="M4 12l5 5L18 6" stroke="url(#g-green)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          <div class="step-title">{t('how.step4Title')}</div>
          <p class="step-desc">{t('how.step4Desc')}</p>
        </div>
      </div>

      <!-- Data sources absorbed into the methodology section as a
           compact pill strip: what we cross-reference is part of how
           we research, not a separate product tour. -->
      <div class="methodology-sources fi d1">
        <div class="methodology-sources-label">{t('how.sourcesLabel')}</div>
        <div class="methodology-sources-pills">
