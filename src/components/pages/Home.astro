          <div class="section-label"><span class="label">{t('solucoesTeaser.eyebrow')}</span></div>
          <h2 class="section-title">{t('solucoesTeaser.title')} <span class="gradient-text">{t('solucoesTeaser.titleAccent')}</span></h2>
