---
import Layout from '../../layouts/Layout.astro';
import Visual from '../Visual.astro';
import MediaSlot from '../MediaSlot.astro';
import { useTranslations, getLocaleFromUrl, localize } from '../../i18n/utils';
import { serviceAreas as ptAreas } from '../../i18n/pt';
import { serviceAreas as enAreas } from '../../i18n/en';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const href = (path: string) => localize(path, locale);

// Nós da constelação de serviços: rótulos localizados (do dicionário do
// locale ativo) + estilo do "planeta" por nó. A ordem/cores são fixas; o
// texto vem de serviceAreas pra não vazar PT na home em inglês.
const areaLabels = Object.fromEntries(
  (locale === 'en' ? enAreas : ptAreas).map((a) => [a.slug, a.label]),
) as Record<string, string>;
const constelNodes = [
  { slug: 'atendimento', style: '--i:0; --pb:#8B5CF6; --pd:#4C1D95; --pa:rgba(221,210,255,0.55); --pg:rgba(167,139,250,0.55)' },
  { slug: 'comercial', style: '--i:1; --pb:#6366F1; --pd:#312E81; --pa:rgba(199,210,254,0.55); --pg:rgba(129,140,248,0.5)' },
  { slug: 'operacoes', style: '--i:2; --pb:#2DD4BF; --pd:#0F5F58; --pa:rgba(204,251,241,0.5); --pg:rgba(45,212,191,0.45)' },
  { slug: 'financeiro', style: '--i:3; --pb:#E0A75E; --pd:#7C4310; --pa:rgba(254,238,205,0.55); --pg:rgba(240,180,110,0.42)' },
  { slug: 'dados', style: '--i:4; --pb:#E879A8; --pd:#8B1F53; --pa:rgba(255,224,238,0.5); --pg:rgba(232,121,168,0.42)' },
];
---

<Layout
  title={t('pageTitles.home')}
  description={t('pageTitles.homeDescription')}
  active="home"
  locale={locale}
>
  <!-- Wrapper do site escuro futurista (acento lilás). Os tokens dark
       vêm do :root; .band-dark aprofunda bandas específicas (CTA). -->
  <div class="home-dark">
  <!-- ═══════════════ HERO ══════════════════════════════════════════
       Redesign monocromático Apple/Resend: composição editorial à
       esquerda, headline em Inter peso leve, grid fino + glow branco no
       topo, faixa de dados full-bleed com hairlines. Estilo escopado
       abaixo (.hero-b-*). Alto contraste por preto×branco, sem cor. -->
  <section id="hero" class="hero-b">
    <canvas class="hero-b-particles" aria-hidden="true"></canvas>
    <div class="hero-b-ghost" aria-hidden="true">D.LAB</div>
    <div class="hero-b-grid" aria-hidden="true"></div>
    <div class="hero-b-glow" data-parallax="0.18" aria-hidden="true"></div>

    <!-- Figura futurista (lado direito). Arquivo fornecido depois; se
         ausente, esconde sem ícone quebrado e fica só o glow + wordmark. -->
    <div class="hero-b-figure" aria-hidden="true">
      <div class="hero-b-figure-glow"></div>
      <img src="/herohat.png" alt="" class="hero-b-figure-img" width="900" height="1200" loading="eager" onerror="this.style.display='none'" />
    </div>

    <!-- MEDIA SLOT: loop de fundo do herói. Descomente o <video> e
         aponte o src; o overlay garante legibilidade do texto por cima.
         Pausa/oculta sob prefers-reduced-motion (ver CSS). -->
    <div class="hero-b-media" aria-hidden="true">
      <!--
      <video class="hero-b-media-video" autoplay muted loop playsinline preload="none" poster="/media/hero-poster.jpg">
        <source src="/media/hero-loop.webm" type="video/webm" />
        <source src="/media/hero-loop.mp4" type="video/mp4" />
      </video>
      -->
      <div class="hero-b-media-overlay"></div>
    </div>

    <div class="hero-b-wrap">
      <div class="hero-b-brandrow fi">
        <img src="/d.lab-logo.png" class="hero-b-logo" alt="D.Lab" width="1082" height="240" />
        <span class="hero-b-sep" aria-hidden="true"></span>
        <span class="hero-b-eyebrow">{t('hero.eyebrow')}</span>
      </div>

      <h1 class="hero-b-headline fi d1">
        {t('hero.taglineLine1')}<br />
        <span class="ink">{t('hero.taglineAccentWord')}</span> {t('hero.taglineLine3')}
      </h1>

      <p class="hero-b-sub fi d2">{t('hero.sub')}</p>

      <div class="hero-b-ctas fi d3">
        <a href={href('/contato')} class="hero-b-btn hero-b-btn-solid">{t('hero.ctaPrimary')}</a>
        <a href={href('/#como-funciona')} class="hero-b-btn hero-b-btn-ghost">{t('hero.ctaSecondary')}</a>
      </div>
    </div>

  </section>

  <!-- ═══════════════ PARA QUEM É (âncora de público) ════════════════
       Faixa fina logo abaixo do herói: fixa o público (médias empresas
       e scaleups) antes da prova, pra o visitante certo se reconhecer. -->
  <section id="para-quem" class="pq-band">
    <div class="container">
      <div class="pq-inner fi">
        <span class="pq-label">{t('paraQuem.label')}</span>
        <p class="pq-text">{t('paraQuem.text')}</p>
        <div class="pq-chips">
          <span class="pq-chip">{t('paraQuem.chip1')}</span>
          <span class="pq-chip">{t('paraQuem.chip2')}</span>
          <span class="pq-chip">{t('paraQuem.chip3')}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ CASOS DE USO ══════════════════════════════════
       Onde a IA dá resultado, em linguagem de PME. Cada card:
       problema → o que a IA faz → resultado. As métricas são REFERÊNCIAS
       DE MERCADO rotuladas — não são resultados de clientes do D.Lab. -->
  <section id="casos" class="casos-section section">
    <div class="section-glow lilac" data-parallax="0.08" style="top:-40px;left:-80px"></div>
    <div class="container">
      <div class="casos-head fi">
        <div class="section-label" style="justify-content:center"><span class="label">{t('casos.eyebrow')}</span></div>
        <h2 class="section-title">{t('casos.title')}<br><span class="gradient-text">{t('casos.titleAccent')}</span></h2>
        <p class="section-sub" style="margin:18px auto 0">{t('casos.sub')}</p>
      </div>

      <div class="casos-grid fi d1">
        <article class="caso-card sweep">
          <div class="caso-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 5h16v10H8l-4 4V5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M8 9h8M8 12h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></div>
          <span class="caso-tag">{t('casos.c1Tag')}</span>
          <h3 class="caso-title">{t('casos.c1Title')}</h3>
          <p class="caso-prob"><span class="caso-prob-lbl">Problema</span> {t('casos.c1Problem')}</p>
          <p class="caso-does">{t('casos.c1Does')}</p>
          <div class="caso-metric"><span class="caso-metric-val">{t('casos.c1Metric')}</span><span class="caso-metric-note">{t('casos.c1MetricNote')}</span></div>
        </article>

        <article class="caso-card sweep">
          <div class="caso-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M3 17l5-5 4 3 6-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M14 8h5v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          <span class="caso-tag">{t('casos.c2Tag')}</span>
          <h3 class="caso-title">{t('casos.c2Title')}</h3>
          <p class="caso-prob"><span class="caso-prob-lbl">Problema</span> {t('casos.c2Problem')}</p>
          <p class="caso-does">{t('casos.c2Does')}</p>
          <div class="caso-metric"><span class="caso-metric-val">{t('casos.c2Metric')}</span><span class="caso-metric-note">{t('casos.c2MetricNote')}</span></div>
        </article>

        <article class="caso-card sweep">
          <div class="caso-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="12" cy="12" r="3.2" stroke="currentColor" stroke-width="1.5"/></svg></div>
          <span class="caso-tag">{t('casos.c3Tag')}</span>
          <h3 class="caso-title">{t('casos.c3Title')}</h3>
          <p class="caso-prob"><span class="caso-prob-lbl">Problema</span> {t('casos.c3Problem')}</p>
          <p class="caso-does">{t('casos.c3Does')}</p>
          <div class="caso-metric"><span class="caso-metric-val">{t('casos.c3Metric')}</span><span class="caso-metric-note">{t('casos.c3MetricNote')}</span></div>
        </article>

        <article class="caso-card sweep">
          <div class="caso-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M7 3h7l4 4v14H7z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M14 3v4h4M10 13h5M10 16h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          <span class="caso-tag">{t('casos.c4Tag')}</span>
          <h3 class="caso-title">{t('casos.c4Title')}</h3>
          <p class="caso-prob"><span class="caso-prob-lbl">Problema</span> {t('casos.c4Problem')}</p>
          <p class="caso-does">{t('casos.c4Does')}</p>
          <div class="caso-metric"><span class="caso-metric-val">{t('casos.c4Metric')}</span><span class="caso-metric-note">{t('casos.c4MetricNote')}</span></div>
        </article>

        <article class="caso-card sweep">
          <div class="caso-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><rect x="4" y="13" width="3.5" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="10.2" y="8" width="3.5" height="12" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="16.5" y="4" width="3.5" height="16" rx="1" stroke="currentColor" stroke-width="1.5"/></svg></div>
          <span class="caso-tag">{t('casos.c5Tag')}</span>
          <h3 class="caso-title">{t('casos.c5Title')}</h3>
          <p class="caso-prob"><span class="caso-prob-lbl">Problema</span> {t('casos.c5Problem')}</p>
          <p class="caso-does">{t('casos.c5Does')}</p>
          <div class="caso-metric"><span class="caso-metric-val">{t('casos.c5Metric')}</span><span class="caso-metric-note">{t('casos.c5MetricNote')}</span></div>
        </article>

        <a href={href('/solucoes')} class="caso-card caso-card-cta sweep">
          <span class="caso-cta-text">{t('casos.cta')}</span>
        </a>
      </div>

      <p class="casos-disclaimer fi">{t('casos.metricNote')}</p>
    </div>
  </section>

  <!-- (Removido) FEATURED STUDY — pesquisa vive só no Blog agora. -->

  <!-- ═══════════════ DIAGNOSTIC PROMO (faixa fina) ══════════════════
       Rebaixado de card grande para uma faixa horizontal fina (pill),
       logo abaixo do estudo. Peso visual leve, contraste com o card de
       prova acima — resolve os "dois retângulos gigantes" e funciona
       como lead-magnet de baixo atrito. -->
  <section id="diagnostic-promo" class="diag-strip-section">
    <div class="container">
      <a class="diag-strip fi" href={href('/diagnostico')} aria-label={t('diagnostic.homePromoCta')}>
        <span class="diag-strip-pulse" aria-hidden="true"></span>
        <span class="diag-strip-main">
          <span class="diag-strip-eyebrow">{t('diagnostic.homeEyebrow')}</span>
          <span class="diag-strip-title">{t('diagnostic.homePromoTitle')} <strong>{t('diagnostic.homePromoAccent')}</strong></span>
        </span>
        <span class="diag-strip-stats" aria-hidden="true">
          <span class="diag-strip-stat"><b>{t('diagnostic.homePromoStat1Val')}</b> {t('diagnostic.homePromoStat1Label')}</span>
          <span class="diag-strip-dot"></span>
          <span class="diag-strip-stat"><b>{t('diagnostic.homePromoStat2Val')}</b> {t('diagnostic.homePromoStat2Label')}</span>
          <span class="diag-strip-dot"></span>
          <span class="diag-strip-stat"><b>{t('diagnostic.homePromoStat3Val')}</b> {t('diagnostic.homePromoStat3Label')}</span>
        </span>
        <span class="diag-strip-cta">{t('diagnostic.homePromoCta')}</span>
      </a>
    </div>
  </section>

  <!-- ═══════════════ IA EM AÇÃO (visual moderno / agente) ════════════
       Console de agente animado (CSS puro, ilustrativo). Sinaliza que o
       D.Lab é nativo digital e constrói agentes de verdade — "mostra"
       antes de o "Como funciona" explicar. -->
  <section id="ai-demo" class="aid-section section">
    <div class="section-glow blue" data-parallax="0.08" style="top:0;right:-120px"></div>
    <div class="container">
      <div class="aid-grid fi">
        <div class="aid-copy">
          <div class="section-label"><span class="label">{t('aiDemo.label')}</span></div>
          <h2 class="aid-title">{t('aiDemo.title')} <span class="gradient-text">{t('aiDemo.titleAccent')}</span></h2>
          <p class="aid-caption">{t('aiDemo.caption')}</p>
        </div>

        <!-- MEDIA SLOT: o console animado abaixo é o placeholder; pode ser
             trocado por um screencast estilizado do agente rodando
             (<video> com poster), mantendo o mesmo enquadramento. -->
        <div class="aid-console" aria-hidden="true">
          <div class="aid-console-bar">
            <span class="aid-tdot r"></span><span class="aid-tdot y"></span><span class="aid-tdot g"></span>
            <span class="aid-console-name">{t('aiDemo.chrome')}</span>
            <span class="aid-live"><span class="aid-live-dot"></span>{t('aiDemo.live')}</span>
          </div>
          <div class="aid-console-body">
            <div class="aid-line aid-l1"><span class="aid-prompt">›</span> {t('aiDemo.l1')}</div>
            <div class="aid-line aid-l2"><span class="aid-spin">◓</span> {t('aiDemo.l2')}</div>
            <div class="aid-line aid-l3"><span class="aid-spin">◓</span> {t('aiDemo.l3')}</div>
            <div class="aid-line aid-l4"><span class="aid-tool">→</span> {t('aiDemo.l4')}</div>
            <div class="aid-line aid-l5"><span class="aid-check">✓</span> {t('aiDemo.l5')}<span class="aid-cursor"></span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ COMO FUNCIONA (jornada p/ médias empresas) ══════
       Seção de mercado, amigável: traduz a escada de IA em três passos
       sem jargão, com entregável por passo e uma faixa "por que é seguro
       começar" que derruba o medo de projeto de IA caro/complexo. -->
  <section id="como-funciona" class="cf-section section">
    <div class="section-glow lilac" data-parallax="0.08" style="top:-40px;left:-100px"></div>
    <div class="section-glow blue" data-parallax="-0.07" style="bottom:-60px;right:-100px"></div>
    <div class="container">
      <div class="cf-head fi">
        <div class="section-label" style="justify-content:center"><span class="label">{t('comoFunciona.eyebrow')}</span></div>
        <h2 class="section-title">{t('comoFunciona.title')}<br><span class="gradient-text">{t('comoFunciona.titleAccent')}</span></h2>
        <p class="section-sub" style="margin:18px auto 0">{t('comoFunciona.sub')}</p>
      </div>

      <div class="cf-steps fi d1">
        <div class="cf-step">
          <!-- MEDIA SLOT: mini-clipe do passo 1 (diagnóstico). -->
          <MediaSlot img="/diagnosis.png" label={t('comoFunciona.mediaDiagnosis')} ratio="16 / 9" class="cf-step-media" />
          <div class="cf-step-num">1</div>
          <div class="cf-step-tag">{t('comoFunciona.step1Tag')}</div>
          <h3 class="cf-step-title">{t('comoFunciona.step1Title')}</h3>
          <p class="cf-step-desc">{t('comoFunciona.step1Desc')}</p>
          <div class="cf-step-deliver">{t('comoFunciona.step1Deliver')}</div>
        </div>
        <div class="cf-arrow" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M4 11h13M13 6l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div class="cf-step cf-step-core">
          <!-- MEDIA SLOT: mini-clipe do passo 2 (implementação). -->
          <MediaSlot img="/implementation.png" label={t('comoFunciona.mediaImplementation')} ratio="16 / 9" class="cf-step-media" />
          <div class="cf-step-num">2</div>
          <div class="cf-step-tag">{t('comoFunciona.step2Tag')}</div>
          <h3 class="cf-step-title">{t('comoFunciona.step2Title')}</h3>
          <p class="cf-step-desc">{t('comoFunciona.step2Desc')}</p>
          <div class="cf-step-deliver">{t('comoFunciona.step2Deliver')}</div>
        </div>
        <div class="cf-arrow" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M4 11h13M13 6l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div class="cf-step">
          <!-- MEDIA SLOT: mini-clipe do passo 3 (medição/acompanhamento). -->
          <MediaSlot img="/mesurement.png" label={t('comoFunciona.mediaMeasurement')} ratio="16 / 9" class="cf-step-media" />
          <div class="cf-step-num">3</div>
          <div class="cf-step-tag">{t('comoFunciona.step3Tag')}</div>
          <h3 class="cf-step-title">{t('comoFunciona.step3Title')}</h3>
          <p class="cf-step-desc">{t('comoFunciona.step3Desc')}</p>
          <div class="cf-step-deliver">{t('comoFunciona.step3Deliver')}</div>
        </div>
      </div>

      <div class="cf-reassure fi d2">
        <div class="cf-reassure-label">{t('comoFunciona.reassureLabel')}</div>
        <ul class="cf-reassure-list">
          <li>{t('comoFunciona.reassure1')}</li>
          <li>{t('comoFunciona.reassure2')}</li>
          <li>{t('comoFunciona.reassure3')}</li>
          <li>{t('comoFunciona.reassure4')}</li>
        </ul>
      </div>

      <div class="cf-cta fi d2">
        <a href={href('/contato')} class="btn btn-primary">{t('comoFunciona.cta')}</a>
        <span class="cf-cta-note">{t('comoFunciona.ctaNote')}</span>
      </div>
    </div>
  </section>

  <!-- (Removido) BRAND STATEMENT — posicionamento de pesquisa saiu. -->

  <!-- ═══════════════ TRUST BAR ═════════════════════════════════════ -->
  <div id="logos">
    <div class="container">
      <p class="logos-lbl label">{t('trust.title')}</p>
      <div class="trust-row">
        <div class="trust-item">
          <div class="trust-val">{t('trust.ndaVal')}</div>
          <div class="trust-lbl">{t('trust.ndaLbl')}</div>
        </div>
        <div class="trust-item">
          <div class="trust-val">{t('trust.seniorVal')}</div>
          <div class="trust-lbl">{t('trust.seniorLbl')}</div>
        </div>
        <div class="trust-item">
          <div class="trust-val">{t('trust.dualVal')}</div>
          <div class="trust-lbl">{t('trust.dualLbl')}</div>
        </div>
        <div class="trust-item">
          <div class="trust-val">{t('trust.methodVal')}</div>
          <div class="trust-lbl">{t('trust.methodLbl')}</div>
        </div>
        <div class="trust-item">
          <div class="trust-val">{t('trust.openVal')}</div>
          <div class="trust-lbl">{t('trust.openLbl')}</div>
        </div>
      </div>
    </div>
  </div>

  <!-- (Removido) PUBLICAÇÕES — pesquisa vive só no Blog agora. -->

  <!-- (Removido) FRENTES DE PESQUISA — research fora da home. -->

  {/* REMOVIDO da home — pesquisa/research, metodologia aberta, demo de
      relatório, colaboração e a antiga "escada de consultoria" saíram do
      escopo de implementação de IA. Conteúdo de pesquisa vive só no Blog.
      Bloco mantido comentado para referência; pode ser apagado numa
      limpeza futura.
  <section id="segments" class="section">
    <div class="section-glow lilac" data-parallax="0.09" style="top:-100px;right:-150px"></div>
    <div class="section-glow blue" data-parallax="-0.07" style="bottom:-80px;left:-100px"></div>
    <div class="container">
      <div class="seg-head fi">
        <div class="section-label" style="justify-content:center"><span class="label">{t('segments.eyebrow')}</span></div>
        <h2 class="section-title">{t('segments.title')}<br><span class="gradient-text">{t('segments.titleAccent')}</span></h2>
        <p class="section-sub" style="margin:0 auto">{t('segments.sub')}</p>
      </div>
      <div class="seg-grid">
        <div class="seg-card fi d1">
          <div class="icon-wrap" style="margin-bottom:20px">
            <svg viewBox="0 0 22 22" fill="none"><circle cx="11" cy="11" r="8" stroke="url(#g1)" stroke-width="1.5"/><circle cx="11" cy="11" r="3" stroke="url(#g1)" stroke-width="1.5"/><path d="M11 3v3M11 16v3M3 11h3M16 11h3" stroke="url(#g1)" stroke-width="1.3" stroke-linecap="round"/></svg>
          </div>
          <div class="seg-tag">{t('segments.marketTag')}</div>
          <div class="seg-name">{t('segments.marketName')}</div>
          <p class="seg-desc">{t('segments.marketDesc')}</p>
          <div class="seg-samples">
            <span class="seg-sample">{t('segments.marketSample1')}</span>
            <span class="seg-sample">{t('segments.marketSample2')}</span>
            <span class="seg-sample">{t('segments.marketSample3')}</span>
          </div>
        </div>

        <div class="seg-card blue fi d2">
          <div class="icon-wrap blue" style="margin-bottom:20px">
