        </div>
        <div class="step">
          <div class="step-num">02</div>
          <div class="icon-wrap blue"><svg viewBox="0 0 22 22" fill="none"><circle cx="11" cy="11" r="7" stroke="url(#g2)" stroke-width="1.5"/><path d="M11 7v4l3 2" stroke="url(#g2)" stroke-width="1.5" stroke-linecap="round"/></svg></div>
          <div class="step-title">{t('how.step2Title')}</div>
          <p class="step-desc">{t('how.step2Desc')}</p>
          <div class="step-connector"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M5 10h10M12 7l3 3-3 3" stroke="rgba(255,255,255,0.3)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        </div>
        <div class="step">
          <div class="step-num">03</div>
          <div class="icon-wrap cyan"><svg viewBox="0 0 22 22" fill="none"><rect x="3" y="13" width="3" height="6" rx="1" fill="url(#g-green)" opacity=".7"/><rect x="8" y="9" width="3" height="10" rx="1" fill="url(#g-green)"/><rect x="13" y="5" width="3" height="14" rx="1" fill="url(#g-green)"/><rect x="18" y="3" width="3" height="16" rx="1" fill="url(#g1)"/></svg></div>
          <div class="step-title">{t('how.step3Title')}</div>
          <p class="step-desc">{t('how.step3Desc')}</p>
          <div class="step-connector"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M5 10h10M12 7l3 3-3 3" stroke="rgba(255,255,255,0.3)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        </div>
        <div class="step">
          <div class="step-num">04</div>
          <div class="icon-wrap green"><svg viewBox="0 0 22 22" fill="none"><path d="M4 12l5 5L18 6" stroke="url(#g-green)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          <div class="step-title">{t('how.step4Title')}</div>
          <p class="step-desc">{t('how.step4Desc')}</p>
        </div>
      </div>

      <!-- Data sources absorbed into the methodology section as a
           compact pill strip: what we cross-reference is part of how
           we research, not a separate product tour. -->
      <div class="methodology-sources fi d1">
        <div class="methodology-sources-label">{t('how.sourcesLabel')}</div>
