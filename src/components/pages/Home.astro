<style>
  /* ── HERO B · Resend Minimal (monocromático, alto contraste) ───────
     Composição editorial à esquerda, headline Inter peso leve, grid
     fino + glow branco no topo, faixa de dados full-bleed com hairlines.
     Reveals herdam do sistema global .fi (disparado pelo Layout no
     #hero). Ênfase por escala e contraste, nunca por cor. */
  .hero-b {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* respiro extra no topo p/ a brandrow não encostar no menu fixo */
    padding: 200px 0 40px;
    overflow: hidden;
    z-index: 1;
  }
  .hero-b-brandrow { margin-top: 8px; }
  .hero-b-grid {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background-image:
      linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse 80% 60% at 25% 30%, #000 10%, transparent 72%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 25% 30%, #000 10%, transparent 72%);
  }
  /* Glow lilás radial sutil no topo do herói (baixa intensidade, não
     cansa a vista). Acompanha o scroll via data-parallax. */
  .hero-b-glow {
    position: absolute; z-index: 0; pointer-events: none;
    top: -360px; left: 8%;
    width: 760px; height: 760px;
    background: radial-gradient(circle at center,
      rgba(167,139,250,0.16) 0%, rgba(139,92,246,0.06) 40%, transparent 70%);
    filter: blur(34px);
  }

  .hero-b-wrap {
    position: relative; z-index: 2;
    width: 100%; max-width: 1180px;
    margin: 0 auto; padding: 0 40px;
    flex: 1;
    display: flex; flex-direction: column;
    /* safe center: centraliza quando há espaço, mas alinha ao topo
       quando o conteúdo é alto, sem comer o respiro do topo (e sem
       encostar no menu). Degrada para topo em browsers sem `safe`. */
    justify-content: safe center;
  }

  .hero-b-brandrow {
    display: inline-flex; align-items: center; gap: 16px;
    margin-bottom: 40px;
  }
  .hero-b-logo { display: block; height: 20px; width: auto; object-fit: contain; }
  .hero-b-sep { width: 1px; height: 13px; background: var(--line-strong); }
  .hero-b-eyebrow {
    font-size: 11.5px; font-weight: 500;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--accent);
  }

  .hero-b-headline {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(40px, 6vw, 84px);
    line-height: 1.04;
    letter-spacing: -0.035em;
    max-width: 15ch;
    text-wrap: balance;
    margin-bottom: 34px;
    /* Frase inteira off-white (alto contraste); o punch de cor vem de
       UMA palavra-chave em lilás (.ink), não de uma linha apagada. */
    color: var(--ink);
  }
  .hero-b-headline .dim { color: var(--ink); font-weight: 600; }
  .hero-b-headline .ink { color: var(--accent); font-weight: 700; }

  .hero-b-sub {
    font-size: 18px; font-weight: 400; line-height: 1.7;
    color: var(--ink-dim);
    max-width: 540px;
    margin-bottom: 40px;
    text-wrap: pretty;
  }

  .hero-b-ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-b-btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 14px 28px; border-radius: 100px;
    font-size: 15px; font-weight: 600; font-family: var(--font-sans);
    cursor: pointer; transition: transform .2s ease, background .2s ease, border-color .2s ease, box-shadow .2s ease;
  }
  .hero-b-btn-solid { background: var(--accent); color: var(--accent-ink); border: 1px solid var(--accent); box-shadow: 0 8px 24px rgba(124,58,237,0.28); }
  .hero-b-btn-solid:hover { transform: translateY(-2px); background: var(--accent-strong); border-color: var(--accent-strong); box-shadow: 0 12px 34px rgba(124,58,237,0.38); }
  .hero-b-btn-ghost { background: var(--glass-bg); color: var(--text); border: 1px solid var(--glass-border); backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur); box-shadow: var(--glass-hl); }
  .hero-b-btn-ghost:hover { border-color: var(--glass-border-h); color: var(--accent-soft); transform: translateY(-2px); }

  .hero-b-proof {
    position: relative; z-index: 2;
    width: 100%;
    margin-top: 56px;
    border-top: 1px solid var(--line);
    background: rgba(255,255,255,0.015);
  }
  .hero-b-proof-label {
    padding: 14px 28px 0;
    font-size: 10.5px; font-weight: 700;
    letter-spacing: .14em; text-transform: uppercase;
    color: var(--accent);
  }
  .hero-b-proof-inner {
    display: grid; grid-template-columns: repeat(5, 1fr);
  }
  .hero-b-proof-item {
    display: flex; flex-direction: column; gap: 9px;
    padding: 24px 28px;
    border-right: 1px solid var(--line);
    color: inherit; text-decoration: none;
    transition: background .2s ease;
  }
  .hero-b-proof-item:last-child { border-right: none; }
  .hero-b-proof-item:hover { background: rgba(255,255,255,0.03); }
  .hero-b-proof-val {
    font-size: clamp(19px, 1.9vw, 25px);
    font-weight: 300; letter-spacing: -0.02em;
    color: var(--ink); font-feature-settings: 'tnum' 1;
  }
  .hero-b-proof-lbl { font-size: 11.5px; line-height: 1.5; color: var(--text-muted); font-weight: 400; }
  /* Placeholder (item 6): deixa explícito que prova de IA entra depois,
     pra ninguém confundir os números de pesquisa com resultado de IA. */
  .hero-b-proof-note {
    padding: 14px 28px 18px;
    font-size: 12px; line-height: 1.55; color: var(--text-dim);
    border-top: 1px dashed var(--line);
  }

  @media (max-width: 1000px) {
    .hero-b-proof-inner { grid-template-columns: repeat(3, 1fr); }
    .hero-b-proof-item:nth-child(3) { border-right: none; }
    .hero-b-proof-item:nth-child(n+4) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 620px) {
    .hero-b { padding: 140px 0 24px; }
    .hero-b-wrap { padding: 0 24px; }
    .hero-b-headline { max-width: none; }
    .hero-b-proof-inner { grid-template-columns: repeat(2, 1fr); }
    .hero-b-proof-item:nth-child(3) { border-right: 1px solid var(--line); }
    .hero-b-proof-item:nth-child(2n) { border-right: none; }
    .hero-b-proof-item:nth-child(n+3) { border-top: 1px solid var(--line); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-b-btn:hover { transform: none; }
  }

  /* glifos ruidosos do decode (gimmick) lêem como "decodificando" */
  .hero-b-headline .scramble-glyph { opacity: .82; }

  /* ═══════════ HERÓI · tema claro (claro-led + roxo) ═══════════════ */
  /* Wordmark fantasma gigante atrás do herói (profundidade tipográfica). */
  .hero-b-ghost {
    position: absolute; z-index: 0; pointer-events: none; user-select: none;
    left: 50%; top: 46%; transform: translate(-50%, -50%);
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(180px, 34vw, 500px); letter-spacing: -0.04em;
    line-height: 1; white-space: nowrap;
    /* wordmark fantasma mais presente (impacto da versão clara). */
    color: rgba(167,139,250,0.11);
    text-shadow: 0 0 70px rgba(167,139,250,0.14);
  }
  /* Logo é branco (asset mono) → inverte pra ficar escuro sobre claro. */
  .home-light .hero-b-logo { filter: brightness(0) saturate(100%); opacity: .9; }
  /* Grade sutil escura + glow roxo no lugar dos brancos invisíveis. */
  .home-light .hero-b-grid {
    background-image:
      linear-gradient(rgba(0,0,0,0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,0,0,0.035) 1px, transparent 1px);
  }
  .home-light .hero-b-glow {
    background: radial-gradient(circle at center,
      rgba(124,58,237,0.18) 0%, rgba(167,139,250,0.10) 40%, transparent 70%);
  }
  /* Sem véu escuro sobre o herói claro (a mídia, quando houver, é painel). */
  .home-light .hero-b-media-overlay { background: none; }
  .home-light .hero-b-proof { background: rgba(124,58,237,0.03); }

  /* Partículas (canvas leve, desenhadas via JS). Atrás de tudo. */
  .hero-b-particles { position: absolute; inset: 0; z-index: 0; pointer-events: none; opacity: .9; }

  /* Figura futurista no lado direito, com glow roxo e float suave. */
  .hero-b-figure {
    position: absolute; z-index: 1; pointer-events: none;
    right: max(0px, calc((100% - 1180px) / 2));
    bottom: 90px; width: min(46vw, 560px); height: auto;
    display: flex; align-items: flex-end; justify-content: center;
  }
  .hero-b-figure-glow {
    position: absolute; inset: -8% -6% 6% -6%; z-index: 0;
    background: radial-gradient(closest-side, rgba(124,58,237,0.30), rgba(167,139,250,0.12) 55%, transparent 75%);
    filter: blur(18px);
  }
  .hero-b-figure-img {
    position: relative; z-index: 1;
    width: 100%; height: auto; max-height: 82vh; object-fit: contain;
    filter: drop-shadow(0 30px 60px rgba(12,12,17,0.28));
    animation: heroFloat 7s ease-in-out infinite;
