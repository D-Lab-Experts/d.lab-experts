            <span class="solt-note">{t('solucoesTeaser.note')}</span>
          </div>
        </div>
        <!-- Constelação de Serviços: núcleo de IA pulsante + 5 serviços
             orbitando, linhas com fluxo de luz, profundidade 3D e partículas
             ao fundo. Movimento por um único loop rAF, pausa fora da
             viewport e estático sob prefers-reduced-motion. Hover destaca
             nó + linha; parallax sutil seguindo o cursor. -->
        <div class="solt-art">
          <!-- Cada nó é um link pra página da frente (/solucoes/<slug>),
               que explica como o D.Lab ajuda naquela área. As partes
               puramente decorativas ficam aria-hidden; os nós, não. -->
          <div class="constel">
            <div class="constel-glow" aria-hidden="true"></div>
            <canvas class="constel-particles" aria-hidden="true"></canvas>
            <div class="constel-stage" data-stage>
              <svg class="constel-links" data-links preserveAspectRatio="none" aria-hidden="true"></svg>
              <div class="constel-core" aria-hidden="true">
                <span class="constel-core-orb"></span>
                <span class="constel-core-ping"></span>
                <span class="constel-core-ping d"></span>
              </div>
              {constelNodes.map((n) => (
                <a class="constel-node" data-node href={href(`/solucoes/${n.slug}`)} aria-label={areaLabels[n.slug]} style={n.style}><span class="constel-dot"></span><span class="constel-label">{areaLabels[n.slug]}</span></a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

