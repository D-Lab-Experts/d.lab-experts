      <div class="research-head fi">
        <div class="section-label" style="justify-content:center"><span class="label">{t('research.eyebrow')}</span></div>
        <h2 class="section-title">{t('research.title')}<br><span class="gradient-text">{t('research.titleAccent')}</span></h2>
        <p class="section-sub" style="margin:0 auto">{t('research.sub')}</p>
      </div>

      <div class="research-grid fi">
        {posts.map((post) => {
          const isOriginal = post.data.researchType === 'original';
          const cat = post.data.category.toLowerCase();
          const extraTag = post.data.tags.find((tag: string) => tag.toLowerCase() !== cat);
          return (
          <a href={`/posts/${post.slug}`} class="research-card fi d1" style="position:relative">
            <div class="research-card-img" style="padding:0;background:#0B0B0F">
              {post.data.cover && (
                <img src={post.data.cover} alt={post.data.coverAlt ?? ''} loading="lazy" width="800" height="450" style="width:100%;height:100%;object-fit:cover;position:relative;z-index:1" />
              )}
            </div>
            <div class="research-card-body">
              <div class="research-card-tags">
                {isOriginal && <span class="research-card-tag original">{t('blog.originalMarker')}</span>}
                <span class="research-card-tag">{post.data.category}</span>
                {!isOriginal && extraTag && (
                  <span class="research-card-tag blue">{extraTag}</span>
                )}
              </div>
              <h3 class="research-card-title">{post.data.title}</h3>
              <p class="research-card-excerpt">{post.data.description}</p>
              <div class="research-card-format-row">
                <span class={`research-card-format format-${post.data.format}`}>
                  <span class="format-dot"></span>{formatLabelMap[post.data.format]}
                </span>
                {post.data.readingTime && (
                  <>
                    <span class="blog-card-dot"></span>
                    <span class="research-card-time">{post.data.readingTime}</span>
                  </>
                )}
              </div>
              <div class="research-card-footer">
                <span class="research-card-date">{post.data.pubDate.toLocaleDateString('pt-BR', { year: 'numeric', month: 'long' })}</span>
                <span class="research-card-read">{t('research.readCta')} <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              </div>
            </div>
          </a>
          );
        })}
      </div>

      <div class="research-cta fi">
        <a href="/blog" class="btn btn-ghost">{t('research.cta')}</a>
      </div>
    </div>
  </section>

