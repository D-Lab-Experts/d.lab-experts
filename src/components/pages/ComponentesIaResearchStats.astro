---
import Layout from '../../layouts/Layout.astro';
import NeuralNetwork from '../NeuralNetwork.astro';
import { useTranslations, getLocaleFromUrl, localize } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const href = (path: string) => localize(path, locale);

const principles = [
  { title: 'principle1Title', body: 'principle1Body' },
  { title: 'principle2Title', body: 'principle2Body' },
  { title: 'principle3Title', body: 'principle3Body' },
  { title: 'principle4Title', body: 'principle4Body' },
  { title: 'principle5Title', body: 'principle5Body' },
  { title: 'principle6Title', body: 'principle6Body' },
] as const;

const insideFiles = [
  { name: 'inside1Name', desc: 'inside1Desc' },
  { name: 'inside2Name', desc: 'inside2Desc' },
  { name: 'inside3Name', desc: 'inside3Desc' },
  { name: 'inside4Name', desc: 'inside4Desc' },
] as const;

const cases = ['case1', 'case2', 'case3', 'case4', 'case5', 'case6'] as const;
---

<Layout
  title={t('pageTitles.componentesIaResearchStats')}
  description={t('pageTitles.componentesIaResearchStatsDescription')}
  active="solucoes"
  locale={locale}
>
  <!-- ═══════════════ HERO ═════════════════════════════════════ -->
  <section class="rs-hero">
    <div class="section-glow lilac" style="top:-40px;left:50%;transform:translateX(-50%)"></div>
    <div class="section-glow blue" data-parallax="0.08" style="bottom:-20px;right:-60px"></div>
    <NeuralNetwork color="white" density="low" opacity={0.12} />
    <div class="container">
      <div class="rs-hero-inner fi">
        <a class="rs-breadcrumb" href={href('/componentes-ia')}>{t('componentesIaResearchStats.breadcrumbBack')}</a>

        <div class="rs-eyebrow">
          <span style="width:22px;height:1px;background:var(--grad);display:block"></span>
          {t('componentesIaResearchStats.heroEyebrow')}
        </div>

        <h1 class="rs-title">{t('componentesIaResearchStats.heroTitle')}</h1>
        <p class="rs-subtitle">{t('componentesIaResearchStats.heroSubtitle')}</p>

        <div class="rs-hero-meta">
          <span class="rs-meta-pill rs-meta-live">
            <span class="rs-meta-dot"></span>
            {t('componentesIaResearchStats.heroStatusLive')}
          </span>
          <span class="rs-meta-pill">{t('componentesIaResearchStats.heroVersion')}</span>
          <span class="rs-meta-pill">{t('componentesIaResearchStats.heroSize')}</span>
          <span class="rs-meta-pill">{t('componentesIaResearchStats.heroLicense')}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ DOWNLOAD CARD ═══════════════════════════ -->
  <section class="rs-download-section">
    <div class="container">
      <div class="rs-download fi">
        <div class="rs-download-copy">
          <span class="rs-download-label">{t('componentesIaResearchStats.downloadLabel')}</span>
          <h2 class="rs-download-title">{t('componentesIaResearchStats.downloadTitle')}</h2>
          <p class="rs-download-desc">{t('componentesIaResearchStats.downloadDesc')}</p>
          <a
            class="rs-download-btn"
            href="/skills/research-statistics-engine.skill"
            download="research-statistics-engine.skill"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {t('componentesIaResearchStats.downloadButton')}
          </a>
          <p class="rs-download-hint">{t('componentesIaResearchStats.downloadHint')}</p>
        </div>
        <div class="rs-download-visual" aria-hidden="true">
          <svg viewBox="0 0 120 120" fill="none" width="120" height="120">
            <defs>
              <linearGradient id="rs-g-pkg" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#EAEAF0"/>
                <stop offset="100%" stop-color="#EAEAF0"/>
              </linearGradient>
            </defs>
            <rect x="22" y="34" width="76" height="64" rx="8" stroke="url(#rs-g-pkg)" stroke-width="1.6" fill="rgba(234,234,240,0.06)"/>
            <path d="M22 50h76" stroke="url(#rs-g-pkg)" stroke-width="1.4" opacity="0.5"/>
            <rect x="48" y="22" width="24" height="20" rx="4" stroke="url(#rs-g-pkg)" stroke-width="1.6" fill="rgba(22,22,32,0.7)"/>
            <path d="M60 60v22m0 0l-7-7m7 7l7-7" stroke="url(#rs-g-pkg)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ WHAT IT DOES ═══════════════════════════ -->
  <section class="rs-section">
    <div class="container">
      <div class="rs-block fi">
        <span class="rs-block-label">{t('componentesIaResearchStats.whatLabel')}</span>
        <h2 class="rs-block-title">{t('componentesIaResearchStats.whatTitle')}</h2>
        <p class="rs-block-body">{t('componentesIaResearchStats.whatBody')}</p>
      </div>
    </div>
  </section>

  <!-- ═══════════════ TWO MODES ══════════════════════════════ -->
  <section class="rs-section">
    <div class="container">
      <div class="rs-modes fi">
        <span class="rs-block-label">{t('componentesIaResearchStats.modesLabel')}</span>
        <div class="rs-modes-grid">
          <article class="rs-mode rs-mode-a">
            <div class="rs-mode-head">
              <span class="rs-mode-letter">A</span>
              <h3>{t('componentesIaResearchStats.modeATitle')}</h3>
            </div>
            <p>{t('componentesIaResearchStats.modeABody')}</p>
          </article>
          <article class="rs-mode rs-mode-b">
            <div class="rs-mode-head">
              <span class="rs-mode-letter">B</span>
              <h3>{t('componentesIaResearchStats.modeBTitle')}</h3>
            </div>
            <p>{t('componentesIaResearchStats.modeBBody')}</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ PRINCIPLES ═════════════════════════════ -->
  <section class="rs-section">
    <div class="container">
      <div class="rs-block fi">
        <span class="rs-block-label">{t('componentesIaResearchStats.principlesLabel')}</span>
        <p class="rs-block-intro">{t('componentesIaResearchStats.principlesIntro')}</p>
        <div class="rs-principles">
          {principles.map(p => (
            <div class="rs-principle">
              <h4>{t(`componentesIaResearchStats.${p.title}` as any)}</h4>
              <p>{t(`componentesIaResearchStats.${p.body}` as any)}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ INSIDE ═════════════════════════════════ -->
  <section class="rs-section">
    <div class="container">
      <div class="rs-block fi">
        <span class="rs-block-label">{t('componentesIaResearchStats.insideLabel')}</span>
        <ul class="rs-inside">
          {insideFiles.map(f => (
            <li class="rs-inside-item">
              <code>{t(`componentesIaResearchStats.${f.name}` as any)}</code>
              <span>{t(`componentesIaResearchStats.${f.desc}` as any)}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══════════════ INSTALL ════════════════════════════════ -->
  <section class="rs-section">
    <div class="container">
      <div class="rs-block fi">
        <span class="rs-block-label">{t('componentesIaResearchStats.installLabel')}</span>
        <ol class="rs-steps">
          <li class="rs-step">
            <span class="rs-step-num">1</span>
            <div>
              <h4>{t('componentesIaResearchStats.installStep1Title')}</h4>
              <p>{t('componentesIaResearchStats.installStep1Body')}</p>
            </div>
          </li>
          <li class="rs-step">
            <span class="rs-step-num">2</span>
            <div>
              <h4>{t('componentesIaResearchStats.installStep2Title')}</h4>
              <p>{t('componentesIaResearchStats.installStep2Body')}</p>
            </div>
          </li>
          <li class="rs-step">
            <span class="rs-step-num">3</span>
            <div>
              <h4>{t('componentesIaResearchStats.installStep3Title')}</h4>
              <p>{t('componentesIaResearchStats.installStep3Body')}</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ═══════════════ USE CASES ══════════════════════════════ -->
  <section class="rs-section">
    <div class="container">
      <div class="rs-block fi">
        <span class="rs-block-label">{t('componentesIaResearchStats.casesLabel')}</span>
        <ul class="rs-cases">
          {cases.map(c => (
            <li>{t(`componentesIaResearchStats.${c}` as any)}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══════════════ CTA ════════════════════════════════════ -->
  <section class="rs-cta">
    <div class="section-glow lilac" style="top:50%;left:50%;transform:translate(-50%,-50%)"></div>
    <div class="container fi">
      <h2>{t('componentesIaResearchStats.ctaTitle')}</h2>
      <p>{t('componentesIaResearchStats.ctaSub')}</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a href={href('/colaborar')} class="btn btn-primary">{t('componentesIaResearchStats.ctaPrimary')}</a>
        <a href={href('/componentes-ia')} class="btn btn-ghost">{t('componentesIaResearchStats.ctaSecondary')}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ═════════ HERO ═════════════════════════════════════════ */
  .rs-hero {
    padding: 130px 0 40px;
    position: relative;
    overflow: hidden;
    z-index: 1;
  }
  .rs-hero-inner {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 2;
  }
  .rs-breadcrumb {
    display: inline-block;
    margin-bottom: 22px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .rs-breadcrumb:hover { color: var(--lilac); }
  .rs-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lilac);
    margin-bottom: 22px;
  }
  .rs-title {
    font-size: clamp(34px, 4.8vw, 56px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: 18px;
    text-wrap: balance;
  }
  .rs-subtitle {
    font-size: 17px;
    color: var(--muted);
    line-height: 1.6;
    max-width: 680px;
    margin: 0 auto 24px;
    text-wrap: pretty;
  }
  .rs-hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }
  .rs-meta-pill {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 100px;
    border: 1px solid rgba(234,234,240, 0.18);
    background: rgba(234,234,240, 0.05);
    color: var(--muted);
  }
  .rs-meta-live {
    color: var(--green);
    border-color: rgba(234,234,240, 0.28);
    background: rgba(234,234,240, 0.08);
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .rs-meta-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 8px rgba(234,234,240, 0.7);
    animation: rsPulse 2.2s ease-in-out infinite;
  }
  @keyframes rsPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.55; transform: scale(1.3); }
  }

  /* ═════════ DOWNLOAD CARD ═════════════════════════════════ */
  .rs-download-section {
    padding: 30px 0 40px;
    position: relative;
    z-index: 1;
  }
  .rs-download {
    max-width: 980px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 36px;
    align-items: center;
    padding: 36px 40px;
    background: linear-gradient(135deg, rgba(234,234,240, 0.1), rgba(234,234,240, 0.05) 70%, transparent);
    border: 1px solid rgba(234,234,240, 0.32);
    border-radius: 20px;
    position: relative;
    overflow: hidden;
  }
  .rs-download::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 50% at 20% 30%, rgba(234,234,240, 0.16), transparent 70%);
    pointer-events: none;
  }
  .rs-download-copy { position: relative; z-index: 1; }
  .rs-download-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--lilac);
  }
  .rs-download-title {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--white);
    margin: 8px 0 10px;
  }
  .rs-download-desc {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.7;
    margin: 0 0 20px;
    max-width: 580px;
  }
  .rs-download-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    border-radius: 100px;
    background: var(--grad-btn);
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.3), 0 0 32px rgba(234,234,240, 0.32);
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .rs-download-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4), 0 0 40px rgba(234,234,240, 0.45);
  }
  .rs-download-hint {
    font-size: 12px;
    color: var(--muted);
    margin: 14px 0 0;
    letter-spacing: 0.02em;
  }
  .rs-download-visual {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
  }
  @media (max-width: 760px) {
    .rs-download {
      grid-template-columns: 1fr;
      padding: 28px 26px;
      gap: 20px;
    }
    .rs-download-visual { display: none; }
  }

  /* ═════════ SHARED BLOCKS ═══════════════════════════════ */
  .rs-section {
    padding: 30px 0;
    position: relative;
    z-index: 1;
  }
  .rs-block {
    max-width: 880px;
    margin: 0 auto;
  }
  .rs-block-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--lilac);
  }
  .rs-block-title {
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--white);
    line-height: 1.2;
    margin: 10px 0 14px;
    text-wrap: balance;
  }
  .rs-block-body {
    font-size: 15px;
    line-height: 1.75;
    color: var(--muted);
    margin: 0;
    max-width: 760px;
  }
  .rs-block-intro {
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted);
    margin: 12px 0 24px;
    max-width: 720px;
  }

  /* ═════════ MODES ═══════════════════════════════════════ */
  .rs-modes { max-width: 1020px; margin: 0 auto; }
  .rs-modes-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 14px;
  }
  .rs-mode {
    padding: 28px 28px 26px;
    background: linear-gradient(165deg, rgba(26, 26, 40, 0.85), rgba(22, 22, 32, 0.65));
    border: 1px solid var(--border);
    border-radius: 18px;
  }
  .rs-mode-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
  }
  .rs-mode-letter {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 17px;
    letter-spacing: -0.02em;
  }
  .rs-mode-a .rs-mode-letter {
    color: var(--lilac);
    background: rgba(234,234,240, 0.12);
    border: 1px solid rgba(234,234,240, 0.28);
  }
  .rs-mode-b .rs-mode-letter {
    color: var(--green);
    background: rgba(234,234,240, 0.1);
    border: 1px solid rgba(234,234,240, 0.28);
  }
  .rs-mode h3 {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--white);
    margin: 0;
  }
  .rs-mode p {
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
    margin: 0;
  }
  @media (max-width: 760px) {
    .rs-modes-grid { grid-template-columns: 1fr; }
  }

  /* ═════════ PRINCIPLES ═════════════════════════════════ */
  .rs-principles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin-top: 8px;
  }
  .rs-principle {
    padding: 22px 24px;
    background: rgba(22, 22, 32, 0.6);
    border: 1px solid var(--border);
    border-radius: 14px;
    transition: border-color 0.25s, background 0.25s;
  }
  .rs-principle:hover {
    border-color: rgba(234,234,240, 0.32);
    background: rgba(26, 26, 40, 0.75);
  }
  .rs-principle h4 {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--white);
    margin: 0 0 8px;
  }
  .rs-principle p {
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--muted);
    margin: 0;
  }
  @media (max-width: 760px) {
    .rs-principles { grid-template-columns: 1fr; }
  }

  /* ═════════ INSIDE ═════════════════════════════════════ */
  .rs-inside {
    list-style: none;
    padding: 0;
    margin: 10px 0 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .rs-inside-item {
    display: grid;
    grid-template-columns: 230px 1fr;
    gap: 22px;
    padding: 16px 22px;
    background: rgba(22, 22, 32, 0.55);
    border: 1px solid var(--border);
    border-radius: 12px;
    align-items: center;
  }
  .rs-inside-item code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px;
    color: var(--lilac);
    background: rgba(234,234,240, 0.08);
    border: 1px solid rgba(234,234,240, 0.18);
    padding: 5px 12px;
    border-radius: 8px;
    width: fit-content;
    letter-spacing: 0;
  }
  .rs-inside-item span {
    font-size: 13.5px;
    color: var(--muted);
    line-height: 1.65;
  }
  @media (max-width: 760px) {
    .rs-inside-item { grid-template-columns: 1fr; gap: 8px; }
  }

  /* ═════════ INSTALL STEPS ═════════════════════════════ */
  .rs-steps {
    list-style: none;
    padding: 0;
    margin: 14px 0 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    counter-reset: rsstep;
  }
  .rs-step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 18px;
    align-items: start;
    padding: 18px 22px;
    background: rgba(22, 22, 32, 0.6);
    border: 1px solid var(--border);
    border-radius: 14px;
  }
  .rs-step-num {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(234,234,240, 0.12);
    border: 1px solid rgba(234,234,240, 0.28);
    color: var(--lilac);
    font-weight: 700;
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .rs-step h4 {
    font-size: 15px;
    font-weight: 700;
    color: var(--white);
    margin: 0 0 4px;
    letter-spacing: -0.005em;
  }
  .rs-step p {
    font-size: 13.5px;
    color: var(--muted);
    line-height: 1.65;
    margin: 0;
  }

  /* ═════════ USE CASES ═════════════════════════════════ */
  .rs-cases {
    list-style: none;
    padding: 0;
    margin: 14px 0 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .rs-cases li {
    position: relative;
    padding: 14px 18px 14px 36px;
    background: rgba(22, 22, 32, 0.55);
    border: 1px solid var(--border);
    border-radius: 12px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
  }
  .rs-cases li::before {
    content: '';
    position: absolute;
    top: 22px;
    left: 16px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lilac);
    box-shadow: 0 0 8px rgba(234,234,240, 0.4);
  }

  /* ═════════ CTA ═══════════════════════════════════════ */
  .rs-cta {
    padding: 70px 0 110px;
    text-align: center;
    position: relative;
    z-index: 1;
    overflow: hidden;
  }
  .rs-cta h2 {
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 14px;
    text-wrap: balance;
  }
  .rs-cta p {
    font-size: 15px;
    color: var(--muted);
    max-width: 540px;
    margin: 0 auto 24px;
    line-height: 1.7;
  }

  @media (max-width: 640px) {
    .rs-hero { padding: 110px 0 32px; }
    .rs-title { font-size: 30px; }
  }
