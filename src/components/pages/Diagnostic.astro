---
import Layout from '../../layouts/Layout.astro';
import NeuralNetwork from '../NeuralNetwork.astro';
import { defaultLocale, type Locale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const localePrefix = locale === defaultLocale ? '' : `/${locale}`;
const href = (path: string) => `${localePrefix}${path}`;

// Decision size tiers. Midpoint is what the model multiplies by, so the
// result is a single representative figure per tier instead of a free
// input (reduces fake precision).
const q1Values = [50_000, 500_000, 5_000_000, 30_000_000];
// Post slug for the "Deciding in the Dark" link per locale.
const decidingSlug = locale === 'pt' ? 'decisao-no-escuro' : 'deciding-in-the-dark';

// The EN and PT routes have different slugs so the language switcher
// and hreflang alternates must use explicit URLs.
const alternateUrls = {
  en: '/diagnostic',
  pt: '/pt/diagnostico',
} as const;
---

<Layout
  title={t('pageTitles.diagnostic')}
  description={t('pageTitles.diagnosticDescription')}
  locale={locale}
  alternateUrls={alternateUrls}
>
  <!-- ═══════════════ HERO ═══════════════════════════════════════ -->
  <section class="diag-hero">
    <div class="section-glow lilac" style="top:-40px;left:50%;transform:translateX(-50%)"></div>
    <div class="section-glow blue" style="bottom:-20px;right:-60px"></div>
    <NeuralNetwork color="lilac" density="low" opacity={0.24} />
    <div class="container">
      <div class="diag-hero-inner fi">
        <div class="diag-eyebrow">
          <span style="width:22px;height:1px;background:var(--grad);display:block"></span>
          {t('diagnostic.heroEyebrow')}
        </div>
        <h1 class="diag-title">
          {t('diagnostic.heroTitleLead')} <span class="gradient-text">{t('diagnostic.heroTitleAccent')}</span>
        </h1>
        <p class="diag-sub">{t('diagnostic.heroSub')}</p>
        <div class="diag-steps">
          <span class="diag-step-pill"><span class="diag-step-dot"></span>{t('diagnostic.heroStep1')}</span>
          <span class="diag-step-pill"><span class="diag-step-dot"></span>{t('diagnostic.heroStep2')}</span>
          <span class="diag-step-pill"><span class="diag-step-dot"></span>{t('diagnostic.heroStep3')}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ FORM + RESULT ══════════════════════════════ -->
  <section class="diag-workbench">
    <div class="section-glow lilac" style="top:30%;right:-80px;width:380px;height:300px"></div>
    <div class="container">
      <div class="diag-grid">
        <!-- FORM (left) -->
        <form class="diag-form fi" id="diag-form" data-locale={locale}>
          <header class="diag-form-head">
            <h2>{t('diagnostic.formTitle')}</h2>
            <p>{t('diagnostic.formSub')}</p>
          </header>

          <!-- Q1: decision size -->
          <fieldset class="diag-q">
            <legend class="diag-q-title">{t('diagnostic.q1Title')}</legend>
            <p class="diag-q-desc">{t('diagnostic.q1Desc')}</p>
            <div class="diag-opts diag-opts-grid2">
              {[
                { v: '0', label: t('diagnostic.q1Opt1') },
                { v: '1', label: t('diagnostic.q1Opt2') },
                { v: '2', label: t('diagnostic.q1Opt3') },
                { v: '3', label: t('diagnostic.q1Opt4') },
              ].map((opt) => (
                <label class="diag-opt">
                  <input type="radio" name="q1" value={opt.v} />
                  <span class="diag-opt-label">{opt.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Q2: reversibility -->
          <fieldset class="diag-q">
            <legend class="diag-q-title">{t('diagnostic.q2Title')}</legend>
            <p class="diag-q-desc">{t('diagnostic.q2Desc')}</p>
            <div class="diag-opts diag-opts-grid2">
              {[
                { v: 'two', label: t('diagnostic.q2Opt1') },
                { v: 'one', label: t('diagnostic.q2Opt2') },
              ].map((opt) => (
                <label class="diag-opt">
                  <input type="radio" name="q2" value={opt.v} />
                  <span class="diag-opt-label">{opt.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Q3: data maturity -->
          <fieldset class="diag-q">
            <legend class="diag-q-title">{t('diagnostic.q3Title')}</legend>
            <p class="diag-q-desc">{t('diagnostic.q3Desc')}</p>
            <div class="diag-opts">
              {[
                { v: 'none', label: t('diagnostic.q3Opt1') },
                { v: 'adhoc', label: t('diagnostic.q3Opt2') },
                { v: 'systematic', label: t('diagnostic.q3Opt3') },
              ].map((opt) => (
                <label class="diag-opt">
                  <input type="radio" name="q3" value={opt.v} />
                  <span class="diag-opt-label">{opt.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Q4: time pressure -->
          <fieldset class="diag-q">
            <legend class="diag-q-title">{t('diagnostic.q4Title')}</legend>
            <p class="diag-q-desc">{t('diagnostic.q4Desc')}</p>
            <div class="diag-opts">
              {[
                { v: 'urgent', label: t('diagnostic.q4Opt1') },
                { v: 'standard', label: t('diagnostic.q4Opt2') },
                { v: 'exploratory', label: t('diagnostic.q4Opt3') },
              ].map((opt) => (
                <label class="diag-opt">
                  <input type="radio" name="q4" value={opt.v} />
                  <span class="diag-opt-label">{opt.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Q5: stakeholders -->
          <fieldset class="diag-q">
            <legend class="diag-q-title">{t('diagnostic.q5Title')}</legend>
            <p class="diag-q-desc">{t('diagnostic.q5Desc')}</p>
            <div class="diag-opts">
              {[
                { v: 'solo', label: t('diagnostic.q5Opt1') },
                { v: 'small', label: t('diagnostic.q5Opt2') },
                { v: 'large', label: t('diagnostic.q5Opt3') },
              ].map((opt) => (
                <label class="diag-opt">
                  <input type="radio" name="q5" value={opt.v} />
                  <span class="diag-opt-label">{opt.label}</span>
                </label>
              ))}
            </div>
          </fieldset>
        </form>

        <!-- RESULT (right, sticky) -->
        <aside class="diag-result fi d1" id="diag-result">
          <div class="diag-result-inner">
            <header class="diag-result-head">
              <div class="label" style="display:flex;align-items:center;gap:10px;margin-bottom:12px">
                <span style="width:22px;height:1px;background:var(--grad);display:block"></span>
                {t('diagnostic.resultTitle')}
              </div>
              <div class="diag-stale-hint" id="diag-stale">{t('diagnostic.resultStaleHint')}</div>
            </header>

            <div class="diag-result-body" id="diag-body" hidden>
              <!-- Badge -->
              <div class="diag-badge" id="diag-badge">
                <span class="diag-badge-dot"></span>
                <span class="diag-badge-label"></span>
              </div>
              <p class="diag-badge-sub" id="diag-badge-sub"></p>

              <!-- Quality probability -->
              <div class="diag-metric">
                <div class="diag-metric-head">
                  <span class="diag-metric-label">{t('diagnostic.resultQualityLabel')}</span>
                </div>
                <div class="diag-metric-big" id="diag-quality-value">—</div>
                <div class="diag-metric-meta">{t('diagnostic.resultQualityVsBase')}</div>
                <div class="diag-quality-bar">
                  <div class="diag-quality-bar-baseline" title="37% baseline (McKinsey)"></div>
                  <div class="diag-quality-bar-fill" id="diag-quality-fill"></div>
                </div>
              </div>

              <!-- Exposure range -->
              <div class="diag-metric">
                <div class="diag-metric-head">
                  <span class="diag-metric-label">{t('diagnostic.resultExposureLabel')}</span>
                </div>
                <div class="diag-metric-range">
                  <span class="diag-metric-range-low" id="diag-exposure-low">—</span>
                  <span class="diag-metric-range-sep">–</span>
                  <span class="diag-metric-range-high" id="diag-exposure-high">—</span>
                </div>
                <div class="diag-metric-meta">{t('diagnostic.resultExposureHint')}</div>
              </div>

              <!-- Actions -->
              <div class="diag-actions">
                <div class="label" style="margin-bottom:10px">{t('diagnostic.actionsTitle')}</div>
                <div id="diag-actions-list"></div>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ═══════════════ METHODOLOGY ════════════════════════════════ -->
  <section class="diag-methodology">
    <div class="section-glow blue" style="top:20%;left:-100px"></div>
    <div class="container">
      <div class="diag-method-head fi">
        <div class="label" style="display:inline-flex;align-items:center;gap:10px">
          <span style="width:22px;height:1px;background:var(--grad);display:block"></span>
          {t('diagnostic.methodologyTitle')}
        </div>
        <h2 class="section-title" style="margin-top:14px">{t('diagnostic.methodologyFormulaTitle')}</h2>
        <p class="section-sub">{t('diagnostic.methodologySub')}</p>
      </div>

      <div class="diag-formula fi d1">
        <p set:html={t('diagnostic.methodologyFormulaQuality')}></p>
        <p set:html={t('diagnostic.methodologyFormulaExposure')}></p>
      </div>

      <h3 class="diag-sources-title fi">{t('diagnostic.methodologySourcesTitle')}</h3>
      <ol class="diag-sources fi d1">
        <li>{t('diagnostic.srcMcKinsey')}</li>
        <li>{t('diagnostic.srcBrynjolfsson')}</li>
        <li>{t('diagnostic.srcPMI')}</li>
        <li>{t('diagnostic.srcBezos')}</li>
        <li>{t('diagnostic.srcBain')}</li>
        <li>{t('diagnostic.srcKahneman')}</li>
        <li>{t('diagnostic.srcIBM')}</li>
      </ol>

      <div class="diag-disclaimer fi">
        <div class="diag-disclaimer-title">{t('diagnostic.disclaimerTitle')}</div>
        <p>{t('diagnostic.disclaimerBody')}</p>
      </div>
    </div>
  </section>

  <!-- ═══════════════ CTA ════════════════════════════════════════ -->
  <section class="diag-cta">
    <div class="section-glow lilac" style="top:50%;left:50%;transform:translate(-50%,-50%)"></div>
    <div class="container fi">
      <h2>{t('diagnostic.ctaFinal')}</h2>
      <p>{t('diagnostic.ctaFinalSub')}</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a href={href('/contato')} class="btn btn-primary">{t('diagnostic.ctaFinalPrimary')}</a>
        <a href={href('/blog')} class="btn btn-ghost">{t('diagnostic.ctaFinalSecondary')}</a>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{
  q1Values,
  locale,
  decidingSlug,
  urls: {
    briefing: href(`/posts/${decidingSlug}`),
    contato: href('/contato'),
    framework: href('/blog'),
    sprint: href('/colaborar'),
  },
  labels: {
    currency: locale === 'pt' ? 'R$' : 'R$',
    badgeRed: t('diagnostic.resultBadgeRed'),
    badgeYellow: t('diagnostic.resultBadgeYellow'),
    badgeGreen: t('diagnostic.resultBadgeGreen'),
    badgeRedSub: t('diagnostic.resultBadgeRedSub'),
    badgeYellowSub: t('diagnostic.resultBadgeYellowSub'),
    badgeGreenSub: t('diagnostic.resultBadgeGreenSub'),
    actionBriefingTitle: t('diagnostic.actionBriefingTitle'),
    actionBriefingDesc: t('diagnostic.actionBriefingDesc'),
    actionBriefingCta: t('diagnostic.actionBriefingCta'),
    actionResearchTitle: t('diagnostic.actionResearchTitle'),
    actionResearchDesc: t('diagnostic.actionResearchDesc'),
    actionResearchCta: t('diagnostic.actionResearchCta'),
    actionFrameworkTitle: t('diagnostic.actionFrameworkTitle'),
    actionFrameworkDesc: t('diagnostic.actionFrameworkDesc'),
    actionFrameworkCta: t('diagnostic.actionFrameworkCta'),
    actionDataTitle: t('diagnostic.actionDataTitle'),
    actionDataDesc: t('diagnostic.actionDataDesc'),
    actionDataCta: t('diagnostic.actionDataCta'),
  },
}}>
  // ══════ DIAGNOSTIC MODEL ════════════════════════════════════════
  // Every coefficient below is cited in the sources section above.
  // Keep this file in sync with the methodology copy.
  const model = {
    baseQuality: 0.37, // McKinsey 2019
    dataMaturityDelta: { none: -0.15, adhoc: 0.0, systematic: 0.12 }, // Brynjolfsson/MIT
    timePressureDelta: { urgent: -0.10, standard: 0.0, exploratory: 0.05 }, // Kahneman/PMI
    stakeholdersDelta: { solo: 0.03, small: 0.0, large: -0.06 }, // Bain "Decide & Deliver"
    qualityMin: 0.05,
    qualityMax: 0.75,
    exposureLowPct: 0.05, // PMI lower bound
    exposureHighPct: 0.25, // PMI upper bound, for high-impact decisions
    reversibilityMultiplier: { two: 1.0, one: 1.5 }, // Bezos one-way door
  };

  const form = document.getElementById('diag-form');
  const staleHint = document.getElementById('diag-stale');
  const body = document.getElementById('diag-body');
  const badge = document.getElementById('diag-badge');
  const badgeLabel = badge?.querySelector('.diag-badge-label');
  const badgeSub = document.getElementById('diag-badge-sub');
  const qualityValue = document.getElementById('diag-quality-value');
  const qualityFill = document.getElementById('diag-quality-fill');
  const exposureLow = document.getElementById('diag-exposure-low');
  const exposureHigh = document.getElementById('diag-exposure-high');
  const actionsList = document.getElementById('diag-actions-list');

  function readAnswers() {
    if (!form) return null;
    const data = new FormData(form);
    const q1 = data.get('q1');
    const q2 = data.get('q2');
    const q3 = data.get('q3');
    const q4 = data.get('q4');
    const q5 = data.get('q5');
    if (q1 === null || q2 === null || q3 === null || q4 === null || q5 === null) return null;
    return { q1: Number(q1), q2, q3, q4, q5 };
  }

  function computeQuality(a) {
    const q = model.baseQuality
      + (model.dataMaturityDelta[a.q3] ?? 0)
      + (model.timePressureDelta[a.q4] ?? 0)
      + (model.stakeholdersDelta[a.q5] ?? 0);
    return Math.max(model.qualityMin, Math.min(model.qualityMax, q));
  }

  function computeExposure(a, quality) {
    const size = q1Values[a.q1];
    const rev = model.reversibilityMultiplier[a.q2] ?? 1.0;
    const riskShare = 1 - quality;
    return {
      low: size * riskShare * model.exposureLowPct,
      high: size * riskShare * model.exposureHighPct * rev,
    };
  }

  function formatCurrency(n) {
    // Always format in BRL style since the amount tiers are in R$,
    // regardless of the visitor's locale. Use locale's grouping rules.
    const formatter = new Intl.NumberFormat(locale === 'pt' ? 'pt-BR' : 'en-US', {
      style: 'decimal',
      maximumFractionDigits: 0,
    });
    return `${labels.currency} ${formatter.format(Math.round(n))}`;
  }

  function buildActions(a, quality) {
    // Pick the 2 most relevant actions for this answer set.
    const pool = [];
    if (a.q3 === 'none') {
      pool.push({ key: 'data', title: labels.actionDataTitle, desc: labels.actionDataDesc, cta: labels.actionDataCta, url: urls.sprint });
    }
    if (a.q2 === 'one' && a.q4 === 'urgent') {
      pool.push({ key: 'framework', title: labels.actionFrameworkTitle, desc: labels.actionFrameworkDesc, cta: labels.actionFrameworkCta, url: urls.framework });
    }
    // Always include the briefing post — it's the canonical reading.
    pool.push({ key: 'briefing', title: labels.actionBriefingTitle, desc: labels.actionBriefingDesc, cta: labels.actionBriefingCta, url: urls.briefing });
    // High-risk answers → book a diagnostic.
    if (quality < 0.35 || a.q1 >= 2) {
      pool.push({ key: 'research', title: labels.actionResearchTitle, desc: labels.actionResearchDesc, cta: labels.actionResearchCta, url: urls.contato });
    }
    // Dedup by key, take top 2
    const seen = new Set();
    const picked = [];
    for (const item of pool) {
      if (seen.has(item.key)) continue;
      seen.add(item.key);
      picked.push(item);
      if (picked.length === 2) break;
    }
    return picked;
  }

  function renderActions(actions) {
    if (!actionsList) return;
    actionsList.innerHTML = '';
    actions.forEach((action) => {
      const card = document.createElement('a');
      card.href = action.url;
      card.className = 'diag-action';
      card.innerHTML = `
        <div class="diag-action-body">
          <div class="diag-action-title">${action.title}</div>
          <div class="diag-action-desc">${action.desc}</div>
        </div>
        <div class="diag-action-cta">${action.cta}</div>
      `;
      actionsList.appendChild(card);
    });
  }

  function render() {
    const a = readAnswers();
    if (!a) {
      if (body) body.hidden = true;
      if (staleHint) staleHint.hidden = false;
      return;
    }
    if (body) body.hidden = false;
    if (staleHint) staleHint.hidden = true;

    const quality = computeQuality(a);
    const exposure = computeExposure(a, quality);

    // Quality cell
    if (qualityValue) qualityValue.textContent = `${Math.round(quality * 100)}%`;
    if (qualityFill) qualityFill.style.width = `${Math.min(100, Math.max(0, quality * 100))}%`;

    // Exposure cells
    if (exposureLow) exposureLow.textContent = formatCurrency(exposure.low);
    if (exposureHigh) exposureHigh.textContent = formatCurrency(exposure.high);

    // Badge
    let badgeKey = 'green';
    if (quality < 0.35) badgeKey = 'red';
    else if (quality < 0.55) badgeKey = 'yellow';
    if (badge) {
      badge.classList.remove('diag-badge-red', 'diag-badge-yellow', 'diag-badge-green');
      badge.classList.add(`diag-badge-${badgeKey}`);
    }
    if (badgeLabel) {
      badgeLabel.textContent =
        badgeKey === 'red'    ? labels.badgeRed
      : badgeKey === 'yellow' ? labels.badgeYellow
                              : labels.badgeGreen;
    }
    if (badgeSub) {
      badgeSub.textContent =
        badgeKey === 'red'    ? labels.badgeRedSub
      : badgeKey === 'yellow' ? labels.badgeYellowSub
                              : labels.badgeGreenSub;
    }

    // Actions
    renderActions(buildActions(a, quality));
  }

  if (form) {
    form.addEventListener('change', render);
    // Initial render (shows stale hint until first answer).
    render();
  }
</script>

<style>
  /* ═══════════ HERO ═══════════════════════════════════════════ */
  .diag-hero {
    padding: 160px 0 80px;
    position: relative;
    overflow: hidden;
    z-index: 1;
  }
  .diag-hero-inner {
    text-align: center;
    max-width: 820px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }
  .diag-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--lilac);
    margin-bottom: 24px;
  }
  .diag-title {
    font-size: clamp(36px, 5.2vw, 64px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: 22px;
    text-wrap: balance;
  }
  .diag-sub {
    font-size: 17px;
    color: var(--muted);
    line-height: 1.6;
    max-width: 620px;
    margin: 0 auto 32px;
    text-wrap: pretty;
  }
  .diag-steps {
    display: inline-flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .diag-step-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 100px;
    border: 1px solid rgba(177, 140, 255, 0.22);
    background: rgba(177, 140, 255, 0.04);
    color: var(--lilac);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .diag-step-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--lilac);
    box-shadow: 0 0 8px rgba(177, 140, 255, 0.6);
  }

  /* ═══════════ WORKBENCH (form + result) ══════════════════════ */
  .diag-workbench {
    padding: 60px 0 80px;
    position: relative;
    overflow: hidden;
    z-index: 1;
  }
  .diag-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: start;
  }

  /* FORM */
  .diag-form {
    background: rgba(22, 22, 32, 0.55);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 32px 36px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .diag-form-head h2 {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 6px;
  }
  .diag-form-head p {
    font-size: 13px;
    color: var(--muted);
  }
  .diag-q {
    border: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .diag-q-title {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--white);
  }
  .diag-q-desc {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.55;
    margin-bottom: 4px;
  }
  .diag-opts {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
  }
  .diag-opts-grid2 {
    grid-template-columns: 1fr 1fr;
  }
  .diag-opt {
    position: relative;
    cursor: pointer;
    padding: 12px 16px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: rgba(22, 22, 32, 0.55);
    transition: border-color 0.2s, background 0.2s;
  }
  .diag-opt:hover {
    border-color: rgba(177, 140, 255, 0.4);
    background: rgba(177, 140, 255, 0.05);
  }
  .diag-opt input[type="radio"] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .diag-opt-label {
    font-size: 14px;
    color: var(--white);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .diag-opt-label::before {
    content: '';
    display: block;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1.5px solid rgba(177, 140, 255, 0.45);
    background: transparent;
    flex-shrink: 0;
    transition: border-color 0.2s, background 0.2s;
  }
  .diag-opt:has(input:checked) {
    border-color: rgba(177, 140, 255, 0.55);
    background: rgba(177, 140, 255, 0.08);
  }
  .diag-opt:has(input:checked) .diag-opt-label::before {
