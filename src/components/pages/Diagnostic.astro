---
import Layout from '../../layouts/Layout.astro';
import NeuralNetwork from '../NeuralNetwork.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations();

// Decision size tiers. Midpoint is what the model multiplies by, so
// the result is a single representative figure per tier instead of a
// free input (reduces fake precision).
const q1Values = [50_000, 500_000, 5_000_000, 30_000_000];
---

<Layout
  title={t('pageTitles.diagnostic')}
  description={t('pageTitles.diagnosticDescription')}
  active="diagnostic"
>
  <!-- ═══════════════ HERO ═══════════════════════════════════════ -->
  <section class="diag-hero">
    <div class="section-glow lilac" style="top:-40px;left:50%;transform:translateX(-50%)"></div>
    <div class="section-glow blue" style="bottom:-20px;right:-60px"></div>
    <NeuralNetwork color="lilac" density="low" opacity={0.24} />
    <div class="container">
      <div class="diag-hero-inner fi">
        <div class="diag-eyebrow">
          <span style="width:22px;height:1px;background:var(--grad);display:block"></span>
          {t('diagnostic.heroEyebrow')}
        </div>
        <h1 class="diag-title">
          {t('diagnostic.heroTitleLead')} <span class="gradient-text">{t('diagnostic.heroTitleAccent')}</span>
        </h1>
        <p class="diag-sub">{t('diagnostic.heroSub')}</p>
        <div class="diag-steps">
          <span class="diag-step-pill"><span class="diag-step-dot"></span>{t('diagnostic.heroStep1')}</span>
          <span class="diag-step-pill"><span class="diag-step-dot"></span>{t('diagnostic.heroStep2')}</span>
          <span class="diag-step-pill"><span class="diag-step-dot"></span>{t('diagnostic.heroStep3')}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ FORM + RESULT ══════════════════════════════ -->
  <section class="diag-workbench">
    <div class="section-glow lilac" style="top:30%;right:-80px;width:380px;height:300px"></div>
    <div class="container">
      <div class="diag-grid">
        <!-- FORM (left) -->
        <form class="diag-form fi" id="diag-form">
          <header class="diag-form-head">
            <h2>{t('diagnostic.formTitle')}</h2>
            <p>{t('diagnostic.formSub')}</p>
          </header>

          <!-- Q1: decision size -->
          <fieldset class="diag-q">
            <legend class="diag-q-title">{t('diagnostic.q1Title')}</legend>
            <p class="diag-q-desc">{t('diagnostic.q1Desc')}</p>
            <div class="diag-opts diag-opts-grid2">
              {[
                { v: '0', label: t('diagnostic.q1Opt1') },
                { v: '1', label: t('diagnostic.q1Opt2') },
                { v: '2', label: t('diagnostic.q1Opt3') },
                { v: '3', label: t('diagnostic.q1Opt4') },
              ].map((opt) => (
                <label class="diag-opt">
                  <input type="radio" name="q1" value={opt.v} />
                  <span class="diag-opt-label">{opt.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Q2: reversibility -->
          <fieldset class="diag-q">
            <legend class="diag-q-title">{t('diagnostic.q2Title')}</legend>
            <p class="diag-q-desc">{t('diagnostic.q2Desc')}</p>
            <div class="diag-opts diag-opts-grid2">
              {[
                { v: 'two', label: t('diagnostic.q2Opt1') },
                { v: 'one', label: t('diagnostic.q2Opt2') },
              ].map((opt) => (
                <label class="diag-opt">
                  <input type="radio" name="q2" value={opt.v} />
                  <span class="diag-opt-label">{opt.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Q3: data maturity -->
          <fieldset class="diag-q">
            <legend class="diag-q-title">{t('diagnostic.q3Title')}</legend>
            <p class="diag-q-desc">{t('diagnostic.q3Desc')}</p>
            <div class="diag-opts">
              {[
                { v: 'none', label: t('diagnostic.q3Opt1') },
                { v: 'adhoc', label: t('diagnostic.q3Opt2') },
                { v: 'systematic', label: t('diagnostic.q3Opt3') },
              ].map((opt) => (
                <label class="diag-opt">
                  <input type="radio" name="q3" value={opt.v} />
                  <span class="diag-opt-label">{opt.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Q4: time pressure -->
          <fieldset class="diag-q">
            <legend class="diag-q-title">{t('diagnostic.q4Title')}</legend>
            <p class="diag-q-desc">{t('diagnostic.q4Desc')}</p>
            <div class="diag-opts">
              {[
                { v: 'urgent', label: t('diagnostic.q4Opt1') },
                { v: 'standard', label: t('diagnostic.q4Opt2') },
                { v: 'exploratory', label: t('diagnostic.q4Opt3') },
              ].map((opt) => (
                <label class="diag-opt">
                  <input type="radio" name="q4" value={opt.v} />
                  <span class="diag-opt-label">{opt.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Q5: stakeholders -->
          <fieldset class="diag-q">
            <legend class="diag-q-title">{t('diagnostic.q5Title')}</legend>
            <p class="diag-q-desc">{t('diagnostic.q5Desc')}</p>
            <div class="diag-opts">
              {[
                { v: 'solo', label: t('diagnostic.q5Opt1') },
                { v: 'small', label: t('diagnostic.q5Opt2') },
                { v: 'large', label: t('diagnostic.q5Opt3') },
              ].map((opt) => (
                <label class="diag-opt">
                  <input type="radio" name="q5" value={opt.v} />
                  <span class="diag-opt-label">{opt.label}</span>
                </label>
              ))}
            </div>
          </fieldset>
        </form>

        <!-- RESULT (right, sticky) -->
        <aside class="diag-result fi d1" id="diag-result">
          <div class="diag-result-inner" id="diag-result-inner">
            <!-- Accent strip — color shifts with badge state -->
            <div class="diag-result-accent" aria-hidden="true"></div>

            <header class="diag-result-head">
              <div class="diag-result-eyebrow">
                <span style="width:22px;height:1px;background:var(--grad);display:block"></span>
                {t('diagnostic.resultTitle')}
              </div>
              <div class="diag-stale-hint" id="diag-stale">{t('diagnostic.resultStaleHint')}</div>
            </header>

            <div class="diag-result-body" id="diag-body" hidden>
              <!-- Badge -->
              <div class="diag-badge" id="diag-badge">
                <span class="diag-badge-dot"></span>
                <span class="diag-badge-label"></span>
              </div>
              <p class="diag-badge-sub" id="diag-badge-sub"></p>

              <!-- Quality probability card -->
              <div class="diag-metric diag-metric-quality">
                <div class="diag-metric-head">
                  <span class="diag-metric-tag">{t('diagnostic.resultQualityLabel')}</span>
                </div>
                <div class="diag-metric-big" id="diag-quality-value">—</div>
                <div class="diag-quality-bar">
                  <div class="diag-quality-bar-baseline" title="37% baseline (McKinsey)" aria-hidden="true"></div>
                  <div class="diag-quality-bar-fill" id="diag-quality-fill"></div>
                </div>
                <div class="diag-metric-meta">{t('diagnostic.resultQualityVsBase')}</div>
              </div>

              <!-- Exposure range card -->
              <div class="diag-metric diag-metric-exposure">
                <div class="diag-metric-head">
                  <span class="diag-metric-tag">{t('diagnostic.resultExposureLabel')}</span>
                </div>
                <div class="diag-range">
                  <div class="diag-range-item diag-range-low">
                    <span class="diag-range-lbl">LOW</span>
                    <span class="diag-range-val" id="diag-exposure-low">—</span>
                  </div>
                  <div class="diag-range-bar" aria-hidden="true"></div>
                  <div class="diag-range-item diag-range-high">
                    <span class="diag-range-lbl">HIGH</span>
                    <span class="diag-range-val" id="diag-exposure-high">—</span>
                  </div>
                </div>
                <div class="diag-metric-meta">{t('diagnostic.resultExposureHint')}</div>
              </div>

              <!-- Narrative — 2 paragraphs assembled from the answer
                   combination, with inline citations to the source
                   behind each observation. -->
              <div class="diag-narrative" id="diag-narrative">
                <div class="diag-narr-block">
                  <div class="diag-narr-lead" id="diag-narr-lead1">{t('diagnostic.narrativeReadingLead')}</div>
                  <p id="diag-narr-p1"></p>
                </div>
                <div class="diag-narr-block">
                  <div class="diag-narr-lead" id="diag-narr-lead2">{t('diagnostic.narrativeContextLead')}</div>
                  <p id="diag-narr-p2"></p>
                </div>
              </div>

              <!-- Actions -->
              <div class="diag-actions">
                <div class="diag-actions-label">{t('diagnostic.actionsTitle')}</div>
                <div id="diag-actions-list"></div>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ═══════════════ METHODOLOGY ════════════════════════════════ -->
  <section class="diag-methodology">
    <div class="section-glow blue" style="top:20%;left:-100px"></div>
    <div class="container">
      <div class="diag-method-head fi">
        <div class="label" style="display:inline-flex;align-items:center;gap:10px">
          <span style="width:22px;height:1px;background:var(--grad);display:block"></span>
          {t('diagnostic.methodologyTitle')}
        </div>
        <h2 class="section-title" style="margin-top:14px">{t('diagnostic.methodologyFormulaTitle')}</h2>
        <p class="section-sub">{t('diagnostic.methodologySub')}</p>
      </div>

      <div class="diag-formula fi d1">
        <p set:html={t('diagnostic.methodologyFormulaQuality')}></p>
        <p set:html={t('diagnostic.methodologyFormulaExposure')}></p>
      </div>

      <h3 class="diag-sources-title fi">{t('diagnostic.methodologySourcesTitle')}</h3>
      <ol class="diag-sources fi d1">
        <li>{t('diagnostic.srcMcKinsey')}</li>
        <li>{t('diagnostic.srcBrynjolfsson')}</li>
        <li>{t('diagnostic.srcPMI')}</li>
        <li>{t('diagnostic.srcBezos')}</li>
        <li>{t('diagnostic.srcBain')}</li>
        <li>{t('diagnostic.srcKahneman')}</li>
        <li>{t('diagnostic.srcIBM')}</li>
      </ol>

      <div class="diag-disclaimer fi">
        <div class="diag-disclaimer-title">{t('diagnostic.disclaimerTitle')}</div>
        <p>{t('diagnostic.disclaimerBody')}</p>
      </div>
    </div>
  </section>

  <!-- ═══════════════ CTA ════════════════════════════════════════ -->
  <section class="diag-cta">
    <div class="section-glow lilac" style="top:50%;left:50%;transform:translate(-50%,-50%)"></div>
    <div class="container fi">
      <h2>{t('diagnostic.ctaFinal')}</h2>
      <p>{t('diagnostic.ctaFinalSub')}</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a href="/contato" class="btn btn-primary">{t('diagnostic.ctaFinalPrimary')}</a>
        <a href="/blog" class="btn btn-ghost">{t('diagnostic.ctaFinalSecondary')}</a>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{
  q1Values,
  urls: {
    briefing: '/posts/decisao-no-escuro',
    contato: '/contato',
    framework: '/blog',
    sprint: '/colaborar',
  },
  labels: {
    currency: 'R$',
    badgeRed: t('diagnostic.resultBadgeRed'),
    badgeYellow: t('diagnostic.resultBadgeYellow'),
    badgeGreen: t('diagnostic.resultBadgeGreen'),
    badgeRedSub: t('diagnostic.resultBadgeRedSub'),
    badgeYellowSub: t('diagnostic.resultBadgeYellowSub'),
    badgeGreenSub: t('diagnostic.resultBadgeGreenSub'),
    actionBriefingTitle: t('diagnostic.actionBriefingTitle'),
    actionBriefingDesc: t('diagnostic.actionBriefingDesc'),
    actionBriefingCta: t('diagnostic.actionBriefingCta'),
    actionResearchTitle: t('diagnostic.actionResearchTitle'),
    actionResearchDesc: t('diagnostic.actionResearchDesc'),
    actionResearchCta: t('diagnostic.actionResearchCta'),
    actionFrameworkTitle: t('diagnostic.actionFrameworkTitle'),
    actionFrameworkDesc: t('diagnostic.actionFrameworkDesc'),
    actionFrameworkCta: t('diagnostic.actionFrameworkCta'),
    actionDataTitle: t('diagnostic.actionDataTitle'),
    actionDataDesc: t('diagnostic.actionDataDesc'),
    actionDataCta: t('diagnostic.actionDataCta'),
    narrativeIntro: t('diagnostic.narrativeIntro'),
    narrativeDeltaAbove: t('diagnostic.narrativeDeltaAbove'),
    narrativeDeltaBelow: t('diagnostic.narrativeDeltaBelow'),
    narrativeDeltaEqual: t('diagnostic.narrativeDeltaEqual'),
    narrativeCloseRed: t('diagnostic.narrativeCloseRed'),
    narrativeCloseYellow: t('diagnostic.narrativeCloseYellow'),
    narrativeCloseGreen: t('diagnostic.narrativeCloseGreen'),
    narrDataNone: t('diagnostic.narrDataNone'),
    narrDataAdhoc: t('diagnostic.narrDataAdhoc'),
    narrDataSystematic: t('diagnostic.narrDataSystematic'),
    narrTimeUrgent: t('diagnostic.narrTimeUrgent'),
    narrTimeStandard: t('diagnostic.narrTimeStandard'),
    narrTimeExplor: t('diagnostic.narrTimeExplor'),
    narrRevTwo: t('diagnostic.narrRevTwo'),
    narrRevOne: t('diagnostic.narrRevOne'),
    narrStkSolo: t('diagnostic.narrStkSolo'),
    narrStkSmall: t('diagnostic.narrStkSmall'),
    narrStkLarge: t('diagnostic.narrStkLarge'),
    narrSize0: t('diagnostic.narrSize0'),
    narrSize1: t('diagnostic.narrSize1'),
    narrSize2: t('diagnostic.narrSize2'),
    narrSize3: t('diagnostic.narrSize3'),
  },
}}>
  // ══════ DIAGNOSTIC MODEL ════════════════════════════════════════
  // Every coefficient below is cited in the sources section above.
  // Keep this file in sync with the methodology copy.
  const model = {
    baseQuality: 0.37, // McKinsey 2019
    dataMaturityDelta: { none: -0.15, adhoc: 0.0, systematic: 0.12 }, // Brynjolfsson/MIT
    timePressureDelta: { urgent: -0.10, standard: 0.0, exploratory: 0.05 }, // Kahneman/PMI
    // Stakeholders sweet-spot (non-monotonic): 2-5 outperforms solo
    // (wisdom-of-crowds, Kahneman decision hygiene) and large groups
    // (Bain coordination overhead, groupthink). Solo has speed but
    // carries single-decider bias risk.
    stakeholdersDelta: { solo: 0.0, small: 0.03, large: -0.06 },
    qualityMin: 0.05,
    qualityMax: 0.75,
    exposureLowPct: 0.05, // PMI lower bound
    exposureHighPct: 0.25, // PMI upper bound, for high-impact decisions
    reversibilityMultiplier: { two: 1.0, one: 1.5 }, // Bezos one-way door
  };

  const form = document.getElementById('diag-form');
  const resultInner = document.getElementById('diag-result-inner');
  const staleHint = document.getElementById('diag-stale');
  const body = document.getElementById('diag-body');
  const badge = document.getElementById('diag-badge');
  const badgeLabel = badge?.querySelector('.diag-badge-label');
  const badgeSub = document.getElementById('diag-badge-sub');
  const qualityValue = document.getElementById('diag-quality-value');
  const qualityFill = document.getElementById('diag-quality-fill');
  const exposureLow = document.getElementById('diag-exposure-low');
  const exposureHigh = document.getElementById('diag-exposure-high');
  const actionsList = document.getElementById('diag-actions-list');
  const narrP1 = document.getElementById('diag-narr-p1');
  const narrP2 = document.getElementById('diag-narr-p2');

  function readAnswers() {
    if (!form) return null;
    const data = new FormData(form);
    const q1 = data.get('q1');
    const q2 = data.get('q2');
    const q3 = data.get('q3');
    const q4 = data.get('q4');
    const q5 = data.get('q5');
    if (q1 === null || q2 === null || q3 === null || q4 === null || q5 === null) return null;
    return { q1: Number(q1), q2, q3, q4, q5 };
  }

  function computeQuality(a) {
    const q = model.baseQuality
      + (model.dataMaturityDelta[a.q3] ?? 0)
      + (model.timePressureDelta[a.q4] ?? 0)
      + (model.stakeholdersDelta[a.q5] ?? 0);
    return Math.max(model.qualityMin, Math.min(model.qualityMax, q));
  }

  function computeExposure(a, quality) {
    const size = q1Values[a.q1];
    const rev = model.reversibilityMultiplier[a.q2] ?? 1.0;
    const riskShare = 1 - quality;
    return {
      low: size * riskShare * model.exposureLowPct,
      high: size * riskShare * model.exposureHighPct * rev,
    };
  }

  function formatCurrency(n) {
    // Always format in BRL style since the amount tiers are in R$,
    // regardless of the visitor's locale. Use locale's grouping rules.
    const formatter = new Intl.NumberFormat('pt-BR', {
      style: 'decimal',
      maximumFractionDigits: 0,
    });
    return `${labels.currency} ${formatter.format(Math.round(n))}`;
  }

  function buildActions(a, quality) {
    // Pick the 2 most relevant actions for this answer set.
    const pool = [];
    if (a.q3 === 'none') {
      pool.push({ key: 'data', title: labels.actionDataTitle, desc: labels.actionDataDesc, cta: labels.actionDataCta, url: urls.sprint });
    }
    if (a.q2 === 'one' && a.q4 === 'urgent') {
      pool.push({ key: 'framework', title: labels.actionFrameworkTitle, desc: labels.actionFrameworkDesc, cta: labels.actionFrameworkCta, url: urls.framework });
    }
    // Always include the briefing post — it's the canonical reading.
    pool.push({ key: 'briefing', title: labels.actionBriefingTitle, desc: labels.actionBriefingDesc, cta: labels.actionBriefingCta, url: urls.briefing });
    // High-risk answers → book a diagnostic.
    if (quality < 0.35 || a.q1 >= 2) {
      pool.push({ key: 'research', title: labels.actionResearchTitle, desc: labels.actionResearchDesc, cta: labels.actionResearchCta, url: urls.contato });
    }
    // Dedup by key, take top 2
    const seen = new Set();
    const picked = [];
    for (const item of pool) {
      if (seen.has(item.key)) continue;
      seen.add(item.key);
      picked.push(item);
      if (picked.length === 2) break;
    }
    return picked;
  }

  // Fragment lookups per answer choice. Mirrors the rating deltas
  // in the model — so the copy reads consistent with the math.
  const dataFragMap = { none: labels.narrDataNone, adhoc: labels.narrDataAdhoc, systematic: labels.narrDataSystematic };
  const timeFragMap = { urgent: labels.narrTimeUrgent, standard: labels.narrTimeStandard, exploratory: labels.narrTimeExplor };
  const revFragMap = { two: labels.narrRevTwo, one: labels.narrRevOne };
  const stkFragMap = { solo: labels.narrStkSolo, small: labels.narrStkSmall, large: labels.narrStkLarge };
  const sizeFragMap = [labels.narrSize0, labels.narrSize1, labels.narrSize2, labels.narrSize3];

  function capitalizeFirst(str) {
    return str.charAt(0).toUpperCase() + str.slice(1);
  }

  function buildNarrative(a, quality, badgeKey) {
    const percent = Math.round(quality * 100);
    const deltaPP = percent - 37;
    let deltaStr;
    if (deltaPP > 0) {
      deltaStr = labels.narrativeDeltaAbove.replace('{n}', `+${deltaPP}`);
    } else if (deltaPP < 0) {
      deltaStr = labels.narrativeDeltaBelow.replace('{n}', `${deltaPP}`);
    } else {
      deltaStr = labels.narrativeDeltaEqual;
    }
    const intro = labels.narrativeIntro
      .replace('{percent}', String(percent))
      .replace('{delta}', deltaStr);
    const closer =
      badgeKey === 'red'    ? labels.narrativeCloseRed
    : badgeKey === 'yellow' ? labels.narrativeCloseYellow
                            : labels.narrativeCloseGreen;

    const p1 = `${intro} ${capitalizeFirst(dataFragMap[a.q3])}; ${timeFragMap[a.q4]}; ${stkFragMap[a.q5]}.`;
    const p2 = `${capitalizeFirst(sizeFragMap[a.q1])}. ${capitalizeFirst(revFragMap[a.q2])}. ${closer}`;
    return { p1, p2 };
  }

  function renderNarrative(a, quality, badgeKey) {
    if (!narrP1 || !narrP2) return;
    const { p1, p2 } = buildNarrative(a, quality, badgeKey);
    narrP1.innerHTML = p1;
    narrP2.innerHTML = p2;
  }

  function renderActions(actions) {
    if (!actionsList) return;
    actionsList.innerHTML = '';
    actions.forEach((action, idx) => {
      const card = document.createElement('a');
      card.href = action.url;
      card.className = 'diag-action';
      const step = String(idx + 1).padStart(2, '0');
      card.innerHTML = `
        <div class="diag-action-head">
          <span class="diag-action-step">${step}</span>
          <div class="diag-action-head-text">
            <h4 class="diag-action-title">${action.title}</h4>
          </div>
        </div>
        <p class="diag-action-desc">${action.desc}</p>
        <div class="diag-action-foot">
          <span class="diag-action-cta">${action.cta}</span>
          <span class="diag-action-arrow" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
      `;
      actionsList.appendChild(card);
    });
  }

  function render() {
    const a = readAnswers();
    if (!a) {
      if (body) body.hidden = true;
      if (staleHint) staleHint.hidden = false;
      return;
    }
    if (body) body.hidden = false;
    if (staleHint) staleHint.hidden = true;

    const quality = computeQuality(a);
    const exposure = computeExposure(a, quality);

    // Quality cell
    if (qualityValue) qualityValue.textContent = `${Math.round(quality * 100)}%`;
    if (qualityFill) qualityFill.style.width = `${Math.min(100, Math.max(0, quality * 100))}%`;

    // Exposure cells
    if (exposureLow) exposureLow.textContent = formatCurrency(exposure.low);
    if (exposureHigh) exposureHigh.textContent = formatCurrency(exposure.high);

    // Badge + accent strip state (propagates color tint to the whole card)
    let badgeKey = 'green';
    if (quality < 0.35) badgeKey = 'red';
    else if (quality < 0.55) badgeKey = 'yellow';
    if (badge) {
      badge.classList.remove('diag-badge-red', 'diag-badge-yellow', 'diag-badge-green');
      badge.classList.add(`diag-badge-${badgeKey}`);
    }
    if (resultInner) {
      resultInner.classList.remove('state-red', 'state-yellow', 'state-green');
      resultInner.classList.add(`state-${badgeKey}`);
    }
    if (badgeLabel) {
      badgeLabel.textContent =
        badgeKey === 'red'    ? labels.badgeRed
      : badgeKey === 'yellow' ? labels.badgeYellow
                              : labels.badgeGreen;
    }
    if (badgeSub) {
      badgeSub.textContent =
        badgeKey === 'red'    ? labels.badgeRedSub
      : badgeKey === 'yellow' ? labels.badgeYellowSub
                              : labels.badgeGreenSub;
    }

    // Narrative (depends on badgeKey computed above)
    renderNarrative(a, quality, badgeKey);

    // Actions
    renderActions(buildActions(a, quality));
  }

  if (form) {
    form.addEventListener('change', render);
    // Initial render (shows stale hint until first answer).
    render();
  }
</script>

<style>
  /* ═══════════ HERO ═══════════════════════════════════════════ */
  .diag-hero {
    padding: 160px 0 80px;
    position: relative;
    overflow: hidden;
    z-index: 1;
  }
  .diag-hero-inner {
    text-align: center;
    max-width: 820px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }
  .diag-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--lilac);
    margin-bottom: 24px;
  }
  .diag-title {
    font-size: clamp(36px, 5.2vw, 64px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: 22px;
    text-wrap: balance;
  }
  .diag-sub {
    font-size: 17px;
    color: var(--muted);
    line-height: 1.6;
    max-width: 620px;
    margin: 0 auto 32px;
    text-wrap: pretty;
  }
  .diag-steps {
    display: inline-flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .diag-step-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 100px;
    border: 1px solid rgba(177, 140, 255, 0.22);
    background: rgba(177, 140, 255, 0.04);
    color: var(--lilac);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .diag-step-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--lilac);
    box-shadow: 0 0 8px rgba(177, 140, 255, 0.6);
  }

  /* ═══════════ WORKBENCH (form + result) ══════════════════════ */
  .diag-workbench {
    padding: 60px 0 80px;
    position: relative;
    overflow: hidden;
    z-index: 1;
  }
  .diag-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: start;
  }

  /* FORM */
  .diag-form {
    background: rgba(22, 22, 32, 0.55);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 32px 36px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .diag-form-head h2 {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 6px;
  }
  .diag-form-head p {
    font-size: 13px;
    color: var(--muted);
  }
  .diag-q {
    border: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .diag-q-title {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--white);
  }
  .diag-q-desc {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.55;
    margin-bottom: 4px;
  }
  .diag-opts {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
  }
  .diag-opts-grid2 {
    grid-template-columns: 1fr 1fr;
  }
  .diag-opt {
    position: relative;
    cursor: pointer;
    padding: 12px 16px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: rgba(22, 22, 32, 0.55);
    transition: border-color 0.2s, background 0.2s;
  }
  .diag-opt:hover {
    border-color: rgba(177, 140, 255, 0.4);
    background: rgba(177, 140, 255, 0.05);
  }
  .diag-opt input[type="radio"] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .diag-opt-label {
    font-size: 14px;
    color: var(--white);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .diag-opt-label::before {
    content: '';
    display: block;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1.5px solid rgba(177, 140, 255, 0.45);
    background: transparent;
    flex-shrink: 0;
    transition: border-color 0.2s, background 0.2s;
  }
  .diag-opt:has(input:checked) {
    border-color: rgba(177, 140, 255, 0.55);
    background: rgba(177, 140, 255, 0.08);
  }
  .diag-opt:has(input:checked) .diag-opt-label::before {
    background: var(--lilac);
    border-color: var(--lilac);
    box-shadow: 0 0 0 3px rgba(177, 140, 255, 0.18);
  }

  /* ═══════════ RESULT PANEL ════════════════════════════════════
     Nested metric cards + accent bar that shifts color per badge
     state, so red/yellow/green read at a glance instead of forcing
     the reader to parse numbers first. */
  .diag-result {
    position: sticky;
    top: 100px;
  }
  .diag-result-inner {
    position: relative;
    background: linear-gradient(165deg, rgba(26, 26, 40, 0.85), rgba(22, 22, 32, 0.7));
    border: 1px solid rgba(177, 140, 255, 0.2);
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
    transition: border-color 0.35s, box-shadow 0.35s;
  }
  .diag-result-accent {
    height: 4px;
    width: 100%;
    background: var(--grad);
    transition: background 0.4s;
  }
  .diag-result-inner.state-red .diag-result-accent {
    background: linear-gradient(90deg, var(--red), var(--amber));
  }
  .diag-result-inner.state-red {
    border-color: rgba(255, 92, 122, 0.32);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4), 0 0 60px rgba(255, 92, 122, 0.06);
  }
  .diag-result-inner.state-yellow .diag-result-accent {
    background: linear-gradient(90deg, var(--amber), var(--yellow));
  }
  .diag-result-inner.state-yellow {
    border-color: rgba(255, 209, 102, 0.3);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4), 0 0 60px rgba(255, 209, 102, 0.05);
  }
  .diag-result-inner.state-green .diag-result-accent {
    background: linear-gradient(90deg, var(--green), var(--cyan));
  }
  .diag-result-inner.state-green {
    border-color: rgba(0, 229, 160, 0.3);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4), 0 0 60px rgba(0, 229, 160, 0.06);
  }

  .diag-result-head {
    padding: 26px 28px 0;
  }
  .diag-result-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dimmed);
    margin-bottom: 14px;
  }
  .diag-stale-hint {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.6;
    padding: 14px 0 28px;
  }
  .diag-result-body {
    padding: 8px 28px 28px;
  }

  /* Badge */
  .diag-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 100px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .diag-badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }
  .diag-badge.diag-badge-red {
    background: rgba(255, 92, 122, 0.12);
    border: 1px solid rgba(255, 92, 122, 0.36);
    color: var(--red);
  }
  .diag-badge.diag-badge-red .diag-badge-dot {
    background: var(--red);
    box-shadow: 0 0 10px rgba(255, 92, 122, 0.8);
    animation: diagBadgePulse 2s ease-in-out infinite;
  }
  .diag-badge.diag-badge-yellow {
    background: rgba(255, 209, 102, 0.12);
    border: 1px solid rgba(255, 209, 102, 0.36);
    color: var(--yellow);
  }
  .diag-badge.diag-badge-yellow .diag-badge-dot {
    background: var(--yellow);
    box-shadow: 0 0 10px rgba(255, 209, 102, 0.8);
    animation: diagBadgePulse 2.4s ease-in-out infinite;
  }
  .diag-badge.diag-badge-green {
    background: rgba(0, 229, 160, 0.12);
    border: 1px solid rgba(0, 229, 160, 0.36);
    color: var(--green);
  }
  .diag-badge.diag-badge-green .diag-badge-dot {
    background: var(--green);
    box-shadow: 0 0 10px rgba(0, 229, 160, 0.8);
    animation: diagBadgePulse 2.8s ease-in-out infinite;
  }
  @keyframes diagBadgePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.55; transform: scale(1.25); }
  }
  .diag-badge-sub {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 22px;
  }

  /* Metric cards */
  .diag-metric {
    padding: 20px 22px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: rgba(14, 14, 22, 0.55);
    margin-bottom: 14px;
  }
  .diag-metric-head { margin-bottom: 14px; }
  .diag-metric-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .diag-metric-tag::before {
    content: '';
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 8px currentColor;
  }
  .diag-metric-quality {
    border-color: rgba(177, 140, 255, 0.22);
    background: linear-gradient(165deg, rgba(177, 140, 255, 0.08), rgba(14, 14, 22, 0.55) 70%);
  }
  .diag-metric-quality .diag-metric-tag { color: var(--lilac); }
  .diag-metric-exposure {
    border-color: rgba(255, 209, 102, 0.22);
    background: linear-gradient(165deg, rgba(255, 209, 102, 0.06), rgba(255, 92, 122, 0.04) 60%, rgba(14, 14, 22, 0.55));
  }
  .diag-metric-exposure .diag-metric-tag { color: var(--yellow); }

  .diag-metric-big {
    font-size: 42px;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1;
    margin-bottom: 14px;
    background: linear-gradient(135deg, #B18CFF 0%, #7B9EFF 60%, #4DA3FF 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .diag-metric-meta {
    font-size: 11px;
    color: var(--dimmed);
    margin-top: 10px;
    letter-spacing: 0.04em;
  }

  /* Exposure range — LOW/HIGH with colored rail between */
  .diag-range {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 16px;
    align-items: center;
    margin-bottom: 4px;
  }
  .diag-range-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .diag-range-item.diag-range-high {
    align-items: flex-end;
    text-align: right;
  }
  .diag-range-lbl {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .diag-range-low .diag-range-lbl { color: var(--yellow); }
  .diag-range-high .diag-range-lbl { color: var(--red); }
  .diag-range-val {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1;
  }
  .diag-range-low .diag-range-val { color: var(--yellow); }
  .diag-range-high .diag-range-val { color: var(--red); }
  .diag-range-bar {
    position: relative;
    height: 4px;
    min-width: 48px;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--yellow), var(--amber), var(--red));
    align-self: center;
    margin-top: 6px;
  }
  .diag-range-bar::before,
  .diag-range-bar::after {
    content: '';
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    top: 50%;
    transform: translateY(-50%);
  }
  .diag-range-bar::before {
    left: -4px;
    background: var(--yellow);
    box-shadow: 0 0 10px rgba(255, 209, 102, 0.7);
  }
  .diag-range-bar::after {
    right: -4px;
    background: var(--red);
    box-shadow: 0 0 10px rgba(255, 92, 122, 0.7);
  }

  /* Quality bar */
  .diag-quality-bar {
    position: relative;
    height: 8px;
    background: rgba(14, 14, 22, 0.9);
    border: 1px solid rgba(177, 140, 255, 0.12);
    border-radius: 6px;
    overflow: hidden;
  }
  .diag-quality-bar-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0%;
    background: linear-gradient(90deg, #B18CFF, #7B9EFF, #4DA3FF);
    border-radius: 4px;
    box-shadow: 0 0 12px rgba(177, 140, 255, 0.55);
    transition: width 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .diag-quality-bar-baseline {
    position: absolute;
    top: -4px;
    bottom: -4px;
    left: 37%;
    width: 1.5px;
    background: #fff;
    opacity: 0.55;
    z-index: 1;
    pointer-events: none;
  }
  .diag-quality-bar-baseline::after {
    content: '37%';
    position: absolute;
    bottom: -18px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.6);
  }

  /* Narrative — two stacked "Reading" / "Context" paragraphs that
     assemble from the user's answers and cite the relevant research
     inline. Sits between the metric cards and the actions so the
     reader sees numbers → explanation → what to do. */
  .diag-narrative {
    margin-top: 22px;
    padding: 22px 22px 18px;
    border: 1px solid rgba(177, 140, 255, 0.14);
    background: linear-gradient(165deg, rgba(30, 30, 44, 0.7), rgba(14, 14, 22, 0.55));
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .diag-narr-block {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .diag-narr-lead {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--lilac);
  }
  .diag-narr-lead::before {
    content: '';
    display: block;
    width: 16px;
    height: 1px;
    background: var(--lilac);
    opacity: 0.6;
  }
  .diag-narrative p {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.7;
    margin: 0;
  }
  .diag-narrative p strong {
    color: var(--white);
    font-weight: 600;
  }
  .diag-narrative p em {
    font-style: italic;
    color: var(--lilac);
  }

  /* Actions — stacked cards with numbered step, description, and a
     divider-separated CTA footer. Color-coded per action position
     (lilac for first, green for second) so the reader sees them as a
     sequence, not a list. */
  .diag-actions {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .diag-actions-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dimmed);
    margin-bottom: 14px;
  }
  .diag-action {
    display: block;
    padding: 18px 20px 0;
    background: rgba(14, 14, 22, 0.65);
    border: 1px solid var(--border);
    border-radius: 14px;
    margin-bottom: 12px;
    color: inherit;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    transition: border-color 0.25s, background 0.25s, transform 0.25s;
  }
  /* Colored rail on the left — grows slightly on hover */
  .diag-action::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--lilac);
    transition: width 0.25s;
  }
  .diag-action:nth-child(2)::before { background: var(--green); }
  .diag-action:last-child { margin-bottom: 0; }
  .diag-action:hover {
    border-color: rgba(177, 140, 255, 0.4);
    background: rgba(177, 140, 255, 0.06);
    transform: translateX(3px);
  }
  .diag-action:nth-child(2):hover {
    border-color: rgba(0, 229, 160, 0.4);
    background: rgba(0, 229, 160, 0.05);
  }
  .diag-action:hover::before { width: 4px; }

  /* Head row — numbered step + title */
  .diag-action-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }
  .diag-action-step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(177, 140, 255, 0.14);
    color: var(--lilac);
    border: 1px solid rgba(177, 140, 255, 0.3);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    flex-shrink: 0;
  }
  .diag-action:nth-child(2) .diag-action-step {
    background: rgba(0, 229, 160, 0.14);
    color: var(--green);
    border-color: rgba(0, 229, 160, 0.3);
  }
  .diag-action-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--white);
    letter-spacing: -0.005em;
    line-height: 1.3;
  }
  .diag-action-desc {
    font-size: 12.5px;
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 14px;
  }

  /* Foot — divider + CTA pill + arrow */
  .diag-action-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 0;
    border-top: 1px solid var(--border);
  }
  .diag-action-cta {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lilac);
  }
  .diag-action:nth-child(2) .diag-action-cta { color: var(--green); }
  .diag-action-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid rgba(177, 140, 255, 0.3);
    background: rgba(177, 140, 255, 0.08);
    color: var(--lilac);
    transition: transform 0.25s, background 0.25s, border-color 0.25s;
  }
  .diag-action:nth-child(2) .diag-action-arrow {
    border-color: rgba(0, 229, 160, 0.3);
    background: rgba(0, 229, 160, 0.08);
    color: var(--green);
  }
  .diag-action:hover .diag-action-arrow {
    transform: translateX(3px);
    background: rgba(177, 140, 255, 0.2);
    border-color: rgba(177, 140, 255, 0.55);
  }
  .diag-action:nth-child(2):hover .diag-action-arrow {
    background: rgba(0, 229, 160, 0.18);
    border-color: rgba(0, 229, 160, 0.55);
  }

  /* ═══════════ METHODOLOGY ════════════════════════════════════ */
  .diag-methodology {
    padding: 80px 0 60px;
    position: relative;
    overflow: hidden;
    z-index: 1;
  }
  .diag-method-head {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 36px;
  }
  /* `.section-sub` has its own max-width (520px) and no auto-margin,
     so inside the centered head it would hug the left. Force center. */
  .diag-method-head .section-sub {
    margin: 0 auto;
  }
  .diag-formula {
    max-width: 840px;
    margin: 0 auto 60px;
    background: rgba(22, 22, 32, 0.55);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 22px 28px;
  }
  .diag-formula p {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.7;
  }
  .diag-formula p + p { margin-top: 8px; }
  .diag-formula strong { color: var(--white); }
  .diag-sources-title {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--white);
    max-width: 840px;
    margin: 0 auto 18px;
  }
  .diag-sources {
    max-width: 840px;
    margin: 0 auto;
    padding-left: 0;
    counter-reset: diag-src;
    list-style: none;
  }
  .diag-sources li {
    counter-increment: diag-src;
    position: relative;
    padding: 14px 0 14px 32px;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
    color: var(--muted);
    line-height: 1.65;
  }
  .diag-sources li::before {
    content: counter(diag-src, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 14px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--lilac);
  }
  .diag-disclaimer {
    max-width: 840px;
    margin: 40px auto 0;
    padding: 20px 22px;
    background: rgba(255, 209, 102, 0.05);
    border: 1px solid rgba(255, 209, 102, 0.18);
    border-left: 3px solid var(--yellow);
    border-radius: 12px;
  }
  .diag-disclaimer-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--yellow);
    margin-bottom: 8px;
  }
  .diag-disclaimer p {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.65;
  }

  /* ═══════════ FINAL CTA ══════════════════════════════════════ */
  .diag-cta {
    padding: 80px 0 120px;
    text-align: center;
    position: relative;
    z-index: 1;
    overflow: hidden;
  }
  .diag-cta h2 {
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 16px;
    text-wrap: balance;
  }
  .diag-cta p {
    font-size: 16px;
    color: var(--muted);
    max-width: 560px;
    margin: 0 auto 30px;
    line-height: 1.65;
  }

