---
import Layout from '../../layouts/Layout.astro';
import NeuralNetwork from '../NeuralNetwork.astro';
import { getCollection } from 'astro:content';
import { useTranslations, getLocaleFromUrl, localize } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const href = (path: string) => localize(path, locale);

// Show only the posts written in the active locale. Legacy PT posts
// have no `lang` field → schema defaults them to 'pt'.
const allPosts = (await getCollection('blog', ({ data }) =>
    !data.draft && (data.lang ?? 'pt') === locale))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Grid único — sem separar pesquisa original de dados secundários.
const intelligencePosts = allPosts.filter((p) => p.data.track === 'intelligence');

const formatDate = (d: Date) =>
  d.toLocaleDateString(locale === 'en' ? 'en-US' : 'pt-BR', { year: 'numeric', month: 'long' });

const formatLabel: Record<'briefing' | 'report' | 'foresight' | 'sector', string> = {
  briefing: t('formats.briefing'),
  report: t('formats.report'),
  foresight: t('formats.foresight'),
  sector: t('formats.sector'),
};

// D.Lab Research Series ID, formato "D.LAB #00X". Lê como
// identificador de catálogo de publicação, não de feed de blog.
const formatCatalogId = (volume?: string) =>
  volume ? `D.LAB #${String(volume).padStart(3, '0')}` : null;

// Lista compacta de autores pra rodar abaixo do título no card.
// Prefere citationAuthors (array curado) e cai pro `author` se não houver.
type PostData = Awaited<ReturnType<typeof getCollection<'blog'>>>[number]['data'];
const formatAuthors = (data: PostData) => {
  const list = data.citationAuthors && data.citationAuthors.length > 0
    ? data.citationAuthors
    : data.author.split(/\s*&\s*/).filter(Boolean);
  if (list.length === 0) return data.author;
  if (list.length === 1) return list[0];
  if (list.length === 2) return `${list[0]} · ${list[1]}`;
  return `${list[0]} · ${list[1]} · +${list.length - 2}`;
};

const methodLabel: Record<'original' | 'secondary', string> = {
  original: t('blog.methodOriginal'),
  secondary: t('blog.methodSecondary'),
};

// Materiais ricos (ferramentas e recursos abertos) não são pesquisa:
// recebem rótulo próprio e dispensam ID de catálogo e autoria de
// pesquisador. Discriminados pela categoria de ferramentas (PT ou EN).
const isRichMaterial = (data: PostData) => data.category === 'Ferramentas' || data.category === 'Tools';
const richMaterialLabel = t('blog.richMaterial');
---

<Layout
  title={t('pageTitles.blog')}
  description={t('pageTitles.blogDescription')}
  active="blog"
  locale={locale}
>
  <!-- ═══════════════ BLOG HERO ═══════════════════════════════════ -->
  <section class="blog-hero">
    <div class="blog-hero-glow"></div>
    <NeuralNetwork color="white" density="low" opacity={0.12} />
    <div class="container">
      <div class="blog-hero-inner fi">
        <div class="section-label" style="justify-content:center"><span class="label">{t('blog.heroEyebrow')}</span></div>
        <h1 class="blog-hero-title">{t('blog.heroTitle')} <span class="gradient-text">{t('blog.heroTitleAccent')}</span></h1>
        <p class="blog-hero-sub">{t('blog.heroSub')}</p>
      </div>

    </div>
  </section>

  <!-- ═══════════════ FERRAMENTAS GRÁTIS (régua/banner) ════════════
       As soluções/ferramentas gratuitas do D.Lab vivem aqui no Blog,
       separadas dos serviços pagos (aba Serviços). Conteúdo aberto. -->
  <section class="container blog-tools fi">
    <div class="blog-tools-inner">
      <div class="blog-tools-head">
        <span class="blog-tools-label">{t('blogTools.label')}</span>
        <h2 class="blog-tools-title">{t('blogTools.title')}</h2>
        <p class="blog-tools-sub">{t('blogTools.sub')}</p>
      </div>
      <div class="blog-tools-grid">
        <a href={href(t('blogTools.tool1Href'))} class="blog-tool-card sweep">
          <h3 class="blog-tool-name">{t('blogTools.tool1Name')}</h3>
          <p class="blog-tool-desc">{t('blogTools.tool1Desc')}</p>
          <span class="blog-tool-cta">{t('blogTools.tool1Cta')}</span>
        </a>
        <a href={href(t('blogTools.tool2Href'))} class="blog-tool-card sweep">
          <h3 class="blog-tool-name">{t('blogTools.tool2Name')}</h3>
          <p class="blog-tool-desc">{t('blogTools.tool2Desc')}</p>
          <span class="blog-tool-cta">{t('blogTools.tool2Cta')}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════ 01 · INTELLIGENCE ══════════════════════════ -->
  <section class="container blog-track-section" id="inteligencia">
    <div class="blog-track-header fi">
      <div class="blog-track-eyebrow lilac">
        {t('blog.intelEyebrow')}
      </div>
      <h2 class="blog-track-title">{t('blog.intelTitle')} <span class="gradient-text">{t('blog.intelTitleAccent')}</span></h2>
      <p class="blog-track-sub">{t('blog.intelSub')}</p>
    </div>

    {intelligencePosts.length > 0 ? (
      <div class="blog-grid">
        {intelligencePosts.map((post) => {
          const cardClass = 'blog-card blog-card-catalog fi d2';
          const material = isRichMaterial(post.data);
          const catalogId = material ? null : formatCatalogId(post.data.citationVolume);
          const authors = formatAuthors(post.data);
          const method = material ? richMaterialLabel : methodLabel[post.data.researchType];
          return (
            <a href={href(`/posts/${post.slug}`)} class={cardClass}>
              <div class="blog-card-img" style={`padding:0;background:${post.data.cover ? 'none' : 'var(--surface)'}`}>
                {post.data.cover && (
                  <img src={post.data.cover} alt={post.data.coverAlt ?? ''} loading="lazy" width="800" height="450" style="width:100%;height:100%;object-fit:cover;position:relative;z-index:1" />
                )}
              </div>
              <div class="blog-card-body">
                <div class="blog-card-cataloghead">
                  {catalogId && <span class="blog-card-catalogid">{catalogId}</span>}
                  <span class="blog-card-catalogdate">{formatDate(post.data.pubDate)}</span>
                </div>
                <h3 class="blog-card-title">{post.data.title}</h3>
                {!material && <div class="blog-card-authors">{authors}</div>}
                <p class="blog-card-excerpt">{post.data.description}</p>
                <div class="blog-card-catalogfoot">
                  <span class="blog-card-methodtag">{method}</span>
                  <span class="blog-card-catalogmeta">
                    {formatLabel[post.data.format]}
                    {post.data.readingTime && <span class="blog-card-metasep">·</span>}
                    {post.data.readingTime}
                  </span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <div class="blog-empty fi">
        <div class="blog-empty-title">{t('blog.emptyIntelTitle')}</div>
        <div class="blog-empty-text">{t('blog.emptyIntelText')}</div>
      </div>
    )}
  </section>

  <div class="section-sep"></div>

  <!-- ═══════════════ SCIENTIFIC COLLABORATION ═════════════════════════ -->
  <section class="blog-colab-cta">
    <div class="section-glow lilac" style="top:0;left:50%;transform:translateX(-50%);width:520px;height:380px"></div>
    <div class="section-glow blue" data-parallax="0.08" style="bottom:-60px;right:-100px"></div>
    <div class="container">
      <div class="blog-colab-inner fi">
        <div class="section-label" style="justify-content:center;margin-bottom:20px">
          <span class="label">{t('blog.colabLabel')}</span>
        </div>
        <h2 class="blog-colab-title">
          {t('blog.colabTitle')}<br /><span class="gradient-text">{t('blog.colabTitleAccent')}</span>
        </h2>
        <p class="blog-colab-sub">{t('blog.colabSub')}</p>
        <div class="blog-colab-modes">
          <span class="blog-colab-chip">{t('blog.colabChipSubmit')}</span>
          <span class="blog-colab-chip">{t('blog.colabChipCo')}</span>
          <span class="blog-colab-chip">{t('blog.colabChipData')}</span>
          <span class="blog-colab-chip">{t('blog.colabChipReview')}</span>
        </div>
        <div class="blog-colab-ctas">
          <a href={href('/colaborar')} class="btn btn-primary">{t('blog.colabCtaPrimary')}</a>
          <a href={href('/colaborar')} class="btn btn-ghost">{t('blog.colabCtaSecondary')}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .blog-colab-cta {
    padding: 100px 28px 120px;
    position: relative;
    overflow: hidden;
  }
  .blog-colab-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 2;
  }
  .blog-colab-title {
    font-size: clamp(32px, 4.5vw, 52px);
    font-weight: 300;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: 20px;
    text-wrap: balance;
  }
  .blog-colab-sub {
    font-size: 16px;
    color: var(--muted);
    line-height: 1.75;
    margin: 0 auto 28px;
    max-width: 580px;
  }
  .blog-colab-modes {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }
  .blog-colab-chip {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 100px;
    border: 1px solid rgba(234,234,240, 0.22);
    background: rgba(234,234,240, 0.04);
    color: var(--lilac);
  }
  .blog-colab-ctas {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ═══════════ FERRAMENTAS GRÁTIS (régua no Blog) ═════════════════ */
  .blog-tools { margin: 4px auto 8px; max-width: 1180px; }
  .blog-tools-inner {
    background: var(--bg-elev);
    border: 1px solid rgba(167,139,250,0.24);
    border-radius: 20px; padding: 28px 30px;
  }
  .blog-tools-head { margin-bottom: 18px; }
  .blog-tools-label { display:inline-block; font-size:10px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; color:var(--accent); margin-bottom:8px; }
  .blog-tools-title { font-family:var(--font-display); font-weight:600; font-size:clamp(20px,2.6vw,28px); letter-spacing:-.02em; color:var(--ink); margin:0 0 4px; }
  .blog-tools-sub { font-size:14px; color:var(--text-muted); margin:0; }
  .blog-tools-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  .blog-tool-card { display:flex; flex-direction:column; gap:8px; padding:20px 22px; border:1px solid var(--line); border-radius:14px; background:var(--bg); text-decoration:none; color:inherit; transition:border-color .25s, transform .25s; }
  .blog-tool-card:hover { border-color:rgba(167,139,250,0.5); transform:translateY(-3px); }
  .blog-tool-name { font-family:var(--font-display); font-weight:600; font-size:17px; color:var(--ink); margin:0; }
  .blog-tool-desc { font-size:13.5px; line-height:1.55; color:var(--text-muted); margin:0; flex:1; }
  .blog-tool-cta { font-size:13px; font-weight:600; color:var(--accent); }
  @media (max-width:680px){ .blog-tools-grid { grid-template-columns:1fr; } }
</style>
