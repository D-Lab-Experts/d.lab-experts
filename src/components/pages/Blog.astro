---
import Layout from '../../layouts/Layout.astro';
import NeuralNetwork from '../NeuralNetwork.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations();

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const intelligencePosts = allPosts.filter((p) => p.data.track === 'intelligence');
const cybersecPosts = allPosts.filter((p) => p.data.track === 'cybersec');

type Post = (typeof allPosts)[number];
const byType = (posts: Post[], type: 'original' | 'secondary') =>
  posts.filter((p) => p.data.researchType === type);

const intelOriginal = byType(intelligencePosts, 'original');
const intelSecondary = byType(intelligencePosts, 'secondary');
const cyberOriginal = byType(cybersecPosts, 'original');
const cyberSecondary = byType(cybersecPosts, 'secondary');

const intelGroups = [
  {
    key: 'original',
    label: 'Original Research',
    sub: 'Studies built on data the Hub collected directly — surveys, interviews, and primary analysis.',
    posts: intelOriginal,
  },
  {
    key: 'secondary',
    label: 'Secondary-Data Research',
    sub: 'Analyses grounded in public datasets, sector reports, and auditable third-party sources.',
    posts: intelSecondary,
  },
] as const;

const cyberGroups = [
  {
    key: 'original',
    label: 'Original Cases',
    sub: 'Technical analyses with data collected from our own engagements — pentests, forensics, instrumentation.',
    posts: cyberOriginal,
  },
  {
    key: 'secondary',
    label: 'Secondary-Data Analyses',
    sub: 'Reads built on threat-intel feeds, vendor reports, and open-source intelligence.',
    posts: cyberSecondary,
  },
] as const;

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });

const formatLabel: Record<'briefing' | 'report' | 'foresight' | 'sector', string> = {
  briefing: 'Briefing',
  report: 'Report',
  foresight: 'Foresight',
  sector: 'Sector Report',
};
---

<Layout
  title={t('pageTitles.blog')}
  description={t('pageTitles.blogDescription')}
  active="blog"
>
  <!-- ═══════════════ BLOG HERO ═══════════════════════════════════ -->
  <section class="blog-hero">
    <div class="blog-hero-glow"></div>
    <NeuralNetwork color="lilac" density="medium" opacity={0.30} />
    <div class="container">
      <div class="blog-hero-inner fi">
        <div class="section-label" style="justify-content:center"><span class="label">Open Research &amp; Analyses</span></div>
        <h1 class="blog-hero-title">Open research and <span class="gradient-text">public analyses.</span></h1>
        <p class="blog-hero-sub">We publish a fraction of what we produce as public proof of method. Applied intelligence and cybersecurity, under the same protocol of rigor.</p>
      </div>

      <div class="blog-track-nav fi d1">
        <a href="#inteligencia" class="blog-track-btn lilac">
          <span class="blog-track-btn-dot"></span>
          Intelligence &amp; Research
          <span class="blog-track-btn-count">{intelligencePosts.length}</span>
        </a>
        <a href="#cybersec" class="blog-track-btn green">
          <span class="blog-track-btn-dot"></span>
          Cybersecurity
          <span class="blog-track-btn-count">{cybersecPosts.length}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════ 01 · INTELLIGENCE ══════════════════════════ -->
  <section class="container blog-track-section" id="inteligencia">
    <div class="blog-track-header fi">
      <div class="blog-track-eyebrow lilac">
        <span class="blog-track-eyebrow-num">01</span>
        Intelligence
      </div>
      <h2 class="blog-track-title">Intelligence &amp; <span class="gradient-text">Applied Research</span></h2>
      <p class="blog-track-sub">Strategic decisions, markets, competition, trends, audiences, and policy. Research that anchors the move before it happens.</p>
    </div>

    {intelligencePosts.length > 0 ? (
      intelGroups.filter((g) => g.posts.length > 0).map((group) => (
        <div class="blog-subtrack">
          <div class="blog-subtrack-header fi">
            <span class="blog-subtrack-tag lilac">
              <span class="blog-subtrack-dot"></span>
              {group.label}
              <span class="blog-subtrack-count">{group.posts.length}</span>
            </span>
            <p class="blog-subtrack-sub">{group.sub}</p>
          </div>
          <div class="blog-grid">
            {group.posts.map((post) => {
              const cardClass = post.data.featured ? 'blog-card-featured fi d1' : 'blog-card fi d2';
              const isOriginal = post.data.researchType === 'original';
              const cat = post.data.category.toLowerCase();
              const extraTags = post.data.tags
                .filter((t: string) => t.toLowerCase() !== cat)
                .slice(0, isOriginal ? 1 : 2);
              return (
                <a href={`/posts/${post.slug}`} class={cardClass}>
                  <div class="blog-card-img" style={`padding:0;background:${post.data.cover ? 'none' : 'var(--surface)'}`}>
                    {post.data.cover && (
                      <img src={post.data.cover} alt={post.data.coverAlt ?? ''} loading="lazy" width="800" height="450" style="width:100%;height:100%;object-fit:cover;position:relative;z-index:1" />
                    )}
                  </div>
                  <div class="blog-card-body">
                    <div class="blog-card-tags">
                      {isOriginal && <span class="blog-card-tag original">Original Research</span>}
                      <span class="blog-card-tag lilac">{post.data.category}</span>
                      {extraTags.map((t: string) => (
                        <span class="blog-card-tag blue">{t}</span>
                      ))}
                    </div>
                    <h3 class="blog-card-title">{post.data.title}</h3>
                    <p class="blog-card-excerpt">{post.data.description}</p>
                    <div class="blog-card-meta">
                      <span class={`blog-card-format format-${post.data.format}`}>
                        <span class="format-dot"></span>{formatLabel[post.data.format]}
                      </span>
                      {post.data.readingTime && (
                        <>
                          <span class="blog-card-dot"></span>
                          <span class="blog-card-time">{post.data.readingTime}</span>
                        </>
                      )}
                    </div>
                    <div class="blog-card-footer">
                      <span class="blog-card-date">{formatDate(post.data.pubDate)}</span>
                      <span class="blog-card-read">Read study <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      ))
    ) : (
      <div class="blog-empty fi">
        <div class="blog-empty-title">In preparation.</div>
        <div class="blog-empty-text">The next studies will publish once post-NDA release clears.</div>
      </div>
    )}
  </section>

  <div class="section-sep"></div>

  <!-- ═══════════════ 02 · CYBERSECURITY ════════════════════════ -->
  <section class="container blog-track-section blog-track-cyber" id="cybersec">
    <div class="blog-track-header fi">
      <div class="blog-track-eyebrow green">
        <span class="blog-track-eyebrow-num">02</span>
        Cybersecurity
      </div>
      <h2 class="blog-track-title">Cybersecurity &amp; <span class="gradient-text-green">Offensive Operation</span></h2>
      <p class="blog-track-sub">Pentest, vulnerability analysis, incidents, and security posture. Technical cases and analyses published when NDA allows.</p>
    </div>

    {cybersecPosts.length > 0 ? (
      cyberGroups.filter((g) => g.posts.length > 0).map((group) => (
        <div class="blog-subtrack">
          <div class="blog-subtrack-header fi">
            <span class="blog-subtrack-tag green">
              <span class="blog-subtrack-dot"></span>
              {group.label}
              <span class="blog-subtrack-count">{group.posts.length}</span>
            </span>
            <p class="blog-subtrack-sub">{group.sub}</p>
          </div>
          <div class="blog-grid">
            {group.posts.map((post) => {
              const cardClass = post.data.featured ? 'blog-card-featured fi d1' : 'blog-card fi d2';
              const isOriginal = post.data.researchType === 'original';
              const cat = post.data.category.toLowerCase();
              const extraTags = post.data.tags
                .filter((t: string) => t.toLowerCase() !== cat)
                .slice(0, isOriginal ? 1 : 2);
              return (
                <a href={`/posts/${post.slug}`} class={cardClass}>
                  <div class="blog-card-img" style={`padding:0;background:${post.data.cover ? 'none' : 'var(--surface)'}`}>
                    {post.data.cover && (
                      <img src={post.data.cover} alt={post.data.coverAlt ?? ''} loading="lazy" width="800" height="450" style="width:100%;height:100%;object-fit:cover;position:relative;z-index:1" />
                    )}
                  </div>
                  <div class="blog-card-body">
                    <div class="blog-card-tags">
                      {isOriginal && <span class="blog-card-tag original green">Original Case</span>}
                      <span class="blog-card-tag green">{post.data.category}</span>
                      {extraTags.map((t: string) => (
                        <span class="blog-card-tag cyan">{t}</span>
                      ))}
                    </div>
                    <h3 class="blog-card-title">{post.data.title}</h3>
                    <p class="blog-card-excerpt">{post.data.description}</p>
                    <div class="blog-card-meta">
                      <span class={`blog-card-format format-${post.data.format}`}>
                        <span class="format-dot"></span>{formatLabel[post.data.format]}
                      </span>
                      {post.data.readingTime && (
                        <>
                          <span class="blog-card-dot"></span>
                          <span class="blog-card-time">{post.data.readingTime}</span>
                        </>
                      )}
                    </div>
                    <div class="blog-card-footer">
                      <span class="blog-card-date">{formatDate(post.data.pubDate)}</span>
                      <span class="blog-card-read green">Read analysis <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      ))
    ) : (
      <div class="blog-empty cyber fi">
        <div class="blog-empty-icon">
          <svg width="36" height="36" viewBox="0 0 36 36" fill="none">
            <path d="M18 3L6 8v9c0 7.5 5 14 12 16 7-2 12-8.5 12-16V8L18 3z" stroke="url(#g-green)" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M13 18l3.5 3.5L23 14" stroke="url(#g-green)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="blog-empty-title">In preparation.</div>
        <div class="blog-empty-text">The first public cybersecurity cases will publish when NDA allows. Meanwhile, the practice remains active in pentest, vulnerability analysis, and offensive consulting.</div>
        <div class="blog-empty-cta">
          <a href="/contato" class="btn btn-ghost">Propose a security scope →</a>
        </div>
      </div>
    )}
  </section>

  <div class="section-sep"></div>

  <!-- ═══════════════ SCIENTIFIC COLLABORATION ═════════════════════════ -->
  <section class="blog-colab-cta">
    <div class="section-glow lilac" style="top:0;left:50%;transform:translateX(-50%);width:520px;height:380px"></div>
    <div class="section-glow blue" style="bottom:-60px;right:-100px"></div>
    <div class="container">
      <div class="blog-colab-inner fi">
        <div class="section-label" style="justify-content:center;margin-bottom:20px">
          <span class="label">Open Research Hub</span>
        </div>
        <h2 class="blog-colab-title">
          Research is<br /><span class="gradient-text">collective work.</span>
        </h2>
        <p class="blog-colab-sub">
          Researchers, frontier thinkers, independent scientists — if you have a study ready,
          a relevant dataset, or a question that fits one of the lines on our agenda, we want
          to hear. We publish with explicit co-authorship and exposed reasoning, the way
          science works.
        </p>
        <div class="blog-colab-modes">
          <span class="blog-colab-chip">Submit research</span>
          <span class="blog-colab-chip">Propose co-research</span>
          <span class="blog-colab-chip">Share data</span>
          <span class="blog-colab-chip">Peer review</span>
        </div>
        <div class="blog-colab-ctas">
          <a href="/colaborar" class="btn btn-primary">Collaboration proposal →</a>
          <a href="/colaborar" class="btn btn-ghost">How it works</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .blog-colab-cta {
    padding: 100px 28px 120px;
    position: relative;
    overflow: hidden;
  }
  .blog-colab-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 2;
  }
  .blog-colab-title {
    font-size: clamp(32px, 4.5vw, 52px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.12;
    margin-bottom: 20px;
    text-wrap: balance;
  }
  .blog-colab-sub {
    font-size: 16px;
    color: var(--muted);
    line-height: 1.75;
    margin: 0 auto 28px;
    max-width: 580px;
  }
  .blog-colab-modes {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }
  .blog-colab-chip {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 100px;
    border: 1px solid rgba(177, 140, 255, 0.22);
    background: rgba(177, 140, 255, 0.04);
    color: var(--lilac);
  }
  .blog-colab-ctas {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
