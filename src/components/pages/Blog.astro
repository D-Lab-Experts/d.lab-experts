---
import Layout from '../../layouts/Layout.astro';
import NeuralNetwork from '../NeuralNetwork.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations();

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const intelligencePosts = allPosts.filter((p) => p.data.track === 'intelligence');
const cybersecPosts = allPosts.filter((p) => p.data.track === 'cybersec');

type Post = (typeof allPosts)[number];
const byType = (posts: Post[], type: 'original' | 'secondary') =>
  posts.filter((p) => p.data.researchType === type);

const intelOriginal = byType(intelligencePosts, 'original');
const intelSecondary = byType(intelligencePosts, 'secondary');
const cyberOriginal = byType(cybersecPosts, 'original');
const cyberSecondary = byType(cybersecPosts, 'secondary');

const intelGroups = [
  { key: 'original',  label: t('blog.groupOriginalLabel'),  sub: t('blog.groupOriginalSub'),  posts: intelOriginal },
  { key: 'secondary', label: t('blog.groupSecondaryLabel'), sub: t('blog.groupSecondarySub'), posts: intelSecondary },
] as const;

const cyberGroups = [
  { key: 'original',  label: t('blog.cyberGroupOriginalLabel'),  sub: t('blog.cyberGroupOriginalSub'),  posts: cyberOriginal },
  { key: 'secondary', label: t('blog.cyberGroupSecondaryLabel'), sub: t('blog.cyberGroupSecondarySub'), posts: cyberSecondary },
] as const;

const formatDate = (d: Date) =>
  d.toLocaleDateString('pt-BR', { year: 'numeric', month: 'long' });

const formatLabel: Record<'briefing' | 'report' | 'foresight' | 'sector', string> = {
  briefing: t('formats.briefing'),
  report: t('formats.report'),
  foresight: t('formats.foresight'),
  sector: t('formats.sector'),
};

// D.Lab Research Series ID, formato "D.LAB #00X". Lê como
// identificador de catálogo de publicação, não de feed de blog.
const formatCatalogId = (volume?: string) =>
  volume ? `D.LAB #${String(volume).padStart(3, '0')}` : null;

// Lista compacta de autores pra rodar abaixo do título no card.
// Prefere citationAuthors (array curado) e cai pro `author` se não houver.
type PostData = Awaited<ReturnType<typeof getCollection<'blog'>>>[number]['data'];
const formatAuthors = (data: PostData) => {
  const list = data.citationAuthors && data.citationAuthors.length > 0
    ? data.citationAuthors
    : data.author.split(/\s*&\s*/).filter(Boolean);
  if (list.length === 0) return data.author;
  if (list.length === 1) return list[0];
  if (list.length === 2) return `${list[0]} · ${list[1]}`;
  return `${list[0]} · ${list[1]} · +${list.length - 2}`;
};

const methodLabel: Record<'original' | 'secondary', string> = {
  original: 'Pesquisa original',
  secondary: 'Dados secundários',
};
---

<Layout
  title={t('pageTitles.blog')}
  description={t('pageTitles.blogDescription')}
  active="blog"
>
  <!-- ═══════════════ BLOG HERO ═══════════════════════════════════ -->
  <section class="blog-hero">
    <div class="blog-hero-glow"></div>
    <NeuralNetwork color="white" density="low" opacity={0.12} />
    <div class="container">
      <div class="blog-hero-inner fi">
        <div class="section-label" style="justify-content:center"><span class="label">{t('blog.heroEyebrow')}</span></div>
        <h1 class="blog-hero-title">{t('blog.heroTitle')} <span class="gradient-text">{t('blog.heroTitleAccent')}</span></h1>
        <p class="blog-hero-sub">{t('blog.heroSub')}</p>
      </div>

      <div class="blog-track-nav fi d1">
        <a href="#inteligencia" class="blog-track-btn lilac">
          <span class="blog-track-btn-dot"></span>
          {t('blog.navIntel')}
          <span class="blog-track-btn-count">{intelligencePosts.length}</span>
        </a>
        <a href="#cybersec" class="blog-track-btn green">
          <span class="blog-track-btn-dot"></span>
          {t('blog.navCyber')}
          <span class="blog-track-btn-count">{cybersecPosts.length}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════ 01 · INTELLIGENCE ══════════════════════════ -->
  <section class="container blog-track-section" id="inteligencia">
    <div class="blog-track-header fi">
      <div class="blog-track-eyebrow lilac">
        <span class="blog-track-eyebrow-num">01</span>
        {t('blog.intelEyebrow')}
      </div>
      <h2 class="blog-track-title">{t('blog.intelTitle')} <span class="gradient-text">{t('blog.intelTitleAccent')}</span></h2>
      <p class="blog-track-sub">{t('blog.intelSub')}</p>
    </div>

    {intelligencePosts.length > 0 ? (
      intelGroups.filter((g) => g.posts.length > 0).map((group) => (
        <div class="blog-subtrack">
          <div class="blog-subtrack-header fi">
            <span class="blog-subtrack-tag lilac">
              <span class="blog-subtrack-dot"></span>
              {group.label}
              <span class="blog-subtrack-count">{group.posts.length}</span>
            </span>
            <p class="blog-subtrack-sub">{group.sub}</p>
          </div>
          <div class="blog-grid">
            {group.posts.map((post) => {
              const cardClass = 'blog-card blog-card-catalog fi d2';
              const catalogId = formatCatalogId(post.data.citationVolume);
              const authors = formatAuthors(post.data);
              const method = methodLabel[post.data.researchType];
              return (
                <a href={`/posts/${post.slug}`} class={cardClass}>
                  <div class="blog-card-img" style={`padding:0;background:${post.data.cover ? 'none' : 'var(--surface)'}`}>
                    {post.data.cover && (
                      <img src={post.data.cover} alt={post.data.coverAlt ?? ''} loading="lazy" width="800" height="450" style="width:100%;height:100%;object-fit:cover;position:relative;z-index:1" />
                    )}
                  </div>
                  <div class="blog-card-body">
                    <div class="blog-card-cataloghead">
                      {catalogId && <span class="blog-card-catalogid">{catalogId}</span>}
                      <span class="blog-card-catalogdate">{formatDate(post.data.pubDate)}</span>
                    </div>
                    <h3 class="blog-card-title">{post.data.title}</h3>
                    <div class="blog-card-authors">{authors}</div>
                    <p class="blog-card-excerpt">{post.data.description}</p>
                    <div class="blog-card-catalogfoot">
                      <span class="blog-card-methodtag">{method}</span>
                      <span class="blog-card-catalogmeta">
                        {formatLabel[post.data.format]}
                        {post.data.readingTime && <span class="blog-card-metasep">·</span>}
                        {post.data.readingTime}
                      </span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      ))
    ) : (
      <div class="blog-empty fi">
        <div class="blog-empty-title">{t('blog.emptyIntelTitle')}</div>
        <div class="blog-empty-text">{t('blog.emptyIntelText')}</div>
      </div>
    )}
  </section>

  <div class="section-sep"></div>

  <!-- ═══════════════ 02 · CYBERSECURITY ════════════════════════ -->
  <section class="container blog-track-section blog-track-cyber" id="cybersec">
    <div class="blog-track-header fi">
      <div class="blog-track-eyebrow green">
        <span class="blog-track-eyebrow-num">02</span>
        {t('blog.cyberEyebrow')}
      </div>
      <h2 class="blog-track-title">{t('blog.cyberTitle')} <span class="gradient-text-green">{t('blog.cyberTitleAccent')}</span></h2>
      <p class="blog-track-sub">{t('blog.cyberSub')}</p>
    </div>

    {cybersecPosts.length > 0 ? (
      cyberGroups.filter((g) => g.posts.length > 0).map((group) => (
        <div class="blog-subtrack">
          <div class="blog-subtrack-header fi">
            <span class="blog-subtrack-tag green">
              <span class="blog-subtrack-dot"></span>
              {group.label}
              <span class="blog-subtrack-count">{group.posts.length}</span>
            </span>
            <p class="blog-subtrack-sub">{group.sub}</p>
          </div>
          <div class="blog-grid">
            {group.posts.map((post) => {
              const cardClass = 'blog-card blog-card-catalog blog-card-catalog-cyber fi d2';
              const catalogId = formatCatalogId(post.data.citationVolume);
              const authors = formatAuthors(post.data);
              const method = methodLabel[post.data.researchType];
              return (
                <a href={`/posts/${post.slug}`} class={cardClass}>
                  <div class="blog-card-img" style={`padding:0;background:${post.data.cover ? 'none' : 'var(--surface)'}`}>
                    {post.data.cover && (
                      <img src={post.data.cover} alt={post.data.coverAlt ?? ''} loading="lazy" width="800" height="450" style="width:100%;height:100%;object-fit:cover;position:relative;z-index:1" />
                    )}
                  </div>
                  <div class="blog-card-body">
                    <div class="blog-card-cataloghead">
                      {catalogId && <span class="blog-card-catalogid">{catalogId}</span>}
                      <span class="blog-card-catalogdate">{formatDate(post.data.pubDate)}</span>
                    </div>
                    <h3 class="blog-card-title">{post.data.title}</h3>
                    <div class="blog-card-authors">{authors}</div>
                    <p class="blog-card-excerpt">{post.data.description}</p>
                    <div class="blog-card-catalogfoot">
                      <span class="blog-card-methodtag">{method}</span>
                      <span class="blog-card-catalogmeta">
                        {formatLabel[post.data.format]}
                        {post.data.readingTime && <span class="blog-card-metasep">·</span>}
                        {post.data.readingTime}
                      </span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      ))
    ) : (
      <div class="blog-empty cyber fi">
        <div class="blog-empty-icon">
          <svg width="36" height="36" viewBox="0 0 36 36" fill="none">
            <path d="M18 3L6 8v9c0 7.5 5 14 12 16 7-2 12-8.5 12-16V8L18 3z" stroke="url(#g-green)" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M13 18l3.5 3.5L23 14" stroke="url(#g-green)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="blog-empty-title">{t('blog.emptyCyberTitle')}</div>
        <div class="blog-empty-text">{t('blog.emptyCyberText')}</div>
        <div class="blog-empty-cta">
          <a href="/contato" class="btn btn-ghost">{t('blog.emptyCyberCta')}</a>
        </div>
      </div>
    )}
  </section>

  <div class="section-sep"></div>

  <!-- ═══════════════ SCIENTIFIC COLLABORATION ═════════════════════════ -->
  <section class="blog-colab-cta">
    <div class="section-glow lilac" style="top:0;left:50%;transform:translateX(-50%);width:520px;height:380px"></div>
    <div class="section-glow blue" style="bottom:-60px;right:-100px"></div>
    <div class="container">
      <div class="blog-colab-inner fi">
        <div class="section-label" style="justify-content:center;margin-bottom:20px">
          <span class="label">{t('blog.colabLabel')}</span>
        </div>
        <h2 class="blog-colab-title">
          {t('blog.colabTitle')}<br /><span class="gradient-text">{t('blog.colabTitleAccent')}</span>
        </h2>
        <p class="blog-colab-sub">{t('blog.colabSub')}</p>
        <div class="blog-colab-modes">
          <span class="blog-colab-chip">{t('blog.colabChipSubmit')}</span>
          <span class="blog-colab-chip">{t('blog.colabChipCo')}</span>
          <span class="blog-colab-chip">{t('blog.colabChipData')}</span>
          <span class="blog-colab-chip">{t('blog.colabChipPeer')}</span>
        </div>
        <div class="blog-colab-ctas">
          <a href="/colaborar" class="btn btn-primary">{t('blog.colabCtaPrimary')}</a>
          <a href="/colaborar" class="btn btn-ghost">{t('blog.colabCtaSecondary')}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .blog-colab-cta {
    padding: 100px 28px 120px;
    position: relative;
    overflow: hidden;
  }
  .blog-colab-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 2;
  }
  .blog-colab-title {
    font-size: clamp(32px, 4.5vw, 52px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.12;
    margin-bottom: 20px;
    text-wrap: balance;
  }
  .blog-colab-sub {
    font-size: 16px;
    color: var(--muted);
    line-height: 1.75;
    margin: 0 auto 28px;
    max-width: 580px;
  }
  .blog-colab-modes {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }
  .blog-colab-chip {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 100px;
    border: 1px solid rgba(234,234,240, 0.22);
    background: rgba(234,234,240, 0.04);
    color: var(--lilac);
  }
  .blog-colab-ctas {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
