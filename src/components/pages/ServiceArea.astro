---
import Layout from '../../layouts/Layout.astro';
import NeuralNetwork from '../NeuralNetwork.astro';
import { localize } from '../../i18n/utils';
import { defaultLocale, type Locale } from '../../i18n/ui';
import type { ServiceArea } from '../../i18n/pt';

// Página por frente da constelação de serviços. O conteúdo é
// data-driven (props `area` + `chrome` + `related`), então as rotas
// PT (/solucoes/[area]) e EN (/en/solucoes/[area]) compartilham este
// template e só injetam o dicionário do seu locale.
type Chrome = {
  backToAll: string;
  heroDiagnosisCta: string;
  relatedCardCta: string;
  problemLabel: string;
  helpLabel: string;
  howLabel: string;
  metricLabel: string;
  metricDisclaimer: string;
  relatedLabel: string;
  ctaTitle: string;
  ctaSub: string;
  ctaPrimary: string;
  ctaSecondary: string;
  steps: ReadonlyArray<{ title: string; body: string }>;
};

interface Props {
  area: ServiceArea;
  chrome: Chrome;
  related: ServiceArea[];
  locale?: Locale;
}

const { area, chrome: c, related, locale = defaultLocale } = Astro.props;
const href = (path: string) => localize(path, locale);
---

<Layout title={area.seoTitle} description={area.seoDescription} active="solucoes" locale={locale}>
  <!-- Acento da página = cor do "planeta" da área na constelação. -->
  <div class="area" style={`--area: ${area.accent}; --area-deep: ${area.accentDeep};`}>
    <!-- ═══════════════ HERO ═════════════════════════════════════════ -->
    <section class="area-hero">
      <div
        class="area-hero-glow"
        style={`background: radial-gradient(closest-side, ${area.accent}33, transparent 70%);`}
      >
      </div>
      <NeuralNetwork color="white" density="low" opacity={0.1} />
      <div class="container">
        <a href={href('/solucoes')} class="area-back">{c.backToAll}</a>
        <div class="area-hero-inner fi">
          <span class="area-tag">
            <span class="area-tag-dot"></span>
            {area.tag}
          </span>
          <h1 class="area-title">
            {area.title} <span class="gradient-text">{area.titleAccent}</span>
          </h1>
          <p class="area-sub">{area.sub}</p>
          <div class="area-hero-cta">
            <a href={href('/contato')} class="btn btn-primary">{c.ctaPrimary}</a>
            <a href={href('/diagnostico')} class="btn btn-ghost">{c.heroDiagnosisCta}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════ DESAFIO + COMO AJUDAMOS ═══════════════════════ -->
    <section class="area-body">
      <div class="container area-grid">
        <div class="area-problem fi">
          <span class="area-eyebrow">{c.problemLabel}</span>
          <p class="area-problem-text">{area.problem}</p>
        </div>
        <div class="area-help fi d1">
          <span class="area-eyebrow">{c.helpLabel}</span>
          <ul class="area-help-list">
            {area.help.map((item) => <li>{item}</li>)}
          </ul>
          <div class="area-metric">
            <div class="area-metric-val">{area.metricVal}</div>
            <div class="area-metric-note">{c.metricLabel} · {area.metricNote}</div>
          </div>
        </div>
      </div>
      <p class="container area-disclaimer fi">{c.metricDisclaimer}</p>
    </section>

    <!-- ═══════════════ COMO IMPLEMENTAMOS ════════════════════════════ -->
    <section class="area-how">
      <div class="container">
        <h2 class="area-h2 fi">{c.howLabel}</h2>
        <div class="area-steps fi d1">
          {c.steps.map((step, i) => (
            <div class="area-step">
              <div class="area-step-num">{i + 1}</div>
              <h3 class="area-step-title">{step.title}</h3>
              <p class="area-step-body">{step.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════ OUTRAS FRENTES ════════════════════════════════ -->
    {related.length > 0 && (
      <section class="area-related">
        <div class="container">
          <h2 class="area-h2 fi">{c.relatedLabel}</h2>
          <div class="area-related-grid fi d1">
            {related.map((r) => (
              <a
                href={href(`/solucoes/${r.slug}`)}
                class="area-related-card"
                style={`--area: ${r.accent}; --area-deep: ${r.accentDeep};`}
              >
                <span class="area-related-dot"></span>
                <span class="area-related-tag">{r.tag}</span>
                <span class="area-related-title">{r.titleAccent ? `${r.title} ${r.titleAccent}` : r.title}</span>
                <span class="area-related-arrow">{c.relatedCardCta}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ═══════════════ CTA FINAL ═════════════════════════════════════ -->
    <section class="area-cta">
      <div
        class="area-hero-glow"
        style={`background: radial-gradient(closest-side, ${area.accent}2e, transparent 70%); top:50%; left:50%; transform:translate(-50%,-50%);`}
      >
      </div>
      <div class="container fi">
        <h2>{c.ctaTitle}</h2>
        <p>{c.ctaSub}</p>
        <div class="area-cta-row">
          <a href={href('/contato')} class="btn btn-primary">{c.ctaPrimary}</a>
          <a href={href('/solucoes')} class="btn btn-ghost">{c.ctaSecondary}</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .area { position: relative; z-index: 1; }

  /* ── HERO ─────────────────────────────────────────────────────── */
  .area-hero { padding: 150px 0 60px; position: relative; overflow: hidden; }
  .area-hero-glow {
    position: absolute; top: -40px; left: 50%; transform: translateX(-50%);
    width: 620px; height: 620px; max-width: 120%;
    filter: blur(40px); z-index: 0; pointer-events: none;
  }
  .area-hero .container { position: relative; z-index: 2; }
  .area-back {
    display: inline-block; margin-bottom: 22px;
    font-size: 13px; font-weight: 600; color: var(--text-muted);
    text-decoration: none; transition: color .2s;
  }
  .area-back:hover { color: var(--area, var(--accent)); }
  .area-hero-inner { max-width: 760px; }
  .area-tag {
    display: inline-flex; align-items: center; gap: 9px;
    font-size: 11px; font-weight: 700; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--area, var(--accent));
    margin-bottom: 20px;
  }
  .area-tag-dot {
    width: 9px; height: 9px; border-radius: 50%;
    background: radial-gradient(circle at 32% 28%, #fff, var(--area, var(--accent)) 70%);
    box-shadow: 0 0 12px 1px var(--area, var(--accent));
  }
  .area-title {
    font-family: var(--font-display);
    font-size: clamp(34px, 5vw, 58px); font-weight: 700;
    letter-spacing: -0.035em; line-height: 1.08;
    margin-bottom: 22px; text-wrap: balance;
  }
  .area-sub {
    font-size: 17px; color: var(--text-muted); line-height: 1.7;
    max-width: 660px; margin: 0 0 30px; text-wrap: pretty;
  }
  .area-hero-cta { display: flex; gap: 12px; flex-wrap: wrap; }

  /* ── DESAFIO + COMO AJUDAMOS ──────────────────────────────────── */
  .area-body { padding: clamp(36px, 5vw, 64px) 0 20px; position: relative; z-index: 1; }
  .area-grid {
    display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 28px;
    align-items: start;
  }
  .area-eyebrow {
    display: block; font-size: 10px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--area, var(--accent)); margin-bottom: 16px;
  }
  .area-problem {
    padding: 30px 30px; border-radius: 18px;
    background: var(--bg-elev); border: 1px solid var(--line);
    position: relative; overflow: hidden;
  }
  .area-problem::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
    background: linear-gradient(var(--area, var(--accent)), transparent);
  }
  .area-problem-text {
    font-size: 17px; line-height: 1.7; color: var(--ink); margin: 0;
    text-wrap: pretty;
  }
  .area-help {
    padding: 30px 32px; border-radius: 18px;
    background: var(--bg-elev); border: 1px solid var(--line);
  }
  .area-help-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  .area-help-list li {
    position: relative; padding-left: 30px;
    font-size: 15.5px; line-height: 1.6; color: var(--ink);
  }
  .area-help-list li::before {
    content: ''; position: absolute; left: 0; top: 3px;
    width: 18px; height: 18px; border-radius: 50%;
    background: var(--area, var(--accent)); opacity: 0.16;
  }
  .area-help-list li::after {
    content: ''; position: absolute; left: 5px; top: 8px;
    width: 8px; height: 5px;
    border-left: 1.6px solid var(--area, var(--accent));
    border-bottom: 1.6px solid var(--area, var(--accent));
    transform: rotate(-45deg);
  }
  .area-metric {
    margin-top: 26px; padding-top: 22px; border-top: 1px dashed var(--line);
  }
  .area-metric-val {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(22px, 2.6vw, 30px); letter-spacing: -0.02em;
    color: var(--area, var(--accent)); line-height: 1.1; margin-bottom: 8px;
  }
  .area-metric-note {
    font-size: 10px; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--text-dim);
  }
  .area-disclaimer { font-size: 12px; color: var(--text-dim); margin: 22px auto 0; }

  /* ── COMO IMPLEMENTAMOS ───────────────────────────────────────── */
  .area-how { padding: clamp(40px, 6vw, 72px) 0; position: relative; z-index: 1; }
  .area-h2 {
    font-family: var(--font-display); font-size: clamp(24px, 3vw, 34px);
    font-weight: 700; letter-spacing: -0.03em; line-height: 1.15;
    margin: 0 0 32px; text-wrap: balance;
  }
  .area-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .area-step {
    padding: 28px 26px 26px; border-radius: 18px;
    background: var(--bg-elev); border: 1px solid var(--line);
    transition: border-color .3s, transform .3s;
  }
  .area-step:hover { border-color: var(--area, var(--accent)); transform: translateY(-3px); }
  .area-step-num {
    width: 38px; height: 38px; border-radius: 11px;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-weight: 700; font-size: 16px;
    color: var(--area, var(--accent));
    background: color-mix(in srgb, var(--area, var(--accent)) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--area, var(--accent)) 36%, transparent);
    margin-bottom: 18px;
  }
  .area-step-title {
    font-family: var(--font-display); font-size: 18px; font-weight: 600;
    letter-spacing: -0.02em; color: var(--ink); margin: 0 0 10px;
  }
  .area-step-body { font-size: 14.5px; line-height: 1.65; color: var(--text-muted); margin: 0; }

  /* ── OUTRAS FRENTES ───────────────────────────────────────────── */
  .area-related { padding: clamp(20px, 4vw, 48px) 0 clamp(40px, 6vw, 72px); position: relative; z-index: 1; }
  .area-related-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
  .area-related-card {
    display: flex; flex-direction: column; gap: 8px;
    padding: 24px 26px; border-radius: 18px;
    background: var(--bg-elev); border: 1px solid var(--line);
    text-decoration: none; color: inherit;
    transition: border-color .3s, transform .3s;
  }
  .area-related-card:hover { border-color: var(--area, var(--accent)); transform: translateY(-3px); }
  .area-related-dot {
    width: 14px; height: 14px; border-radius: 50%;
    background: radial-gradient(circle at 30% 26%, #fff, var(--area-deep, #4C1D95) 72%);
    box-shadow: 0 0 12px 1px color-mix(in srgb, var(--area, var(--accent)) 60%, transparent);
  }
  .area-related-tag {
    font-size: 10px; font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--area, var(--accent));
  }
  .area-related-title {
    font-family: var(--font-display); font-size: 18px; font-weight: 600;
    letter-spacing: -0.02em; color: var(--ink); line-height: 1.25;
  }
  .area-related-arrow { font-size: 13px; font-weight: 600; color: var(--text-muted); margin-top: 4px; }
  .area-related-card:hover .area-related-arrow { color: var(--area, var(--accent)); }

  /* ── CTA FINAL ────────────────────────────────────────────────── */
  .area-cta { padding: clamp(56px, 8vw, 110px) 0; text-align: center; position: relative; overflow: hidden; z-index: 1; }
  .area-cta .container { position: relative; z-index: 2; }
  .area-cta h2 {
    font-family: var(--font-display); font-size: clamp(26px, 3.4vw, 40px);
    font-weight: 700; letter-spacing: -0.03em; line-height: 1.15;
    margin-bottom: 16px; text-wrap: balance;
  }
  .area-cta p { font-size: 16px; color: var(--text-muted); max-width: 580px; margin: 0 auto 28px; line-height: 1.7; }
  .area-cta-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

  /* ── RESPONSIVO ───────────────────────────────────────────────── */
  @media (max-width: 860px) {
    .area-grid { grid-template-columns: 1fr; }
    .area-steps { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .area-hero { padding: 130px 0 40px; }
    .area-related-grid { grid-template-columns: 1fr; }
    .area-problem, .area-help { padding: 24px 22px; }
  }

  /* color-mix fallback: navegadores sem suporte usam o acento sólido. */
  @supports not (color: color-mix(in srgb, red 50%, blue)) {
    .area-step-num { background: var(--accent-tint); border-color: rgba(167,139,250,0.36); }
  }
</style>
