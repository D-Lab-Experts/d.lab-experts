---
import Layout from '../../layouts/Layout.astro';
import NeuralNetwork from '../NeuralNetwork.astro';
import { useTranslations, getLocaleFromUrl, localize } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const href = (path: string) => localize(path, locale);

// TODO: trocar pelo endpoint real do Formspree (https://formspree.io/forms).
// O e-mail capturado cai na sua base do Formspree quando o lead desbloqueia.
const FORMSPREE = 'https://formspree.io/f/SEU_ID_FORMSPREE';

const solutions = ['s1', 's2', 's3', 's4', 's5'] as const;
---

<Layout
  title={t('pageTitles.solucoes')}
  description={t('pageTitles.solucoesDescription')}
  active="solucoes"
  locale={locale}
>
  <!-- ═══════════════ HERO ═════════════════════════════════════════ -->
  <section class="sol-hero">
    <div class="section-glow lilac" style="top:-40px;left:50%;transform:translateX(-50%)"></div>
    <div class="section-glow blue" data-parallax="0.08" style="bottom:0;right:-60px"></div>
    <NeuralNetwork color="white" density="low" opacity={0.12} />
    <div class="container">
      <div class="sol-hero-inner fi">
        <div class="sol-eyebrow">
          <span style="width:22px;height:1px;background:var(--grad);display:block"></span>
          {t('solucoesPage.heroEyebrow')}
        </div>
        <h1 class="sol-title">
          {t('solucoesPage.heroTitleLead')} <span class="gradient-text">{t('solucoesPage.heroTitleAccent')}</span>
        </h1>
        <p class="sol-sub">{t('solucoesPage.heroSub')}</p>
      </div>
    </div>
  </section>

  <!-- (Removido) COMMITMENT STRIP — era o posicionamento "tudo grátis";
       não cabe na aba de Serviços (pagos). O grátis vive no Blog. -->

  <!-- ═══════════════ SERVIÇOS · grid aberto (sem gate) ══════════════
       Conteúdo aberto: problema → o que entregamos → como implementamos.
       Sem e-mail-gate (evita gatekeeping desnecessário). A captura de
       lead acontece no CTA (diagnóstico) e no contato. -->
  <section id="solucoes-gate" class="solg-section">
    <div class="container">
      <div class="solg-grid fi d2">
        {solutions.map((s) => (
          <article class="solg-card">
            <span class="solg-card-tag">{t(`solGate.${s}Tag`)}</span>
            <h3 class="solg-card-title">{t(`solGate.${s}Title`)}</h3>
            <p class="solg-card-teaser">{t(`solGate.${s}Teaser`)}</p>
            <div class="solg-card-detail">
              <div class="solg-detail-label">{t('solGate.detailLabel')}</div>
              <ul>
                <li>{t(`solGate.${s}d1`)}</li>
                <li>{t(`solGate.${s}d2`)}</li>
                <li>{t(`solGate.${s}d3`)}</li>
              </ul>
            </div>
            <div class="solg-card-foot">
              <a href={href('/contato')} class="solg-card-link">{t('solGate.cardCta')}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- (Removido) TOOLS GRID — as ferramentas gratuitas (Diagnóstico e
       Componentes IA) saíram da aba de Serviços e agora são promovidas
       no Blog (banner + 1 post cada). As páginas /diagnostico e
       /componentes-ia seguem ativas. -->

  <!-- ═══════════════ FINAL CTA ═══════════════════════════════════ -->
  <section class="sol-cta">
    <div class="section-glow lilac" style="top:50%;left:50%;transform:translate(-50%,-50%)"></div>
    <div class="container fi">
      <h2>{t('solucoesPage.ctaTitle')}</h2>
      <p>{t('solucoesPage.ctaSub')}</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a href={href('/contato')} class="btn btn-primary">{t('solucoesPage.ctaPrimary')}</a>
        <a href={href('/blog')} class="btn btn-ghost">{t('solucoesPage.ctaSecondary')}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ═══════════ HERO ═══════════════════════════════════════════ */
  .sol-hero {
    padding: 150px 0 60px;
    position: relative;
    overflow: hidden;
    z-index: 1;
  }
  .sol-hero-inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 2;
  }
  .sol-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lilac);
    margin-bottom: 24px;
  }
  .sol-title {
    font-size: clamp(36px, 5vw, 60px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: 22px;
    text-wrap: balance;
  }
  .sol-sub {
    font-size: 16px;
    color: var(--muted);
    line-height: 1.7;
    max-width: 680px;
    margin: 0 auto;
    text-wrap: pretty;
  }

  /* ═══════════ COMMITMENT STRIP ═════════════════════════════════
     Fica entre hero e tools. Carrega dois sinais: (1) tudo gratuito,
     (2) comunidade que agrega valor. Sem competir com a hero. */
  .sol-commitment {
    padding: 24px 0 16px;
    position: relative;
    z-index: 1;
  }
  .sol-commitment-inner {
    max-width: 980px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 22px;
    align-items: start;
    padding: 22px 28px;
    background: linear-gradient(120deg, rgba(234,234,240, 0.08), rgba(234,234,240, 0.04) 70%, transparent);
    border: 1px solid rgba(234,234,240, 0.22);
    border-radius: 16px;
  }
  .sol-commitment-mark {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: rgba(234,234,240, 0.1);
    border: 1px solid rgba(234,234,240, 0.28);
    flex-shrink: 0;
  }
  .sol-commitment-copy {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .sol-commitment-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--lilac);
  }
  .sol-commitment-title {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--white);
    line-height: 1.25;
    margin: 0;
  }
  .sol-commitment-body {
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
    margin: 4px 0 0;
  }
  @media (max-width: 640px) {
    .sol-commitment-inner { grid-template-columns: 1fr; padding: 20px 22px; }
  }

  /* ═══════════ TOOLS GRID ══════════════════════════════════════ */
  .sol-section {
    padding: 40px 0 60px;
    position: relative;
    z-index: 1;
  }
  .sol-tools-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .sol-tool {
    display: flex;
    flex-direction: column;
    padding: 32px 34px 30px;
    background: linear-gradient(165deg, rgba(26, 26, 40, 0.85), rgba(22, 22, 32, 0.65));
    border: 1px solid var(--border);
    border-radius: 20px;
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(.16, 1, .3, 1), border-color 0.3s, box-shadow 0.3s;
  }
  .sol-tool::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 20px;
    background: linear-gradient(165deg, rgba(234,234,240, 0.08), transparent 60%);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .sol-tool-live:hover {
    transform: translateY(-4px);
    border-color: rgba(234,234,240, 0.42);
    box-shadow: 0 32px 70px rgba(0, 0, 0, 0.4), 0 0 60px rgba(234,234,240, 0.06);
  }
  .sol-tool-wip:hover {
    transform: translateY(-2px);
    border-color: rgba(234,234,240, 0.3);
  }
  .sol-tool:hover::before { opacity: 1; }

  .sol-tool-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
  }
  .sol-tool-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 12px;
    border-radius: 100px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .sol-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }
  .sol-status-live {
    background: rgba(234,234,240, 0.1);
    border: 1px solid rgba(234,234,240, 0.28);
    color: var(--green);
  }
  .sol-status-live .sol-status-dot {
    background: var(--green);
    box-shadow: 0 0 10px rgba(234,234,240, 0.7);
    animation: solPulse 2.2s ease-in-out infinite;
  }
  .sol-status-wip {
    background: rgba(234,234,240, 0.08);
    border: 1px solid rgba(234,234,240, 0.24);
    color: var(--yellow);
  }
  .sol-status-wip .sol-status-dot {
    background: var(--yellow);
    box-shadow: 0 0 8px rgba(234,234,240, 0.6);
  }
  @keyframes solPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.55; transform: scale(1.3); }
  }
  .sol-tool-category {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dimmed);
  }

  .sol-tool-icon {
    margin-bottom: 22px;
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background: rgba(22, 22, 32, 0.6);
    border: 1px solid rgba(234,234,240, 0.14);
  }
  .sol-tool-wip .sol-tool-icon {
    border-color: rgba(234,234,240, 0.16);
  }

  .sol-tool-title {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 12px;
    color: var(--white);
  }
  .sol-tool-desc {
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
    margin: 0 0 20px;
    flex: 1;
  }

  .sol-tool-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }
  .sol-chip {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 100px;
    background: rgba(234,234,240, 0.06);
    border: 1px solid rgba(234,234,240, 0.14);
    color: var(--muted);
  }
  .sol-tool-wip .sol-chip {
    background: rgba(234,234,240, 0.04);
    border-color: rgba(234,234,240, 0.14);
  }
  .sol-chip-wip {
    color: var(--yellow);
    background: rgba(234,234,240, 0.08);
    border-color: rgba(234,234,240, 0.22);
  }
  /* "Gratuito" — mais destaque que os demais chips, já que é o
     diferencial mais visível da estratégia. */
  .sol-chip-free {
    color: var(--green);
    background: rgba(234,234,240, 0.1);
    border-color: rgba(234,234,240, 0.3);
    font-weight: 700;
  }

  .sol-tool-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--lilac);
    padding: 11px 20px;
    border-radius: 100px;
    border: 1px solid rgba(234,234,240, 0.32);
    background: rgba(234,234,240, 0.06);
    transition: gap 0.25s, border-color 0.25s, background 0.25s;
  }
  .sol-tool-live:hover .sol-tool-cta {
    gap: 12px;
    border-color: rgba(234,234,240, 0.55);
    background: rgba(234,234,240, 0.14);
  }
  .sol-tool-cta-wip {
    color: var(--green);
    border-color: rgba(234,234,240, 0.28);
    background: rgba(234,234,240, 0.05);
  }
  .sol-tool-wip:hover .sol-tool-cta-wip {
    gap: 12px;
    border-color: rgba(234,234,240, 0.5);
    background: rgba(234,234,240, 0.1);
  }

  /* ═══════════ FINAL CTA ══════════════════════════════════════ */
  .sol-cta {
    padding: 80px 0 120px;
    text-align: center;
    position: relative;
    z-index: 1;
    overflow: hidden;
  }
  .sol-cta h2 {
    font-size: clamp(26px, 3.2vw, 38px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 16px;
    text-wrap: balance;
  }
  .sol-cta p {
    font-size: 15px;
    color: var(--muted);
    max-width: 540px;
    margin: 0 auto 28px;
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .sol-tools-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .sol-hero { padding: 130px 0 40px; }
    .sol-tool { padding: 26px 24px 24px; }
    .sol-tool-head { flex-wrap: wrap; }
    .sol-tool-title { font-size: 19px; }
  }

  /* ═══════════ SOLUÇÕES · E-MAIL-GATE ═════════════════════════════ */
  .solg-section { padding: clamp(40px,6vw,80px) 0 20px; position: relative; z-index: 1; }
  .solg-head { text-align: center; max-width: 760px; margin: 0 auto 40px; }
  .solg-gate {
    max-width: 760px; margin: 0 auto 44px;
    background: var(--bg-elev); border: 1px solid rgba(167,139,250,0.30);
    border-radius: 18px; padding: 24px 26px;
    display: flex; flex-direction: column; gap: 16px;
  }
  .solg-gate.is-unlocked { display: none; }
  .solg-gate-copy { display: flex; align-items: flex-start; gap: 14px; }
  .solg-gate-lock { width: 40px; height: 40px; flex-shrink: 0; display:flex; align-items:center; justify-content:center; border-radius: 10px; background: var(--accent-tint); border: 1px solid rgba(167,139,250,0.3); color: var(--accent); }
  .solg-gate-title { font-family: var(--font-display); font-weight: 600; font-size: 18px; letter-spacing: -.02em; color: var(--ink); margin: 0 0 4px; }
  .solg-gate-sub { font-size: 13.5px; line-height: 1.55; color: var(--text-muted); margin: 0; }
  .solg-gate-fields { display: flex; gap: 10px; flex-wrap: wrap; }
  .solg-input {
    flex: 1; min-width: 220px;
    background: var(--bg); border: 1px solid var(--line); border-radius: 100px;
    padding: 13px 20px; color: var(--ink); font-size: 15px; font-family: inherit;
  }
  .solg-input:focus { outline: none; border-color: var(--accent); }
  .solg-submit { white-space: nowrap; }
  .solg-consent { display: flex; align-items: flex-start; gap: 10px; font-size: 12.5px; line-height: 1.5; color: var(--text-muted); cursor: pointer; }
  .solg-consent input { margin-top: 2px; width: 16px; height: 16px; accent-color: var(--accent); flex-shrink: 0; }
  .solg-consent a { color: var(--accent); text-decoration: underline; }
  .solg-msg { font-size: 13px; margin: 0; min-height: 1em; }
  .solg-msg.is-error { color: #ff9b9b; }
  .solg-msg.is-ok { color: var(--accent-strong); }
  .solg-sronly { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); }

  .solg-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; max-width: 1120px; margin: 0 auto; }
  .solg-card { display: flex; flex-direction: column; padding: 24px 24px 20px; background: var(--bg-elev); border: 1px solid var(--line); border-radius: 18px; transition: border-color .3s, transform .3s; }
  .solg-card:hover { border-color: rgba(167,139,250,0.4); transform: translateY(-3px); }
  .solg-card-tag { font-size: 10px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--accent-strong); margin-bottom: 8px; }
  .solg-card-title { font-family: var(--font-display); font-weight: 600; font-size: 18px; letter-spacing: -.02em; color: var(--ink); margin: 0 0 10px; }
  .solg-card-teaser { font-size: 14px; line-height: 1.6; color: var(--text-muted); margin: 0 0 14px; flex: 1; }
  .solg-card-detail { border-top: 1px dashed var(--line); padding-top: 14px; margin-bottom: 14px; }
  .solg-detail-label { font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); margin-bottom: 10px; }
  .solg-card-detail ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .solg-card-detail li { position: relative; padding-left: 20px; font-size: 13px; line-height: 1.5; color: var(--ink); }
  .solg-card-detail li::before { content: ''; position: absolute; left: 0; top: 6px; width: 10px; height: 6px; border-left: 1.5px solid var(--accent); border-bottom: 1.5px solid var(--accent); transform: rotate(-45deg); }
  .solg-card-foot { margin-top: auto; }
  .solg-card-link { font-size: 13px; font-weight: 600; color: var(--accent); text-decoration: none; }
  .solg-card-link:hover { color: var(--accent-strong); }
  @media (max-width: 900px) { .solg-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .solg-grid { grid-template-columns: 1fr; } }
</style>
