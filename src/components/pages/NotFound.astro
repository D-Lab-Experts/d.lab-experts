---
import Layout from '../../layouts/Layout.astro';
import type { Locale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Layout
  title={t('pageTitles.notFound')}
  description={t('pageTitles.notFoundDescription')}
  locale={locale}
>
  <section class="nf-hero">
    <div class="section-glow lilac" style="top:0;left:50%;transform:translateX(-50%);width:500px;height:400px"></div>
    <div class="section-glow blue" style="bottom:0;right:-80px"></div>
    <div class="container">
      <div class="nf-inner fi">
        <div class="nf-code">
          <span class="gradient-text">404</span>
        </div>
        <h1 class="nf-title">This page doesn't exist.</h1>
        <p class="nf-sub">
          The URL you reached may have moved, been renamed, or never existed at all. But we
          have plenty of content for you to explore.
        </p>
        <div class="nf-ctas">
          <a href="/" class="btn btn-primary">Back to the home →</a>
          <a href="/blog" class="btn btn-ghost">See open publications</a>
        </div>

        <div class="nf-search-hint">
          <div class="label" style="margin-bottom:12px">Shortcuts</div>
          <ul class="nf-links">
            <li><a href="/#segments">Research agenda</a></li>
            <li><a href="/#products">Consulting practices</a></li>
            <li><a href="/about">About D.Lab Experts</a></li>
            <li><a href="/blog">Open publications</a></li>
            <li><a href="/rss.xml">Publications RSS</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .nf-hero {
    padding: 180px 0 140px;
    position: relative;
    z-index: 1;
    overflow: hidden;
    min-height: calc(100vh - var(--nav-h) - 200px);
    display: flex;
    align-items: center;
  }
  .nf-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }
  .nf-code {
    font-size: clamp(110px, 18vw, 200px);
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 1;
    margin-bottom: 24px;
    opacity: 0.95;
  }
  .nf-title {
    font-size: clamp(28px, 3.4vw, 38px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.12;
    margin-bottom: 18px;
  }
  .nf-sub {
    font-size: 17px;
    color: var(--muted);
    line-height: 1.7;
    max-width: 520px;
    margin: 0 auto 40px;
  }
  .nf-ctas {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 56px;
  }
  .nf-search-hint {
    border-top: 1px solid var(--border);
    padding-top: 36px;
    max-width: 420px;
    margin: 0 auto;
  }
  .nf-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 24px;
    list-style: none;
    padding: 0;
    margin: 0;
    text-align: left;
  }
  .nf-links a {
    font-size: 14px;
    color: var(--muted);
    transition: color 0.2s;
    display: inline-block;
    padding: 4px 0;
  }
  .nf-links a:hover {
    color: var(--lilac);
  }
  @media (max-width: 640px) {
    .nf-links { grid-template-columns: 1fr; }
    .nf-ctas { flex-direction: column; align-items: stretch; }
    .nf-ctas .btn { justify-content: center; }
  }
</style>
