---
import Layout from '../../layouts/Layout.astro';
import NeuralNetwork from '../NeuralNetwork.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations();
---

<Layout
  title={t('pageTitles.about')}
  description={t('pageTitles.aboutDescription')}
  active="about"
>
  <!-- ═══════════════ HERO ═════════════════════════════════════════ -->
  <section class="about-hero">
    <div class="section-glow lilac" style="top:-50px;left:50%;transform:translateX(-50%)"></div>
    <div class="section-glow blue" style="bottom:0;right:-100px"></div>
    <NeuralNetwork color="lilac" density="medium" opacity={0.30} />
    <div class="container">
      <div class="about-hero-inner fi">
        <div style="display:inline-flex;align-items:center;gap:10px;margin-bottom:24px"><span class="label" style="display:flex;align-items:center;gap:10px"><span style="width:20px;height:1px;background:var(--grad);display:block"></span>{t('aboutPage.heroEyebrow')}</span></div>
        <h1 class="about-hero-title">{t('aboutPage.heroTitle')}<br /><span class="gradient-text">{t('aboutPage.heroTitleAccent')}</span></h1>
        <p class="about-hero-sub">{t('aboutPage.heroSub')}</p>
      </div>

      <div class="atom-container fi d1">
        <div class="atom">
          <div class="atom-glow"></div>
          <div class="atom-nucleus"></div>
          <div class="atom-orbit atom-orbit-1">
            <div class="atom-orbit-wrap atom-orbit-wrap-1">
              <div class="atom-orbit-ring"></div>
              <div class="atom-electron atom-electron-1"></div>
            </div>
          </div>
          <div class="atom-orbit atom-orbit-2">
            <div class="atom-orbit-wrap atom-orbit-wrap-2">
              <div class="atom-orbit-ring"></div>
              <div class="atom-electron atom-electron-2"></div>
            </div>
          </div>
          <div class="atom-orbit atom-orbit-3">
            <div class="atom-orbit-wrap atom-orbit-wrap-3">
              <div class="atom-orbit-ring"></div>
              <div class="atom-electron atom-electron-3"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="about-stats fi d2">
        <div class="about-stat">
          <div class="about-stat-val" style="color:var(--lilac)">$ 4.4T</div>
          <div class="about-stat-lbl">{t('aboutPage.heroStatAILabel')}</div>
        </div>
        <div class="about-stat">
          <div class="about-stat-val" style="color:var(--blue)">73%</div>
          <div class="about-stat-lbl">{t('aboutPage.heroStatSmbLabel')}</div>
        </div>
        <div class="about-stat">
          <div class="about-stat-val" style="color:var(--cyan)">$ 4.88M</div>
          <div class="about-stat-lbl">{t('aboutPage.heroStatBreachLabel')}</div>
        </div>
        <div class="about-stat">
          <div class="about-stat-val" style="color:var(--green)">{t('aboutPage.heroStatDualVal')}</div>
          <div class="about-stat-lbl">{t('aboutPage.heroStatDualLabel')}</div>
        </div>
      </div>
    </div>
  </section>

  <div class="section-sep"></div>

  <!-- ═══════════════ WHO WE ARE ════════════════════════════════════ -->
  <section class="about-section">
    <div class="section-glow lilac" style="top:30%;left:-120px"></div>
    <div class="container">
      <div class="about-split fi">
        <aside class="about-split-aside">
          <div class="about-split-eyebrow">{t('aboutPage.whoEyebrow')}</div>
          <h2>{t('aboutPage.whoTitle')}</h2>
          <p class="lead" set:html={t('aboutPage.whoLead')}></p>
          <div class="aside-stats">
            <div class="aside-stat">
              <div class="aside-stat-val" style="color:var(--lilac)">73%</div>
              <div class="aside-stat-lbl">{t('aboutPage.whoAsideIntuitLabel')}<br />{t('aboutPage.whoAsideIntuitSrc')}</div>
            </div>
            <div class="aside-stat">
              <div class="aside-stat-val" style="color:var(--blue)">23×</div>
              <div class="aside-stat-lbl">{t('aboutPage.whoAsideCustLabel')}<br />{t('aboutPage.whoAsideCustSrc')}</div>
            </div>
            <div class="aside-stat">
              <div class="aside-stat-val" style="color:var(--cyan)">$ 4.88M</div>
              <div class="aside-stat-lbl">{t('aboutPage.whoAsideBreachLabel')}<br />{t('aboutPage.whoAsideBreachSrc')}</div>
            </div>
          </div>
        </aside>
        <div class="about-split-content">
          <p set:html={t('aboutBody.p1')}></p>
          <p set:html={t('aboutBody.p2')}></p>
          <div class="split-insight">
            <span set:html={t('aboutBody.insight')}></span>
            <span class="src">{t('aboutBody.insightSource')}</span>
          </div>
          <p set:html={t('aboutBody.p3')}></p>
          <p set:html={t('aboutBody.p4')}></p>
        </div>
      </div>
    </div>
  </section>

  <div class="section-sep"></div>

  <!-- ═══════════════ WHAT WE RESEARCH ══════════════════════════════ -->
  <section class="about-section">
    <div class="section-glow blue" style="top:20%;right:-100px"></div>
    <div class="section-glow cyan" style="bottom:10%;left:-80px"></div>
    <div class="container">
      <div class="about-section-header fi">
        <div class="eyebrow">{t('aboutPage.scopeEyebrow')}</div>
        <h2>{t('aboutPage.scopeTitle')}</h2>
        <p class="lead">{t('aboutPage.scopeLead')}</p>
      </div>

      <div class="services-split">
        <div class="service-card data fi-l d1">
          <div class="service-card-icon lilac">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><rect x="3" y="3" width="7" height="7" rx="2" stroke="url(#g1)" stroke-width="1.5"/><rect x="12" y="3" width="7" height="7" rx="2" stroke="url(#g1)" stroke-width="1.5"/><rect x="3" y="12" width="7" height="7" rx="2" stroke="url(#g1)" stroke-width="1.5"/><path d="M15.5 12v7M12 15.5h7" stroke="url(#g1)" stroke-width="1.5" stroke-linecap="round"/></svg>
          </div>
          <h3>{t('aboutPage.intelName')}</h3>
          <p set:html={t('aboutPage.intelDesc')}></p>
          <ul>
            <li>{t('aboutPage.intelItem1')}</li>
            <li>{t('aboutPage.intelItem2')}</li>
            <li>{t('aboutPage.intelItem3')}</li>
            <li>{t('aboutPage.intelItem4')}</li>
            <li>{t('aboutPage.intelItem5')}</li>
            <li>{t('aboutPage.intelItem6')}</li>
          </ul>
        </div>
        <div class="service-card cyber fi-r d1">
          <div class="service-card-icon cyan">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M11 2L4 5.5v5c0 4.7 3 8.5 7 10 4-1.5 7-5.3 7-10v-5L11 2z" stroke="url(#g-green)" stroke-width="1.5" stroke-linejoin="round"/><path d="M8 11l2.5 2.5L14.5 9" stroke="url(#g-green)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3>{t('aboutPage.cyberName')}</h3>
          <p set:html={t('aboutPage.cyberDesc')}></p>
          <ul>
            <li>{t('aboutPage.cyberItem1')}</li>
            <li>{t('aboutPage.cyberItem2')}</li>
            <li>{t('aboutPage.cyberItem3')}</li>
            <li>{t('aboutPage.cyberItem4')}</li>
            <li>{t('aboutPage.cyberItem5')}</li>
            <li>{t('aboutPage.cyberItem6')}</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <div class="section-sep"></div>

  <!-- ═══════════════ METHODOLOGY ════════════════════════════════ -->
  <section class="about-section">
    <div class="section-glow lilac" style="top:50%;right:-100px"></div>
    <div class="container">
      <div class="about-section-header fi">
        <div class="eyebrow">{t('aboutPage.methodEyebrow')}</div>
        <h2>{t('aboutPage.methodTitle')}</h2>
        <p class="lead">{t('aboutPage.methodLead')}</p>
      </div>

      <div class="method-steps fi d1">
        <div class="method-step">
          <div class="method-step-num">01</div>
          <div class="method-step-title">{t('aboutPage.methodStep1Title')}</div>
          <div class="method-step-desc">{t('aboutPage.methodStep1Desc')}</div>
        </div>
        <div class="method-step">
          <div class="method-step-num">02</div>
          <div class="method-step-title">{t('aboutPage.methodStep2Title')}</div>
          <div class="method-step-desc">{t('aboutPage.methodStep2Desc')}</div>
        </div>
        <div class="method-step">
          <div class="method-step-num">03</div>
          <div class="method-step-title">{t('aboutPage.methodStep3Title')}</div>
          <div class="method-step-desc">{t('aboutPage.methodStep3Desc')}</div>
        </div>
        <div class="method-step">
          <div class="method-step-num">04</div>
          <div class="method-step-title">{t('aboutPage.methodStep4Title')}</div>
          <div class="method-step-desc">{t('aboutPage.methodStep4Desc')}</div>
        </div>
      </div>

      <div class="pillars-grid fi">
        <div class="pillar">
          <div class="pillar-icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 2L12.5 7.5H18L13.5 11L15.5 17L10 13.5L4.5 17L6.5 11L2 7.5H7.5L10 2Z" stroke="url(#g1)" stroke-width="1.2" stroke-linejoin="round"/></svg></div>
          <div class="pillar-title">{t('aboutPage.pillar1Title')}</div>
          <div class="pillar-desc">{t('aboutPage.pillar1Desc')}</div>
        </div>
        <div class="pillar">
          <div class="pillar-icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="7" stroke="url(#g1)" stroke-width="1.2"/><circle cx="10" cy="10" r="3" stroke="url(#g1)" stroke-width="1.2"/><path d="M10 3v2M10 15v2M3 10h2M15 10h2" stroke="url(#g1)" stroke-width="1" stroke-linecap="round"/></svg></div>
          <div class="pillar-title">{t('aboutPage.pillar2Title')}</div>
          <div class="pillar-desc">{t('aboutPage.pillar2Desc')}</div>
        </div>
        <div class="pillar">
          <div class="pillar-icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M3 15l4-4 3 2.5 4-5.5 3-2" stroke="url(#g-green)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          <div class="pillar-title">{t('aboutPage.pillar3Title')}</div>
          <div class="pillar-desc">{t('aboutPage.pillar3Desc')}</div>
        </div>
        <div class="pillar">
          <div class="pillar-icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 2L4 5.5v5c0 4 2.5 7.2 6 8.5 3.5-1.3 6-4.5 6-8.5v-5L10 2z" stroke="url(#g-green)" stroke-width="1.2" stroke-linejoin="round"/><path d="M7.5 10l2 2 3.5-4" stroke="url(#g-green)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          <div class="pillar-title">{t('aboutPage.pillar4Title')}</div>
          <div class="pillar-desc">{t('aboutPage.pillar4Desc')}</div>
        </div>
      </div>
    </div>
  </section>

  <div class="section-sep"></div>

  <!-- ═══════════════ WHY NOW ══════════════════════════════════════ -->
  <section class="about-section">
    <div class="section-glow cyan" style="top:30%;left:-80px"></div>
    <div class="container">
      <div class="about-split fi">
        <aside class="about-split-aside">
          <div class="about-split-eyebrow">{t('aboutPage.whyEyebrow')}</div>
          <h2>{t('aboutPage.whyTitleLead')} <span class="gradient-text">{t('aboutPage.whyTitleAccent')}</span></h2>
          <p class="lead">{t('aboutPage.whyLead')}</p>
          <div class="aside-stats">
            <div class="aside-stat">
              <div class="aside-stat-val" style="color:var(--lilac)">29%</div>
              <div class="aside-stat-lbl">{t('aboutPage.whyAsideFailLabel')}<br />{t('aboutPage.whyAsideFailSrc')}</div>
            </div>
            <div class="aside-stat">
              <div class="aside-stat-val" style="color:var(--cyan)">+72%</div>
              <div class="aside-stat-lbl">{t('aboutPage.whyAsideRansomLabel')}<br />{t('aboutPage.whyAsideRansomSrc')}</div>
            </div>
            <div class="aside-stat">
              <div class="aside-stat-val" style="color:var(--green)">$ 33B</div>
              <div class="aside-stat-lbl">{t('aboutPage.whyAsideBiLabel')}<br />{t('aboutPage.whyAsideBiSrc')}</div>
            </div>
          </div>
        </aside>
        <div class="about-split-content">
          <p set:html={t('aboutPage.whyP1')}></p>
          <p set:html={t('aboutPage.whyP2')}></p>
          <div class="split-insight">
            <span set:html={t('aboutPage.whyInsight')}></span>
            <span class="src">{t('aboutPage.whyInsightSrc')}</span>
          </div>
          <p set:html={t('aboutPage.whyP3')}></p>
          <p set:html={t('aboutPage.whyP4')}></p>
        </div>
      </div>
    </div>
  </section>

  <div class="section-sep"></div>

  <!-- ═══════════════ CTA ═══════════════════════════════════════════ -->
  <section class="about-cta">
    <div class="section-glow lilac" style="top:50%;left:50%;transform:translate(-50%,-50%)"></div>
    <div class="container fi">
      <h2>{t('aboutPage.ctaTitleLead')}<br /><span class="gradient-text">{t('aboutPage.ctaTitleAccent')}</span></h2>
      <p>{t('aboutPage.ctaLead')}</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a href="/blog" class="btn btn-primary">{t('aboutPage.ctaPrimary')}</a>
        <a href="/contato" class="btn btn-ghost">{t('aboutPage.ctaSecondary')}</a>
      </div>
    </div>
  </section>
</Layout>
