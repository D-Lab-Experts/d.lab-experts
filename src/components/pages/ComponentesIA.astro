---
import Layout from '../../layouts/Layout.astro';
import NeuralNetwork from '../NeuralNetwork.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations();
---

<Layout
  title={t('pageTitles.componentesIa')}
  description={t('pageTitles.componentesIaDescription')}
  active="solucoes"
>
  <!-- ═══════════════ HERO ═════════════════════════════════════════ -->
  <section class="cia-hero">
    <div class="section-glow lilac" style="top:-40px;left:50%;transform:translateX(-50%)"></div>
    <div class="section-glow blue" style="bottom:0;right:-60px"></div>
    <NeuralNetwork color="lilac" density="low" opacity={0.24} />
    <div class="container">
      <div class="cia-hero-inner fi">
        <a class="cia-breadcrumb" href="/solucoes">{t('componentesIaPage.heroBreadcrumbBack')}</a>
        <div class="cia-eyebrow">
          <span style="width:22px;height:1px;background:var(--grad);display:block"></span>
          {t('componentesIaPage.heroEyebrow')}
        </div>
        <h1 class="cia-title">
          {t('componentesIaPage.heroTitleLead')} <span class="gradient-text">{t('componentesIaPage.heroTitleAccent')}</span>
        </h1>
        <p class="cia-sub">{t('componentesIaPage.heroSub')}</p>
      </div>
    </div>
  </section>

  <!-- ═══════════════ COMMITMENT STRIP ═══════════════════════════ -->
  <section class="cia-commitment">
    <div class="container">
      <div class="cia-commitment-inner fi">
        <div class="cia-commitment-mark" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M10 2l2.5 5L18 8l-4 4 1 6-5-3-5 3 1-6-4-4 5.5-1L10 2z" stroke="url(#g1)" stroke-width="1.2" stroke-linejoin="round" fill="rgba(177,140,255,0.08)"/>
          </svg>
        </div>
        <div class="cia-commitment-copy">
          <span class="cia-commitment-label">{t('componentesIaPage.commitmentLabel')}</span>
          <h2 class="cia-commitment-title">{t('componentesIaPage.commitmentTitle')}</h2>
          <p class="cia-commitment-body">{t('componentesIaPage.commitmentBody')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ LIST ═══════════════════════════════════════ -->
  <section class="cia-section">
    <div class="container">
      <div class="cia-list-head fi">
        <span class="cia-list-label">{t('componentesIaPage.listLabel')}</span>
        <p class="cia-list-sub">{t('componentesIaPage.listSub')}</p>
      </div>

      <div class="cia-grid">
        <!-- SKILL 1 — Research & Statistics Engine -->
        <a class="cia-card fi" href="/componentes-ia/research-statistics-engine">
          <div class="cia-card-head">
            <span class="cia-card-status">
              <span class="cia-card-dot"></span>
              {t('componentesIaPage.skill1Status')}
            </span>
            <span class="cia-card-type">{t('componentesIaPage.skill1Type')}</span>
          </div>

          <div class="cia-card-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" width="48" height="48">
              <defs>
                <linearGradient id="cia-g-stats" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#B18CFF"/>
                  <stop offset="100%" stop-color="#4DA3FF"/>
                </linearGradient>
              </defs>
              <!-- Bar chart -->
              <rect x="8"  y="28" width="6" height="14" rx="1" fill="url(#cia-g-stats)" opacity="0.55"/>
              <rect x="18" y="20" width="6" height="22" rx="1" fill="url(#cia-g-stats)" opacity="0.75"/>
              <rect x="28" y="12" width="6" height="30" rx="1" fill="url(#cia-g-stats)"/>
              <rect x="38" y="22" width="6" height="20" rx="1" fill="url(#cia-g-stats)" opacity="0.6"/>
              <!-- Trendline -->
              <path d="M8 26 L21 18 L31 10 L41 18" stroke="#B18CFF" stroke-width="1.6" stroke-linecap="round" fill="none" opacity="0.85"/>
              <circle cx="31" cy="10" r="2.4" fill="#B18CFF"/>
            </svg>
          </div>

          <h3 class="cia-card-title">{t('componentesIaPage.skill1Title')}</h3>
          <p class="cia-card-subtitle">{t('componentesIaPage.skill1Subtitle')}</p>
          <p class="cia-card-desc">{t('componentesIaPage.skill1Desc')}</p>

          <div class="cia-card-tags">
            <span class="cia-tag">{t('componentesIaPage.skill1Tag1')}</span>
            <span class="cia-tag">{t('componentesIaPage.skill1Tag2')}</span>
            <span class="cia-tag">{t('componentesIaPage.skill1Tag3')}</span>
            <span class="cia-tag">{t('componentesIaPage.skill1Tag4')}</span>
          </div>

          <span class="cia-card-cta">{t('componentesIaPage.skill1Cta')}</span>
        </a>

        <!-- Placeholder slot for upcoming items (visual rhythm) -->
        <div class="cia-card cia-card-empty fi d1" aria-hidden="true">
          <div class="cia-card-empty-inner">
            <div class="cia-card-empty-dot"></div>
            <p>{t('componentesIaPage.listEmpty')}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ CTA ═══════════════════════════════════════ -->
  <section class="cia-cta">
    <div class="section-glow lilac" style="top:50%;left:50%;transform:translate(-50%,-50%)"></div>
    <div class="container fi">
      <h2>{t('componentesIaPage.ctaTitle')}</h2>
      <p>{t('componentesIaPage.ctaSub')}</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a href="/colaborar" class="btn btn-primary">{t('componentesIaPage.ctaPrimary')}</a>
        <a href="/solucoes" class="btn btn-ghost">{t('componentesIaPage.ctaSecondary')}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ═════════ HERO ═════════════════════════════════════════════ */
  .cia-hero {
    padding: 130px 0 50px;
    position: relative;
    overflow: hidden;
    z-index: 1;
  }
  .cia-hero-inner {
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 2;
  }
  .cia-breadcrumb {
    display: inline-block;
    margin-bottom: 22px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .cia-breadcrumb:hover { color: var(--lilac); }
  .cia-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lilac);
    margin-bottom: 22px;
  }
  .cia-title {
    font-size: clamp(34px, 4.8vw, 56px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: 22px;
    text-wrap: balance;
  }
  .cia-sub {
    font-size: 16px;
    color: var(--muted);
    line-height: 1.7;
    max-width: 660px;
    margin: 0 auto;
    text-wrap: pretty;
  }

  /* ═════════ COMMITMENT ═════════════════════════════════════ */
  .cia-commitment {
    padding: 18px 0 12px;
    position: relative;
    z-index: 1;
  }
  .cia-commitment-inner {
    max-width: 980px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 22px;
    align-items: start;
    padding: 22px 28px;
    background: linear-gradient(120deg, rgba(177, 140, 255, 0.08), rgba(0, 229, 160, 0.04) 70%, transparent);
    border: 1px solid rgba(177, 140, 255, 0.22);
    border-radius: 16px;
  }
  .cia-commitment-mark {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: rgba(177, 140, 255, 0.1);
    border: 1px solid rgba(177, 140, 255, 0.28);
    flex-shrink: 0;
  }
  .cia-commitment-copy { display: flex; flex-direction: column; gap: 6px; }
  .cia-commitment-label {
    font-size: 10px; font-weight: 700; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--lilac);
  }
  .cia-commitment-title {
    font-size: 19px; font-weight: 700; letter-spacing: -0.015em;
    color: var(--white); line-height: 1.25; margin: 0;
  }
  .cia-commitment-body { font-size: 14px; line-height: 1.7; color: var(--muted); margin: 4px 0 0; }
  @media (max-width: 640px) {
    .cia-commitment-inner { grid-template-columns: 1fr; padding: 20px 22px; }
  }

  /* ═════════ LIST ═══════════════════════════════════════════ */
  .cia-section {
    padding: 40px 0 50px;
    position: relative;
    z-index: 1;
  }
  .cia-list-head {
    max-width: 1100px;
    margin: 0 auto 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .cia-list-label {
    font-size: 11px; font-weight: 700; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--lilac);
  }
  .cia-list-sub { font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0; max-width: 720px; }

  .cia-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .cia-card {
    display: flex;
    flex-direction: column;
    padding: 32px 34px 30px;
    background: linear-gradient(165deg, rgba(26, 26, 40, 0.85), rgba(22, 22, 32, 0.65));
    border: 1px solid var(--border);
    border-radius: 20px;
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(.16, 1, .3, 1), border-color 0.3s, box-shadow 0.3s;
  }
  .cia-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 20px;
    background: linear-gradient(165deg, rgba(177, 140, 255, 0.08), transparent 60%);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }
  a.cia-card:hover {
    transform: translateY(-4px);
    border-color: rgba(177, 140, 255, 0.42);
    box-shadow: 0 32px 70px rgba(0, 0, 0, 0.4), 0 0 60px rgba(177, 140, 255, 0.06);
  }
  a.cia-card:hover::before { opacity: 1; }

  .cia-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
  }
  .cia-card-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 12px;
    border-radius: 100px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: rgba(0, 229, 160, 0.1);
    border: 1px solid rgba(0, 229, 160, 0.28);
    color: var(--green);
  }
  .cia-card-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 10px rgba(0, 229, 160, 0.7);
    animation: ciaPulse 2.2s ease-in-out infinite;
  }
  @keyframes ciaPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.55; transform: scale(1.3); }
  }
  .cia-card-type {
    font-size: 10px; font-weight: 600; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--lilac);
  }

  .cia-card-icon {
    margin-bottom: 20px;
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background: rgba(22, 22, 32, 0.6);
    border: 1px solid rgba(177, 140, 255, 0.14);
  }

  .cia-card-title {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0 0 4px;
    color: var(--white);
  }
  .cia-card-subtitle {
    font-size: 13px;
    color: var(--lilac);
    margin: 0 0 14px;
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  .cia-card-desc {
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
    margin: 0 0 22px;
    flex: 1;
  }
  .cia-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 22px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }
  .cia-tag {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 100px;
    background: rgba(177, 140, 255, 0.06);
    border: 1px solid rgba(177, 140, 255, 0.14);
    color: var(--muted);
  }
  .cia-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--lilac);
    padding: 11px 20px;
    border-radius: 100px;
    border: 1px solid rgba(177, 140, 255, 0.32);
    background: rgba(177, 140, 255, 0.06);
    transition: gap 0.25s, border-color 0.25s, background 0.25s;
  }
  a.cia-card:hover .cia-card-cta {
    gap: 12px;
    border-color: rgba(177, 140, 255, 0.55);
    background: rgba(177, 140, 255, 0.14);
  }

  /* Placeholder slot — discrete, only signaling rhythm */
  .cia-card-empty {
    border: 1px dashed rgba(255, 255, 255, 0.08);
    background: rgba(22, 22, 32, 0.35);
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 280px;
  }
  .cia-card-empty-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 24px;
  }
  .cia-card-empty-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(177, 140, 255, 0.18);
    box-shadow: 0 0 16px rgba(177, 140, 255, 0.25);
  }
  .cia-card-empty p {
    font-size: 13px;
    color: var(--dimmed, rgba(234, 234, 240, 0.35));
    margin: 0;
    letter-spacing: 0.04em;
  }

  /* ═════════ CTA ═══════════════════════════════════════════ */
  .cia-cta {
    padding: 70px 0 110px;
    text-align: center;
    position: relative;
    z-index: 1;
    overflow: hidden;
  }
  .cia-cta h2 {
    font-size: clamp(26px, 3.2vw, 38px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 16px;
    text-wrap: balance;
  }
  .cia-cta p {
    font-size: 15px;
    color: var(--muted);
    max-width: 540px;
    margin: 0 auto 24px;
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .cia-grid { grid-template-columns: 1fr; }
    .cia-card-empty { min-height: 160px; }
  }
  @media (max-width: 640px) {
    .cia-hero { padding: 110px 0 36px; }
    .cia-card { padding: 26px 24px 24px; }
    .cia-card-head { flex-wrap: wrap; }
    .cia-card-title { font-size: 19px; }
  }
</style>
