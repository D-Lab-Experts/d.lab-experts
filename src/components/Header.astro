---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { defaultLocale, type Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

export interface Props {
  active?: 'home' | 'about' | 'segments' | 'products' | 'blog' | 'contato' | 'colaborar' | 'diagnostic';
  locale: Locale;
  alternateUrls?: Partial<Record<Locale, string>>;
}
const { active, locale, alternateUrls } = Astro.props;
const t = useTranslations(locale);

// Locale-aware internal URLs. Hash anchors live on the locale home
// so /pt/#segments scrolls on the PT homepage.
const localePrefix = locale === defaultLocale ? '' : `/${locale}`;
const href = (path: string) => `${localePrefix}${path}`;

// Diagnostic uses a locale-specific slug (EN 'diagnostic' / PT
// 'diagnostico'), so it doesn't follow the shared prefix helper.
const diagnosticHref = locale === 'pt' ? '/pt/diagnostico' : '/diagnostic';

type Link = {
  href: string;
  label: string;
  key: Props['active'];
  highlight?: boolean;
  badge?: string;
};

const links: Array<Link> = [
  { href: href('/#hero'), label: t('nav.home'), key: 'home' },
  { href: href('/about'), label: t('nav.about'), key: 'about' },
  { href: href('/#segments'), label: t('nav.segments'), key: 'segments' },
  { href: href('/#products'), label: t('nav.products'), key: 'products' },
  { href: href('/blog'), label: t('nav.blog'), key: 'blog', highlight: true },
  { href: diagnosticHref, label: t('nav.diagnostic'), key: 'diagnostic', badge: 'NEW' },
  { href: href('/contato'), label: t('nav.contato'), key: 'contato' },
];
---

<nav id="nav">
  <div class="nav-inner">
    <a href={href('/')} class="nav-logo" aria-label={t('nav.ariaLogo')}>
      <img src="/d.lab-mark.webp" alt="D.Lab Experts" class="nav-logo-img" width="71" height="16" />
    </a>
    <ul class="nav-links">
      {links.map((link) => {
        const classes = [
          active === link.key ? 'active' : '',
          link.highlight ? 'nav-link-dual' : '',
          link.badge ? 'nav-link-badge' : '',
        ].filter(Boolean).join(' ');
        return (
          <li>
            <a href={link.href} class={classes}>
              {link.label}
              {link.highlight && <span class="nav-dot-dual" aria-hidden="true"></span>}
              {link.badge && <span class="nav-badge">{link.badge}</span>}
            </a>
          </li>
        );
      })}
    </ul>
    <div class="nav-ctas">
      <LanguageSwitcher locale={locale} alternateUrls={alternateUrls} />
      <a href={href('/contato')} class="btn btn-primary btn-sm">{t('nav.ctaProblem')}</a>
    </div>
    <button class="hamburger" id="hamburger" aria-label={t('nav.ariaOpenMenu')}>
      <span></span><span></span><span></span>
    </button>
  </div>
  <!-- Scroll progress bar — glued to the bottom edge of the nav,
       width grows from 0 → 100% as the user scrolls the page. -->
  <div id="scroll-progress" aria-hidden="true"></div>
</nav>

<div class="mobile-menu" id="mobile-menu">
  {links.map((link) => (
    <a
      href={link.href}
      data-mm-link
      class:list={[link.highlight && 'nav-link-dual', link.badge && 'nav-link-badge']}
    >
      {link.label}
      {link.highlight && <span class="nav-dot-dual" aria-hidden="true"></span>}
      {link.badge && <span class="nav-badge">{link.badge}</span>}
    </a>
  ))}
  <div class="mobile-lang-switcher">
    <LanguageSwitcher locale={locale} alternateUrls={alternateUrls} />
  </div>
  <div class="mobile-ctas">
    <a href={href('/contato')} class="btn btn-primary">{t('nav.ctaProblem')}</a>
  </div>
</div>

<style>
  .nav-ctas { display: inline-flex; align-items: center; gap: 14px; }
  .mobile-lang-switcher {
    display: flex;
    justify-content: center;
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }
  /* NEW-badge on a nav link. Sits to the right of the label, small,
     gradient pill so it reads as a deliberate signal — not an ad. */
  .nav-link-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .nav-badge {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--grad);
    color: #fff;
    line-height: 1;
    transform: translateY(-1px);
  }
  @media (max-width: 1023px) {
    .nav-badge { transform: translateY(0); }
  }
</style>
