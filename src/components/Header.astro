---
import { useTranslations } from '../i18n/utils';

export interface Props {
  active?: 'home' | 'about' | 'segments' | 'products' | 'blog' | 'contato' | 'colaborar' | 'solucoes';
}
const { active } = Astro.props;
const t = useTranslations();

type Child = {
  href: string;
  label: string;
  key: Props['active'];
  highlight?: boolean;
};
type Link = {
  href?: string;
  label: string;
  key?: Props['active'];
  highlight?: boolean;
  badge?: string;
  // When present, this item renders as a dropdown grouping the children.
  children?: Child[];
};

const links: Array<Link> = [
  { href: '/#hero', label: t('nav.home'), key: 'home' },
  { href: '/about', label: t('nav.about'), key: 'about' },
  { href: '/#segments', label: t('nav.segments'), key: 'segments' },
  { href: '/#products', label: t('nav.products'), key: 'products' },
  {
    label: t('nav.hub'),
    children: [
      { href: '/blog', label: t('nav.blog'), key: 'blog', highlight: true },
      { href: '/solucoes', label: t('nav.solucoes'), key: 'solucoes' },
      { href: '/colaborar', label: t('nav.collaborate'), key: 'colaborar' },
    ],
  },
  { href: '/contato', label: t('nav.contato'), key: 'contato' },
];

const isChildActive = (children: Child[] = []) => children.some((c) => c.key === active);
---

<nav id="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label={t('nav.ariaLogo')}>
      <img src="/d.lab-logo.png" class="nav-logo-img" alt="D.Lab" width="1082" height="240" />
    </a>
    <ul class="nav-links">
      {links.map((link) => {
        if (link.children) {
          return (
            <li class="nav-dropdown">
              <button
                type="button"
                class:list={['nav-dropdown-trigger', isChildActive(link.children) && 'active']}
                aria-haspopup="true"
                aria-expanded="false"
              >
                {link.label}
                <svg class="nav-dropdown-caret" width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2.5 4.5L6 8l3.5-3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <div class="nav-dropdown-panel">
                <ul>
                  {link.children.map((c) => (
                    <li>
                      <a
                        href={c.href}
                        class:list={[active === c.key && 'active', c.highlight && 'nav-link-dual']}
                      >
                        {c.label}
                        {c.highlight && <span class="nav-dot-dual" aria-hidden="true"></span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          );
        }
        const classes = [
          active === link.key ? 'active' : '',
          link.highlight ? 'nav-link-dual' : '',
          link.badge ? 'nav-link-badge' : '',
        ].filter(Boolean).join(' ');
        return (
          <li>
            <a href={link.href} class={classes}>
              {link.label}
              {link.highlight && <span class="nav-dot-dual" aria-hidden="true"></span>}
              {link.badge && <span class="nav-badge">{link.badge}</span>}
            </a>
          </li>
        );
      })}
    </ul>
    <div class="nav-ctas">
      <a href="/contato" class="btn btn-primary btn-sm">{t('nav.ctaProblem')}</a>
    </div>
    <button class="hamburger" id="hamburger" aria-label={t('nav.ariaOpenMenu')}>
      <span></span><span></span><span></span>
    </button>
  </div>
  <!-- Scroll progress bar — glued to the bottom edge of the nav,
       width grows from 0 → 100% as the user scrolls the page. -->
  <div id="scroll-progress" aria-hidden="true"></div>
</nav>

<div class="mobile-menu" id="mobile-menu">
  {links.map((link) =>
    link.children ? (
      <div class="mobile-menu-group">
        <span class="mobile-menu-group-label">{link.label}</span>
        {link.children.map((c) => (
          <a
            href={c.href}
            data-mm-link
            class:list={['mobile-menu-sublink', active === c.key && 'active', c.highlight && 'nav-link-dual']}
          >
            {c.label}
            {c.highlight && <span class="nav-dot-dual" aria-hidden="true"></span>}
          </a>
        ))}
      </div>
    ) : (
      <a
        href={link.href}
        data-mm-link
        class:list={[active === link.key && 'active', link.highlight && 'nav-link-dual', link.badge && 'nav-link-badge']}
      >
        {link.label}
        {link.highlight && <span class="nav-dot-dual" aria-hidden="true"></span>}
        {link.badge && <span class="nav-badge">{link.badge}</span>}
      </a>
    )
  )}
  <div class="mobile-ctas">
    <a href="/contato" class="btn btn-primary">{t('nav.ctaProblem')}</a>
  </div>
</div>

<style>
  .nav-ctas { display: inline-flex; align-items: center; gap: 14px; }
  .nav-link-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .nav-badge {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--grad);
    color: #fff;
    line-height: 1;
    transform: translateY(-1px);
  }
  @media (max-width: 1023px) {
    .nav-badge { transform: translateY(0); }
  }
</style>
