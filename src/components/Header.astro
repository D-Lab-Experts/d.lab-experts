---
import { useTranslations } from '../i18n/utils';

export interface Props {
  active?: 'home' | 'about' | 'segments' | 'products' | 'blog' | 'contato' | 'colaborar' | 'solucoes';
}
const { active } = Astro.props;
const t = useTranslations();

type Link = {
  href: string;
  label: string;
  key: Props['active'];
  highlight?: boolean;
  badge?: string;
};

const links: Array<Link> = [
  { href: '/#hero', label: t('nav.home'), key: 'home' },
  { href: '/about', label: t('nav.about'), key: 'about' },
  { href: '/#segments', label: t('nav.segments'), key: 'segments' },
  { href: '/#products', label: t('nav.products'), key: 'products' },
  { href: '/blog', label: t('nav.blog'), key: 'blog', highlight: true },
  { href: '/solucoes', label: t('nav.solucoes'), key: 'solucoes' },
  { href: '/contato', label: t('nav.contato'), key: 'contato' },
];
---

<nav id="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label={t('nav.ariaLogo')}>
      <img src="/d.lab-mark.webp" alt="D.Lab Experts" class="nav-logo-img" width="71" height="16" />
    </a>
    <ul class="nav-links">
      {links.map((link) => {
        const classes = [
          active === link.key ? 'active' : '',
          link.highlight ? 'nav-link-dual' : '',
          link.badge ? 'nav-link-badge' : '',
        ].filter(Boolean).join(' ');
        return (
          <li>
            <a href={link.href} class={classes}>
              {link.label}
              {link.highlight && <span class="nav-dot-dual" aria-hidden="true"></span>}
              {link.badge && <span class="nav-badge">{link.badge}</span>}
            </a>
          </li>
        );
      })}
    </ul>
    <div class="nav-ctas">
      <a href="/contato" class="btn btn-primary btn-sm">{t('nav.ctaProblem')}</a>
    </div>
    <button class="hamburger" id="hamburger" aria-label={t('nav.ariaOpenMenu')}>
      <span></span><span></span><span></span>
    </button>
  </div>
  <!-- Scroll progress bar — glued to the bottom edge of the nav,
       width grows from 0 → 100% as the user scrolls the page. -->
  <div id="scroll-progress" aria-hidden="true"></div>
</nav>

<div class="mobile-menu" id="mobile-menu">
  {links.map((link) => (
    <a
      href={link.href}
      data-mm-link
      class:list={[link.highlight && 'nav-link-dual', link.badge && 'nav-link-badge']}
    >
      {link.label}
      {link.highlight && <span class="nav-dot-dual" aria-hidden="true"></span>}
      {link.badge && <span class="nav-badge">{link.badge}</span>}
    </a>
  ))}
  <div class="mobile-ctas">
    <a href="/contato" class="btn btn-primary">{t('nav.ctaProblem')}</a>
  </div>
</div>

<style>
  .nav-ctas { display: inline-flex; align-items: center; gap: 14px; }
  .nav-link-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .nav-badge {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--grad);
    color: #fff;
    line-height: 1;
    transform: translateY(-1px);
  }
  @media (max-width: 1023px) {
    .nav-badge { transform: translateY(0); }
  }
</style>
