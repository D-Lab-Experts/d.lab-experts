---
import { defaultLocale, type Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
// EN visitors never see this — the page they're on IS the canonical
// English version. The notice only renders for /pt/* and /es/* routes
// whose body still falls back to EN copy.
const showNotice = locale !== defaultLocale;
const t = useTranslations(locale);
---

{showNotice && (
  <div class="translation-notice" role="status">
    <div class="container">
      <div class="translation-notice-inner">
        <span class="translation-notice-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.2" opacity="0.5"/>
            <path d="M7 4v3M7 9.5v.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="translation-notice-heading">{t('translationNotice.heading')}</span>
        <span class="translation-notice-divider" aria-hidden="true">·</span>
        <span class="translation-notice-message">{t('translationNotice.message')}</span>
      </div>
    </div>
  </div>
)}

<style>
  .translation-notice {
    background: rgba(177, 140, 255, 0.06);
    border-bottom: 1px solid rgba(177, 140, 255, 0.12);
    padding: 10px 0;
    position: relative;
    z-index: 5;
  }
  .translation-notice-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 12px;
    color: var(--muted);
  }
  .translation-notice-icon {
    display: inline-flex;
    color: var(--lilac);
    flex-shrink: 0;
  }
  .translation-notice-heading {
    font-weight: 600;
    color: var(--lilac);
    letter-spacing: 0.04em;
  }
  .translation-notice-divider {
    color: var(--dimmed);
    opacity: 0.6;
  }
  .translation-notice-message {
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .translation-notice-divider { display: none; }
    .translation-notice-inner { flex-direction: column; gap: 4px; text-align: center; }
  }
</style>
