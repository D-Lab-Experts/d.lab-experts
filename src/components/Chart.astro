---
/**
 * Chart.astro — wrapper editorial para visualizações de publicação.
 *
 * Padronização inspirada em FT, Our World in Data, Economist:
 *   título   → label sóbrio em Satoshi, pé do gráfico
 *   nota     → linha explicativa em dimmed (unidades, recorte temporal)
 *   gráfico  → SVG passado via <slot/>, numerais em mono via .chart-num
 *   fonte    → CITADA explicitamente abaixo do gráfico, sempre
 *
 * A regra é: nenhum gráfico de publicação aparece sem fonte. Se
 * `source` não for declarado, o componente emite warning no build.
 */

export interface Props {
  /** Título curto do gráfico. Ex.: "Óbitos de ciclistas, 2010-2023". */
  title: string;
  /** Linha explicativa opcional: recorte, unidade, observação. */
  note?: string;
  /** Fonte citada. Obrigatório. Ex.: "SIM/DATASUS · reconciliação D.Lab". */
  source: string;
  /** Aspect ratio do slot SVG. Default: 'auto' (deixa o SVG decidir). */
  ratio?: 'auto' | 'wide' | 'square' | 'short';
  /** Cor de destaque do dot do título (lilac/blue/green/yellow). */
  accent?: 'lilac' | 'blue' | 'green' | 'yellow';
}

const { title, note, source, ratio = 'auto', accent = 'lilac' } = Astro.props;

if (!source) {
  console.warn(`[Chart] sem fonte citada: ${title}`);
}
---

<figure class={`chart-card chart-ratio-${ratio} chart-accent-${accent}`}>
  <figcaption class="chart-head">
    <div class="chart-title">
      <span class="chart-title-dot" aria-hidden="true"></span>
      {title}
    </div>
    {note && <div class="chart-note">{note}</div>}
  </figcaption>

  <div class="chart-body">
    <slot />
  </div>

  <div class="chart-source">
    <span class="chart-source-label">Fonte</span>
    <span class="chart-source-text">{source}</span>
  </div>
</figure>

<style>
  /* ── Chart card ─────────────────────────────────────────────────
     Padrão de publicação: tipografia em Satoshi (UI), eixos/numerais
     do SVG passado via slot em DM Mono via .chart-num utility class. */
  .chart-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 28px 28px 22px;
    margin: 32px 0;
    overflow: hidden;
    font-family: var(--font-sans);
  }
  .chart-head {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 22px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }
  .chart-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--white);
    letter-spacing: 0.01em;
  }
  .chart-title-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  /* Accent prop API preservada, mas todas as variantes resolvem
     para o mesmo dot branco neutro. Cor saiu do papel de diferenciação. */
  .chart-accent-lilac  .chart-title-dot,
  .chart-accent-blue   .chart-title-dot,
  .chart-accent-green  .chart-title-dot,
  .chart-accent-yellow .chart-title-dot { background: rgba(234,234,240,0.55); }
  .chart-note {
    font-size: 12px;
    color: var(--dimmed);
    line-height: 1.5;
    letter-spacing: 0.01em;
    margin-left: 17px;
  }
  .chart-body {
    position: relative;
    width: 100%;
  }
  .chart-body :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .chart-body :global(svg text) {
    font-family: var(--font-mono);
    font-feature-settings: 'tnum' 1;
  }
  .chart-body :global(svg text.chart-label),
  .chart-body :global(svg .chart-label text) {
    font-family: var(--font-sans);
    font-feature-settings: normal;
  }
  .chart-ratio-wide  .chart-body :global(svg) { aspect-ratio: 16 / 7; }
  .chart-ratio-square .chart-body :global(svg) { aspect-ratio: 1 / 1; }
  .chart-ratio-short .chart-body :global(svg) { aspect-ratio: 16 / 5; }

  .chart-source {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }
  .chart-source-label {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dimmed);
    flex-shrink: 0;
  }
  .chart-source-text {
    font-size: 11.5px;
    color: var(--muted);
    line-height: 1.5;
    letter-spacing: 0.01em;
  }

  @media (max-width: 640px) {
    .chart-card { padding: 22px 20px 18px; margin: 24px 0; }
    .chart-head { margin-bottom: 18px; padding-bottom: 12px; }
    .chart-note { margin-left: 0; }
  }
</style>
