---
// Shared SVG gradient defs used by inline icons across the site.
// Originalmente lilás/azul/verde/amarelo etc; agora todos branco-cinza
// para acoplar ao registro monocromático. Os ids são preservados pra
// não quebrar as ~50 referências `url(#g1)` etc. espalhadas.
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <linearGradient id="g1" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#EAEAF0" stop-opacity="0.85"/><stop offset="100%" stop-color="#EAEAF0" stop-opacity="0.55"/></linearGradient>
    <linearGradient id="g2" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="#EAEAF0" stop-opacity="0.85"/><stop offset="100%" stop-color="#EAEAF0" stop-opacity="0.55"/></linearGradient>
    <linearGradient id="g-green" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="#EAEAF0" stop-opacity="0.80"/><stop offset="100%" stop-color="#EAEAF0" stop-opacity="0.55"/></linearGradient>
    <linearGradient id="g-area" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#EAEAF0" stop-opacity="0.18"/><stop offset="100%" stop-color="#EAEAF0" stop-opacity="0"/></linearGradient>
    <linearGradient id="g-line2" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="#EAEAF0" stop-opacity="0.55"/><stop offset="100%" stop-color="#EAEAF0" stop-opacity="0.40"/></linearGradient>
    <linearGradient id="g-area2" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#EAEAF0" stop-opacity="0.12"/><stop offset="100%" stop-color="#EAEAF0" stop-opacity="0"/></linearGradient>
    <linearGradient id="g-violet" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#EAEAF0" stop-opacity="0.80"/><stop offset="100%" stop-color="#EAEAF0" stop-opacity="0.55"/></linearGradient>
    <linearGradient id="g-magenta" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#EAEAF0" stop-opacity="0.80"/><stop offset="100%" stop-color="#EAEAF0" stop-opacity="0.55"/></linearGradient>
    <linearGradient id="g-yellow" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#EAEAF0" stop-opacity="0.85"/><stop offset="100%" stop-color="#EAEAF0" stop-opacity="0.55"/></linearGradient>
    <filter id="glow-f"><feGaussianBlur stdDeviation="2" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
  </defs>
</svg>
