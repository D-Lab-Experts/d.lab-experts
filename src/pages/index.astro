---
import Layout from '../layouts/Layout.astro';
import NeuralNetwork from '../components/NeuralNetwork.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout
  title="D.Lab | Inteligência de Dados & Cybersegurança"
  description="Laboratório brasileiro de pesquisa aplicada em inteligência de dados e cybersegurança. Análise estratégica, inteligência competitiva, pentest, consultoria de segurança, IA e automação. Trabalho sob NDA."
  active="home"
>
  <!-- ═══════════════ HERO ══════════════════════════════════════════ -->
  <section id="hero">
    <div class="hero-grid"></div>
    <div class="hero-light-a"></div>
    <div class="hero-light-b"></div>
    <NeuralNetwork color="lilac" density="medium" opacity={0.32} />

    <svg class="hero-orbital" viewBox="0 0 800 800" fill="none">
      <circle cx="400" cy="400" r="300" stroke="rgba(177,140,255,0.15)" stroke-width="0.5" fill="none" stroke-dasharray="6 8"/>
      <circle cx="400" cy="400" r="200" stroke="rgba(77,163,255,0.12)" stroke-width="0.5" fill="none" stroke-dasharray="4 10"/>
      <circle cx="400" cy="400" r="100" stroke="rgba(177,140,255,0.1)" stroke-width="0.5" fill="none"/>
      <circle r="3" fill="#B18CFF" opacity=".6">
        <animateMotion dur="20s" repeatCount="indefinite" path="M400,100 A300,300 0 1,1 399.99,100"/>
      </circle>
      <circle r="2.5" fill="#4DA3FF" opacity=".5">
        <animateMotion dur="15s" repeatCount="indefinite" path="M400,200 A200,200 0 1,1 399.99,200"/>
      </circle>
      <circle r="2" fill="#00E5A0" opacity=".4">
        <animateMotion dur="10s" repeatCount="indefinite" path="M400,300 A100,100 0 1,1 399.99,300"/>
      </circle>
      <circle cx="400" cy="400" r="2" fill="rgba(177,140,255,0.3)"/>
      <circle cx="250" cy="350" r="1.5" fill="rgba(77,163,255,0.25)"/>
      <circle cx="550" cy="350" r="1.5" fill="rgba(77,163,255,0.25)"/>
      <circle cx="400" cy="250" r="1.5" fill="rgba(177,140,255,0.2)"/>
      <circle cx="400" cy="550" r="1.5" fill="rgba(177,140,255,0.2)"/>
      <line x1="400" y1="400" x2="250" y2="350" stroke="rgba(177,140,255,0.08)" stroke-width="0.5"/>
      <line x1="400" y1="400" x2="550" y2="350" stroke="rgba(77,163,255,0.08)" stroke-width="0.5"/>
      <line x1="400" y1="400" x2="400" y2="250" stroke="rgba(177,140,255,0.06)" stroke-width="0.5"/>
      <line x1="400" y1="400" x2="400" y2="550" stroke="rgba(177,140,255,0.06)" stroke-width="0.5"/>
    </svg>

    <div class="hero-inner">
      <div class="fi d1">
        <div class="hero-tag"><span class="tag-dot"></span>Pesquisa aplicada · Inteligência · Cybersegurança</div>
        <h1 class="hero-h1">
          Inteligência<br>para <span class="hero-accent">decisões<br><span class="hero-rotate-word" id="rotate-word"></span></span>
        </h1>
        <p class="hero-sub">Laboratório brasileiro de pesquisa aplicada para empresas que não podem errar a próxima decisão. Cruzamos fontes, testamos infraestruturas e entregamos raciocínio exposto. Não opinião embalada.</p>
        <div class="hero-ctas">
          <a href="/contato" class="btn btn-primary">Propor um problema →</a>
          <a href="/blog" class="btn btn-ghost">Ler uma pesquisa aberta</a>
        </div>
        <div class="hero-stats">
          <div>
            <div class="hero-stat-val">NDA</div>
            <div class="hero-stat-lbl">Padrão de entrega</div>
          </div>
          <div>
            <div class="hero-stat-val">Sênior</div>
            <div class="hero-stat-lbl">Sem juniores entre você e o analista</div>
          </div>
          <div>
            <div class="hero-stat-val">Protocolo</div>
            <div class="hero-stat-lbl">Mesma metodologia documentada em todo projeto</div>
          </div>
        </div>
      </div>

      <div class="hero-card-wrap fi d2">
        <div class="hero-card">
          <div class="hc-header">
            <div style="display:flex;align-items:center">
              <img src="/d.lab-icon.webp" alt="" class="hc-icon" width="28" height="28" />
              <div>
                <div class="hc-title">Cafeteria Premium</div>
                <div class="hc-sub">Santo André, SP · Análise de viabilidade</div>
              </div>
            </div>
            <span class="badge badge-green badge-dot">Concluído</span>
          </div>

          <div class="hc-metrics">
            <div class="hc-m"><div class="hc-m-val" style="color:var(--green)">Alta</div><div class="hc-m-lbl">Demanda</div></div>
            <div class="hc-m"><div class="hc-m-val" style="color:var(--yellow)">Média</div><div class="hc-m-lbl">Saturação</div></div>
            <div class="hc-m"><div class="hc-m-val" style="color:var(--lilac)">7.8</div><div class="hc-m-lbl">Score</div></div>
          </div>

          <div class="hc-chart">
            <div class="hc-chart-label">Tendência de demanda · 12 meses</div>
            <svg class="sparkline-svg" viewBox="0 0 320 56" preserveAspectRatio="none">
              <defs>
                <linearGradient id="spark-area" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#B18CFF" stop-opacity="0.2"/>
                  <stop offset="100%" stop-color="#B18CFF" stop-opacity="0"/>
                </linearGradient>
              </defs>
              <path d="M0,42 C20,40 40,36 60,32 C80,28 100,30 120,24 C140,18 160,20 180,16 C200,12 220,14 240,10 C260,6 280,8 320,4 L320,56 L0,56 Z" fill="url(#spark-area)"/>
              <path d="M0,42 C20,40 40,36 60,32 C80,28 100,30 120,24 C140,18 160,20 180,16 C200,12 220,14 240,10 C260,6 280,8 320,4" fill="none" stroke="url(#g2)" stroke-width="1.8" stroke-linecap="round" filter="url(#glow-f)"/>
              <circle cx="320" cy="4" r="3" fill="#B18CFF" filter="url(#glow-f)">
                <animate attributeName="opacity" values="1;0.4;1" dur="1.4s" repeatCount="indefinite"/>
              </circle>
              <circle cx="320" cy="4" r="3" fill="none" stroke="#B18CFF" stroke-opacity=".6">
                <animate attributeName="r" values="3;8;3" dur="1.4s" repeatCount="indefinite"/>
                <animate attributeName="stroke-opacity" values=".6;0;.6" dur="1.4s" repeatCount="indefinite"/>
              </circle>
              <text x="0" y="56" font-size="8" fill="rgba(234,234,240,0.22)" font-family="Satoshi">Jan</text>
              <text x="145" y="56" font-size="8" fill="rgba(234,234,240,0.22)" font-family="Satoshi">Jun</text>
              <text x="300" y="56" font-size="8" fill="rgba(234,234,240,0.22)" font-family="Satoshi">Dez</text>
            </svg>
          </div>

          <div class="hc-bars">
            <div class="hc-bar-row">
              <div class="hc-bar-meta"><span class="hc-bar-name">Potencial de demanda</span><span class="hc-bar-pct" style="color:var(--lilac)">82%</span></div>
              <div class="hc-bar-track"><div class="hc-bar-fill hero-bar" data-v="82"></div></div>
            </div>
            <div class="hc-bar-row">
              <div class="hc-bar-meta"><span class="hc-bar-name">Concentração de público</span><span class="hc-bar-pct" style="color:var(--blue)">68%</span></div>
              <div class="hc-bar-track"><div class="hc-bar-fill hero-bar" data-v="68"></div></div>
            </div>
          </div>

          <div class="hc-verdict">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" style="flex-shrink:0;margin-top:1px"><path d="M8 1L10 6H15L11 9.5L12.5 15L8 11.5L3.5 15L5 9.5L1 6H6L8 1Z" fill="url(#g1)" opacity=".9"/></svg>
            <div class="hc-verdict-text"><strong>Nota D.Lab:</strong> Demanda reprimida no raio de 800m. Janela curta. Avançar.</div>
          </div>
        </div>
      </div>
    </div>

    <div class="scroll-ind">
      <span class="label" style="font-size:9px">Scroll</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- ═══════════════ BRAND STATEMENT ═══════════════════════════════ -->
  <section id="brand-statement">
    <div class="brand-wave-bg">
      <svg viewBox="0 0 1200 400" preserveAspectRatio="none">
        <path class="brand-wave-line" d="M0,200 Q150,140 300,200 T600,200 T900,200 T1200,200" stroke="rgba(177,140,255,0.25)" stroke-width="1">
          <animate attributeName="d" dur="8s" repeatCount="indefinite" values="M0,200 Q150,140 300,200 T600,200 T900,200 T1200,200;M0,200 Q150,260 300,200 T600,200 T900,200 T1200,200;M0,200 Q150,140 300,200 T600,200 T900,200 T1200,200"/>
        </path>
        <path class="brand-wave-line" d="M0,200 Q200,160 400,200 T800,200 T1200,200" stroke="rgba(77,163,255,0.18)" stroke-width="0.8">
          <animate attributeName="d" dur="10s" repeatCount="indefinite" values="M0,200 Q200,160 400,200 T800,200 T1200,200;M0,200 Q200,240 400,200 T800,200 T1200,200;M0,200 Q200,160 400,200 T800,200 T1200,200"/>
        </path>
        <path class="brand-wave-line" d="M0,200 Q300,180 600,200 T1200,200" stroke="rgba(0,229,160,0.1)" stroke-width="0.6">
          <animate attributeName="d" dur="12s" repeatCount="indefinite" values="M0,200 Q300,180 600,200 T1200,200;M0,200 Q300,220 600,200 T1200,200;M0,200 Q300,180 600,200 T1200,200"/>
        </path>
      </svg>
    </div>
    <NeuralNetwork color="lilac" density="low" opacity={0.22} />
    <div class="container">
      <div class="brand-inner fi">
        <h2 class="brand-title">
          Clareza. Estrutura. <span class="gradient-text">Vantagem.</span>
        </h2>
        <p class="brand-desc">Quando a decisão é cara demais pra palpite, o trabalho é de laboratório.</p>
      </div>
    </div>
  </section>

  <div class="wave-divider">
    <svg viewBox="0 0 1200 60" preserveAspectRatio="none" fill="none">
      <path d="M0,30 Q150,15 300,30 T600,30 T900,30 T1200,30" stroke="rgba(177,140,255,0.06)" stroke-width="1"/>
      <path d="M0,35 Q200,22 400,35 T800,35 T1200,35" stroke="rgba(77,163,255,0.04)" stroke-width="0.8"/>
    </svg>
  </div>

  <!-- ═══════════════ TRUST BAR ═════════════════════════════════════ -->
  <div id="logos">
    <div class="container">
      <p class="logos-lbl label">Padrões D.Lab</p>
      <div class="trust-row">
        <div class="trust-item">
          <div class="trust-val">NDA</div>
          <div class="trust-lbl">Confidencialidade como padrão</div>
        </div>
        <div class="trust-item">
          <div class="trust-val">Sênior</div>
          <div class="trust-lbl">Do briefing à entrega, sempre o analista sênior</div>
        </div>
        <div class="trust-item">
          <div class="trust-val">Dual</div>
          <div class="trust-lbl">Inteligência e cyber na mesma operação</div>
        </div>
        <div class="trust-item">
          <div class="trust-val">Método</div>
          <div class="trust-lbl">Cada etapa rastreável, zero caixa-preta</div>
        </div>
        <div class="trust-item">
          <div class="trust-val">Aplicada</div>
          <div class="trust-lbl">Análise pública como prova do método</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══════════════ SEGMENTOS ════════════════════════════════════ -->
  <div class="section-sep"></div>
  <section id="segments" class="section">
    <div class="section-glow lilac" style="top:-100px;right:-150px"></div>
    <div class="section-glow blue" style="bottom:-80px;left:-100px"></div>
    <canvas class="section-particles" data-color="lilac"></canvas>
    <div class="container">
      <div class="seg-head fi">
        <div class="section-label" style="justify-content:center"><span class="label">Onde atuamos</span></div>
        <h2 class="section-title">Seis verticais.<br><span class="gradient-text">Um único protocolo.</span></h2>
        <p class="section-sub" style="margin:0 auto">Do mercado à segurança, da concorrência à política. O mesmo rigor metodológico em qualquer decisão.</p>
      </div>
      <div class="seg-grid">
        <div class="seg-card fi d1">
          <div class="icon-wrap" style="margin-bottom:20px">
            <svg viewBox="0 0 22 22" fill="none"><circle cx="11" cy="11" r="8" stroke="url(#g1)" stroke-width="1.5"/><circle cx="11" cy="11" r="3" stroke="url(#g1)" stroke-width="1.5"/><path d="M11 3v3M11 16v3M3 11h3M16 11h3" stroke="url(#g1)" stroke-width="1.3" stroke-linecap="round"/></svg>
          </div>
          <div class="seg-tag" style="color:var(--lilac)">Mercado & Público</div>
          <div class="seg-name">Análise de Mercado & Público</div>
          <p class="seg-desc">Quem é o cliente real, onde ele está, o que ele busca, e quanto disso você pode capturar. Sem achismo, sem persona genérica.</p>
          <div class="seg-samples">
            <span class="seg-sample">Perfil de público</span>
            <span class="seg-sample">Dimensionamento de mercado</span>
            <span class="seg-sample">Análise de demanda</span>
          </div>
        </div>

        <div class="seg-card blue fi d2">
          <div class="icon-wrap blue" style="margin-bottom:20px">
            <svg viewBox="0 0 22 22" fill="none"><rect x="3" y="3" width="7" height="7" rx="2" stroke="url(#g2)" stroke-width="1.5"/><rect x="12" y="3" width="7" height="7" rx="2" stroke="url(#g2)" stroke-width="1.5"/><rect x="3" y="12" width="7" height="7" rx="2" stroke="url(#g2)" stroke-width="1.5"/><path d="M15.5 12v7M12 15.5h7" stroke="url(#g2)" stroke-width="1.5" stroke-linecap="round"/></svg>
          </div>
          <div class="seg-tag" style="color:var(--blue)">Estratégia</div>
          <div class="seg-name">Análise Estratégica de Mercado</div>
          <p class="seg-desc">Dimensionamento, posicionamento e janelas de oportunidade. Para quando a decisão é cara demais pra palpite de reunião.</p>
          <div class="seg-samples">
            <span class="seg-sample">Análise estratégica</span>
            <span class="seg-sample">Consultoria competitiva</span>
            <span class="seg-sample">Benchmarking setorial</span>
          </div>
        </div>

        <div class="seg-card yellow fi d3">
          <div class="icon-wrap yellow" style="margin-bottom:20px">
            <svg viewBox="0 0 22 22" fill="none"><path d="M11 3l8 8-8 8-8-8 8-8z" stroke="url(#g-yellow)" stroke-width="1.5" stroke-linejoin="round"/><circle cx="11" cy="11" r="3.8" stroke="url(#g-yellow)" stroke-width="1.5"/></svg>
          </div>
          <div class="seg-tag" style="color:var(--yellow)">Política</div>
          <div class="seg-name">Análise Política e Eleitoral</div>
          <p class="seg-desc">Opinião pública, eleitorado, sentimento e modelagem de cenário. Campanha é disputa de leitura de contexto antes de ser disputa de narrativa.</p>
          <div class="seg-samples">
            <span class="seg-sample">Mapeamento eleitoral</span>
            <span class="seg-sample">Opinião pública</span>
            <span class="seg-sample">Modelagem de cenários</span>
          </div>
        </div>

        <div class="seg-card violet fi d2">
          <div class="icon-wrap violet" style="margin-bottom:20px">
            <svg viewBox="0 0 22 22" fill="none"><polyline points="3,15 7,9 11,12 15,6 19,8" stroke="url(#g-violet)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/><circle cx="19" cy="8" r="2" fill="url(#g-violet)" opacity=".7"/></svg>
          </div>
          <div class="seg-tag" style="color:var(--violet)">Tendências</div>
          <div class="seg-name">Estudos de Tendência</div>
          <p class="seg-desc">Sinais fracos antes do consenso. Para quem precisa se mover antes do setor inteiro enxergar.</p>
          <div class="seg-samples">
            <span class="seg-sample">Tendências de consumo</span>
            <span class="seg-sample">Comportamento digital</span>
            <span class="seg-sample">Análise cultural</span>
          </div>
        </div>

        <div class="seg-card green fi d3">
          <div class="icon-wrap green" style="margin-bottom:20px">
            <svg viewBox="0 0 22 22" fill="none"><path d="M3 18l4-4 4 3 4-6 4-4" stroke="url(#g-green)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="3" cy="18" r="1.5" fill="url(#g-green)"/><circle cx="19" cy="7" r="1.5" fill="url(#g-green)"/></svg>
          </div>
          <div class="seg-tag" style="color:var(--green)">Concorrência</div>
          <div class="seg-name">Inteligência Competitiva</div>
          <p class="seg-desc">Dossiê dos concorrentes reais, não os da sua cabeça. Força, posicionamento, pontos cegos, e o que eles ainda não viram.</p>
          <div class="seg-samples">
            <span class="seg-sample">Análise de concorrentes</span>
            <span class="seg-sample">Benchmarking de mercado</span>
            <span class="seg-sample">Posicionamento estratégico</span>
          </div>
        </div>

        <div class="seg-card cyan fi d4">
          <div class="icon-wrap cyan" style="margin-bottom:20px">
            <svg viewBox="0 0 22 22" fill="none"><path d="M11 2L4 5.5v5c0 4.7 3 8.5 7 10 4-1.5 7-5.3 7-10v-5L11 2z" stroke="url(#g-green)" stroke-width="1.5" stroke-linejoin="round"/><path d="M8 11l2.5 2.5L14.5 9" stroke="url(#g-green)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="seg-tag" style="color:var(--cyan)">Segurança</div>
          <div class="seg-name">Cybersegurança</div>
          <p class="seg-desc">Pentest, análise de vulnerabilidades e consultoria ofensiva. Descobrimos o que um atacante descobriria, antes dele, e deixamos documentado.</p>
          <div class="seg-samples">
            <span class="seg-sample">Pentest</span>
            <span class="seg-sample">Análise de vulnerabilidades</span>
            <span class="seg-sample">Consultoria de segurança</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="wave-divider">
    <svg viewBox="0 0 1200 60" preserveAspectRatio="none" fill="none">
      <path d="M0,30 Q300,10 600,30 T1200,30" stroke="rgba(177,140,255,0.05)" stroke-width="1"/>
    </svg>
  </div>

  <!-- ═══════════════ PROBLEMA / SOLUÇÃO ═══════════════════════════ -->
  <section id="problem">
    <div class="prob-ambient"></div>
    <div class="container">
      <div class="prob-header fi">
        <div class="section-label" style="justify-content:center"><span class="label">O Problema</span></div>
        <h2 class="section-title">De decisões no escuro a<br><span class="gradient-text">inteligência acionável.</span></h2>
        <p class="section-sub" style="margin:0 auto">A distância entre intuição e estratégia é medida em dados.</p>
      </div>

      <div class="prob-layout fi">
        <div class="prob-panel red-side">
          <div class="prob-head">
            <div class="icon-wrap red sm"><svg viewBox="0 0 17 17" fill="none"><path d="M4 4l9 9M13 4l-9 9" stroke="#FF5C7A" stroke-width="1.8" stroke-linecap="round"/></svg></div>
            <h3>Sem D.Lab</h3>
          </div>
          <ul class="prob-list">
            <li><span class="prob-bul r"></span>Decisão baseada em feeling e anedota</li>
            <li><span class="prob-bul r"></span>Concorrência "analisada" no olho</li>
            <li><span class="prob-bul r"></span>Processos manuais ocupando tempo de decisão</li>
            <li><span class="prob-bul r"></span>Investimento sem leitura de demanda real</li>
            <li><span class="prob-bul r"></span>Infraestrutura exposta que ninguém mapeou</li>
            <li><span class="prob-bul r"></span>IA adiada enquanto o concorrente automatiza</li>
          </ul>
        </div>

        <div class="prob-center">
          <div class="prob-3d-wrap">
            <div class="prob-orbit-ring"><div class="prob-orbit-dot"></div></div>
            <div class="prob-orbit-ring"><div class="prob-orbit-dot"></div></div>
            <div class="prob-prism">
              <div class="prob-face front">
                <svg width="48" height="48" viewBox="0 0 48 48" fill="none" opacity=".6">
                  <path d="M24 8L38 18V34L24 44L10 34V18L24 8Z" stroke="url(#g1)" stroke-width="1" fill="none"/>
                  <path d="M24 8V44M10 18L38 34M38 18L10 34" stroke="url(#g1)" stroke-width=".5" opacity=".4"/>
                  <circle cx="24" cy="24" r="3" fill="url(#g1)" opacity=".5"/>
                </svg>
              </div>
              <div class="prob-face back">
                <svg width="40" height="40" viewBox="0 0 40 40" fill="none" opacity=".4">
                  <rect x="4" y="4" width="32" height="32" rx="4" stroke="url(#g2)" stroke-width=".8"/>
                  <line x1="4" y1="20" x2="36" y2="20" stroke="url(#g2)" stroke-width=".5" opacity=".5"/>
                  <line x1="20" y1="4" x2="20" y2="36" stroke="url(#g2)" stroke-width=".5" opacity=".5"/>
                </svg>
              </div>
              <div class="prob-face left">
                <svg width="36" height="36" viewBox="0 0 36 36" fill="none" opacity=".3">
                  <circle cx="18" cy="18" r="12" stroke="url(#g-green)" stroke-width=".8"/>
                  <circle cx="18" cy="18" r="6" stroke="url(#g-green)" stroke-width=".6"/>
                  <circle cx="18" cy="18" r="2" fill="url(#g-green)" opacity=".6"/>
                </svg>
              </div>
              <div class="prob-face right">
                <svg width="36" height="36" viewBox="0 0 36 36" fill="none" opacity=".3">
                  <polyline points="4,28 12,16 18,22 26,10 32,14" stroke="url(#g1)" stroke-width=".8" fill="none"/>
                </svg>
              </div>
              <div class="prob-face top">
                <div class="prob-face-inner">D.Lab</div>
              </div>
              <div class="prob-face bottom"></div>
            </div>
            <img src="/d.lab-icon2.webp" alt="" class="prob-icon-mark" width="28" height="28" loading="lazy" />
          </div>
          <div class="prob-arrow">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M4 10h12M12 6l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Transformação
          </div>
        </div>

        <div class="prob-panel green-side">
