              <div class="about-pillar-desc">Cada análise com metodologia documentada e replicável</div>
            </div>
            <div class="about-pillar">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="7" stroke="url(#g1)" stroke-width="1.2"/><circle cx="10" cy="10" r="3" stroke="url(#g1)" stroke-width="1.2"/><path d="M10 3v2M10 15v2M3 10h2M15 10h2" stroke="url(#g1)" stroke-width="1" stroke-linecap="round"/></svg>
