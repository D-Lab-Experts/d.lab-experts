                  <div class="rc-bar-row"><div class="rc-bar-meta"><span class="rc-bar-lbl">Localização</span><span class="rc-bar-pct" style="color:var(--blue)">7.4</span></div><div class="rc-bar-track"><div class="rc-bar-fill score-bar" data-v="74"></div></div></div>
                  <div class="rc-bar-row"><div class="rc-bar-meta"><span class="rc-bar-lbl">Competitividade</span><span class="rc-bar-pct" style="color:var(--lilac)">6.1</span></div><div class="rc-bar-track"><div class="rc-bar-fill score-bar" data-v="61"></div></div></div>
                  <div class="rc-bar-row"><div class="rc-bar-meta"><span class="rc-bar-lbl">Público-alvo</span><span class="rc-bar-pct" style="color:var(--cyan)">8.8</span></div><div class="rc-bar-track"><div class="rc-bar-fill score-bar green" data-v="88"></div></div></div>
