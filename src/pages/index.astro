  <div class="section-sep"></div>
  <!-- ═══════════════ DATA STACK ════════════════════════════════════ -->
  <section id="data-stack" class="section">
    <div class="section-glow cyan" style="top:30%;right:-80px"></div>
    <canvas class="section-particles" data-color="cyan"></canvas>
    <NeuralNetwork color="cyan" density="medium" opacity={0.28} />
    <svg class="ds-flow" height="120" viewBox="0 0 1200 120" preserveAspectRatio="none">
      <path d="M0,60 Q150,20 300,60 T600,60 T900,60 T1200,60" stroke="url(#g2)" stroke-width="1.5" fill="none">
        <animate attributeName="stroke-dashoffset" from="1000" to="0" dur="6s" repeatCount="indefinite"/>
        <animate attributeName="stroke-dasharray" from="0,1000" to="1000,0" dur="6s" repeatCount="indefinite"/>
      </path>
      <path d="M0,80 Q200,40 400,80 T800,80 T1200,80" stroke="url(#g-green)" stroke-width="1" fill="none">
        <animate attributeName="stroke-dashoffset" from="800" to="0" dur="9s" repeatCount="indefinite"/>
        <animate attributeName="stroke-dasharray" from="0,800" to="800,0" dur="9s" repeatCount="indefinite"/>
      </path>
    </svg>
    <div class="container">
      <div class="ds-head fi">
        <div class="section-label" style="justify-content:center"><span class="label">Fontes de dados</span></div>
        <h2 class="section-title">Fontes que ninguém<br><span class="gradient-text">cruza desse jeito.</span></h2>
        <p class="section-sub" style="margin:0 auto">Combinamos fontes públicas, APIs, scraping e pesquisa primária. Cada camada documentada, cada cruzamento auditável. A visão completa vira decisão, não deck.</p>
      </div>
      <div class="ds-grid fi">
        <div class="ds-card"><div class="ds-top"><div class="icon-wrap"><svg viewBox="0 0 22 22" fill="none"><circle cx="11" cy="11" r="8" stroke="url(#g1)" stroke-width="1.5"/><circle cx="11" cy="11" r="3" stroke="url(#g1)" stroke-width="1.5"/><path d="M11 3v3M11 16v3M3 11h3M16 11h3" stroke="url(#g1)" stroke-width="1.3" stroke-linecap="round"/></svg></div><span class="badge badge-blue">API</span></div><div class="ds-name">Google Maps e Places</div><p class="ds-desc">Mapeamento de concorrentes, estabelecimentos, pontos de fluxo e avaliações em tempo real.</p></div>
        <div class="ds-card"><div class="ds-top"><div class="icon-wrap green"><svg viewBox="0 0 22 22" fill="none"><rect x="3" y="3" width="16" height="16" rx="3" stroke="url(#g-green)" stroke-width="1.5"/><path d="M7 11h8M11 7v8" stroke="url(#g-green)" stroke-width="1.5" stroke-linecap="round"/></svg></div><span class="badge badge-green">Aberto</span></div><div class="ds-name">IBGE e DataSUS</div><p class="ds-desc">Dados censitários, perfil socioeconômico, densidade demográfica e indicadores por região.</p></div>
        <div class="ds-card"><div class="ds-top"><div class="icon-wrap blue"><svg viewBox="0 0 22 22" fill="none"><polyline points="3,15 7,9 11,12 15,6 19,8" stroke="url(#g2)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg></div><span class="badge badge-green">Tendências</span></div><div class="ds-name">Google Trends</div><p class="ds-desc">Análise temporal de interesse por categoria, sazonalidade e tendências emergentes de mercado.</p></div>
        <div class="ds-card"><div class="ds-top"><div class="icon-wrap yellow"><svg viewBox="0 0 22 22" fill="none"><rect x="4" y="8" width="14" height="10" rx="2" stroke="#FFD166" stroke-width="1.5"/><path d="M8 8V6a3 3 0 016 0v2" stroke="#FFD166" stroke-width="1.5" stroke-linecap="round"/></svg></div><span class="badge badge-yellow">Scraping</span></div><div class="ds-name">Marketplaces e Plataformas</div><p class="ds-desc">Dados de preço, volume, avaliações e posicionamento de competidores em marketplaces, delivery e e-commerce.</p></div>
        <div class="ds-card"><div class="ds-top"><div class="icon-wrap"><svg viewBox="0 0 22 22" fill="none"><rect x="2" y="5" width="18" height="14" rx="3" stroke="url(#g1)" stroke-width="1.5"/><path d="M2 10h18" stroke="url(#g1)" stroke-width="1.5"/><circle cx="7" cy="15" r="1.5" fill="url(#g1)"/></svg></div><span class="badge badge-blue">Ads API</span></div><div class="ds-name">Meta Audience Insights</div><p class="ds-desc">Segmentação demográfica, comportamental e de interesse do público-alvo via Ads API.</p></div>
        <div class="ds-card"><div class="ds-top"><div class="icon-wrap cyan"><svg viewBox="0 0 22 22" fill="none"><path d="M3 11C3 6.58 6.58 3 11 3s8 3.58 8 8-3.58 8-8 8-8-3.58-8-8z" stroke="url(#g-green)" stroke-width="1.5"/><path d="M3 11h18M11 3c-2.21 3.13-3 5.34-3 8s.79 4.87 3 8M11 3c2.21 3.13 3 5.34 3 8s-.79 4.87-3 8" stroke="url(#g-green)" stroke-width="1.3"/></svg></div><span class="badge badge-green">Web</span></div><div class="ds-name">SimilarWeb e SEMrush</div><p class="ds-desc">Tráfego digital de concorrentes, posicionamento em busca, share of voice e análise de presença online.</p></div>
      </div>
    </div>
  </section>

  <div class="section-sep"></div>
  <!-- ═══════════════ ANÁLISES PÚBLICAS ══════════════════════════════ -->
  <section id="research" class="section">
    <div class="section-glow violet" style="top:-60px;right:-100px;width:400px;height:400px;background:radial-gradient(ellipse,rgba(167,139,250,.05) 0%,transparent 70%);filter:blur(60px);position:absolute;pointer-events:none;border-radius:50%"></div>
    <div class="section-glow blue" style="bottom:0;left:-80px"></div>
    <canvas class="section-particles" data-color="lilac"></canvas>
    <div class="container">
      <div class="research-head fi">
        <div class="section-label" style="justify-content:center"><span class="label">Análises Públicas</span></div>
        <h2 class="section-title">Pesquisa aberta.<br><span class="gradient-text">Enquanto o resto é fechado.</span></h2>
        <p class="section-sub" style="margin:0 auto">As pesquisas abertas nascem no nosso próprio laboratório — estudos independentes, publicados como prova de método. Trabalho de cliente nunca é divulgado: sempre sob NDA.</p>
      </div>

      <div class="research-grid fi">
        {posts.map((post) => {
          const isOriginal = post.data.researchType === 'original';
          const cat = post.data.category.toLowerCase();
          const extraTag = post.data.tags.find((t: string) => t.toLowerCase() !== cat);
          return (
          <a href={`/posts/${post.slug}`} class="research-card fi d1" style="position:relative">
            <div class="research-card-img" style="padding:0;background:#0B0B0F">
              {post.data.cover && (
                <img src={post.data.cover} alt={post.data.coverAlt ?? ''} loading="lazy" width="800" height="450" style="width:100%;height:100%;object-fit:cover;position:relative;z-index:1" />
              )}
            </div>
            <div class="research-card-body">
              <div class="research-card-tags">
                {isOriginal && <span class="research-card-tag original">Pesquisa Original</span>}
                <span class="research-card-tag">{post.data.category}</span>
                {!isOriginal && extraTag && (
                  <span class="research-card-tag blue">{extraTag}</span>
                )}
              </div>
              <h3 class="research-card-title">{post.data.title}</h3>
              <p class="research-card-excerpt">{post.data.description}</p>
              <div class="research-card-footer">
                <span class="research-card-date">{post.data.pubDate.toLocaleDateString('pt-BR', { year: 'numeric', month: 'long' })}{post.data.readingTime ? ` · ${post.data.readingTime}` : ''}</span>
                <span class="research-card-read">Ler pesquisa <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              </div>
            </div>
          </a>
          );
        })}
      </div>

      <div class="research-cta fi">
        <a href="/blog" class="btn btn-ghost">Ver todas as pesquisas</a>
      </div>
    </div>
  </section>

  <div class="section-sep"></div>
