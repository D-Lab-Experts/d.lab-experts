---
// PREVIEW ISOLADO — Hero variação B · "Cinematic Center" (Apple-leaning)
// Página autocontida: não importa Layout nem global.css. Mesma copy
// validada de src/i18n/pt.ts, arranjo e escala diferentes da A.
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>Preview · Hero B — Cinematic Center | D.Lab</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=DM+Sans:opsz,wght@9..40,400;9..40,500&family=DM+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main>
      <!-- ══ HERO B ══════════════════════════════════════════════════ -->
      <section class="hero" id="hero">
        <div class="glow glow-lilac" aria-hidden="true"></div>
        <div class="glow glow-blue" aria-hidden="true"></div>
        <div class="grid" aria-hidden="true"></div>

        <div class="wrap">
          <div class="eyebrow reveal">
            <span class="dot" aria-hidden="true"></span>
            Decision Intelligence · Data Engineering · Cybersecurity
          </div>

          <p class="kicker reveal d1">
            <span>não é consultoria.</span>
            <span>não é pesquisa de mercado.</span>
          </p>

          <h1 class="headline reveal d2">
            é inteligência<br />
            <span class="accent-word">para decisão.</span>
          </h1>

          <p class="sub reveal d3">
            Laboratório de pesquisa aplicada. Método explícito, dados
            primários, publicação aberta.
          </p>

          <div class="ctas reveal d4">
            <a href="/contato" class="btn btn-accent">iniciar projeto →</a>
            <a href="/blog" class="btn btn-ghost">ler a pesquisa</a>
          </div>
        </div>

        <!-- faixa de dados full-bleed, estilo "data band" -->
        <div class="proof-band reveal d5">
          <div class="proof-inner">
            <a href="/posts/campanhas-afirmativas-gaming" class="proof-item">
              <span class="proof-val">N=98</span>
              <span class="proof-lbl">amostra do estudo de gaming, protocolo STROBE</span>
            </a>
            <a href="/posts/campanhas-afirmativas-gaming" class="proof-item">
              <span class="proof-val accent">87.8%</span>
              <span class="proof-lbl">acreditam que campanhas afirmativas geram impacto real</span>
            </a>
            <a href="/posts/campanhas-afirmativas-gaming" class="proof-item">
              <span class="proof-val">16.3%</span>
              <span class="proof-lbl">acreditam que marcas agem por motivação genuína</span>
            </a>
            <a href="/posts/campanhas-afirmativas-gaming" class="proof-item">
              <span class="proof-val">3.48×</span>
              <span class="proof-lbl">mais propensos a trocar de marca por compromisso comprovado</span>
            </a>
            <a href="/posts/campanhas-afirmativas-gaming" class="proof-item">
              <span class="proof-val">STROBE</span>
              <span class="proof-lbl">protocolo de relato seguido na pesquisa</span>
            </a>
          </div>
        </div>
      </section>

      <div class="pv-note">
        Preview B · <a href="/preview/hero-a">ver variação A →</a>
      </div>
    </main>

    <style is:global>
      :root {
        --bg:        #0B0B0F;
        --surface:   #1A1A22;
        --elev-2:    #22222C;
        --ink:       #EAEAF0;
        --ink-dim:   rgba(234, 234, 240, 0.55);
        --accent:    #B18CFF; /* lilás */
        --accent-2:  #4DA3FF; /* azul */
        --line:      rgba(234, 234, 240, 0.10);
        --line-2:    rgba(234, 234, 240, 0.18);
        --font-display: 'Syne', system-ui, sans-serif;
        --font-sans:    'DM Sans', system-ui, -apple-system, sans-serif;
        --font-mono:    'DM Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { color-scheme: dark; }
      body {
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-sans);
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        overflow-x: hidden;
      }
      a { color: inherit; text-decoration: none; }
    </style>

    <style>
      /* ── HERO B · Cinematic Center ─────────────────────────────────
         Apple-leaning: escala dramática, centralizado, afirmação
         gigante. Dois glows radiais (lilás + azul) misturados em baixa
         opacidade dão dimensão ao fundo escuro. Faixa de dados full
         bleed embaixo. Cor como pontuação (a palavra-chave, um número). */
      .hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 140px 0 0;
        overflow: hidden;
        text-align: center;
      }
      .wrap {
        position: relative; z-index: 2;
        width: 100%; max-width: 1000px;
        margin: 0 auto; padding: 0 32px;
        flex: 1;
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
      }
      .glow { position: absolute; pointer-events: none; z-index: 0; filter: blur(50px); }
      .glow-lilac {
        width: 720px; height: 720px;
        top: -160px; left: 50%; margin-left: -480px;
        background: radial-gradient(circle at center,
          rgba(177,140,255,0.18) 0%, rgba(177,140,255,0.05) 40%, transparent 70%);
        animation: breathe 10s ease-in-out infinite;
      }
      .glow-blue {
        width: 640px; height: 640px;
        top: -60px; left: 50%; margin-left: 40px;
        background: radial-gradient(circle at center,
          rgba(77,163,255,0.12) 0%, rgba(77,163,255,0.035) 42%, transparent 70%);
        animation: breathe 10s ease-in-out infinite reverse;
      }
      @keyframes breathe {
        0%, 100% { opacity: 0.65; transform: scale(1); }
        50%      { opacity: 1;    transform: scale(1.08); }
      }
      .grid {
        position: absolute; inset: 0; z-index: 0; pointer-events: none;
        background-image:
          linear-gradient(rgba(234,234,240,0.02) 1px, transparent 1px),
          linear-gradient(90deg, rgba(234,234,240,0.02) 1px, transparent 1px);
        background-size: 88px 88px;
        mask-image: radial-gradient(ellipse 75% 65% at 50% 38%, #000 25%, transparent 78%);
        -webkit-mask-image: radial-gradient(ellipse 75% 65% at 50% 38%, #000 25%, transparent 78%);
      }

      .eyebrow {
        display: inline-flex; align-items: center; gap: 10px;
        font-family: var(--font-mono);
        font-size: 11.5px; font-weight: 500;
        letter-spacing: 0.14em; text-transform: uppercase;
        color: var(--ink-dim);
        padding: 7px 16px;
        border: 1px solid var(--line-2);
        border-radius: 100px;
        margin-bottom: 36px;
      }
      .eyebrow .dot {
        width: 6px; height: 6px; border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 10px rgba(177,140,255,0.7);
        animation: blink 2.6s ease-in-out infinite;
      }
      @keyframes blink { 0%,100%{opacity:1} 50%{opacity:.35} }

      .kicker {
        display: flex; flex-direction: column; gap: 2px;
        font-family: var(--font-sans);
        font-size: clamp(16px, 2vw, 20px);
        font-weight: 500;
        color: var(--ink-dim);
        margin-bottom: 18px;
      }

      .headline {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: clamp(52px, 9vw, 132px);
        line-height: 0.98;
        letter-spacing: -0.045em;
        color: var(--ink);
        text-wrap: balance;
        margin-bottom: 32px;
      }
      .headline .accent-word {
        background: linear-gradient(100deg, var(--accent) 0%, var(--accent-2) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .sub {
        font-size: 19px; line-height: 1.7;
        color: var(--ink-dim);
        max-width: 540px;
        margin: 0 auto 40px;
        text-wrap: pretty;
      }

      .ctas { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; margin-bottom: 56px; }
      .btn {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 15px 30px; border-radius: 12px;
        font-size: 15px; font-weight: 500; font-family: var(--font-sans);
        cursor: pointer; transition: transform .2s ease, background .2s ease, border-color .2s ease;
      }
      .btn-accent {
        background: var(--accent); color: #15101F;
        border: 1px solid var(--accent); font-weight: 600;
        box-shadow: 0 8px 40px rgba(177,140,255,0.25);
      }
      .btn-accent:hover { transform: translateY(-2px); background: #c2a3ff; }
      .btn-ghost { background: rgba(234,234,240,0.02); color: var(--ink); border: 1px solid var(--line-2); }
      .btn-ghost:hover { border-color: rgba(234,234,240,0.4); background: rgba(234,234,240,0.05); transform: translateY(-2px); }

      /* faixa de dados full-bleed */
      .proof-band {
        position: relative; z-index: 2;
        width: 100%;
        border-top: 1px solid var(--line);
        background: rgba(26,26,34,0.35);
        backdrop-filter: blur(6px);
      }
      .proof-inner {
        max-width: 1280px; margin: 0 auto;
        display: grid; grid-template-columns: repeat(5, 1fr);
      }
      .proof-item {
        display: flex; flex-direction: column; gap: 9px;
        padding: 26px 26px;
        text-align: left;
        border-right: 1px solid var(--line);
        transition: background .2s ease;
      }
      .proof-item:last-child { border-right: none; }
      .proof-item:hover { background: rgba(234,234,240,0.025); }
      .proof-val {
        font-family: var(--font-mono);
        font-size: clamp(20px, 2vw, 26px);
        font-weight: 500; letter-spacing: -0.02em;
        color: var(--ink); font-feature-settings: 'tnum' 1;
      }
      .proof-val.accent { color: var(--accent); }
      .proof-lbl { font-size: 11.5px; line-height: 1.5; color: var(--ink-dim); }

      .pv-note {
        position: fixed; bottom: 16px; right: 18px; z-index: 50;
        font-family: var(--font-mono); font-size: 11px; letter-spacing: .04em;
        color: var(--ink-dim); background: rgba(26,26,34,0.8);
        border: 1px solid var(--line); border-radius: 100px; padding: 7px 14px;
        backdrop-filter: blur(8px);
      }
      .pv-note a { color: var(--accent); }

      .reveal { opacity: 0; transform: translateY(18px); animation: rise .75s cubic-bezier(.16,1,.3,1) forwards; }
      .d1 { animation-delay: .08s; }
      .d2 { animation-delay: .16s; }
      .d3 { animation-delay: .26s; }
      .d4 { animation-delay: .34s; }
      .d5 { animation-delay: .44s; }
      @keyframes rise { to { opacity: 1; transform: translateY(0); } }

      @media (max-width: 1000px) {
        .proof-inner { grid-template-columns: repeat(3, 1fr); }
        .proof-item:nth-child(3) { border-right: none; }
        .proof-item:nth-child(n+4) { border-top: 1px solid var(--line); }
      }
      @media (max-width: 620px) {
        .hero { padding: 110px 0 0; }
        .proof-inner { grid-template-columns: repeat(2, 1fr); }
        .proof-item:nth-child(3) { border-right: 1px solid var(--line); }
        .proof-item:nth-child(2n) { border-right: none; }
        .proof-item:nth-child(n+3) { border-top: 1px solid var(--line); }
      }

      @media (prefers-reduced-motion: reduce) {
        .glow { animation: none; }
        .eyebrow .dot { animation: none; }
        .reveal { animation: none; opacity: 1; transform: none; }
        .btn:hover { transform: none; }
      }
    </style>
  </body>
</html>
