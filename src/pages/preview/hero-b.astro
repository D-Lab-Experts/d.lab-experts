---
// PREVIEW ISOLADO — Hero B · "Resend Minimal"
// Monocromático alto contraste, left-aligned editorial, hairlines
// nítidas, faixa de dados full-bleed. Tipografia fina (Inter).
// Página autocontida. Copy verbatim de src/i18n/pt.ts.
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>Preview · Hero B — Resend Minimal | D.Lab</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,200;14..32,300;14..32,400;14..32,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main>
      <!-- ══ HERO B · RESEND MINIMAL ═════════════════════════════════ -->
      <section class="hero" id="hero">
        <div class="grid" aria-hidden="true"></div>
        <div class="top-glow" aria-hidden="true"></div>

        <div class="wrap">
          <div class="brand-row reveal">
            <span class="brand">D<span class="dot" aria-hidden="true"></span>Lab</span>
            <span class="sep" aria-hidden="true"></span>
            <span class="eyebrow">Decision Intelligence Research</span>
          </div>

          <h1 class="headline reveal d1">
            <span class="dim">não é consultoria. não é pesquisa de mercado.</span><br />
            <span class="ink">é inteligência para decisão.</span>
          </h1>

          <p class="sub reveal d2">
            Laboratório de pesquisa aplicada em Decision Intelligence, Data
            Engineering e Cybersecurity. Método explícito, dados primários,
            publicação aberta.
          </p>

          <div class="ctas reveal d3">
            <a href="/contato" class="btn btn-solid">iniciar projeto →</a>
            <a href="/blog" class="btn btn-ghost">ler a pesquisa</a>
          </div>
        </div>

        <div class="proof-band reveal d4">
          <div class="proof-inner">
            <a href="/posts/campanhas-afirmativas-gaming" class="proof-item">
              <span class="proof-val">N=98</span>
              <span class="proof-lbl">amostra do estudo de gaming, protocolo STROBE</span>
            </a>
            <a href="/posts/campanhas-afirmativas-gaming" class="proof-item">
              <span class="proof-val">87.8%</span>
              <span class="proof-lbl">acreditam que campanhas afirmativas geram impacto real</span>
            </a>
            <a href="/posts/campanhas-afirmativas-gaming" class="proof-item">
              <span class="proof-val">16.3%</span>
              <span class="proof-lbl">acreditam que marcas agem por motivação genuína</span>
            </a>
            <a href="/posts/campanhas-afirmativas-gaming" class="proof-item">
              <span class="proof-val">3.48×</span>
              <span class="proof-lbl">mais propensos a trocar de marca por compromisso comprovado</span>
            </a>
            <a href="/posts/campanhas-afirmativas-gaming" class="proof-item">
              <span class="proof-val">STROBE</span>
              <span class="proof-lbl">protocolo de relato seguido na pesquisa</span>
            </a>
          </div>
        </div>
      </section>

      <div class="pv-note">Preview B · <a href="/preview/hero-a">ver variação A →</a></div>
    </main>

    <style is:global>
      :root {
        --bg:        #08080A;
        --ink:       #F5F5F7;
        --ink-dim:   rgba(245, 245, 247, 0.52);
        --ink-faint: rgba(245, 245, 247, 0.30);
        --line:      rgba(245, 245, 247, 0.10);
        --line-2:    rgba(245, 245, 247, 0.20);
        --font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { color-scheme: dark; }
      body {
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-sans);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        overflow-x: hidden;
      }
      a { color: inherit; text-decoration: none; }
    </style>

    <style>
      /* ── HERO B · Resend Minimal ───────────────────────────────────
         Registro Resend: near-black, grid fino, glow branco no topo,
         composição editorial à esquerda, headline em peso leve, faixa
         de dados full-bleed com hairlines nítidas. Alto contraste mono. */
      .hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 150px 0 0;
        overflow: hidden;
      }
      .grid {
        position: absolute; inset: 0; z-index: 0; pointer-events: none;
        background-image:
          linear-gradient(rgba(245,245,247,0.025) 1px, transparent 1px),
          linear-gradient(90deg, rgba(245,245,247,0.025) 1px, transparent 1px);
        background-size: 80px 80px;
        mask-image: radial-gradient(ellipse 80% 60% at 25% 30%, #000 10%, transparent 72%);
        -webkit-mask-image: radial-gradient(ellipse 80% 60% at 25% 30%, #000 10%, transparent 72%);
      }
      .top-glow {
        position: absolute; z-index: 0; pointer-events: none;
        top: -360px; left: 8%;
        width: 760px; height: 760px;
        background: radial-gradient(circle at center,
          rgba(245,245,247,0.07) 0%, rgba(245,245,247,0.02) 40%, transparent 70%);
        filter: blur(30px);
      }

      .wrap {
        position: relative; z-index: 2;
        width: 100%; max-width: 1180px;
        margin: 0 auto; padding: 0 40px;
        flex: 1;
        display: flex; flex-direction: column; justify-content: center;
      }

      .brand-row {
        display: inline-flex; align-items: center; gap: 16px;
        margin-bottom: 40px;
      }
      .brand {
        display: inline-flex; align-items: flex-end;
        font-weight: 500; font-size: 18px;
        letter-spacing: -0.02em; color: var(--ink); line-height: 1;
      }
      .brand .dot { width: 4px; height: 4px; background: var(--ink); margin: 0 2px 3px; align-self: flex-end; }
      .brand-row .sep { width: 1px; height: 13px; background: var(--line-2); }
      .eyebrow {
        font-size: 11.5px; font-weight: 400;
        letter-spacing: 0.18em; text-transform: uppercase;
        color: var(--ink-dim);
      }

      .headline {
        font-weight: 300;
        font-size: clamp(38px, 5.6vw, 78px);
        line-height: 1.06;
        letter-spacing: -0.03em;
        max-width: 16ch;
        text-wrap: balance;
        margin-bottom: 34px;
      }
      .headline .dim { color: var(--ink-faint); font-weight: 200; }
      .headline .ink { color: var(--ink); font-weight: 400; }

      .sub {
        font-size: 18px; font-weight: 400; line-height: 1.7;
        color: var(--ink-dim);
        max-width: 540px;
        margin-bottom: 40px;
        text-wrap: pretty;
      }

      .ctas { display: flex; gap: 14px; flex-wrap: wrap; }
      .btn {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 13px 26px; border-radius: 10px;
        font-size: 15px; font-weight: 500; font-family: var(--font-sans);
        cursor: pointer; transition: transform .2s ease, background .2s ease, border-color .2s ease;
      }
      .btn-solid { background: var(--ink); color: #000; border: 1px solid var(--ink); }
      .btn-solid:hover { transform: translateY(-2px); background: #fff; }
      .btn-ghost { background: rgba(245,245,247,0.02); color: var(--ink); border: 1px solid var(--line-2); }
      .btn-ghost:hover { border-color: rgba(245,245,247,0.42); background: rgba(245,245,247,0.05); transform: translateY(-2px); }

      .proof-band {
        position: relative; z-index: 2;
        width: 100%;
        margin-top: 72px;
        border-top: 1px solid var(--line);
        background: rgba(245,245,247,0.015);
      }
      .proof-inner {
        max-width: 100%; margin: 0 auto;
        display: grid; grid-template-columns: repeat(5, 1fr);
      }
      .proof-item {
        display: flex; flex-direction: column; gap: 9px;
        padding: 24px 28px;
        border-right: 1px solid var(--line);
        transition: background .2s ease;
      }
      .proof-item:last-child { border-right: none; }
      .proof-item:hover { background: rgba(245,245,247,0.03); }
      .proof-val {
        font-size: clamp(19px, 1.9vw, 25px);
        font-weight: 300; letter-spacing: -0.02em;
        color: var(--ink); font-feature-settings: 'tnum' 1;
      }
      .proof-lbl { font-size: 11.5px; line-height: 1.5; color: var(--ink-dim); font-weight: 400; }

      .pv-note {
        position: fixed; bottom: 16px; right: 18px; z-index: 50;
        font-size: 11px; letter-spacing: .04em;
        color: var(--ink-dim); background: rgba(20,20,22,0.8);
        border: 1px solid var(--line); border-radius: 100px; padding: 7px 14px;
        backdrop-filter: blur(8px);
      }
      .pv-note a { color: var(--ink); }

      .reveal { opacity: 0; transform: translateY(16px); animation: rise .8s cubic-bezier(.16,1,.3,1) forwards; }
      .d1 { animation-delay: .10s; } .d2 { animation-delay: .20s; }
      .d3 { animation-delay: .30s; } .d4 { animation-delay: .42s; }
      @keyframes rise { to { opacity: 1; transform: translateY(0); } }

      @media (max-width: 1000px) {
        .proof-inner { grid-template-columns: repeat(3, 1fr); }
        .proof-item:nth-child(3) { border-right: none; }
        .proof-item:nth-child(n+4) { border-top: 1px solid var(--line); }
      }
      @media (max-width: 620px) {
        .hero { padding: 116px 0 0; }
        .wrap { padding: 0 24px; }
        .headline { max-width: none; }
        .proof-inner { grid-template-columns: repeat(2, 1fr); }
        .proof-item:nth-child(3) { border-right: 1px solid var(--line); }
        .proof-item:nth-child(2n) { border-right: none; }
        .proof-item:nth-child(n+3) { border-top: 1px solid var(--line); }
      }

      @media (prefers-reduced-motion: reduce) {
        .reveal { animation: none; opacity: 1; transform: none; }
        .btn:hover { transform: none; }
      }
    </style>
  </body>
</html>
