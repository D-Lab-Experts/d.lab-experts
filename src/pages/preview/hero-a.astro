---
// PREVIEW ISOLADO — Hero variação A · "Editorial Scale" (Anthropic-leaning)
// Página autocontida: não importa Layout nem global.css, para não
// contaminar o site vivo. Tokens do redesign Apple×Anthropic dark
// (lilás/azul) ficam escopados aqui. Copy verbatim de src/i18n/pt.ts.
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>Preview · Hero A — Editorial Scale | D.Lab</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=DM+Sans:opsz,wght@9..40,400;9..40,500&family=DM+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main>
      <!-- ══ HERO A ══════════════════════════════════════════════════ -->
      <section class="hero" id="hero">
        <div class="glow glow-a" aria-hidden="true"></div>
        <div class="hairline" aria-hidden="true"></div>

        <div class="wrap">
          <div class="kicker reveal">
            <span class="brand">D<span class="dot" aria-hidden="true"></span>Lab</span>
            <span class="sep" aria-hidden="true"></span>
            <span class="eyebrow">Decision Intelligence Research</span>
          </div>

          <h1 class="headline reveal d1">
            <span class="ln dim">não é consultoria.</span>
            <span class="ln dim">não é pesquisa de mercado.</span>
            <span class="ln ink">é inteligência para decisão.</span>
          </h1>

          <p class="sub reveal d2">
            Laboratório de pesquisa aplicada em Decision Intelligence, Data
            Engineering e Cybersecurity. Método explícito, dados primários,
            publicação aberta.
          </p>

          <div class="ctas reveal d3">
            <a href="/contato" class="btn btn-accent">iniciar projeto →</a>
            <a href="/blog" class="btn btn-ghost">ler a pesquisa</a>
          </div>

          <div class="proof reveal d4">
            <a href="/posts/campanhas-afirmativas-gaming" class="proof-item">
              <span class="proof-val">N=98</span>
              <span class="proof-lbl">amostra do estudo de gaming, protocolo STROBE</span>
            </a>
            <a href="/posts/campanhas-afirmativas-gaming" class="proof-item">
              <span class="proof-val accent">87.8%</span>
              <span class="proof-lbl">acreditam que campanhas afirmativas geram impacto real</span>
            </a>
            <a href="/posts/campanhas-afirmativas-gaming" class="proof-item">
              <span class="proof-val">16.3%</span>
              <span class="proof-lbl">acreditam que marcas agem por motivação genuína</span>
            </a>
            <a href="/posts/campanhas-afirmativas-gaming" class="proof-item">
              <span class="proof-val">3.48×</span>
              <span class="proof-lbl">mais propensos a trocar de marca por compromisso social comprovado</span>
            </a>
            <a href="/posts/campanhas-afirmativas-gaming" class="proof-item">
              <span class="proof-val">STROBE</span>
              <span class="proof-lbl">protocolo de relato seguido na pesquisa</span>
            </a>
          </div>
        </div>
      </section>

      <!-- nota de preview -->
      <div class="pv-note">
        Preview A · <a href="/preview/hero-b">ver variação B →</a>
      </div>
    </main>

    <style is:global>
      :root {
        --bg:        #0B0B0F;
        --surface:   #1A1A22;
        --elev-2:    #22222C;
        --ink:       #EAEAF0;
        --ink-dim:   rgba(234, 234, 240, 0.55);
        --accent:    #B18CFF; /* lilás */
        --accent-2:  #4DA3FF; /* azul */
        --line:      rgba(234, 234, 240, 0.10);
        --line-2:    rgba(234, 234, 240, 0.18);
        --font-display: 'Syne', system-ui, sans-serif;
        --font-sans:    'DM Sans', system-ui, -apple-system, sans-serif;
        --font-mono:    'DM Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { color-scheme: dark; }
      body {
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-sans);
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        overflow-x: hidden;
      }
      a { color: inherit; text-decoration: none; }
    </style>

    <style>
      /* ── HERO A · Editorial Scale ──────────────────────────────────
         Anthropic-leaning: a frase é o herói. Alinhamento à esquerda
         numa coluna de leitura, um único glow lilás respirando, cor
         como pontuação (um número, o CTA). Muito respiro vertical. */
      .hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        padding: 160px 0 120px;
        overflow: hidden;
      }
      .wrap {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 40px;
      }
      /* Glow radial lilás único, baixíssima opacidade, respira devagar */
      .glow {
        position: absolute;
        pointer-events: none;
        z-index: 0;
        filter: blur(40px);
      }
      .glow-a {
        width: 760px;
        height: 760px;
        top: -200px;
        left: -120px;
        background: radial-gradient(
          circle at center,
          rgba(177, 140, 255, 0.16) 0%,
          rgba(177, 140, 255, 0.05) 38%,
          transparent 70%
        );
        animation: breathe 9s ease-in-out infinite;
      }
      @keyframes breathe {
        0%, 100% { opacity: 0.7; transform: scale(1); }
        50%      { opacity: 1;   transform: scale(1.06); }
      }
      .hairline {
        position: absolute; inset: 0; z-index: 0; pointer-events: none;
        background-image:
          linear-gradient(rgba(234, 234, 240, 0.022) 1px, transparent 1px),
          linear-gradient(90deg, rgba(234, 234, 240, 0.022) 1px, transparent 1px);
        background-size: 96px 96px;
        mask-image: radial-gradient(ellipse 90% 80% at 30% 35%, #000 20%, transparent 75%);
        -webkit-mask-image: radial-gradient(ellipse 90% 80% at 30% 35%, #000 20%, transparent 75%);
      }

      .kicker {
        display: inline-flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 40px;
      }
      .brand {
        display: inline-flex;
        align-items: flex-end;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 19px;
        letter-spacing: -0.03em;
        color: var(--ink);
        line-height: 1;
      }
      .brand .dot {
        width: 5px; height: 5px;
        background: var(--accent);
        margin: 0 2px 3px;
        align-self: flex-end;
      }
      .kicker .sep { width: 1px; height: 14px; background: var(--line-2); }
      .eyebrow {
        font-family: var(--font-mono);
        font-size: 11.5px;
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--ink-dim);
      }

      .headline {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(40px, 6.4vw, 88px);
        line-height: 1.04;
        letter-spacing: -0.035em;
        text-wrap: balance;
        margin-bottom: 36px;
      }
      .headline .ln { display: block; }
      .headline .dim { color: var(--ink-dim); }
      .headline .ink { color: var(--ink); }

      .sub {
        font-size: 18px;
        line-height: 1.7;
        color: var(--ink-dim);
        max-width: 560px;
        margin-bottom: 44px;
        text-wrap: pretty;
      }

      .ctas { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 80px; }
      .btn {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 14px 26px; border-radius: 10px;
        font-size: 15px; font-weight: 500; font-family: var(--font-sans);
        cursor: pointer; transition: transform .2s ease, background .2s ease, border-color .2s ease;
      }
      .btn-accent {
        background: var(--accent);
        color: #15101F;
        border: 1px solid var(--accent);
        font-weight: 600;
      }
      .btn-accent:hover { transform: translateY(-2px); background: #c2a3ff; }
      .btn-ghost { background: transparent; color: var(--ink); border: 1px solid var(--line-2); }
      .btn-ghost:hover { border-color: rgba(234,234,240,0.4); background: rgba(234,234,240,0.03); transform: translateY(-2px); }

      .proof {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 0;
        border-top: 1px solid var(--line);
        padding-top: 28px;
      }
      .proof-item {
        display: flex; flex-direction: column; gap: 10px;
        padding: 4px 22px 4px 0;
        border-right: 1px solid var(--line);
        transition: opacity .2s ease;
      }
      .proof-item:last-child { border-right: none; }
      .proof-item:hover { opacity: 1; }
      .proof:hover .proof-item { opacity: 0.5; }
      .proof:hover .proof-item:hover { opacity: 1; }
      .proof-val {
        font-family: var(--font-mono);
        font-size: clamp(20px, 2.2vw, 28px);
        font-weight: 500;
        letter-spacing: -0.02em;
        color: var(--ink);
        font-feature-settings: 'tnum' 1;
      }
      .proof-val.accent { color: var(--accent); }
      .proof-lbl {
        font-size: 12px;
        line-height: 1.5;
        color: var(--ink-dim);
      }

      .pv-note {
        position: fixed; bottom: 16px; right: 18px; z-index: 50;
        font-family: var(--font-mono); font-size: 11px; letter-spacing: .04em;
        color: var(--ink-dim); background: rgba(26,26,34,0.8);
        border: 1px solid var(--line); border-radius: 100px; padding: 7px 14px;
        backdrop-filter: blur(8px);
      }
      .pv-note a { color: var(--accent); }

      /* ── Reveals (Apple-style, sutil) ── */
      .reveal { opacity: 0; transform: translateY(16px); animation: rise .7s cubic-bezier(.16,1,.3,1) forwards; }
      .d1 { animation-delay: .08s; }
      .d2 { animation-delay: .16s; }
      .d3 { animation-delay: .24s; }
      .d4 { animation-delay: .32s; }
      @keyframes rise { to { opacity: 1; transform: translateY(0); } }

      @media (max-width: 900px) {
        .proof { grid-template-columns: repeat(2, 1fr); gap: 24px 0; }
        .proof-item { border-right: none; padding-right: 18px; }
        .proof-item:nth-child(odd) { border-right: 1px solid var(--line); }
      }
      @media (max-width: 520px) {
        .hero { padding: 120px 0 90px; }
        .proof { grid-template-columns: 1fr; }
        .proof-item:nth-child(odd) { border-right: none; }
        .kicker { flex-wrap: wrap; gap: 10px; }
      }

      @media (prefers-reduced-motion: reduce) {
        .glow-a { animation: none; }
        .reveal { animation: none; opacity: 1; transform: none; }
        .btn:hover { transform: none; }
      }
    </style>
  </body>
</html>
