---
// PREVIEW ISOLADO — Hero A · "Keynote" (Apple-leaning)
// Monocromático alto contraste, tipografia fina/elegante (Inter thin),
// cinemático e imponente. Página autocontida: não importa Layout nem
// global.css. Copy verbatim de src/i18n/pt.ts.
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>Preview · Hero A — Keynote | D.Lab</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,200;14..32,300;14..32,400;14..32,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main>
      <!-- ══ HERO A · KEYNOTE ════════════════════════════════════════ -->
      <section class="hero" id="hero">
        <div class="beam" aria-hidden="true"></div>

        <div class="wrap">
          <div class="eyebrow reveal">Decision Intelligence Research</div>

          <h1 class="headline">
            <span class="ln dim reveal d1">não é consultoria.</span>
            <span class="ln dim reveal d2">não é pesquisa de mercado.</span>
            <span class="ln ink reveal d3">é inteligência para decisão.</span>
          </h1>

          <p class="sub reveal d4">
            Laboratório de pesquisa aplicada em Decision Intelligence, Data
            Engineering e Cybersecurity. Método explícito, dados primários,
            publicação aberta.
          </p>

          <div class="ctas reveal d5">
            <a href="/contato" class="btn btn-solid">iniciar projeto →</a>
            <a href="/blog" class="btn btn-ghost">ler a pesquisa</a>
          </div>
        </div>

        <div class="proof reveal d6">
          <a href="/posts/campanhas-afirmativas-gaming" class="proof-item">
            <span class="proof-val">N=98</span>
            <span class="proof-lbl">amostra do estudo de gaming, protocolo STROBE</span>
          </a>
          <a href="/posts/campanhas-afirmativas-gaming" class="proof-item">
            <span class="proof-val">87.8%</span>
            <span class="proof-lbl">acreditam que campanhas afirmativas geram impacto real</span>
          </a>
          <a href="/posts/campanhas-afirmativas-gaming" class="proof-item">
            <span class="proof-val">16.3%</span>
            <span class="proof-lbl">acreditam que marcas agem por motivação genuína</span>
          </a>
          <a href="/posts/campanhas-afirmativas-gaming" class="proof-item">
            <span class="proof-val">3.48×</span>
            <span class="proof-lbl">mais propensos a trocar de marca por compromisso comprovado</span>
          </a>
          <a href="/posts/campanhas-afirmativas-gaming" class="proof-item">
            <span class="proof-val">STROBE</span>
            <span class="proof-lbl">protocolo de relato seguido na pesquisa</span>
          </a>
        </div>

        <div class="scroll-ind" aria-hidden="true"><span class="scroll-line"></span></div>
      </section>

      <div class="pv-note">Preview A · <a href="/preview/hero-b">ver variação B →</a></div>
    </main>

    <style is:global>
      :root {
        --bg:        #000000;
        --ink:       #F5F5F7;
        --ink-dim:   rgba(245, 245, 247, 0.52);
        --ink-faint: rgba(245, 245, 247, 0.30);
        --line:      rgba(245, 245, 247, 0.12);
        --line-2:    rgba(245, 245, 247, 0.22);
        --font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { color-scheme: dark; }
      body {
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-sans);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        overflow-x: hidden;
      }
      a { color: inherit; text-decoration: none; }
    </style>

    <style>
      /* ── HERO A · Keynote ──────────────────────────────────────────
         Apple keynote: preto absoluto, um feixe de luz branco suave
         vindo de cima, headline gigante em peso fino (300), muito
         respiro. Alto contraste por preto×branco, nunca por cor. */
      .hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 150px 0 0;
        overflow: hidden;
        text-align: center;
      }
      /* Feixe de luz cinematográfico — radial branco, baixíssima opacidade */
      .beam {
        position: absolute;
        z-index: 0; pointer-events: none;
        top: -34%; left: 50%; transform: translateX(-50%);
        width: 1100px; height: 900px;
        background: radial-gradient(
          ellipse 50% 50% at center,
          rgba(245, 245, 247, 0.10) 0%,
          rgba(245, 245, 247, 0.035) 34%,
          transparent 68%
        );
        filter: blur(20px);
        animation: beam-breathe 11s ease-in-out infinite;
      }
      @keyframes beam-breathe {
        0%, 100% { opacity: 0.75; transform: translateX(-50%) scale(1); }
        50%      { opacity: 1;    transform: translateX(-50%) scale(1.05); }
      }

      .wrap {
        position: relative; z-index: 2;
        width: 100%; max-width: 1040px;
        margin: 0 auto; padding: 0 32px;
        flex: 1;
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
      }

      .eyebrow {
        font-size: 12px;
        font-weight: 400;
        letter-spacing: 0.32em;
        text-transform: uppercase;
        color: var(--ink-dim);
        margin-bottom: 40px;
      }

      .headline {
        font-weight: 300;            /* fino / elegante */
        font-size: clamp(40px, 7vw, 104px);
        line-height: 1.02;
        letter-spacing: -0.035em;
        text-wrap: balance;
        margin-bottom: 44px;
      }
      .headline .ln { display: block; }
      .headline .dim { color: var(--ink-faint); font-weight: 200; }
      .headline .ink { color: var(--ink); font-weight: 300; }

      .sub {
        font-size: 18px;
        font-weight: 400;
        line-height: 1.65;
        color: var(--ink-dim);
        max-width: 540px;
        margin: 0 auto 44px;
        text-wrap: pretty;
      }

      .ctas { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; margin-bottom: 16px; }
      .btn {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 14px 28px; border-radius: 980px;   /* pílula Apple */
        font-size: 15px; font-weight: 500; font-family: var(--font-sans);
        cursor: pointer; transition: transform .2s ease, background .2s ease, border-color .2s ease;
      }
      .btn-solid {
        background: var(--ink); color: #000;
        border: 1px solid var(--ink);
      }
      .btn-solid:hover { transform: translateY(-2px); background: #fff; }
      .btn-ghost { background: transparent; color: var(--ink); border: 1px solid var(--line-2); }
      .btn-ghost:hover { border-color: rgba(245,245,247,0.45); background: rgba(245,245,247,0.04); transform: translateY(-2px); }

      /* faixa de prova quieta, separadores em hairline */
      .proof {
        position: relative; z-index: 2;
        width: 100%; max-width: 1180px;
        margin: 0 auto;
        padding: 30px 32px 40px;
        display: grid; grid-template-columns: repeat(5, 1fr);
        gap: 0;
        border-top: 1px solid var(--line);
      }
      .proof-item {
        display: flex; flex-direction: column; gap: 9px;
        padding: 0 24px; text-align: left;
        border-right: 1px solid var(--line);
        transition: opacity .2s ease;
      }
      .proof-item:first-child { padding-left: 0; }
      .proof-item:last-child { border-right: none; padding-right: 0; }
      .proof:hover .proof-item { opacity: 0.45; }
      .proof:hover .proof-item:hover { opacity: 1; }
      .proof-val {
        font-size: clamp(20px, 2.1vw, 28px);
        font-weight: 300; letter-spacing: -0.02em;
        color: var(--ink); font-feature-settings: 'tnum' 1;
      }
      .proof-lbl { font-size: 12px; line-height: 1.5; color: var(--ink-dim); font-weight: 400; }

      .scroll-ind {
        position: absolute; bottom: 26px; left: 50%; transform: translateX(-50%);
        z-index: 2;
      }
      .scroll-line {
        display: block; width: 1px; height: 40px;
        background: linear-gradient(to bottom, var(--ink-dim), transparent);
        animation: spl 2.4s ease-in-out infinite;
      }
      @keyframes spl { 0%,100%{opacity:.3;transform:scaleY(.7)} 50%{opacity:1;transform:scaleY(1)} }

      .pv-note {
        position: fixed; bottom: 16px; right: 18px; z-index: 50;
        font-size: 11px; letter-spacing: .04em;
        color: var(--ink-dim); background: rgba(20,20,22,0.8);
        border: 1px solid var(--line); border-radius: 100px; padding: 7px 14px;
        backdrop-filter: blur(8px);
      }
      .pv-note a { color: var(--ink); }

      .reveal { opacity: 0; transform: translateY(18px); animation: rise .8s cubic-bezier(.16,1,.3,1) forwards; }
      .d1 { animation-delay: .08s; } .d2 { animation-delay: .16s; }
      .d3 { animation-delay: .26s; } .d4 { animation-delay: .40s; }
      .d5 { animation-delay: .50s; } .d6 { animation-delay: .60s; }
      @keyframes rise { to { opacity: 1; transform: translateY(0); } }

      @media (max-width: 900px) {
        .proof { grid-template-columns: repeat(2, 1fr); gap: 22px 0; }
        .proof-item { border-right: none; padding: 0 16px 0 0; }
        .proof-item:nth-child(odd) { border-right: 1px solid var(--line); }
      }
      @media (max-width: 520px) {
        .hero { padding: 116px 0 0; }
        .eyebrow { letter-spacing: 0.22em; }
        .proof { grid-template-columns: 1fr; }
        .proof-item:nth-child(odd) { border-right: none; }
      }

      @media (prefers-reduced-motion: reduce) {
        .beam, .scroll-line { animation: none; }
        .reveal { animation: none; opacity: 1; transform: none; }
        .btn:hover { transform: none; }
      }
    </style>
  </body>
</html>
