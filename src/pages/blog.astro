---
import Layout from '../layouts/Layout.astro';
import NeuralNetwork from '../components/NeuralNetwork.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const intelligencePosts = allPosts.filter((p) => p.data.track === 'intelligence');
const cybersecPosts = allPosts.filter((p) => p.data.track === 'cybersec');

const formatDate = (d: Date) =>
  d.toLocaleDateString('pt-BR', { year: 'numeric', month: 'long' });
---

<Layout
  title="Pesquisas e Análises Públicas | D.Lab · Decision Intelligence Research"
  description="Pesquisas, análises e cases publicados pelo D.Lab como prova pública do método. Inteligência de dados e cybersegurança em fontes abertas, raciocínio exposto e dados auditáveis."
  active="blog"
>
  <!-- ═══════════════ BLOG HERO ═══════════════════════════════════ -->
  <section class="blog-hero">
    <div class="blog-hero-glow"></div>
    <NeuralNetwork color="lilac" density="medium" opacity={0.30} />
    <div class="container">
      <div class="blog-hero-inner fi">
        <div class="section-label" style="justify-content:center"><span class="label">Pesquisas e Análises Públicas</span></div>
        <h1 class="blog-hero-title">Pesquisas e análises <span class="gradient-text">públicas.</span></h1>
        <p class="blog-hero-sub">Publicamos uma fração do que produzimos como prova pública do método. Inteligência aplicada e cybersegurança, sob o mesmo protocolo de rigor.</p>
      </div>

      <div class="blog-track-nav fi d1">
        <a href="#inteligencia" class="blog-track-btn lilac">
          <span class="blog-track-btn-dot"></span>
          Inteligência &amp; Pesquisa
          <span class="blog-track-btn-count">{intelligencePosts.length}</span>
        </a>
        <a href="#cybersec" class="blog-track-btn green">
          <span class="blog-track-btn-dot"></span>
          Cybersegurança
          <span class="blog-track-btn-count">{cybersecPosts.length}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════ 01 · INTELIGÊNCIA ══════════════════════════ -->
  <section class="container blog-track-section" id="inteligencia">
    <div class="blog-track-header fi">
      <div class="blog-track-eyebrow lilac">
        <span class="blog-track-eyebrow-num">01</span>
        Inteligência
      </div>
      <h2 class="blog-track-title">Inteligência &amp; <span class="gradient-text">Pesquisa Aplicada</span></h2>
      <p class="blog-track-sub">Decisão estratégica, mercado, concorrência, tendências, público e política. Pesquisa que fundamenta o movimento antes dele acontecer.</p>
    </div>

    {intelligencePosts.length > 0 ? (
      <div class="blog-grid">
        {intelligencePosts.map((post, idx) => {
          const isFeatured = post.data.featured || idx === 0;
          const cardClass = isFeatured ? 'blog-card-featured fi d1' : 'blog-card fi d2';
          return (
            <a href={`/posts/${post.slug}`} class={cardClass}>
              <div class="blog-card-img" style={`padding:0;background:${post.data.cover ? 'none' : 'var(--surface)'}`}>
                {post.data.cover && (
                  <img src={post.data.cover} alt={post.data.coverAlt ?? ''} loading="lazy" width="800" height="450" style="width:100%;height:100%;object-fit:cover;position:relative;z-index:1" />
                )}
              </div>
              <div class="blog-card-body">
                <div class="blog-card-tags">
                  <span class="blog-card-tag lilac">{post.data.category}</span>
                  {post.data.tags.slice(0, 2).map((t: string) => (
                    <span class="blog-card-tag blue">{t}</span>
                  ))}
                </div>
                <h3 class="blog-card-title">{post.data.title}</h3>
                <p class="blog-card-excerpt">{post.data.description}</p>
                {post.data.readingTime && (
                  <div class="blog-card-meta">
                    <span class="blog-card-author">{post.data.author}</span>
                    <span class="blog-card-dot"></span>
                    <span class="blog-card-time">{post.data.readingTime}</span>
                  </div>
                )}
                <div class="blog-card-footer">
                  <span class="blog-card-date">{formatDate(post.data.pubDate)}</span>
                  <span class="blog-card-read">Ler pesquisa <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <div class="blog-empty fi">
        <div class="blog-empty-title">Em preparação.</div>
        <div class="blog-empty-text">As próximas pesquisas serão publicadas após liberação pós-NDA.</div>
      </div>
    )}
  </section>

  <div class="section-sep"></div>

  <!-- ═══════════════ 02 · CYBERSEGURANÇA ════════════════════════ -->
  <section class="container blog-track-section blog-track-cyber" id="cybersec">
    <div class="blog-track-header fi">
      <div class="blog-track-eyebrow green">
        <span class="blog-track-eyebrow-num">02</span>
        Cybersegurança
      </div>
      <h2 class="blog-track-title">Cybersegurança &amp; <span class="gradient-text-green">Operação Ofensiva</span></h2>
      <p class="blog-track-sub">Pentest, análise de vulnerabilidades, incidentes e posturas de segurança. Cases e análises técnicas publicadas quando o NDA permite.</p>
    </div>

    {cybersecPosts.length > 0 ? (
      <div class="blog-grid">
        {cybersecPosts.map((post, idx) => {
          const isFeatured = post.data.featured || idx === 0;
          const cardClass = isFeatured ? 'blog-card-featured fi d1' : 'blog-card fi d2';
          return (
            <a href={`/posts/${post.slug}`} class={cardClass}>
              <div class="blog-card-img" style={`padding:0;background:${post.data.cover ? 'none' : 'var(--surface)'}`}>
                {post.data.cover && (
                  <img src={post.data.cover} alt={post.data.coverAlt ?? ''} loading="lazy" width="800" height="450" style="width:100%;height:100%;object-fit:cover;position:relative;z-index:1" />
                )}
              </div>
              <div class="blog-card-body">
                <div class="blog-card-tags">
                  <span class="blog-card-tag green">{post.data.category}</span>
                  {post.data.tags.slice(0, 2).map((t: string) => (
                    <span class="blog-card-tag cyan">{t}</span>
                  ))}
                </div>
                <h3 class="blog-card-title">{post.data.title}</h3>
                <p class="blog-card-excerpt">{post.data.description}</p>
                {post.data.readingTime && (
                  <div class="blog-card-meta">
                    <span class="blog-card-author">{post.data.author}</span>
                    <span class="blog-card-dot"></span>
                    <span class="blog-card-time">{post.data.readingTime}</span>
                  </div>
                )}
                <div class="blog-card-footer">
                  <span class="blog-card-date">{formatDate(post.data.pubDate)}</span>
                  <span class="blog-card-read green">Ler análise <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <div class="blog-empty cyber fi">
        <div class="blog-empty-icon">
          <svg width="36" height="36" viewBox="0 0 36 36" fill="none">
            <path d="M18 3L6 8v9c0 7.5 5 14 12 16 7-2 12-8.5 12-16V8L18 3z" stroke="url(#g-green)" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M13 18l3.5 3.5L23 14" stroke="url(#g-green)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="blog-empty-title">Em preparação.</div>
        <div class="blog-empty-text">Os primeiros cases públicos de cybersegurança serão publicados quando o NDA permitir. Enquanto isso, a frente segue ativa em pentest, análise de vulnerabilidades e consultoria ofensiva.</div>
        <div class="blog-empty-cta">
          <a href="/contato" class="btn btn-ghost">Propor um escopo de segurança →</a>
        </div>
      </div>
    )}
  </section>
</Layout>
